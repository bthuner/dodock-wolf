2,949],{},[256,1134,1135],{},[273,1136,1137],{},"cargo:machine",[256,1139,1140],{},"No expiry",[256,1142,1143],{},"Honoured while the machine's record says Running",[238,1145,1146,1149,1151,1154,1156],{},[256,1147,1148],{},"Admin API call",[256,1150,835],{},[256,1152,1153],{},"The bench's id",[256,1155,1006],{},[256,1157,1158,381,1161],{},[273,1159,1160],{},"scope=bench",[273,1162,1163],{},"sub=admin",[238,1165,1166,1169,1171,1173,1175],{},[256,1167,1168],{},"Site login",[256,1170,835],{},[256,1172,1153],{},[256,1174,1006],{},[256,1176,1177,1180],{},[273,1178,1179],{},"scope=site",", the site",[238,1182,1183,1186,1188,1190,1193],{},[256,1184,1185],{},"Open bench",[256,1187,835],{},[256,1189,1153],{},[256,1191,1192],{},"Session length (60 min by default)",[256,1194,1195],{},"Single use",[238,1197,1198,1201,1203,1206,1208],{},[256,1199,1200],{},"Team identity",[256,1202,835],{},[256,1204,1205],{},"An address the site chooses",[256,1207,1006],{},[256,1209,1210,381,1213,381,1216,1219],{},[273,1211,1212],{},"sub=\u003Cteam>",[273,1214,1215],{},"team_name",[273,1217,1218],{},"hosts"," (the server's site addresses)",[238,1221,1222,1225,1228,1231,1234],{},[256,1223,1224],{},"Web console",[256,1226,1227],{},"Atlas (random, not a JWT)",[256,1229,1230],{},"—",[256,1232,1233],{},"30 s",[256,1235,1236],{},"Single use, in the address' fragment",[238,1238,1239,1243,1246,1248,1251],{},[256,1240,1241],{},[273,1242,500],{},[256,1244,1245],{},"Central (random, not a JWT)",[256,1247,1230],{},[256,1249,1250],{},"Until the machine is deleted or staff revoke it",[256,1252,1253],{},"Central keeps its SHA-256",[238,1255,1256,1260,1263,1265,1267],{},[256,1257,1258],{},[273,1259,533],{},[256,1261,1262],{},"The bench",[256,1264,1230],{},[256,1266,385],{},[256,1268,1269,1271],{},[273,1270,1179],{},", one site",[218,1273,1274],{},"There is no revocation list anywhere. A 7-day Datum token of a deleted server is valid until it expires, and Pilot renews by expiry only (when 24 hours or less remain).",[222,1276,1278],{"id":1277},"secrets-on-the-way-to-a-machine","Secrets on the way to a machine",[218,1280,1281,1282,1285,1286,1289],{},"Central passes the customer's ",[273,1283,1284],{},"user_data"," (16 KiB at most) to cloud-init unchanged and stores it on the ",[273,1287,1288],{},"Resource Action",", so its own specification says it must hold no long-lived secret.",[218,1291,1292,1293,1296,1297,1300],{},"The platform's own secrets travel through the ",[383,1294,1295],{},"machine's metadata",", the service at ",[273,1298,1299],{},"169.254.169.254"," inside the machine:",[232,1302,1303,1316],{},[235,1304,1305],{},[238,1306,1307,1310,1313],{},[241,1308,1309],{},"Attribute",[241,1311,1312],{},"Contains",[241,1314,1315],{},"Applied by Pilot to",[251,1317,1318,1334,1353,1371],{},[238,1319,1320,1325,1331],{},[256,1321,1322],{},[273,1323,1324],{},"pilot-central",[256,1326,1327,1328,1330],{},"Central's address, the ",[273,1329,500],{},", the address of the keys, the bench's audience id, a first copy of the keys",[256,1332,1333],{},"Nothing: read at each call",[238,1335,1336,1341,1347],{},[256,1337,1338],{},[273,1339,1340],{},"pilot-common-site-config",[256,1342,1343,1346],{},[273,1344,1345],{},"fc_team",", the SMTP settings of a pooled mailbox, AI keys on a trial",[256,1348,1349,1352],{},[273,1350,1351],{},"sites\u002Fcommon_site_config.json",", once",[238,1354,1355,1360,1366],{},[256,1356,1357],{},[273,1358,1359],{},"pilot-common-config",[256,1361,1362,1363],{},"The Let's Encrypt contact, ",[273,1364,1365],{},"telemetry.endpoint",[256,1367,1368,1352],{},[273,1369,1370],{},"common_config.toml",[238,1372,1373,1378,1385],{},[256,1374,1375],{},[273,1376,1377],{},"pilot-config",[256,1379,1380,1381,1384],{},"The ",[273,1382,1383],{},"[s3]"," backup bucket's keys, when the plan includes storage",[256,1386,1387,1352],{},[273,1388,906],{},[218,1390,1391,1392,1395],{},"SSH keys take the same way: Atlas serves the authorized keys from the metadata at each login, so ",[273,1393,1394],{},"~\u002F.ssh\u002Fauthorized_keys"," of an image holds nothing (Pilot's Admin can still write to it).",[222,1397,1399],{"id":1398},"where-the-regions-meet-the-customer","Where the regions meet the customer",[232,1401,1402,1415],{},[235,1403,1404],{},[238,1405,1406,1409,1412],{},[241,1407,1408],{},"Name",[241,1410,1411],{},"Where TLS ends",[241,1413,1414],{},"What the server receives",[251,1416,1417,1439,1450],{},[238,1418,1419,1424,1427],{},[256,1420,1421],{},[273,1422,1423],{},"\u003Csite>.\u003Cregion domain>",[256,1425,1426],{},"At the proxy, with the region's wildcard certificate",[256,1428,1429,1430,381,1433,381,1436],{},"Plain HTTP on port 80, from the proxy's private address, with ",[273,1431,1432],{},"X-Real-IP",[273,1434,1435],{},"X-Forwarded-For",[273,1437,1438],{},"X-Forwarded-Proto",[238,1440,1441,1444,1447],{},[256,1442,1443],{},"A custom domain",[256,1445,1446],{},"On the server",[256,1448,1449],{},"The TLS stream on port 443, passed by SNI, with a PROXY protocol v2 header. Pilot holds the certificate; HTTP-01 challenges reach port 80",[238,1451,1452,1457,1460],{},[256,1453,1454],{},[273,1455,1456],{},"admin-vm-\u003Clabel>.\u003Cregion domain>",[256,1458,1459],{},"At the proxy",[256,1461,1462],{},"Pilot's Admin",[218,1464,1465],{},"A 502 or 504 the proxy makes itself (server stopped, asleep, unreachable) never reaches the server's logs. The proxy counts it, in aggregate, with no series per site.",[218,1467,1468,1469,1472],{},"Servers of one team in one region share a private IPv6 network (",[273,1470,1471],{},"fdaa:\u003Cregion>:\u003Ctenant>::\u002F64","), separated from other teams in eBPF on the hosts. It does not cross regions. The platform's service machines are reachable on it.",{"title":1474,"searchDepth":1475,"depth":1476,"links":1477},"",1,2,[1478,1484,1487,1488,1489],{"id":224,"depth":1476,"text":225,"children":1479},[1480,1482,1483],{"id":229,"depth":1481,"text":230},3,{"id":353,"depth":1481,"text":560},{"id":691,"depth":1481,"text"