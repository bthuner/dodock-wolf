:144,"path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"title":183,"path":184,"stem":185,"children":186,"icon":189},"Internals","\u002Finternals","7.internals\u002F1.index",[187,190,195,199,204,208],{"title":188,"path":184,"stem":185,"icon":189},"Frappe Cloud v2, read from its code","i-lucide-map",{"title":191,"path":192,"stem":193,"icon":194},"The applications","\u002Finternals\u002Fapps","7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Calls and trust","\u002Finternals\u002Finterop","7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flows","\u002Finternals\u002Fflows","7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Inside a customer server","\u002Finternals\u002Fcustomer-server","7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes for Wolf","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":209,"body":214,"description":1372,"extension":1373,"links":1374,"meta":1375,"navigation":1376,"path":210,"seo":1377,"stem":211,"__hash__":1378},"docs_en\u002F7.internals\u002F6.wolf.md",{"type":215,"value":216,"toc":1351},"minimark",[217,247,252,255,262,266,516,520,525,590,600,604,643,647,770,774,802,806,809,849,855,859,865,869,875,879,946,955,959,962,1022,1026,1227,1231,1234],[218,219,220,221,228,229,234,235,240,241,246],"p",{},"Everything here is planned or to check, not built. The decisions are tracked in ",[222,223,227],"a",{"href":224,"rel":225},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F136",[226],"nofollow","#136"," and the three reviews ",[222,230,233],{"href":231,"rel":232},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F133",[226],"#133"," (Datum), ",[222,236,239],{"href":237,"rel":238},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F134",[226],"#134"," (Central) and ",[222,242,245],{"href":243,"rel":244},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F135",[226],"#135"," (Beacon).",[248,249,251],"h2",{"id":250},"the-finding-that-holds","The finding that holds",[218,253,254],{},"No Frappe Cloud v2 application reads the inside of a bench. Central has no log, no per-site error and no security signal of any kind. Datum receives eight metrics and update events from a customer server. Beacon ignores a single failing site by design. Atlas sees a machine from its edge.",[218,256,257,258,261],{},"So on a customer's server the Wolf Agent is the only collector of: per-site 5xx, Frappe tracebacks, scheduler and worker failures, Frappe logins and role changes, SSH and sudo, attacks seen in nginx, file integrity, outbound connections. That is the ground ",[222,259,227],{"href":224,"rel":260},[226]," chose.",[248,263,265],{"id":264},"what-this-reading-corrects-in-the-reviews","What this reading corrects in the reviews",[267,268,269,282],"table",{},[270,271,272],"thead",{},[273,274,275,279],"tr",{},[276,277,278],"th",{},"Review said",[276,280,281],{},"The code says",[283,284,285,314,361,383,391,402,426,438,453,465,496,504],"tbody",{},[273,286,287,300],{},[288,289,290,291,295,296,299],"td",{},"Central merges ",[292,293,294],"code",{},"fc_team"," into the server's ",[292,297,298],{},"common_site_config.json"," (#134)",[288,301,302,303,306,307,311,312],{},"Central puts it in the machine's metadata (",[292,304,305],{},"pilot-common-site-config","); ",[308,309,310],"strong",{},"Pilot"," merges it once, at first boot. Pilot's code never names ",[292,313,294],{},[273,315,316,335],{},[288,317,318,319,322,323,322,326,322,329,322,332,299],{},"The Pilot API of Central is ",[292,320,321],{},"heartbeat",", ",[292,324,325],{},"datum_token",[292,327,328],{},"register_domain",[292,330,331],{},"get_team_identity_token",[292,333,334],{},"report_pilot_event",[288,336,337,338,322,341,322,344,322,347,322,350,353,354,356,357,360],{},"It is more than 40 methods: also ",[292,339,340],{},"config",[292,342,343],{},"get_server_access",[292,345,346],{},"storage_regions",[292,348,349],{},"domain_records",[292,351,352],{},"deregister_domain",", about 28 billing methods, mailbox OAuth, GitHub repository tokens. ",[292,355,334],{}," is at ",[292,358,359],{},"central.notification.api"," and takes only fixed event types",[273,362,363,368],{},[288,364,365,367],{},[292,366,331],{}," is hard for an app to reach (#134)",[288,369,370,371,374,375,378,379,382],{},"A site already reaches it: ",[292,372,373],{},"POST \u002Fapi\u002Fv1\u002Fsites\u002F\u003Csite>\u002Fcentral\u002Fcentral.api.pilot.get_team_identity_token"," on ",[292,376,377],{},"pilot_endpoint",", with the site's own ",[292,380,381],{},"pilot_auth_token",". Central answers with a 5-minute token for any audience the site names",[273,384,385,388],{},[288,386,387],{},"The default firewall allows outbound traffic (#134)",[288,389,390],{},"The firewall is off by default: everything is allowed, in and out",[273,392,393,399],{},[288,394,395,398],{},[292,396,397],{},"server_metrics"," are samples taken from outside the machine (#134)",[288,400,401],{},"Partly: a guest agent in every image adds load, memory, root file system use and the system's state",[273,403,404,411],{},[288,405,406,407,410],{},"On a customer server Pilot sends a heartbeat, site counts, backup status, ",[292,408,409],{},"pilot_database_up",", disk, update events (#133)",[288,412,413,414,417,418,421,422,425],{},"Also ",[292,415,416],{},"pilot_central_requests_last_5_minutes",", and ",[292,419,420],{},"pilot_site_backup_failed"," with the ",[308,423,424],{},"site's name",". Update events carry the site and up to 8,192 characters of output",[273,427,428,431],{},[288,429,430],{},"Datum accepts tokens from Central, Atlas or Cargo (#133)",[288,432,433,434,437],{},"Yes, and it learns all three keys from ",[308,435,436],{},"Cargo's"," address only",[273,439,440,443],{},[288,441,442],{},"Datum's documents say RSA\u002FECDSA (#133)",[288,444,445,448,449,452],{},[292,446,447],{},"docs\u002Ftokens.md"," now says Ed25519. One comment in ",[292,450,451],{},"CLAUDE.md"," still says otherwise",[273,454,455,462],{},[288,456,457,458,461],{},"Reading Datum needs a row policy on ",[292,459,460],{},"resource_id"," (#133)",[288,463,464],{},"There is no row policy at all: a reader sees the whole region",[273,466,467,478],{},[288,468,469,470,473,474,477],{},"Beacon's bridge: ",[292,471,472],{},"POST \u002Fapi\u002Fresource\u002FBeacon Incident"," with a Responder key, then ",[292,475,476],{},"page_on_call"," (#135)",[288,479,480,481,483,484,487,488,491,492,495],{},"Confirmed, with two cautions. ",[292,482,476],{}," pages at ",[308,485,486],{},"any"," severity. And the controller only defaults ",[292,489,490],{},"visibility"," and ",[292,493,494],{},"status"," when they are empty, so a Responder key can probably create a Public incident (inferred)",[273,497,498,501],{},[288,499,500],{},"Beacon requires Insights (#135)",[288,502,503],{},"Only for Beacon's own health dashboard, read from Beacon's database. Beacon reads ClickHouse by itself",[273,505,506,509],{},[288,507,508],{},"Trial servers sleep when idle (#134)",[288,510,511,512,515],{},"And they are ",[308,513,514],{},"locked",": no SSH, no console, no Admin until the trial is converted",[248,517,519],{"id":518},"what-to-build-cheapest-first","What to build, cheapest first",[521,522,524],"h3",{"id":523},"_1-recognise-a-frappe-cloud-v2-server","1. Recognise a Frappe Cloud v2 server",[267,526,527,540],{},[270,528,529],{},[273,530,531,534,537],{},[276,532,533],{},"Signal",[276,535,536],{},"Where",[276,538,539],{},"Read by",[283,541,542,557,571],{},[273,543,544,549,554],{},[288,545,546],{},[292,547,548],{},"[central] enabled = true",[288,550,551],{},[292,552,553],{},"~\u002Fpilot\u002Fbenches\u002Fcommon_config.toml",[288,555,556],{},"The agent at discovery (root)",[273,558,559,563,568],{},[288,560,561],{},[292,562,294],{},[288,564,565],{},[292,566,567],{},"sites\u002Fcommon_site_config.json",[288,569,570],{},"Same",[273,572,573,579,584],{},[288,574,575,578],{},[292,576,577],{},"[telemetry] endpoint"," is set",[288,580,581],{},[292,582,583],{},"common_config.toml",[288,585,586,587],{},"Same. Never read ",[292,588,589],{},"token",[218,591,592,593,596,597,599],{},"Report ",[292,594,595],{},"platform: frappe-cloud-v2"," and the team id in the registration and the inventory. Do not use ",[292,598,377],{},": a self-hosted Pilot writes it too.",[521,601,603],{"id":602},"_2-stay-quiet-about-what-the-platform-does","2. Stay quiet about what the platform does",[605,606,607,611,622,629,640],"ul",{},[608,609,610],"li",{},"Do not raise \"agent silent\" for a server that can sleep. The case is narrow: a paid server is created without idle sleep, and a trial server is locked, so it has no agent. Label a sleeping server; do not page for it.",[608,612,613,614,617,618,621],{},"A root login from ",[292,615,616],{},"172.16.0.x"," or on ",[292,619,620],{},"ttyS0"," is the web console, started from Central by a team member. Show it as such; it stays worth showing.",[608,623,624,625,628],{},"Outbound HTTP to ",[292,626,627],{},"internal-telemetry-svc.\u003Cregion domain>"," and HTTPS to Central are Pilot. They are not exfiltration.",[608,630,631,632,635,636,639],{},"Requests arriving from the proxy's network carry the client in ",[292,633,634],{},"X-Forwarded-For","; a custom domain's come with a PROXY protocol header. Attribute by those, and only when the peer is in ",[292,637,638],{},"fdaa:\u003Cregion>::\u002F64",".",[608,641,642],{},"Pilot restarting the bench after 900 idle seconds, or itself at 00:00 UTC, is not a crash.",[521,644,646],{"id":645},"_3-signals-this-reading-adds","3. Signals this reading adds",[267,648,649,661],{},[270,650,651],{},[273,652,653,655,658],{},[276,654,533],{},[276,656,657],{},"Why",[276,659,660],{},"Source",[283,662,663,681,708,728,743,759],{},[273,664,665,671,678],{},[288,666,667,668],{},"A process other than Pilot reads ",[292,669,670],{},"169.254.169.254",[288,672,673,674,677],{},"The answer holds the server's ",[292,675,676],{},"X-Pilot-Token",". Code that took over a site would want it",[288,679,680],{},"Outbound connections; the agent must never make that request itself",[273,682,683,696,699],{},[288,684,685,322,688,691,692,695],{},[292,686,687],{},"[telemetry] token",[292,689,690],{},"[s3]"," keys, the SMTP password and ",[292,693,694],{},"ai_keys"," sit in files the bench user reads",[288,697,698],{},"They belong in the list of secrets the scrubber never ships and file integrity watches",[288,700,701,322,703,322,706],{},[292,702,583],{},[292,704,705],{},"bench.toml",[292,707,298],{},[273,709,710,713,724],{},[288,711,712],{},"A new SSH key leaves no file change",[288,714,715,716,719,720,723],{},"On these servers the keys come from the metadata at each login. Watching ",[292,717,718],{},"authorized_keys"," sees only keys added in Pilot's Admin; ",[292,721,722],{},"auth.log"," stays the signal",[288,725,726],{},[292,727,722],{},[273,729,730,733,740],{},[288,731,732],{},"Admin sessions and logins",[288,734,735,736,739],{},"Pilot keeps them, with the address, in ",[292,737,738],{},"logs\u002Faudit_\u003Cyear>_\u003Cweek>.jsonl",". Admin access is shell access as the bench user",[288,741,742],{},"A new reader in the agent",[273,744,745,748,756],{},[288,746,747],{},"The Administrator password of a fresh server",[288,749,750,751,755],{},"Probably shared by every server of one image until changed (to check). The preset ",[752,753,754],"em",{},"Admin login from new IP"," matters most in a server's first hour",[288,757,758],{},"Existing rule",[273,760,761,764,767],{},[288,762,763],{},"Pilot's self-update",[288,765,766],{},"It replaces Pilot's tree from a GitHub release with no signature. A change of Pilot's files outside 00:00 UTC is worth a line",[288,768,769],{},"File integrity",[521,771,773],{"id":772},"_4-receive-pilots-events-without-frappe-cloud","4. Receive Pilot's events without Frappe Cloud",[218,775,776,777,322,780,322,783,322,786,789,790,793,794,797,798,801],{},"Pilot posts every bench event (",[292,778,779],{},"site_down",[292,781,782],{},"task_failed",[292,784,785],{},"backups_failing",[292,787,788],{},"resource_limit_breached","…) to each ",[292,791,792],{},"[[webhook_endpoints]]"," entry, signed with HMAC-SHA256 (",[292,795,796],{},"X-Pilot-Signature-256","). It works on a self-hosted Pilot too. A Wolf endpoint that accepts them would give deployments and backup failures without the root helper ",[292,799,800],{},"wolf-pilot-export"," reading task folders. It is the cheapest new bridge, and it needs nothing from Frappe.",[521,803,805],{"id":804},"_5-register-a-site-without-a-shared-secret","5. Register a site without a shared secret",[218,807,808],{},"The team identity token makes the spike of #134 concrete:",[810,811,812,818,829],"ol",{},[608,813,814,815,817],{},"The Wolf App on a customer's site calls its own Pilot with ",[292,816,381],{},", asking for a token whose audience is the hosted Wolf site's address.",[608,819,820,821,824,825,828],{},"Central returns a 5-minute token signed with its Pilot key: ",[292,822,823],{},"sub"," is the team, ",[292,826,827],{},"hosts"," the server's site addresses.",[608,830,831,832,835,836,839,840,322,843,846,847,639],{},"The hosted Wolf site checks it against ",[292,833,834],{},"central.api.jwks.get_jwks",": signature, ",[292,837,838],{},"aud"," equal to its own address, ",[292,841,842],{},"scope=team-identity",[292,844,845],{},"exp",", and that the caller's host is in ",[292,848,827],{},[218,850,851,852,854],{},"That proves \"this site belongs to team T on Frappe Cloud\" without any secret typed by a person. It needs the site's ",[292,853,381],{},", so it runs in the Wolf App, not in the agent.",[521,856,858],{"id":857},"_6-show-the-platforms-incidents-as-context","6. Show the platform's incidents as context",[218,860,861,864],{},[292,862,863],{},"GET \u002Fapi\u002Fmethod\u002Fbeacon.api.status.get_status"," on the status page's domain is open and cached 60 seconds. Polling it lets a Wolf incident say \"the platform reports an incident on this region since 01:52\". It opens no Wolf incident. It is the only Beacon signal a customer can read.",[521,866,868],{"id":867},"_7-a-beacon-channel","7. A Beacon channel",[218,870,871,872,874],{},"As planned in #135, for a Dokos that has a Beacon of its own, which is not the case today: Beacon needs a Datum, a ClickHouse and an Atlas per region. Keep it behind the two cautions above (never page below critical; never set ",[292,873,490],{},").",[521,876,878],{"id":877},"blocked-and-why","Blocked, and why",[267,880,881,891],{},[270,882,883],{},[273,884,885,888],{},[276,886,887],{},"Idea",[276,889,890],{},"Blocked by",[283,892,893,901,909,921,931],{},[273,894,895,898],{},[288,896,897],{},"Write Wolf's findings to Datum",[288,899,900],{},"Datum accepts three issuers, none of which a customer holds. The repository has no license",[273,902,903,906],{},[288,904,905],{},"Read Datum",[288,907,908],{},"ClickHouse passwords are staff's, and a reader sees the whole region",[273,910,911,914],{},[288,912,913],{},"Read a server's events (resize, restart, snapshot) from Central",[288,915,916,917,920],{},"No customer token and no outbound webhook. ",[292,918,919],{},"Activity Event"," is console only",[273,922,923,926],{},[288,924,925],{},"Report a Wolf alert to Central",[288,927,928,930],{},[292,929,334],{}," belongs to Pilot's credential and takes fixed event types. Using Pilot's token from Wolf would be impersonation",[273,932,933,936],{},[288,934,935],{},"Install the agent at server creation",[288,937,938,941,942,945],{},[292,939,940],{},"user_data"," is stored in clear on the ",[292,943,944],{},"Resource Action",": no registration token may go there unless it is short-lived and single-use",[218,947,948,949,954],{},"Asks to Frappe stay those of ",[222,950,953],{"href":951,"rel":952},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F114",[226],"#114"," and #134: a read-only team token or an outbound webhook of activity events; a way for an app to forward an alert.",[248,956,958],{"id":957},"what-a-customer-should-know-about-the-platform","What a customer should know about the platform",[218,960,961],{},"Read from code, not reported to Frappe, and not checked on a running region. They are properties of a young platform, useful when Dokos writes its own risk register for a tenant on Frappe Cloud v2.",[605,963,964,970,976,982,992,998,1004,1010,1016],{},[608,965,966,969],{},[308,967,968],{},"Site names and update output reach the platform's telemetry",", where Beacon's reader and Insights see the whole region.",[608,971,972,975],{},[308,973,974],{},"Staff can read a server's disk"," (snapshot, rescue mode) and its serial console. That is true of any host; here it is explicit in the code.",[608,977,978,981],{},[308,979,980],{},"The 7-day Datum token of a deleted server stays valid"," until it expires. It only writes.",[608,983,984,987,988,991],{},[308,985,986],{},"Pilot's self-update is not signed."," Whoever can publish a release of ",[292,989,990],{},"frappe\u002Fpilot"," runs code as the bench user on every server at 00:00 UTC.",[608,993,994,997],{},[308,995,996],{},"The marketplace merges a new app by itself"," when the automated check passes. Any bench can install anything in it.",[608,999,1000,1003],{},[308,1001,1002],{},"One key set serves two planes"," at Central, and Pilot does not check a token's issuer. Safety rests on audiences.",[608,1005,1006,1009],{},[308,1007,1008],{},"Beacon holds a System Manager key on every region's Atlas"," to read one list (inferred).",[608,1011,1012,1015],{},[308,1013,1014],{},"No key rotation"," is implemented for the signing keys, and several platform tokens last 365 days.",[608,1017,1018,1021],{},[308,1019,1020],{},"Cargo's SSH client does not verify host keys","; it relies on the private network.",[248,1023,1025],{"id":1024},"where-the-documents-lag-the-code","Where the documents lag the code",[267,1027,1028,1041],{},[270,1029,1030],{},[273,1031,1032,1035,1038],{},[276,1033,1034],{},"Document",[276,1036,1037],{},"Says",[276,1039,1040],{},"Code",[283,1042,1043,1065,1078,1111,1130,1144,1162,1173,1186,1197,1213],{},[273,1044,1045,1055,1058],{},[288,1046,1047,1048,1051,1052],{},"Central ",[292,1049,1050],{},"spec\u002FSSO.md",", comment in ",[292,1053,1054],{},"pilot_credential.py",[288,1056,1057],{},"A server enrols with a bootstrap token",[288,1059,1060,1061,1064],{},"The durable token is in the metadata; ",[292,1062,1063],{},"mint_bootstrap_token"," has no caller",[273,1066,1067,1072,1075],{},[288,1068,1047,1069],{},[292,1070,1071],{},"spec\u002FCONNECT.md",[288,1073,1074],{},"A partner API",[288,1076,1077],{},"Planned; no code",[273,1079,1080,1086,1100],{},[288,1081,1082,1083],{},"Cargo ",[292,1084,1085],{},"docs\u002Fcentral-contract.md",[288,1087,1088,1089,1092,1093,1096,1097],{},"Reports go to ",[292,1090,1091],{},"central.api.cargo_webhooks.*",", with status ",[292,1094,1095],{},"Active"," or ",[292,1098,1099],{},"Failed",[288,1101,1102,322,1105,1096,1108],{},[292,1103,1104],{},"central.api.state_delivery.receive",[292,1106,1107],{},"Available",[292,1109,1110],{},"Not Available",[273,1112,1113,1118,1123],{},[288,1114,1082,1115],{},[292,1116,1117],{},"docs\u002Fbootstrapping.md",[288,1119,1120],{},[292,1121,1122],{},"setup.sh",[288,1124,1125,1126,1129],{},"Not in the repository; Atlas' ",[292,1127,1128],{},"install-cargo.sh"," installs Cargo",[273,1131,1132,1138,1141],{},[288,1133,1134,1137],{},[292,1135,1136],{},"one-click-templates"," README",[288,1139,1140],{},"Cargo renders the user data",[288,1142,1143],{},"Central does",[273,1145,1146,1152,1155],{},[288,1147,1148,1149],{},"Pilot ",[292,1150,1151],{},"docs\u002Fproduction.md",[288,1153,1154],{},"Setup installs \"the log shipper\"",[288,1156,1157,1158,1161],{},"There is none; ",[292,1159,1160],{},"docs\u002Farchitecture.md"," says so",[273,1163,1164,1167,1170],{},[288,1165,1166],{},"Pilot README",[288,1168,1169],{},"Admin on port 8002",[288,1171,1172],{},"7000",[273,1174,1175,1180,1183],{},[288,1176,1177,1178],{},"Central, docstring of ",[292,1179,325],{},[288,1181,1182],{},"Pilot asks again on a 401",[288,1184,1185],{},"Pilot renews by expiry only",[273,1187,1188,1191,1194],{},[288,1189,1190],{},"Beacon README",[288,1192,1193],{},"A High incident stops after 3 rounds",[288,1195,1196],{},"No limit in code",[273,1198,1199,1205,1208],{},[288,1200,1201,1202],{},"Beacon ",[292,1203,1204],{},"docs\u002Fintegration.md",[288,1206,1207],{},"A site is never a label value",[288,1209,1210],{},[292,1211,1212],{},"pilot_site_backup_failed{site}",[273,1214,1215,1218,1221],{},[288,1216,1217],{},"Atlas README",[288,1219,1220],{},"Pre-production",[288,1222,1223,1224,1226],{},"Its ",[292,1225,451],{}," says production",[248,12