3.agent\u002F4.scrubbing","i-lucide-eraser",{"title":75,"path":76,"stem":77,"icon":78},"Watchdog","\u002Fagent\u002Fwatchdog","3.agent\u002F5.watchdog","i-lucide-heart-pulse",{"title":80,"path":81,"stem":82,"icon":83},"Response actions","\u002Fagent\u002Fresponse-actions","3.agent\u002F6.response-actions","i-lucide-shield-ban",{"title":85,"icon":86,"path":87,"stem":88,"children":89,"page":49},"Alerts and incidents","i-lucide-bell","\u002Falerts","4.alerts",[90,95,100,105],{"title":91,"path":92,"stem":93,"icon":94},"Alert rules","\u002Falerts\u002Frules","4.alerts\u002F1.rules","i-lucide-sliders-horizontal",{"title":96,"path":97,"stem":98,"icon":99},"Preset rules","\u002Falerts\u002Fpresets","4.alerts\u002F2.presets","i-lucide-list-todo",{"title":101,"path":102,"stem":103,"icon":104},"Channels","\u002Falerts\u002Fchannels","4.alerts\u002F3.channels","i-lucide-send",{"title":106,"path":107,"stem":108,"icon":109},"Incidents","\u002Falerts\u002Fincidents","4.alerts\u002F4.incidents","i-lucide-siren",{"title":111,"path":112,"stem":113,"children":114,"icon":117},"Security","\u002Fsecurity","5.security\u002F1.index",[115,118,123,128,133,138,143,147],{"title":116,"path":112,"stem":113,"icon":117},"Security overview","i-lucide-shield",{"title":119,"path":120,"stem":121,"icon":122},"Site signals","\u002Fsecurity\u002Fsite-signals","5.security\u002F2.site-signals","i-lucide-globe",{"title":124,"path":125,"stem":126,"icon":127},"Web and host detection","\u002Fsecurity\u002Fdetection","5.security\u002F3.detection","i-lucide-radar",{"title":129,"path":130,"stem":131,"icon":132},"Access and secrets","\u002Fsecurity\u002Faccess","5.security\u002F4.access","i-lucide-key-round",{"title":134,"path":135,"stem":136,"icon":137},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":139,"path":140,"stem":141,"icon":142},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":144,"path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"title":183,"path":184,"stem":185,"children":186,"icon":189},"Internals","\u002Finternals","7.internals\u002F1.index",[187,190,195,199,204,208],{"title":188,"path":184,"stem":185,"icon":189},"Frappe Cloud v2, read from its code","i-lucide-map",{"title":191,"path":192,"stem":193,"icon":194},"The applications","\u002Finternals\u002Fapps","7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Calls and trust","\u002Finternals\u002Finterop","7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flows","\u002Finternals\u002Fflows","7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Inside a customer server","\u002Finternals\u002Fcustomer-server","7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes for Wolf","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":200,"body":214,"description":767,"extension":768,"links":769,"meta":770,"navigation":771,"path":201,"seo":772,"stem":202,"__hash__":773},"docs_en\u002F7.internals\u002F4.flows.md",{"type":215,"value":216,"toc":755},"minimark",[217,225,230,362,373,377,449,453,528,532,577,580,584,639,643,697,701],[218,219,220,221,224],"p",{},"Each step names the application that acts. Tokens and headers are in ",[222,223,196],"a",{"href":197},".",[226,227,229],"h2",{"id":228},"a-server-is-created","A server is created",[231,232,233,253,281,299,311,330,340,353],"ol",{},[234,235,236,240,241,245,246,249,250,224],"li",{},[237,238,239],"strong",{},"Console → Central."," A team member calls ",[242,243,244],"code",{},"central.api.servers.create_server",". Central checks the ",[242,247,248],{},"server:create"," capability and the billing gate, and stores a ",[242,251,252],{},"Resource Action",[234,254,255,258,259,262,263,266,267,270,271,270,274,270,277,280],{},[237,256,257],{},"Central."," For an image tagged ",[242,260,261],{},"purpose=pilot",", Central creates the server's ",[242,264,265],{},"X-Pilot-Token"," and prepares the four metadata attributes (",[242,268,269],{},"pilot-central",", ",[242,272,273],{},"pilot-common-site-config",[242,275,276],{},"pilot-common-config",[242,278,279],{},"pilot-config",").",[234,282,283,286,287,290,291,294,295,298],{},[237,284,285],{},"Central → Atlas."," ",[242,288,289],{},"POST \u002Fapi\u002Fatlas\u002Fvirtual-machines"," with the image, the size, the SSH keys, the customer's ",[242,292,293],{},"user_data",", the firewall, the idle sleep, the metadata, and ",[242,296,297],{},"X-Tenant-ID",". A request that fails in transit is marked uncertain and is never sent again by itself.",[234,300,301,307,308,310],{},[237,302,303,304,224],{},"Atlas → ",[242,305,306],{},"metald"," Atlas picks a host. ",[242,309,306],{}," clones the image's disk (ZFS), builds the network namespace, registers the private address, starts a jailed Firecracker, and fills the metadata service.",[234,312,313,286,316,319,320,322,323,326,327,224],{},[237,314,315],{},"In the machine.",[242,317,318],{},"atlas-metadata.service"," sets the hostname, the private address and the routes. cloud-init runs the ",[242,321,293],{},". Pilot's ",[242,324,325],{},"\u003Cbench>-central-bootstrap.service"," polls the metadata every 0.1 second until the credential is there, applies the three settings once, stores Central's keys, and sets ",[242,328,329],{},"central.bootstrapped",[234,331,332,335,336,339],{},[237,333,334],{},"Atlas → Central."," The host is read every 10 seconds; a change of state is posted as ",[242,337,338],{},"vm.state",". Central also reconciles every 10 minutes, which repairs a missed report.",[234,341,342,345,346,349,350,280],{},[237,343,344],{},"Central → Pilot."," Central builds the name ",[242,347,348],{},"admin-vm-\u003Clabel>.\u003Cregion domain>"," from the machine's private address and asks Pilot to adopt it (",[242,351,352],{},"POST \u002Fapi\u002Fv1\u002Fsettings\u002Fadmin-domain",[234,354,355,286,358,361],{},[237,356,357],{},"Pilot → Central.",[242,359,360],{},"datum_token"," (refused until Central knows the machine's Atlas id), then telemetry starts.",[218,363,364,365,368,369,372],{},"A trial is the same flow with a warm image that already holds a site (",[242,366,367],{},"has_site=1",", resumed from a memory snapshot): Central waits for ",[242,370,371],{},"\u002Fapi\u002Fmethod\u002Fping"," on the site, signs in to it as Administrator, and queues its rename.",[226,374,376],{"id":375},"a-hostname-is-routed","A hostname is routed",[231,378,379,387,401,417,429,443],{},[234,380,381,286,384,224],{},[237,382,383],{},"The site or the Admin → Pilot.",[242,385,386],{},"POST \u002Fsites\u002F\u003Csite>\u002Fdomains",[234,388,389,392,393,396,397,400],{},[237,390,391],{},"Pilot → the domain program."," Pilot runs ",[242,394,395],{},"bench-domain-provider generate-dns-records",", then ",[242,398,399],{},"register \u003Cdomain>",". On Frappe Cloud v2 that program comes from Cargo's image.",[234,402,403,286,406,409,410,413,414,224],{},[237,404,405],{},"The program → Central.",[242,407,408],{},"central.api.pilot.domain_records",": the customer is told to set a CNAME to ",[242,411,412],{},"proxy.\u003Cregion domain>"," and a TXT record ",[242,415,416],{},"_frappe-verification.\u003Cdomain>",[234,418,419,286,421,424,425,428],{},[237,420,405],{},[242,422,423],{},"central.api.pilot.register_domain",". Central checks the TXT record, then reads ",[242,426,427],{},"http:\u002F\u002F\u003Cdomain>\u002F.well-known\u002Ffrappe-pre-authorize\u002F"," to see that the name really arrives at the region's proxy.",[234,430,431,434,435,438,439,442],{},[237,432,433],{},"Central → the proxy."," Central stores a ",[242,436,437],{},"Site Domain"," and sends ",[242,440,441],{},"PATCH \u002Fv1\u002Fdomains\u002F\u003Cdomain>",". Failed routes are retried every 5 minutes.",[234,444,445,448],{},[237,446,447],{},"Pilot."," It writes the nginx server block and, for a custom domain, obtains the certificate itself: the proxy passes that domain's TLS through to the server.",[226,450,452],{"id":451},"a-number-leaves-a-server","A number leaves a server",[231,454,455,468,477,493,506,515],{},[234,456,457,460,461,464,465,224],{},[237,458,459],{},"Cargo → Central."," When the region's Datum host is ready, Cargo's webhook reports ",[242,462,463],{},"telemetry: Available"," with the address ",[242,466,467],{},"http:\u002F\u002Finternal-telemetry-svc.\u003Cregion domain>",[234,469,470,473,474,476],{},[237,471,472],{},"Central → the machine."," That address is in the ",[242,475,276],{}," attribute of every new server.",[234,478,479,286,481,484,485,488,489,492],{},[237,480,357],{},[242,482,483],{},"central.api.pilot.datum_token"," returns a 7-day token whose ",[242,486,487],{},"resource_id"," is the machine's Atlas id. Pilot stores it in ",[242,490,491],{},"[telemetry] token"," and asks again when 24 hours or less remain.",[234,494,495,286,498,501,502,505],{},[237,496,497],{},"Pilot → Datum.",[242,499,500],{},"pilot-monitor.service"," sends ",[242,503,504],{},"pilot_sites"," every 60 seconds and the rest every 5 minutes, over the private network.",[234,507,508,511,512,514],{},[237,509,510],{},"Datum → ClickHouse."," Datum checks the token against the keys Cargo publishes, stamps ",[242,513,487],{}," on each row, and inserts.",[234,516,517,520,521,524,525,527],{},[237,518,519],{},"Beacon → ClickHouse."," Every minute Beacon runs the due rules of ",[242,522,523],{},"pilot\u002Fbeacon\u002Frules\u002F",". It drops every row whose ",[242,526,487],{}," is not a virtual machine in the tree Atlas gave it, or is younger than 10 minutes.",[226,529,531],{"id":530},"a-person-is-paged","A person is paged",[231,533,534,543,548,554,560,566,572],{},[234,535,536,539,540,224],{},[237,537,538],{},"Beacon."," A rule returns a row for a resource. The alert is Pending, then Firing after the rule's ",[242,541,542],{},"pending_for",[234,544,545,547],{},[237,546,538],{}," The alert joins an open incident that covers the resource or its parent, or one of the same rule, or a new Internal incident is created.",[234,549,550,553],{},[237,551,552],{},"Beacon → chat."," Every new incident is posted to the chat webhook.",[234,555,556,559],{},[237,557,558],{},"Beacon → responders."," For High or Critical: email to all responders, and escalation. It starts at once when the resource has no parent, after 90 seconds otherwise (so that a host's alert can absorb its machines').",[234,561,562,565],{},[237,563,564],{},"Beacon → Twilio."," The first responder is called. The next one after 2 minutes (Critical) or 5 (High). After the last one, a new round 15 minutes later, until someone acknowledges.",[234,567,568,571],{},[237,569,570],{},"Twilio → Beacon."," An answered call acknowledges the incident as that responder.",[234,573,574,576],{},[237,575,538],{}," When every alert has recovered, Beacon resolves the incident only if it is Internal and Beacon created it. Otherwise it asks a person to.",[218,578,579],{},"One failing site or one failing server is not a Beacon alert, by design. Pilot's rules need 3 sites and 20% of a server's sites down, or 5 servers and 10% of the region with failing backups. A single failure goes the other way:",[226,581,583],{"id":582},"a-customer-is-told","A customer is told",[231,585,586,594,603,633],{},[234,587,588,286,590,593],{},[237,589,447],{},[242,591,592],{},"pilot-monitor"," or a task raises an event: a site failed its pings for 1 minute; CPU, memory or disk stayed over the limit for 5 minutes; a backup, a migration or a certificate failed.",[234,595,596,598,599,602],{},[237,597,447],{}," The event goes to the Admin's feed, to each ",[242,600,601],{},"[[webhook_endpoints]]",", and to mail.",[234,604,605,286,607,610,611,270,614,270,617,270,620,270,623,270,626,270,629,632],{},[237,606,357],{},[242,608,609],{},"central.notification.api.report_pilot_event",", with one of the event types Central accepts from a Pilot (",[242,612,613],{},"site_unavailable",[242,615,616],{},"site_recovered",[242,618,619],{},"backup_failure",[242,621,622],{},"migration_failure",[242,624,625],{},"certificate_expiry",[242,627,628],{},"certificate_failed",[242,630,631],{},"resource_limit_breached","…).",[234,634,635,638],{},[237,636,637],{},"Central → the team."," A notification in the console and by email.",[226,640,642],{"id":641},"an-image-is-built","An image is built",[231,644,645,651,657,683,692],{},[234,646,647,650],{},[237,648,649],{},"Cargo → GitHub."," Every 2 hours Cargo pairs the newest Pilot release with the head of each Frappe branch it follows.",[234,652,653,656],{},[237,654,655],{},"Cargo → Atlas."," It rents a build machine on the base Ubuntu image.",[234,658,659,662,663,666,667,670,671,674,675,678,679,682],{},[237,660,661],{},"Cargo → the machine."," Over SSH, ",[242,664,665],{},"provision.sh",": user ",[242,668,669],{},"frappe",", Pilot, the bench ",[242,672,673],{},"default-bench",", Frappe at a fixed commit, ",[242,676,677],{},"site.local"," for Site and Apps images, production mode, ",[242,680,681],{},"pilot setup central",", the domain program. No secret is in that script's environment.",[234,684,685,687,688,691],{},[237,686,655],{}," Stop the machine, then ",[242,689,690],{},"POST …\u002Factions\u002Fsnapshot"," with the tags. Base and Apps images also keep a memory snapshot, so a server starts warm.",[234,693,694,696],{},[237,695,285],{}," Central lists images by tag when a server is created. Cargo keeps the 3 newest builds and deletes older images.",[226,698,700],{"id":699},"a-region-comes-up","A region comes up",[231,702,703,709,718,731,740,745],{},[234,704,705,708],{},[237,706,707],{},"Staff → Atlas."," Hosts are enrolled; the Atlas site runs in a machine on one of them.",[234,710,711,714,715,280],{},[237,712,713],{},"Atlas → Cargo's machine."," Atlas creates a platform machine, installs Pilot, a bench and the Cargo site over SSH, and hands it two 365-day tokens (Atlas' API as tenant 0; the proxy, for names ending in ",[242,716,717],{},"-svc",[234,719,720,286,723,726,727,730],{},[237,721,722],{},"Atlas → the proxy.",[242,724,725],{},"cargo.\u003Cregion domain>"," and ",[242,728,729],{},"cargo-pilot.\u003Cregion domain>"," are routed.",[234,732,733,286,736,739],{},[237,734,735],{},"Central → Cargo.",[242,737,738],{},"cargo.api.webhooks.configure"," gives Cargo the address and the secret for its reports.",[234,741,742,744],{},[237,743,655],{}," Cargo rents the machines of the Garage cluster and of the Datum host, and installs them over SSH.",[234,746,747,286,749,270,752,754],{},[237,748,459],{},[242,750,751],{},"storage: Available",[242,753,463],{},". Central marks the region's Cargo as registered at the first report.",{"title":756,"searchDepth":757,"depth":758,"links":759},"",1,2,[760,761,762,763,764,765,766],{"id":228,"depth":758,"text":229},{"id":375,"depth":758,"text":376},{"id":451,"depth":758,"text":452},{"id":530,"depth":758,"text":531},{"id":582,"depth":758,"text":583},{"id":641,"depth":758,"text":642},{"id":699,"depth":758,"text":700},"Seven things that happen on Frappe Cloud v2, hop by hop, with the application at each step.","md",null,{},{"icon":203},{"title":200,"description":767},"57bl4vr7sSb4LKRIge6ziGY1MsymHKlFMId_oPOwTMM",[775,777],{"title":196,"path":197,"stem":198,"description":776,"icon":132},"Every link between two Frappe Cloud v2 applications, with its header, its token and its lifetime.",{"title":205,"path":206,"stem":207,"description":778,"icon":38},"What Frappe Cloud v2 puts on a customer's server, what leaves it, and what the platform sees from outside.",1795109742500]