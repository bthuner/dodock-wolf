lucide-scale",{"title":144,"path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"title":183,"path":184,"stem":185,"children":186,"icon":189},"Internals","\u002Finternals","7.internals\u002F1.index",[187,190,195,199,204,208],{"title":188,"path":184,"stem":185,"icon":189},"Frappe Cloud v2, read from its code","i-lucide-map",{"title":191,"path":192,"stem":193,"icon":194},"The applications","\u002Finternals\u002Fapps","7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Calls and trust","\u002Finternals\u002Finterop","7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flows","\u002Finternals\u002Fflows","7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Inside a customer server","\u002Finternals\u002Fcustomer-server","7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes for Wolf","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":205,"body":214,"description":1127,"extension":1128,"links":1129,"meta":1130,"navigation":1131,"path":206,"seo":1132,"stem":207,"__hash__":1133},"docs_en\u002F7.internals\u002F5.customer-server.md",{"type":215,"value":216,"toc":1112},"minimark",[217,226,231,236,336,340,462,465,469,590,595,599,607,714,730,743,747,754,923,931,941,944,948,951,976,979,983],[218,219,220,221,225],"p",{},"A customer server is a Firecracker virtual machine that boots an image Cargo built, with root SSH for the customer. This page is what a tool running on that server should expect. None of it was checked on a running server yet: the list of what to verify is in ",[222,223,209],"a",{"href":224},"\u002Finternals\u002Fwolf#to-check-on-a-real-server",".",[227,228,230],"h2",{"id":229},"what-is-there","What is there",[232,233,235],"h3",{"id":234},"from-atlas-in-every-image","From Atlas, in every image",[237,238,239,252],"table",{},[240,241,242],"thead",{},[243,244,245,249],"tr",{},[246,247,248],"th",{},"What",[246,250,251],{},"Detail",[253,254,255,274,288,303,321],"tbody",{},[243,256,257,264],{},[258,259,260],"td",{},[261,262,263],"code",{},"atlas-guest-agent",[258,265,266,269,270,273],{},[261,267,268],{},"\u002Fusr\u002Flocal\u002Flib\u002Fatlas\u002Fatlas-guest-agent",". Four socket units, ",[261,271,272],{},"atlas-guest-agent-{usage,freeze,grow,reboot}.socket",", on vsock ports 100000 to 100003: the host asks for usage, freezes file systems before a snapshot, grows the disk, reboots. A firewall in the machine cannot block vsock",[243,275,276,281],{},[258,277,278],{},[261,279,280],{},"atlas-metadata.service",[258,282,283,284,287],{},"Polls the metadata service (",[261,285,286],{},"169.254.169.254",") every 250 ms: hostname, private address, MTU, routes. Steps the clock forward after the machine was frozen",[243,289,290,293],{},[258,291,292],{},"SSH keys from metadata",[258,294,295,298,299,302],{},[261,296,297],{},"\u002Fetc\u002Fssh\u002Fsshd_config.d\u002F90-atlas-mmds.conf",": sshd runs ",[261,300,301],{},"atlas-guest-agent authorized-keys"," at each login. A key added in the console changes no file on the server",[243,304,305,308],{},[258,306,307],{},"cloud-init",[258,309,310,313,314,317,318],{},[261,311,312],{},"\u002Fetc\u002Fcloud\u002Fcloud.cfg.d\u002F99-atlas-datasource.cfg",", data source ",[261,315,316],{},"Atlas","; a serial console on ",[261,319,320],{},"ttyS0",[243,322,323,326],{},[258,324,325],{},"Network",[258,327,328,331,332,335],{},[261,329,330],{},"eth0",", a private IPv6 ",[261,333,334],{},"fdaa:\u003Cregion>:\u003Ctenant>::\u003Cmachine>",", MTU 1380, IPv4 to the internet through the host's NAT",[232,337,339],{"id":338},"from-cargos-pilot-image","From Cargo's Pilot image",[237,341,342,350],{},[240,343,344],{},[243,345,346,348],{},[246,347,248],{},[246,349,251],{},[253,351,352,363,374,392,411,426,434,444],{},[243,353,354,357],{},[258,355,356],{},"User",[258,358,359,362],{},[261,360,361],{},"frappe",", uid 1000. Every other regular user of the Ubuntu image is removed",[243,364,365,368],{},[258,366,367],{},"Pilot",[258,369,370,373],{},[261,371,372],{},"\u002Fhome\u002Ffrappe\u002Fpilot",", at a fixed release",[243,375,376,379],{},[258,377,378],{},"Bench",[258,380,381,384,385,388,389],{},[261,382,383],{},"\u002Fhome\u002Ffrappe\u002Fpilot\u002Fbenches\u002Fdefault-bench",", on MariaDB (",[261,386,387],{},"~\u002Fpilot\u002Fdatabases\u002Fmariadb\u002Frun\u002Fmysqld.sock","), ",[261,390,391],{},"restart_idle_seconds = 900",[243,393,394,397],{},[258,395,396],{},"Site",[258,398,399,402,403,406,407],{},[261,400,401],{},"site.local"," on Site and Apps images. It is reached through the alias ",[261,404,405],{},"*.\u003Cregion domain>",": ",[408,409,410],"strong",{},"the site's folder name is not its public name",[243,412,413,416],{},[258,414,415],{},"Admin",[258,417,418,419,422,423],{},"Domain ",[261,420,421],{},"admin.local",", reached as ",[261,424,425],{},"admin-vm-\u003Clabel>.\u003Cregion domain>",[243,427,428,431],{},[258,429,430],{},"nginx",[258,432,433],{},"Enabled, without TLS for the region's names",[243,435,436,439],{},[258,437,438],{},"The domain program",[258,440,441],{},[261,442,443],{},"\u002Fusr\u002Fbin\u002Fbench-domain-provider",[243,445,446,449],{},[258,447,448],{},"Units",[258,450,451,454,455,458,459],{},[261,452,453],{},"pilot-vm-memory.service"," (zswap, 1 GB of swap), ",[261,456,457],{},"pilot-prewarm.service",", ",[261,460,461],{},"pilot-grow-file-system@.service",[218,463,464],{},"An image holds no token, no telemetry setting, no SSH key and no trace of a team. Each build generates one random Admin password and one Administrator password inside the build machine. The build script does not rotate them, so they are probably the same on every server started from one image until something changes them (inferred, to check).",[232,466,468],{"id":467},"from-pilot-as-on-any-pilot-host","From Pilot, as on any Pilot host",[470,471,472,513,526,537,561,583],"ul",{},[473,474,475,476,479,480,406,482,458,485,488,489,458,492,495,496,458,499,502,503,458,506,458,509,512],"li",{},"systemd ",[408,477,478],{},"user"," units of ",[261,481,361],{},[261,483,484],{},"\u003Cbench>.target",[261,486,487],{},"\u003Cbench>-web"," (with its socket), ",[261,490,491],{},"\u003Cbench>-socketio",[261,493,494],{},"\u003Cbench>-worker_pool…",", the two Redis, ",[261,497,498],{},"\u003Cbench>-admin",[261,500,501],{},"\u003Cbench>-central-bootstrap","; and ",[261,504,505],{},"pilot-monitor.service",[261,507,508],{},"pilot-mariadb.service",[261,510,511],{},"pilot-certificates.timer",". The default is \"lite mode\": one process for web, realtime and jobs.",[473,514,515,458,518,521,522,525],{},[261,516,517],{},"\u002Fetc\u002Fnginx\u002Fconf.d\u002F00-pilot.conf",[261,519,520],{},"\u002Fetc\u002Flogrotate.d\u002Fpilot"," (500 MB, ",[261,523,524],{},"copytruncate","), sudo rules for nginx and certbot.",[473,527,528,529,532,533,536],{},"Logs in ",[261,530,531],{},"\u003Cbench>\u002Flogs\u002F",", and Frappe's own logs in ",[261,534,535],{},"\u003Cbench>\u002Flogs\u002Fworkload\u002F"," on a sandboxed bench. Units write to files there, not to the journal.",[473,538,539,542,543,546,547,550,551,458,554,557,558,225],{},[261,540,541],{},"\u003Cbench>\u002Flogs\u002Fnginx-access.log",", in Pilot's own format: ",[261,544,545],{},"$pilot_client_addr [$time_local] \"$request_method $uri\" $status \"$host\" $request_time",". Only ",[261,548,549],{},"location \u002F"," of the sites is logged: not ",[261,552,553],{},"\u002Fassets",[261,555,556],{},"\u002Ffiles"," or ",[261,559,560],{},"\u002Fsocket.io",[473,562,563,564,458,567,570,571,458,574,458,577,458,580,225],{},"Local signals: ",[261,565,566],{},"logs\u002Fuptime.json.log",[261,568,569],{},"logs\u002Faudit_\u003Cyear>_\u003Cweek>.jsonl"," (Admin sessions and logins, with the address), ",[261,572,573],{},"tasks\u002F\u003Cid>\u002F",[261,575,576],{},"~\u002Fpilot\u002Fsystem\u002Flogs\u002Fsystem-stats.log",[261,578,579],{},"updates_\u003Cyear>_\u003Cweek>.jsonl",[261,581,582],{},"central-requests_\u003Cyear>_\u003Cweek>.jsonl",[473,584,585,586,589],{},"No host firewall and no fail2ban. Pilot's ",[261,587,588],{},"[firewall]"," is an allow and deny list in nginx.",[218,591,592,593,225],{},"Wolf's Pilot support already reads this layout: see ",[222,594,45],{"href":46},[232,596,598],{"id":597},"from-central-at-first-boot","From Central, at first boot",[218,600,601,602,606],{},"Through the metadata attributes (",[222,603,605],{"href":604},"\u002Finternals\u002Finterop#secrets-on-the-way-to-a-machine","the table","):",[237,608,609,619],{},[240,610,611],{},[243,612,613,616],{},[246,614,615],{},"Marker",[246,617,618],{},"File",[253,620,621,639,652,665,682,695],{},[243,622,623,634],{},[258,624,625,458,628,458,631],{},[261,626,627],{},"[central] enabled = true",[261,629,630],{},"bootstrapped = true",[261,632,633],{},"[[central.hostname_aliases]]",[258,635,636],{},[261,637,638],{},"~\u002Fpilot\u002Fbenches\u002Fcommon_config.toml",[243,640,641,649],{},[258,642,643,458,646],{},[261,644,645],{},"[telemetry] endpoint",[261,647,648],{},"token",[258,650,651],{},"Same file. The token is a 7-day Datum write token, in clear",[243,653,654,662],{},[258,655,656,458,659],{},[261,657,658],{},"[admin] jwks_url",[261,660,661],{},"jwks_audience",[258,663,664],{},"Same file",[243,666,667,677],{},[258,668,669,672,673,676],{},[261,670,671],{},"fc_team"," (the team's id), SMTP settings of a pooled mailbox, ",[261,674,675],{},"ai_keys"," on a trial",[258,678,679],{},[261,680,681],{},"sites\u002Fcommon_site_config.json",[243,683,684,690],{},[258,685,686,689],{},[261,687,688],{},"[s3]"," keys of the backup bucket, when the plan includes storage",[258,691,692],{},[261,693,694],{},"bench.toml",[243,696,697,708],{},[258,698,699,458,702,458,705],{},[261,700,701],{},"pilot_endpoint",[261,703,704],{},"pilot_auth_token",[261,706,707],{},"cloud_server_url",[258,709,710,711],{},"Each ",[261,712,713],{},"site_config.json",[218,715,716,718,719,722,723,726,727,729],{},[261,717,701],{}," is ",[408,720,721],{},"not"," a sign of Frappe Cloud v2: a self-hosted Pilot in production writes it too. ",[261,724,725],{},"[central] enabled"," and ",[261,728,671],{}," are.",[731,732,733],"caution",{},[218,734,735,738,739,742],{},[261,736,737],{},"http:\u002F\u002F169.254.169.254\u002Flatest\u002Fmeta-data\u002Fattributes\u002Fpilot-central"," returns the server's ",[261,740,741],{},"X-Pilot-Token"," to any process outside the bench's sandbox. With it a process can ask Central for the team's billing methods, a Datum token, or a GitHub repository token. A tool on the server must never read it. A process that does is a signal worth an alert.",[227,744,746],{"id":745},"what-leaves-the-server","What leaves the server",[218,748,749,750,753],{},"Everything Pilot sends to Datum, from ",[261,751,752],{},"pilot\u002Fcore\u002Fserver\u002Fmonitoring_datum.py",":",[237,755,756,769],{},[240,757,758],{},[243,759,760,763,766],{},[246,761,762],{},"Signal",[246,764,765],{},"Every",[246,767,768],{},"Labels",[253,770,771,798,814,826,849,866,880,897],{},[243,772,773,778,781],{},[258,774,775],{},[261,776,777],{},"pilot_sites",[258,779,780],{},"60 s",[258,782,783,406,786,458,789,458,792,458,795],{},[261,784,785],{},"state",[261,787,788],{},"up",[261,790,791],{},"down",[261,793,794],{},"app_error",[261,796,797],{},"maintenance",[243,799,800,806,809],{},[258,801,802,805],{},[261,803,804],{},"pilot_info"," (the heartbeat)",[258,807,808],{},"5 min",[258,810,811],{},[261,812,813],{},"version",[243,815,816,821,823],{},[258,817,818],{},[261,819,820],{},"pilot_database_up",[258,822,808],{},[258,824,825],{},"—",[243,827,828,836,838],{},[258,829,830,458,833],{},[261,831,832],{},"system_filesystem_size_bytes",[261,834,835],{},"system_filesystem_available_bytes",[258,837,808],{},[258,839,840,458,843,458,846],{},[261,841,842],{},"mountpoint",[261,844,845],{},"device",[261,847,848],{},"type",[243,850,851,856,858],{},[258,852,853],{},[261,854,855],{},"pilot_central_requests_last_5_minutes",[258,857,808],{},[258,859,860,458,863],{},[261,861,862],{},"method",[261,864,865],{},"result",[243,867,868,873,875],{},[258,869,870],{},[261,871,872],{},"pilot_site_backups",[258,874,808],{},[258,876,877],{},[261,878,879],{},"status",[243,881,882,887,889],{},[258,883,884],{},[261,885,886],{},"pilot_site_backup_failed",[258,888,808],{},[258,890,891],{},[408,892,893,896],{},[261,894,895],{},"site",": the site's name",[243,898,899,902,904],{},[258,900,901],{},"Update events, as log lines",[258,903,808],{},[258,905,906,458,909,912,913,458,915,458,918,922],{},[261,907,908],{},"app",[261,910,911],{},"repository",", versions, ",[261,914,879],{},[261,916,917],{},"phase",[408,919,920],{},[261,921,895],{},", and up to the last 8,192 characters of a failed task's output",[218,924,925,926,930],{},"And to Central: the event types of ",[222,927,929],{"href":928},"\u002Finternals\u002Fflows#a-customer-is-told","A customer is told",", with a message.",[218,932,933,936,937,940],{},[408,934,935],{},"What stays on the server",": CPU, memory, load, network and MariaDB metrics (Pilot collects them every 10 seconds, into local files only); the journal; nginx's access and error logs; every bench log; scheduler and worker failures; ",[261,938,939],{},"auth.log","; Frappe's Error Log, Activity Log and Access Log.",[218,942,943],{},"Beacon's telemetry contract says \"A tenant VM sends no machine metrics\" and \"a site is never a label value\". The first holds. The second does not: a failed backup sends the site's name, and a failed update sends the site and its output.",[227,945,947],{"id":946},"what-the-platform-sees-from-outside","What the platform sees from outside",[218,949,950],{},"Without anything in the machine's bench, through the host and the guest agent:",[470,952,953,956,967,970,973],{},[473,954,955],{},"CPU time, memory (from the balloon device), disk size, use and I\u002FO, network bytes and packets at the machine's interface, with counters of sent ICMP, UDP, TCP SYN and TCP RST;",[473,957,958,959,962,963,966],{},"load average, ",[261,960,961],{},"\u002Fproc\u002Fmeminfo",", use of the root file system, and ",[261,964,965],{},"systemctl is-system-running",", from the guest agent;",[473,968,969],{},"whether the machine answers a ping, every minute;",[473,971,972],{},"the serial console's output (128 KiB kept, even with nobody watching);",[473,974,975],{},"at the proxy: request counts and times for the region's names, in aggregate.",[218,977,978],{},"Staff with access to a host can snapshot the disk or mount it in rescue mode. The platform does not see inside TLS for a custom domain, and reads no log or process list of the machine.",[227,980,982],{"id":981},"how-a-server-behaves","How a server behaves",[237,984,985,995],{},[240,986,987],{},[243,988,989,992],{},[246,990,991],{},"Behaviour",[246,993,994],{},"Consequence for a tool on the server",[253,996,997,1011,1022,1033,1044,1055,1066,1083,1094],{},[243,998,999,1008],{},[258,1000,1001,1004,1005],{},[408,1002,1003],{},"Sleep."," A trial server (and a staging team's) is frozen when no request arrives for a while, and wakes on traffic. Outbound connections do not keep it awake. Paid servers are created with ",[261,1006,1007],{},"sleep_after_idle_seconds: 0",[258,1009,1010],{},"A timer stops and resumes with a jump of the clock. Silence is not an outage",[243,1012,1013,1019],{},[258,1014,1015,1018],{},[408,1016,1017],{},"Trial lock."," While a free trial is open: no SSH, no web console, no Pilot Admin",[258,1020,1021],{},"Nothing can be installed",[243,1023,1024,1030],{},[258,1025,1026,1029],{},[408,1027,1028],{},"Warm start."," Base and Apps images resume from a memory snapshot",[258,1031,1032],{},"Boot id, machine id and process start times may be shared between servers of one image (inferred). The journal starts nearly empty",[243,1034,1035,1041],{},[258,1036,1037,1040],{},[408,1038,1039],{},"Snapshot."," File systems are frozen for up to 30 seconds",[258,1042,1043],{},"A log reader sees a pause in writes",[243,1045,1046,1052],{},[258,1047,1048,1051],{},[408,1049,1050],{},"Idle restart."," In lite mode the bench process restarts after 900 seconds without work",[258,1053,1054],{},"It is not a crash",[243,1056,1057,1063],{},[258,1058,1059,1062],{},[408,1060,1061],{},"Firewall."," Off by default, which allows everything in both directions. Once on, a direction without a rule blocks new connections",[258,1064,1065],{},"An agent's outbound HTTPS needs a rule then",[243,1067,1068,1080],{},[258,1069,1070,1073,1074,1077,1078],{},[408,1071,1072],{},"Console logins."," The web console signs in as root from a host-side address (",[261,1075,1076],{},"172.16.0.x",") with a temporary key, or on ",[261,1079,320],{},[258,1081,1082],{},"An unusual root login that the customer started",[243,1084,1085,1091],{},[258,1086,1087,1090],{},[408,1088,1089],{},"Self-update."," Pilot updates itself at 00:00 UTC and restarts each Admin",[258,1092,1093],{},"Paths can move between releases",[243,1095,1096,1106],{},[258,1097,1098,1101,1102,1105],{},[408,1099,1100],{},"Addresses in logs."," For the region's names, nginx sees the proxy's private address; the client is in ",[261,1103,1104],{},"X-Forwarded-For",". For a custom domain it comes in the PROXY protocol header",[258,1107,1108,1109],{},"Trust those only from the proxy's network, ",[261,1110,1111],{},"fdaa:\u003Cregion>::\u002F64",{"title":1113,"searchDepth":1114,"depth":1115,"links":1116},"",1,2,[1117,1124,1125,1126],{"id":229,"depth":1115,"text":230,"children":1118},[1119,1121,1122,1123],{"id":234,"depth":1120,"text":235},3,{"id":338,"depth":1120,"text":339},{"id":467,"depth":1120,"text":468},{"id":597,"depth":1120,"text":598},{"id":745,"depth":1115,"text":746},{"id":946,"depth":1115,"text":947},{"id":981,"depth":1115,"text":982},"What Frappe Cloud v2 puts on a customer's server, what leaves it, and what the platform sees from outside.","md",null,{},{"icon":38},{"title":205,"description":1127},"VUEwQqvCqPM3va41vTti__0EuXFyT1ECtvFANMLwxrw",[1135,1137],{"title":200,"path":201,"stem":202,"description":1136,"icon":203},"Seven things that happen on Frappe Cloud v2, hop by hop, with the application at each step.",{"title":209,"path":210,"stem":211,"description":1138,"icon":117},"What the reading of Frappe Cloud v2 changes for Dodock Wolf, what to build next to it, and what is still to check on a real server.",1795107946376]