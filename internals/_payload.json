,[318,537,538],{},"Incidents, service levels, paging, status page",[318,540,407],{},[318,542,468],{},[318,544,413],{},[221,546,547,548,553,554,557,558,553,563,566,567,553,572,575,576,553,581,584,585,553,590,593,594,553,599,602],{},"Helpers, read for their links to the six: ",[235,549,552],{"href":550,"rel":551},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fcloudtoolkit",[246],"cloudtoolkit"," ",[225,555,556],{},"d51be63"," (durable pipelines and SSH; only Cargo requires it), ",[235,559,562],{"href":560,"rel":561},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fmarketplace",[246],"marketplace",[225,564,565],{},"824b64a"," (the app registry Pilot reads), ",[235,568,571],{"href":569,"rel":570},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fone-click-templates",[246],"one-click-templates",[225,573,574],{},"b342c95"," (Redis, MariaDB, Prometheus and Grafana as ready servers), ",[235,577,580],{"href":578,"rel":579},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fgrove",[246],"grove",[225,582,583],{},"e1dcd85"," and ",[235,586,589],{"href":587,"rel":588},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fpathway",[246],"pathway",[225,591,592],{},"3f91aca"," (AI inference), ",[235,595,598],{"href":596,"rel":597},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fsuite_cloud",[246],"suite_cloud",[225,600,601],{},"9e118db"," (mail servers of Frappe Suite).",[221,604,605],{},"All of it is young: the oldest of the six repositories was created on 21 May 2026, Beacon on 14 November 2026. None has a stable release. Names, routes and files in this section will move.",[255,607,609],{"id":608},"who-owns-what","Who owns what",[291,611,612,625],{},[294,613,614],{},[297,615,616,619,622],{},[300,617,618],{},"Question",[300,620,621],{},"Owner",[300,623,624],{},"Not",[313,626,627,642,656,671,686,696,706,716],{},[297,628,629,632,639],{},[318,630,631],{},"Who is this team, and may this person do that?",[318,633,634,635,638],{},"Central (",[225,636,637],{},"Team",", 18 capabilities)",[318,640,641],{},"The regions see only a tenant number",[297,643,644,647,654],{},[318,645,646],{},"Does this server exist, and is it running?",[318,648,649,650,653],{},"Atlas (",[225,651,652],{},"Virtual Machine","), mirrored in Central",[318,655,284],{},[297,657,658,661,668],{},[318,659,660],{},"Which sites and apps does this server have?",[318,662,663,664,667],{},"Pilot (",[225,665,666],{},"bench.toml",", files)",[318,669,670],{},"Central has no Bench DocType and no deployment record",[297,672,673,676,683],{},[318,674,675],{},"Where does this hostname go?",[318,677,678,679,682],{},"Central decides (",[225,680,681],{},"Site Domain","), the region's proxy applies",[318,684,685],{},"Atlas' site is not on the path",[297,687,688,691,694],{},[318,689,690],{},"Who holds this site's certificate?",[318,692,693],{},"The proxy for the region's wildcard names; the server for a custom domain",[318,695,264],{},[297,697,698,701,704],{},[318,699,700],{},"What did this server measure?",[318,702,703],{},"Datum's ClickHouse, per region",[318,705,264],{},[297,707,708,711,713],{},[318,709,710],{},"Is something wrong with the platform?",[318,712,280],{},[318,714,715],{},"A single failing site or server: Pilot tells its owner through Central",[297,717,718,721,724],{},[318,719,720],{},"What happened inside the bench?",[318,722,723],{},"Nobody outside the server",[318,725,726,727],{},"See ",[235,728,205],{"href":206},[255,730,732],{"id":731},"pages","Pages",[734,735,736,742,747,752,757],"card-group",{},[737,738,739],"card",{"icon":194,"title":191,"to":192},[221,740,741],{},"Each of the six: what it stores, what it accepts, what it calls.",[737,743,744],{"icon":132,"title":196,"to":197},[221,745,746],{},"Every link between two applications, its header, its token and its lifetime.",[737,748,749],{"icon":203,"title":200,"to":201},[221,750,751],{},"A server is created, a hostname is routed, a number is measured, a person is paged.",[737,753,754],{"icon":38,"title":205,"to":206},[221,755,756],{},"What the platform puts there, what leaves, what the platform sees from outside.",[737,758,759],{"icon":117,"title":209,"to":210},[221,760,761],{},"What this changes in #133, #134 and #135, and what is still to check on a real server.",{"title":763,"searchDepth":764,"depth":765,"links":766},"",1,2,[767,768,769,770,771],{"id":257,"depth":765,"text":258},{"id":288,"depth":765,"text":289},{"id":360,"depth":765,"text":361},{"id":608,"depth":765,"text":609},{"id":731,"depth":765,"text":732},"What Frappe Cloud v2 is made of, which app owns what, and where the rest of this analysis is.","md",null,{},{"icon":189},{"title":188,"description":772},"5j6l8q-4yd9ittlPhlwObGOEo0CBENnvsdgglV4TjKo",[774,780],{"title":191,"path":192,"stem":193,"description":781,"icon":194,"children":-1},"Each Frappe Cloud v2 application, what it stores, what it accepts and what it calls.",1795107937135]