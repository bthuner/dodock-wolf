{
  "name": "dodock-wolf-docs",
  "private": true,
  "type": "module",
  "description": "Dodock Wolf documentation site (Nuxt UI + Nuxt Content, same stack as doc.dokos.io)",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "check:links": "node scripts/check-links.mjs",
    "presets": "cd .. && python3 -I docs-site/scripts/presets-table.py"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@iconify-json/simple-icons": "^1.2.102",
    "@iconify-json/vscode-icons": "^1.2.99",
    "@nuxt/content": "^3.16.2",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.2.1",
    "@vueuse/core": "^14.4.0",
    "mermaid": "^11.12.1",
    "nuxt": "^4.6.4",
    "nuxt-llms": "0.3.2",
    "tailwindcss": "^4.3.5",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20.19.0"
  }
