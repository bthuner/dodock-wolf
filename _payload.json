9},[220],"text-primary","incident timeline",", not a customer email.",[204,224,225],{"v-slot:description":206},[213,226,227],{},"Dodock Wolf catches 502 windows, failed nightly crons, worker crashes and suspicious logins on Frappe, ERPNext and Dokos benches. All data stays on your own Frappe site.",[204,229,230,238],{"v-slot:links":206},[231,232,235],"u-button",{"size":233,"to":6,"trailing-icon":234},"xl","i-lucide-arrow-right",[213,236,237],{},"Get started",[231,239,242],{"size":233,"to":14,"color":240,"icon":16,"variant":241},"neutral","outline",[213,243,244],{},"Install in an afternoon",[246,247,250],"prose-pre",{"code":248,"filename":249},"# On the bench: the Wolf App\nbench get-app https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\nbench --site wolf.example.com install-app dodock_wolf\n\n# On each host: the Wolf Agent\ncurl -fsSL https:\u002F\u002Fraw.githubusercontent.com\u002Fbthuner\u002Fdodock-wolf\u002Fmain\u002Fagent\u002Finstall.sh \\\n  | sudo WOLF_URL=https:\u002F\u002Fwolf.example.com WOLF_TOKEN=\u003Ctoken> bash\n","Terminal",[251,252,255],"pre",{"className":253,"code":248,"filename":249,"language":254,"meta":206,"style":206},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","bash",[256,257,258,266,280,297,304,310,326],"code",{"__ignoreMap":206},[217,259,262],{"class":260,"line":261},"line",1,[217,263,265],{"class":264},"sHwdD","# On the bench: the Wolf App\n",[217,267,269,273,277],{"class":260,"line":268},2,[217,270,272],{"class":271},"sBMFI","bench",[217,274,276],{"class":275},"sfazB"," get-app",[217,278,279],{"class":275}," https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\n",[217,281,283,285,288,291,294],{"class":260,"line":282},3,[217,284,272],{"class":271},[217,286,287],{"class":275}," --site",[217,289,290],{"class":275}," wolf.example.com",[217,292,293],{"class":275}," install-app",[217,295,296],{"class":275}," dodock_wolf\n",[217,298,300],{"class":260,"line":299},4,[217,301,303