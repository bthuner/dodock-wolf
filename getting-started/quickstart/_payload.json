 a Frappe 15 or Dokos (Dodock 5) bench, Node 20.19 or later for ",[209,210,211],"code",{},"bench build",", root on\nthe host, and a site that will hold Wolf's data (it can be an existing site).",[214,215,217,222,287,303,307,310,338,348,352,359,413,436,440,477,491,495,513,519,523,530],"steps",{"level":216},"3",[218,219,221],"h3",{"id":220},"install-the-wolf-app","Install the Wolf App",[223,224,230],"pre",{"className":225,"code":226,"filename":227,"language":228,"meta":229,"style":229},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","cd ~\u002Ffrappe-bench\nbench get-app https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\nbench --site wolf.example.com install-app dodock_wolf\nbench build --app dodock_wolf\n","bench","bash","",[209,231,232,245,257,274],{"__ignoreMap":229},[233,234,237,241],"span",{"class":235,"line":236},"line",1,[233,238,240],{"class":239},"s2Zo4","cd",[233,242,244],{"class":243},"sfazB"," ~\u002Ffrappe-bench\n",[233,246,248,251,254],{"class":235,"line":247},2,[233,249,227],{"class":250},"sBMFI",[233,252,253],{"class":243}," get-app",[233,255,256],{"class":243}," https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\n",[233,258,260,262,265,268,271],{"class":235,"line":259},3,[233,261,227],{"class":250},[233,263,264],{"class":243}," --site",[233,266,267],{"class":243}," wolf.example.com",[233,269,270],{"class":243}," install-app",[233,272,273],{"class":243}," dodock_wolf\n",[233,275,277,279,282,285],{"class":235,"line":276},4,[233,278,227],{"class":250},[233,280,281],{"class":243}," build",[233,283,284],{"class":243}," --app",[233,286,273],{"class":243},[198,288,289,290,293,294,297,298,302],{},"Installing creates the roles ",[204,291,292],{},"Wolf Manager"," and ",[204,295,296],{},"Wolf User",", a registration token and the\n",[299,300,301],"a",{"href":102},"preset alert rules",".",[218,304,306],{"id":305},"run-the-scheduler-every-minute","Run the scheduler every minute",[198,308,309],{},"Wolf evaluates rules every minute, but Frappe 15 and Dodock tick every 4 minutes by default.",[223,311,313],{"className":225,"code":312,"filename":227,"language":228,"meta":229,"style":229},"bench set-config -g scheduler_tick_interval 60\n# then restart the bench's scheduler process (supervisor or systemd)\n",[209,314,315,332],{"__ignoreMap":229},[233,316,317,319,322,325,328],{"class":235,"line":236},[233,318,227],{"class":250},[233,320,321],{"class":243}," set-config",[233,323,324],{"class":243}," -g",[233,326,327],{"class":243}," scheduler_tick_interval",[233,329,331],{"class":330},"sbssI"," 60\n",[233,333,334],{"class":235,"line":247},[233,335,337],{"class":336},"sHwdD","# then restart the bench's scheduler process (supervisor or systemd)\n",[339,340,341],"warning",{},[198,342,343,344,347],{},"Without this, an alert can come up to 4 minutes late, and \"fire after 3 evaluations\" means\n12 minutes. The Wolf UI's ",[204,345,346],{},"Monitoring"," page shows the pace in use.",[218,349,351],{"id":350},"install-the-agent-on-the-host","Install the agent on the host",[198,353,354,355,358],{},"Open ",[204,356,357],{},"Wolf Settings → Agent install command"," and copy the one-liner. It looks like this:",[223,360,363],{"className":225,"code":361,"filename":362,"language":228,"meta":229,"style":229},"curl -fsSL https:\u002F\u002Fraw.githubusercontent.com\u002Fbthuner\u002Fdodock-wolf\u002Fmain\u002Fagent\u002Finstall.sh \\\n  | sudo WOLF_URL=https:\u002F\u002Fwolf.example.com WOLF_TOKEN=\u003Cregistration token> bash\n","host",[209,364,365,380],{"__ignoreMap":229},[233,366,367,370,373,376],{"class":235,"line":236},[233,368,369],{"class":250},"curl",[233,371,372],{"class":243}," -fsSL",[233,374,375],{"class":243}," https:\u002F\u002Fraw.githubusercontent.com\u002Fbthuner\u002Fdodock-wolf\u002Fmain\u002Fagent\u002Finstall.sh",[233,377,379],{"class":378},"sTEyZ"," \\\n",[233,381,382,386,389,392,395,398,401,404,407,410],{"class":235,"line":247},[233,383,385],{"class":384},"sMK4o","  |",[233,387,388],{"class":250}," sudo",[233,390,391],{"class":243}," WOLF_URL=https:\u002F\u002Fwolf.example.com",[233,393,394],{"class":243}," WOLF_TOKEN=",[233,396,397],{"class":384},"\u003C",[233,399,400],{"class":243},"registration",[233,402,403],{"class":243}," toke",[233,405,406],{"class":378},"n",[233,408,409],{"class":384},">",[233,411,412],{"class":243}," bash\n",[198,414,415,416,419,420,423,424,427,428,431,432,435],{},"The script installs the agent in ",[209,417,418],{},"\u002Fopt\u002Fwolf-agent"," (linked as ",[209,421,422],{},"\u002Fusr\u002Flocal\u002Fbin\u002Fwolf-agent","), creates a ",[209,425,426],{},"wolf-agent"," system user, registers the host, writes\n",[209,429,430],{},"\u002Fetc\u002Fwolf-agent\u002Fconfig.json"," and starts ",[209,433,434],{},"wolf-agent.service",". It finds your benches by itself.",[218,437,439],{"id":438},"check-what-the-agent-sees","Check what the agent sees",[223,441,443],{"className":225,"code":442,"filename":362,"language":228,"meta":229,"style":229},"sudo -u wolf-agent wolf-agent discover\nsudo -u wolf-agent wolf-agent check --status\n",[209,444,445,461],{"__ignoreMap":229},[233,446,447,450,453,456,458],{"class":235,"line":236},[233,448,449],{"class":250},"sudo",[233,451,452],{"class":243}," -u",[233,454,455],{"class":243}," wolf-agent",[233,457,455],{"class":243},[233,459,460],{"class":243}," discover\n",[233,462,463,465,467,469,471,474],{"class":235,"line":247},[233,464,449],{"class":250},[233,466,452],{"class":243},[233,468,455],{"class":243},[233,470,455],{"class":243},[233,472,473],{"class":243}," check",[233,475,476],{"class":243}," --status\n",[198,478,479,482,483,486,487,490],{},[209,480,481],{},"discover"," lists benches, sites and log paths. ",[209,484,485],{},"check"," collects once and prints the JSON it would\nsend, without sending it. ",[209,488,489],{},"--status"," also asks the site for its health.",[218,492,494],{"id":493},"add-a-channel-to-a-rule","Add a channel to a rule",[198,496,497,498,501,502,504,505,509,510,302],{},"Presets open incidents but notify nobody until you add a channel. Open ",[204,499,500],{},"Wolf Alert Rule → 502\nspike after deployment",", add a row to ",[204,503,106],{}," (type ",[506,507,508],"em",{},"Email",", your address), save, then\nclick ",[204,511,512],{},"Send test notification",[198,514,515,516,518],{},"See ",[299,517,106],{"href":107}," for Slack, Raven, PagerDuty and the other types.",[218,520,522],{"id":521},"open-the-wolf-ui","Open the Wolf UI",[198,524,525,526,529],{},"Go to ",[209,527,528],{},"https:\u002F\u002Fwolf.example.com\u002Fwolf",". The overview lists hosts, benches and sites with their\nlatest metrics and open incidents. Within a minute of the first push, the host shows up.",[198,531,532,533,536,537,540,541,544,545,548],{},"To look at one moment, select a range on the ",[204,534,535],{},"HTTP responses"," chart: drag across it, or click\nits first and last point (with the keyboard: arrow keys, then Enter twice). The chart, the\nfigures under ",[204,538,539],{},"In this window"," and the Events and Errors pages opened from them then cover\nthat range. The figures under ",[204,542,543],{},"Now",", the signals and the list of hosts always show the present.\n",[204,546,547],{},"Back to a relative window"," returns to the last 24 hours.",[550,551,553],"h2",{"id":552},"mark-your-deployments","Mark your deployments",[198,555,556,557,560],{},"Rules such as ",[506,558,559],{},"502 spike after deployment"," only fire when a deployment hit the same scope recently.\nBench migrations on the Wolf site, and Press and Pilot tasks, are recorded by themselves. For other\nbenches, add one line to your deploy script:",[223,562,565],{"className":225,"code":563,"filename":564,"language":228,"meta":229,"style":229},"sudo -u wolf-agent wolf-agent mark-deployment --bench frappe-bench --note \"v5.18.2\" --silence 15m\n","deploy.sh",[209,566,567],{"__ignoreMap":229},[233,568,569,571,573,575,577,580,583,586,589,592,595,598,601],{"class":235,"line":236},[233,570,449],{"class":250},[233,572,452],{"class":243},[233,574,455],{"class":243},[233,576,455],{"class":243},[233,578,579],{"class":243}," mark-deployment",[233,581,582],{"class":243}," --bench",[233,584,585],{"class":243}," frappe-bench",[233,587,588],{"class":243}," --note",[233,590,591],{"class":384}," \"",[233,593,594],{"class":243},"v5.18.2",[233,596,597],{"class":384},"\"",[233,599,600],{"class":243}," --silence",[233,602,603],{"class":243}," 15m\n",[198,605,606,607,609,610,613,614,617,618,622],{},"The config holding the agent's secret is readable by ",[209,608,426],{}," only, hence ",[209,611,612],{},"sudo -u",".\n",[209,615,616],{},"--silence 15m"," also opens a ",[299,619,621],{"href":620},"\u002Falerts\u002Frules#maintenance-windows","maintenance window",": incidents\nkeep opening during the deploy, but their notifications wait until it ends.",[550,624,626],{"id":625},"next","Next",[628,629,630,636,641],"ul",{},[631,632,633,634,302],"li",{},"Watch the other sites of the bench: ",[299,635,40],{"href":41},[631,637,638,639,302],{},"Tune what the agent collects: ",[299,640,65],{"href":66},[631,642,643,644,302],{},"Write your own rules: ",[299,645,96],{"href":97},[647,648,649],"style",{},"html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: va