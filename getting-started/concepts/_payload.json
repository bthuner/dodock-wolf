7},"Notes for Wolf","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":18,"body":214,"description":682,"extension":683,"links":684,"meta":685,"navigation":686,"path":19,"seo":687,"stem":20,"__hash__":688},"docs_en\u002F1.getting-started\u002F3.concepts.md",{"type":215,"value":216,"toc":674},"minimark",[217,222,226,296,304,308,349,395,399,552,556,559,622,626,644,648,670],[218,219,221],"h2",{"id":220},"scope-site-bench-host","Scope: site, bench, host",[223,224,225],"p",{},"Every record carries up to three names. Wolf always reads them in this order:",[227,228,229,245],"table",{},[230,231,232],"thead",{},[233,234,235,239,242],"tr",{},[236,237,238],"th",{},"Scope",[236,240,241],{},"Is",[236,243,244],{},"Example",[246,247,248,266,281],"tbody",{},[233,249,250,257,260],{},[251,252,253],"td",{},[254,255,256],"strong",{},"site",[251,258,259],{},"a Frappe site",[251,261,262],{},[263,264,265],"code",{},"erp.client.com",[233,267,268,273,276],{},[251,269,270],{},[254,271,272],{},"bench",[251,274,275],{},"the bench that serves it",[251,277,278],{},[263,279,280],{},"frappe-bench",[233,282,283,288,291],{},[251,284,285],{},[254,286,287],{},"host",[251,289,290],{},"the Linux machine the agent runs on",[251,292,293],{},[263,294,295],{},"bench-01",[223,297,298,299,303],{},"Host-wide records (SSH logins, listening services) have no site. Rules group by one of these, and\n",[300,301,302],"a",{"href":130},"user scopes"," restrict who sees which.",[218,305,307],{"id":306},"from-a-log-line-to-an-alert","From a log line to an alert",[309,310,315],"pre",{"className":311,"code":312,"language":313,"meta":314,"style":314},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","flowchart LR\n  L[Log line, \u002Fproc, Redis] -->|agent| E[Wolf Event \u002F Wolf Metric Sample]\n  S[Site hooks] --> E\n  E -->|rule, every minute| I[Wolf Incident]\n  I -->|open, reopen, resolve| C[Channels]\n","mermaid","",[263,316,317,325,331,337,343],{"__ignoreMap":314},[318,319,322],"span",{"class":320,"line":321},"line",1,[318,323,324],{},"flowchart LR\n",[318,326,328],{"class":320,"line":327},2,[318,329,330],{},"  L[Log line, \u002Fproc, Redis] -->|agent| E[Wolf Event \u002F Wolf Metric Sample]\n",[318,332,334],{"class":320,"line":333},3,[318,335,336],{},"  S[Site hooks] --> E\n",[318,338,340],{"class":320,"line":339},4,[318,341,342],{},"  E -->|rule, every minute| I[Wolf Incident]\n",[318,344,346],{"class":320,"line":345},5,[318,347,348],{},"  I -->|open, reopen, resolve| C[Channels]\n",[350,351,352,364,377,388],"ol",{},[353,354,355,356,359,360,363],"li",{},"The ",[254,357,358],{},"agent"," parses logs and reads system state. It sends events and metric samples every\n",[263,361,362],{},"push_interval"," (30 s).",[353,365,355,366,368,369,372,373,376],{},[254,367,256],{}," stores them. Events with the same fingerprint are counted on one row (",[254,370,371],{},"Count",",\n",[254,374,375],{},"Last Seen",") instead of piling up.",[353,378,379,380,383,384,387],{},"Every minute, each ",[254,381,382],{},"alert rule"," reads its window. When its condition holds, it opens an\n",[254,385,386],{},"incident"," per group, or feeds the incident already open.",[353,389,390,391,394],{},"The incident notifies its ",[254,392,393],{},"channels"," when it opens, reopens, escalates and resolves, never\non every event.",[218,396,398],{"id":397},"the-objects","The objects",[227,400,401,411],{},[230,402,403],{},[233,404,405,408],{},[236,406,407],{},"DocType",[236,409,410],{},"What it holds",[246,412,413,457,484,500,523,533,542],{},[233,414,415,420],{},[251,416,417],{},[254,418,419],{},"Wolf Event",[251,421,422,423,426,427,426,430,426,433,426,436,426,439,442,443,446,447,426,450,426,453,456],{},"Something that happened: ",[263,424,425],{},"error",", ",[263,428,429],{},"cron_failure",[263,431,432],{},"worker_failure",[263,434,435],{},"security",[263,437,438],{},"host_metric_alert",[263,440,441],{},"deployment",". Has a category (for example ",[263,444,445],{},"web_attack_probe","), a severity (",[263,448,449],{},"info",[263,451,452],{},"warning",[263,454,455],{},"critical","), a scope, a count and a JSON payload.",[233,458,459,464],{},[251,460,461],{},[254,462,463],{},"Wolf Metric Sample",[251,465,466,467,426,470,426,473,476,477,480,481,483],{},"One value of one metric (",[263,468,469],{},"queue_length",[263,471,472],{},"http_502",[263,474,475],{},"tls_days_left","…) for one scope at one time. Rolled up into ",[254,478,479],{},"Wolf Metric Rollup"," by minute and by hour. See ",[300,482,168],{"href":169},".",[233,485,486,491],{},[251,487,488],{},[254,489,490],{},"Wolf Alert Rule",[251,492,493,497,498,483],{},[494,495,496],"em",{},"When X > Y for Z minutes, send alert."," Signal, aggregation, window, group by, channels. See ",[300,499,91],{"href":92},[233,501,502,507],{},[251,503,504],{},[254,505,506],{},"Wolf Incident",[251,508,509,510,426,513,516,517,520,521,483],{},"Events that share a cause, for one group of one rule. Status ",[263,511,512],{},"Open",[263,514,515],{},"Acknowledged"," or ",[263,518,519],{},"Resolved",". Linked to the deployment that preceded it. See ",[300,522,106],{"href":107},[233,524,525,530],{},[251,526,527],{},[254,528,529],{},"Wolf Silence",[251,531,532],{},"A maintenance window: incidents still open, notifications wait.",[233,534,535,539],{},[251,536,537],{},[254,538,35],{},[251,540,541],{},"One registered host, satellite site or integration, with its last push and clock skew.",[233,543,544,549],{},[251,545,546],{},[254,547,548],{},"Wolf Settings",[251,550,551],{},"Retention, signals, agents, SIEM export, threat intelligence.",[218,553,555],{"id":554},"severity","Severity",[223,557,558],{},"Each severity has a colour and a shape, so it never depends on colour alone:",[227,560,561,573],{},[230,562,563],{},[233,564,565,567,570],{},[236,566,555],{},[236,568,569],{},"Glyph",[236,571,572],{},"Meaning",[246,574,575,587,599,611],{},[233,576,577,581,584],{},[251,578,579],{},[263,580,449],{},[251,582,583],{},"○",[251,585,586],{},"Worth knowing.",[233,588,589,593,596],{},[251,590,591],{},[263,592,452],{},[251,594,595],{},"◐",[251,597,598],{},"Look at it today.",[233,600,601,605,608],{},[251,602,603],{},[263,604,455],{},[251,606,607],{},"●",[251,609,610],{},"Someone wakes up.",[233,612,613,616,619],{},[251,614,615],{},"resolved",[251,617,618],{},"✓",[251,620,621],{},"Back to normal.",[218,623,625],{"id":624},"deployments","Deployments",[223,627,628,629,631,632,635,636,639,640,643],{},"A ",[263,630,441],{}," event marks the moment code changed: a ",[263,633,634],{},"bench migrate"," on the Wolf site, a\nPilot task, or ",[263,637,638],{},"wolf-agent mark-deployment",". Rules can require a recent deployment (the\n",[494,641,642],{},"502 spike after deployment"," preset), and incidents show the deployment that preceded them, so the\ntimeline reads \"502s started 4 minutes after the 01:47 deploy\".",[218,645,647],{"id":646},"where-to-look","Where to look",[649,650,651,661],"ul",{},[353,652,653,656,657,660],{},[254,654,655],{},"Wolf UI"," at ",[263,658,659],{},"\u002Fwolf",": the security overview (its home page), incidents, explorers,\nsecurity, operations, monitoring. For Wolf Users and Wolf Managers.",[353,662,663,666,667,483],{},[254,664,665],{},"Desk",": every DocType, configuration, reports such as ",[254,668,669],{},"Wolf Incident Metrics",[671,672,673],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":314,"searchDepth":321,"depth":327,"links":675},[676,677,678,679,680,681],{"id":220,"depth":327,"text":221},{"id":306,"depth":327,"text":307},{"id":397,"depth":327,"text":398},{"id":554,"depth":327,"text":555},{"id":624,"depth":327,"text":625},{"id":646,"depth":327,"text":647},"The few objects Dodock Wolf is made of, and how a log line becomes an alert.","md",null,{},{"icon":21},{"title":18,"description":682},"WHReUe-MwxF6E703LwlCliOArA6o_aGwpfwhwnVYqtg",[690,692],{"title":13,"path":14,"stem":15,"description":691,"icon":16},"Install the Wolf App, put an agent on the host and get a first alert, on one bench.",{"title":30,"path":31,"stem":32,"description":693,"icon":33},"Install the Frappe app that stores Wolf's data, evaluates rules and serves the Wolf UI.",1795111376565]