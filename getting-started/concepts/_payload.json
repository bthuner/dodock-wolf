],"thead",{},[213,214,215,219,222],"tr",{},[216,217,218],"th",{},"Scope",[216,220,221],{},"Is",[216,223,224],{},"Example",[226,227,228,246,261],"tbody",{},[213,229,230,237,240],{},[231,232,233],"td",{},[234,235,236],"strong",{},"site",[231,238,239],{},"a Frappe site",[231,241,242],{},[243,244,245],"code",{},"erp.client.com",[213,247,248,253,256],{},[231,249,250],{},[234,251,252],{},"bench",[231,254,255],{},"the bench that serves it",[231,257,258],{},[243,259,260],{},"frappe-bench",[213,262,263,268,271],{},[231,264,265],{},[234,266,267],{},"host",[231,269,270],{},"the Linux machine the agent runs on",[231,272,273],{},[243,274,275],{},"bench-01",[203,277,278,279,283],{},"Host-wide records (CPU, disk, SSH logins) have no site. Rules group by one of these, and\n",[280,281,282],"a",{"href":140},"user scopes"," restrict who sees which.",[198,285,287],{"id":286},"from-a-log-line-to-an-alert","From a log line to an alert",[289,290,295],"pre",{"className":291,"code":292,"language":293,"meta":294,"style":294},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","flowchart LR\n  L[Log line, \u002Fproc, Redis] -->|agent| E[Wolf Event \u002F Wolf Metric Sample]\n  S[Site hooks] --> E\n  E -->|rule, every minute| I[Wolf Incident]\n  I -->|open, reopen, resolve| C[Channels]\n","mermaid","",[243,296,297,305,311,317,323],{"__ignoreMap":294},[298,299,302],"span",{"class":300,"line":301},"line",1,[298,303,304],{},"flowchart LR\n",[298,306,308],{"class":300,"line":307},2,[298,309,310],{},"  L[Log line, \u002Fproc, Redis] -->|agent| E[Wolf Event \u002F Wolf Metric Sample]\n",[298,312,314],{"class":300,"line":313},3,[298,315,316],{},"  S[Site hooks] --> E\n",[298,318,320],{"class":300,"line":319},4,[298,321,322],{},"  E -->|rule, every minute| I[Wolf Incident]\n",[298,324,326],{"class":300,"line":325},5,[298,327,328],{},"  I -->|open, reopen, resolve| C[Channels]\n",[330,331,332,344,357,368],"ol",{},[333,334,335,336,339,340,343],"li",{},"The ",[234,337,338],{},"agent"," parses logs and reads system state. It sends events and metric samples every\n",[243,341,342],{},"push_interval"," (30 s).",[333,345,335,346,348,349,352,353,356],{},[234,347,236],{}," stores them. Events with the same fingerprint are counted on one row (",[234,350,351],{},"Count",",\n",[234,354,355],{},"Last Seen",") instead of piling up.",[333,358,359,360,363,364,367],{},"Every minute, each ",[234,361,362],{},"alert rule"," reads its window. When its condition holds, it opens an\n",[234,365,366],{},"incident"," per group, or feeds the incident already open.",[333,369,370,371,374],{},"The incident notifies its ",[234,372,373],{},"channels"," when it opens, reopens, escalates and resolves, never\non every event.",[198,376,378],{"id":377},"the-objects","The objects",[207,380,381,391],{},[210,382,383],{},[213,384,385,388],{},[216,386,387],{},"DocType",[216,389,390],{},"What it holds",[226,392,393,437,464,480,503,513,522],{},[213,394,395,400],{},[231,396,397],{},[234,398,399],{},"Wolf Event",[231,401,402,403,406,407,406,410,406,413,406,416,406,419,422,423,426,427,406,430,406,433,436],{},"Something that happened: ",[243,404,405],{},"error",", ",[243,408,409],{},"cron_failure",[243,411,412],{},"worker_failure",[243,414,415],{},"security",[243,417,418],{},"host_metric_alert",[243,420,421],{},"deployment",". Has a category (for example ",[243,424,425],{},"web_attack_probe","), a severity (",[243,428,429],{},"info",[243,431,432],{},"warning",[243,434,435],{},"critical","), a scope, a count and a JSON payload.",[213,438,439,444],{},[231,440,441],{},[234,442,443],{},"Wolf Metric Sample",[231,445,446,447,406,450,406,453,456,457,460,461,463],{},"One value of one metric (",[243,448,449],{},"cpu_usage",[243,451,452],{},"http_502",[243,454,455],{},"tls_days_left","…) for one scope at one time. Rolled up into ",[234,458,459],{},"Wolf Metric Rollup"," by minute and by hour. See ",[280,462,178],{"href":179},".",[213,465,466,471],{},[231,467,468],{},[234,469,470],{},"Wolf Alert Rule",[231,472,473,477,478,463],{},[474,475,476],"em",{},"When X > Y for Z minutes, send alert."," Signal, aggregation, window, group by, channels. See ",[280,479,96],{"href":97},[213,481,482,487],{},[231,483,484],{},[234,485,486],{},"Wolf Incident",[231,488,489,490,406,493,496,497,500,501,463],{},"Events that share a cause, for one group of one rule. Status ",[243,491,492],{},"Open",[243,494,495],{},"Acknowledged"," or ",[243,498,499],{},"Resolved",". Linked to the deployment that preceded it. See ",[280,502,111],{"href":112},[213,504,505,510],{},[231,506,507],{},[234,508,509],{},"Wolf Silence",[231,511,512],{},"A maintenance window: incidents still open, notifications wait.",[213,514,515,519],{},[231,516,517],{},[234,518,35],{},[231,520,521],{},"One registered host, satellite site or integration, with its last push and clock skew.",[213,523,524,529],{},[231,525,526],{},[234,527,528],{},"Wolf Settings",[231,530,531],{},"Retention, signals, agents, SIEM export, threat intelligence.",[198,533,535],{"id":534},"severity","Severity",[203,537,538],{},"Each severity has a colour and a shape, so it never depends on colour alone:",[207,540,541,553],{},[210,542,543],{},[213,544,545,547,550],{},[216,546,535],{},[216,548,549],{},"Glyph",[216,551,552],{},"Meaning",[226,554,555,567,579,591],{},[213,556,557,561,564],{},[231,558,559],{},[243,560,429],{},[231,562,563],{},"○",[231,565,566],{},"Worth knowing. Digest-friendly.",[213,568,569,573,576],{},[231,570,571],{},[243,572,432],{},[231,574,575],{},"◐",[231,577,578],{},"Look at it today.",[213,580,581,585,588],{},[231,582,583],{},[243,584,435],{},[231,586,587],{},"●",[231,589,590],{},"Someone wakes up. Never digested.",[213,592,593,596,599],{},[231,594,595],{},"resolved",[231,597,598],{},"✓",[231,600,601],{},"Back to normal.",[198,603,605],{"id":604},"deployments","Deployments",[203,607,608,609,611,612,615,616,619,620,623],{},"A ",[243,610,421],{}," event marks the moment code changed: a ",[243,613,614],{},"bench migrate"," on the Wolf site, a Press or\nPilot task, or ",[243,617,618],{},"wolf-agent mark-deployment",". Rules can require a recent deployment (the\n",[474,621,622],{},"502 spike after deployment"," preset), and incidents show the deployment that preceded them, so the\ntimeline reads \"502s started 4 minutes after the 01:47 deploy\".",[198,625,627],{"id":626},"where-to-look","Where to look",[629,630,631,641],"ul",{},[333,632,633,636,637,640],{},[234,634,635],{},"Wolf UI"," at ",[243,638,639],{},"\u002Fwolf",": overview, incidents, explorers, metrics, security, monitoring. For Wolf\nUsers and Wolf Managers.",[333,642,643,646,647,463],{},[234,644,645],{},"Desk",": every DocType, configuration, reports such as ",[234,648,649],{},"Wolf Incident Metrics",[651,652,653],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-