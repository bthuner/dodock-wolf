cale",{"title":144,"path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":183,"title":18,"body":184,"description":652,"extension":653,"links":654,"meta":655,"navigation":656,"path":19,"seo":657,"stem":20,"__hash__":658},"docs_en\u002F1.getting-started\u002F3.concepts.md",{"type":185,"value":186,"toc":644},"minimark",[187,192,196,266,274,278,319,365,369,522,526,529,592,596,614,618,640],[188,189,191],"h2",{"id":190},"scope-site-bench-host","Scope: site, bench, host",[193,194,195],"p",{},"Every record carries up to three names. Wolf always reads them in this order:",[197,198,199,215],"table",{},[200,201,202],"thead",{},[203,204,205,209,212],"tr",{},[206,207,208],"th",{},"Scope",[206,210,211],{},"Is",[206,213,214],{},"Example",[216,217,218,236,251],"tbody",{},[203,219,220,227,230],{},[221,222,223],"td",{},[224,225,226],"strong",{},"site",[221,228,229],{},"a Frappe site",[221,231,232],{},[233,234,235],"code",{},"erp.client.com",[203,237,238,243,246],{},[221,239,240],{},[224,241,242],{},"bench",[221,244,245],{},"the bench that serves it",[221,247,248],{},[233,249,250],{},"frappe-bench",[203,252,253,258,261],{},[221,254,255],{},[224,256,257],{},"host",[221,259,260],{},"the Linux machine the agent runs on",[221,262,263],{},[233,264,265],{},"bench-01",[193,267,268,269,273],{},"Host-wide records (CPU, disk, SSH logins) have no site. Rules group by one of these, and\n",[270,271,272],"a",{"href":130},"user scopes"," restrict who sees which.",[188,275,277],{"id":276},"from-a-log-line-to-an-alert","From a log line to an alert",[279,280,285],"pre",{"className":281,"code":282,"language":283,"meta":284,"style":284},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","flowchart LR\n  L[Log line, \u002Fproc, Redis] -->|agent| E[Wolf Event \u002F Wolf Metric Sample]\n  S[Site hooks] --> E\n  E -->|rule, every minute| I[Wolf Incident]\n  I -->|open, reopen, resolve| C[Channels]\n","mermaid","",[233,286,287,295,301,307,313],{"__ignoreMap":284},[288,289,292],"span",{"class":290,"line":291},"line",1,[288,293,294],{},"flowchart LR\n",[288,296,298],{"class":290,"line":297},2,[288,299,300],{},"  L[Log line, \u002Fproc, Redis] -->|agent| E[Wolf Event \u002F Wolf Metric Sample]\n",[288,302,304],{"class":290,"line":303},3,[288,305,306],{},"  S[Site hooks] --> E\n",[288,308,310],{"class":290,"line":309},4,[288,311,312],{},"  E -->|rule, every minute| I[Wolf Incident]\n",[288,314,316],{"class":290,"line":315},5,[288,317,318],{},"  I -->|open, reopen, resolve| C[Channels]\n",[320,321,322,334,347,358],"ol",{},[323,324,325,326,329,330,333],"li",{},"The ",[224,327,328],{},"agent"," parses logs and reads system state. It sends events and metric samples every\n",[233,331,332],{},"push_interval"," (30 s).",[323,335,325,336,338,339,342,343,346],{},[224,337,226],{}," stores them. Events with the same fingerprint are counted on one row (",[224,340,341],{},"Count",",\n",[224,344,345],{},"Last Seen",") instead of piling up.",[323,348,349,350,353,354,357],{},"Every minute, each ",[224,351,352],{},"alert rule"," reads its window. When its condition holds, it opens an\n",[224,355,356],{},"incident"," per group, or feeds the incident already open.",[323,359,360,361,364],{},"The incident notifies its ",[224,362,363],{},"channels"," when it opens, reopens, escalates and resolves, never\non every event.",[188,366,368],{"id":367},"the-objects","The objects",[197,370,371,381],{},[200,372,373],{},[203,374,375,378],{},[206,376,377],{},"DocType",[206,379,380],{},"What it holds",[216,382,383,427,454,470,493,503,512],{},[203,384,385,390],{},[221,386,387],{},[224,388,389],{},"Wolf Event",[221,391,392,393,396,397,396,400,396,403,396,406,396,409,412,413,416,417,396,420,396,423,426],{},"Something that happened: ",[233,394,395],{},"error",", ",[233,398,399],{},"cron_failure",[233,401,402],{},"worker_failure",[233,404,405],{},"security",[233,407,408],{},"host_metric_alert",[233,410,411],{},"deployment",". Has a category (for example ",[233,414,415],{},"web_attack_probe","), a severity (",[233,418,419],{},"info",[233,421,422],{},"warning",[233,424,425],{},"critical","), a scope, a count and a JSON payload.",[203,428,429,434],{},[221,430,431],{},[224,432,433],{},"Wolf Metric Sample",[221,435,436,437,396,440,396,443,446,447,450,451,453],{},"One value of one metric (",[233,438,439],{},"cpu_usage",[233,441,442],{},"http_502",[233,444,445],{},"tls_days_left","…) for one scope at one time. Rolled up into ",[224,448,449],{},"Wolf Metric Rollup"," by minute and by hour. See ",[270,452,168],{"href":169},".",[203,455,456,461],{},[221,457,458],{},[224,459,460],{},"Wolf Alert Rule",[221,462,463,467,468,453],{},[464,465,466],"em",{},"When X > Y for Z minutes, send alert."," Signal, aggregation, window, group by, channels. See ",[270,469,91],{"href":92},[203,471,472,477],{},[221,473,474],{},[224,475,476],{},"Wolf Incident",[221,478,479,480,396,483,486,487,490,491,453],{},"Events that share a cause, for one group of one rule. Status ",[233,481,482],{},"Open",[233,484,485],{},"Acknowledged"," or ",[233,488,489],{},"Resolved",". Linked to the deployment that preceded it. See ",[270,492,106],{"href":107},[203,494,495,500],{},[221,496,497],{},[224,498,499],{},"Wolf Silence",[221,501,502],{},"A maintenance window: incidents still open, notifications wait.",[203,504,505,509],{},[221,506,507],{},[224,508,35],{},[221,510,511],{},"One registered host, satellite site or integration, with its last push and clock skew.",[203,513,514,519],{},[221,515,516],{},[224,517,518],{},"Wolf Settings",[221,520,521],{},"Retention, signals, agents, SIEM export, threat intelligence.",[188,523,525],{"id":524},"severity","Severity",[193,527,528],{},"Each severity has a colour and a shape, so it never depends on colour alone:",[197,530,531,543],{},[200,532,533],{},[203,534,535,537,540],{},[206,536,525],{},[206,538,539],{},"Glyph",[206,541,542],{},"Meaning",[216,544,545,557,569,581],{},[203,546,547,551,554],{},[221,548,549],{},[233,550,419],{},[221,552,553],{},"○",[221,555,556],{},"Worth knowing.",[203,558,559,563,566],{},[221,560,561],{},[233,562,422],{},[221,564,565],{},"◐",[221,567,568],{},"Look at it today.",[203,570,571,575,578],{},[221,572,573],{},[233,574,425],{},[221,576,577],{},"●",[221,579,580],{},"Someone wakes up.",[203,582,583,586,589],{},[221,584,585],{},"resolved",[221,587,588],{},"✓",[221,590,591],{},"Back to normal.",[188,593,595],{"id":594},"deployments","Deployments",[193,597,598,599,601,602,605,606,609,610,613],{},"A ",[233,600,411],{}," event marks the moment code changed: a ",[233,603,604],{},"bench migrate"," on the Wolf site, a\nPilot task, or ",[233,607,608],{},"wolf-agent mark-deployment",". Rules can require a recent deployment (the\n",[464,611,612],{},"502 spike after deployment"," preset), and incidents show the deployment that preceded them, so the\ntimeline reads \"502s started 4 minutes after the 01:47 deploy\".",[188,615,617],{"id":616},"where-to-look","Where to look",[619,620,621,631],"ul",{},[323,622,623,626,627,630],{},[224,624,625],{},"Wolf UI"," at ",[233,628,629],{},"\u002Fwolf",": the security overview (its home page), incidents, explorers,\nsecurity, operations, monitoring. For Wolf Users and Wolf Managers.",[323,632,633,636,637,453],{},[224,634,635],{},"Desk",": every DocType, configuration, reports such as ",[224,638,639],{},"Wolf Incident Metrics",[641,642,643],"style",{},"html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":284,"searchDepth":291,"depth":297,"links":645},[646,647,648,649,650,651],{"id":190,"depth":297,"text":191},{"id":276,"depth":297,"text":277},{"id":3