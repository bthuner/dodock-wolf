212,213],"th",{},"What",[211,215,216],{},"Becomes",[218,219,220,236,260,279,292,332,342,352],"tbody",{},[208,221,222,231],{},[223,224,225,226,230],"td",{},"e-mail addresses, also URL-encoded (",[227,228,229],"code",{},"jane%40example.com",")",[223,232,233],{},[227,234,235],{},"[EMAIL]",[208,237,238,255],{},[223,239,240,243,244,247,248,243,251,254],{},[227,241,242],{},"Authorization:"," \u002F ",[227,245,246],{},"Proxy-Authorization:"," header values, ",[227,249,250],{},"Cookie:",[227,252,253],{},"Set-Cookie:"," values",[223,256,257],{},[227,258,259],{},"[REDACTED]",[208,261,262,275],{},[223,263,264,267,268,267,271,274],{},[227,265,266],{},"Bearer …",", ",[227,269,270],{},"token \u003Ckey>:\u003Csecret>",[227,272,273],{},"Basic …"," credentials",[223,276,277],{},[227,278,259],{},[208,280,281,287],{},[223,282,283,284,230],{},"JWTs (",[227,285,286],{},"eyJ….….…",[223,288,289],{},[227,290,291],{},"[JWT]",[208,293,294,328],{},[223,295,296,297,267,300,267,303,267,306,267,309,267,312,267,315,267,318,267,321,267,324,327],{},"values of ",[227,298,299],{},"password",[227,301,302],{},"pwd",[227,304,305],{},"new_password",[227,307,308],{},"*_secret",[227,310,311],{},"*_token",[227,313,314],{},"api_key",[227,316,317],{},"sid",[227,319,320],{},"session_id",[227,322,323],{},"otp",[227,325,326],{},"signature",", in query strings, forms, JSON or Python dict reprs",[223,329,330],{},[227,331,259],{},[208,333,334,337],{},[223,335,336],{},"card-like numbers (13–19 digits, Luhn-valid, issuer digit 2–6)",[223,338,339],{},[227,340,341],{},"[CARD]",[208,343,344,347],{},[223,345,346],{},"IBAN-like strings (mod-97 checked)",[223,348,349],{},[227,350,351],{},"[IBAN]",[208,353,354,360],{},[223,355,356,357],{},"IP addresses, only with ",[227,358,359],{},"\"ips\": true",[223,361,362,365],{},[227,363,364],{},"[IP:\u003C8 hex>]",", a keyed hash, stable per agent",[367,368,370],"h2",{"id":369},"ip-addresses","IP addresses",[198,372,373,374,377],{},"IPs are kept by default, because the SSH brute-force and \"admin login from a new IP\" rules are built\non them. Turn ",[227,375,376],{},"ips"," on if addresses count as personal data for you and you can live without per-IP\ngrouping in titles.",[367,379,381],{"id":380},"what-never-changes","What never changes",[198,383,384],{},"Type, host, bench, site, timestamp and fingerprint. Fingerprints are computed from the raw lines\nbefore scrubbing, so grouping and deduplication on the Wolf site work the same either way.",[198,386,387,388,391],{},"Metrics carry no free text and are not scrubbed. Text you type yourself\n(",[227,389,390],{},"mark-deployment --note",") is sent as is.",[367,393,395],{"id":394},"settings","Settings",[397,398,404],"pre",{"className":399,"code":400,"filename":401,"language":402,"meta":403,"style":403},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\"scrub\": {\n  \"enabled\": true,\n  \"ips\": false,\n  \"extra_patterns\": [\n    \"internal-\\\\d{4}\",\n    {\"pattern\": \"CUST-\\\\d{6}\", \"replacement\": \"[CUSTOMER]\"}\n  ],\n  \"keep\": [\"@dokos.io\", \"noreply@example.com\"]\n}\n","\u002Fetc\u002Fwolf-agent\u002Fconfig.json","json","",[227,405,406,428,446,460,475,495,546,552,586],{"__ignoreMap":403},[407,408,411,415,419,421,425],"span",{"class":409,"line":410},"line",1,[407,412,414],{"class":413},"sMK4o","\"",[407,416,418],{"class":417},"sfazB","scrub",[407,420,414],{"class":413},[407,422,424],{"class":423},"sTEyZ",": ",[407,426,427],{"class":413},"{\n",[407,429,431,434,438,440,443],{"class":409,"line":430},2,[407,432,433],{"class":413},"  \"",[407,435,437],{"class":436},"spNyl","enabled",[407,439,414],{"class":413},[407,441,442],{"class":413},":",[407,444,445],{"class":413}," true,\n",[407,447,449,451,453,455,457],{"class":409,"line":448},3,[407,450,433],{"class":413},[407,452,376],{"class":436},[407,454,414],{"class":413},[407,456,442],{"class":413},[407,458,459],{"class":413}," false,\n",[407,461,463,465,468,470,472],{"class":409,"line"