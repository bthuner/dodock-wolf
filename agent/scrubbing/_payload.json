","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":70,"body":214,"description":666,"extension":667,"links":668,"meta":669,"navigation":670,"path":71,"seo":671,"stem":72,"__hash__":672},"docs_en\u002F3.agent\u002F4.scrubbing.md",{"type":215,"value":216,"toc":661},"minimark",[217,221,386,391,398,402,405,412,416,611,650,657],[218,219,220],"p",{},"Before an event is spooled or sent, the agent scrubs its title and every string in its payload:\nsample lines, tracebacks, messages, routes. It is on by default.",[222,223,224,237],"table",{},[225,226,227],"thead",{},[228,229,230,234],"tr",{},[231,232,233],"th",{},"What",[231,235,236],{},"Becomes",[238,239,240,256,280,299,312,352,362,372],"tbody",{},[228,241,242,251],{},[243,244,245,246,250],"td",{},"e-mail addresses, also URL-encoded (",[247,248,249],"code",{},"jane%40example.com",")",[243,252,253],{},[247,254,255],{},"[EMAIL]",[228,257,258,275],{},[243,259,260,263,264,267,268,263,271,274],{},[247,261,262],{},"Authorization:"," \u002F ",[247,265,266],{},"Proxy-Authorization:"," header values, ",[247,269,270],{},"Cookie:",[247,272,273],{},"Set-Cookie:"," values",[243,276,277],{},[247,278,279],{},"[REDACTED]",[228,281,282,295],{},[243,283,284,287,288,287,291,294],{},[247,285,286],{},"Bearer …",", ",[247,289,290],{},"token \u003Ckey>:\u003Csecret>",[247,292,293],{},"Basic …"," credentials",[243,296,297],{},[247,298,279],{},[228,300,301,307],{},[243,302,303,304,250],{},"JWTs (",[247,305,306],{},"eyJ….….…",[243,308,309],{},[247,310,311],{},"[JWT]",[228,313,314,348],{},[243,315,316,317,287,320,287,323,287,326,287,329,287,332,287,335,287,338,287,341,287,344,347],{},"values of ",[247,318,319],{},"password",[247,321,322],{},"pwd",[247,324,325],{},"new_password",[247,327,328],{},"*_secret",[247,330,331],{},"*_token",[247,333,334],{},"api_key",[247,336,337],{},"sid",[247,339,340],{},"session_id",[247,342,343],{},"otp",[247,345,346],{},"signature",", in query strings, forms, JSON or Python dict reprs",[243,349,350],{},[247,351,279],{},[228,353,354,357],{},[243,355,356],{},"card-like numbers (13–19 digits, Luhn-valid, issuer digit 2–6)",[243,358,359],{},[247,360,361],{},"[CARD]",[228,363,364,367],{},[243,365,366],{},"IBAN-like strings (mod-97 checked)",[243,368,369],{},[247,370,371],{},"[IBAN]",[228,373,374,380],{},[243,375,376,377],{},"IP addresses, only with ",[247,378,379],{},"\"ips\": true",[243,381,382,385],{},[247,383,384],{},"[IP:\u003C8 hex>]",", a keyed hash, stable per agent",[387,388,390],"h2",{"id":389},"ip-addresses","IP addresses",[218,392,393,394,397],{},"IPs are kept by default, because the SSH brute-force and \"admin login from a new IP\" rules are built\non them. Turn ",[247,395,396],{},"ips"," on if addresses count as personal data for you and you can live without per-IP\ngrouping in titles.",[387,399,401],{"id":400},"what-never-changes","What never changes",[218,403,404],{},"Type, host, bench, site, timestamp and fingerprint. Fingerprints are computed from the raw lines\nbefore scrubbing, so grouping and deduplication on the Wolf site work the same either way.",[218,406,407,408,411],{},"Metrics carry no free text and are not scrubbed. Text you type yourself\n(",[247,409,410],{},"mark-deployment --note",") is sent as is.",[387,413,415],{"id":414},"settings","Settings",[417,418,424],"pre",{"className":419,"code":420,"filename":421,"language":422,"meta":423,"style":423},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\"scrub\": {\n  \"enabled\": true,\n  \"ips\": false,\n  \"extra_patterns\": [\n    \"internal-\\\\d{4}\",\n    {\"pattern\": \"CUST-\\\\d{6}\", \"replacement\": \"[CUSTOMER]\"}\n  ],\n  \"keep\": [\"@dokos.io\", \"noreply@example.com\"]\n}\n","\u002Fetc\u002Fwolf-agent\u002Fconfig.json","json","",[247,425,426,448,466,480,495,515,566,572,606],{"__ignoreMap":423},[427,428,431,435,439,441,445],"span",{"class":429,"line":430},"line",1,[427,432,434],{"class":433},"sMK4o","\"",[427,436,438],{"class":43