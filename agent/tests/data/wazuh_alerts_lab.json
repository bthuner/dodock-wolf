s not needed, disable it.","remediation":"Edit or create a file in the /etc/modprobe.d/ directory ending in .conf Example: vim /etc/modprobe.d/cramfs.conf and add the following line: install cramfs /bin/true Run the following command to unload the cramfs module: # rmmod cramfs.","compliance":{"cis":"1.1.1.1","cis_csc_v7":"5.1","cmmc_v2":{"0":"AC.1.002,CM.2.061,SC.3.180"},"iso_27001-2013":"A.8.1.3,A.14.2.5","mitre_techniques":"T1110,T1003,T1081,T1097,T1178,T1072,T1067,T1495,T1019,T1177,T1485,T1486,T1491,T1488,T1487,T1490,T1146,T1148,T1015,T1133,T1200,T1076,T1051,T1176,T1501,T1087,T1098,T1139,T1197,T1092,T1136,T1011,T1147,T1130,T1174,T1053,T1166,T1206,T1503,T1214,T1187,T1208,T1142,T1075,T1201,T1145,T1184,T1537,T1078,T1077,T1134,T1017,T1088,T1175,T1190,T1210,T1525,T1215,T1086,T1055,T1505,T1035,T1218,T1169,T1100,T1047,T1084,T1028,T1156,T1196,T1530,T1089,T1073,T1157,T1054,T1070,T1037,T1036,T1096,T1034,T1150,T1504,T1494,T1489,T1198,T1165,T1492,T1080,T1209,T1112,T1058,T1173,T1137,T1539,T1535,T1506,T1138,T1044,T1199","nist_sp_800-53":"AU-2,CM-1,CM-2,CM-6,CM-7,IA-5,IA-6,SC-20,SC-21","pci_dss_v3":{"2":{"1":"2.2"}}},"command":["modprobe -n -v cramfs","lsmod"],"result":"not applicable","reason":"Invalid path or wrong permissions to run command 'modprobe -n -v cramfs'"}}},"location":"sca"}
