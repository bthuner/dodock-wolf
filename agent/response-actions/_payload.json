44,"path":145,"stem":146,"icon":147},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":193,"title":85,"body":194,"description":1386,"extension":1387,"links":1388,"meta":1389,"navigation":1390,"path":86,"seo":1391,"stem":87,"__hash__":1392},"docs_en\u002F3.agent\u002F6.response-actions.md",{"type":195,"value":196,"toc":1377},"minimark",[197,206,274,299,304,307,322,327,370,745,748,752,764,768,775,798,801,804,823,868,882,1142,1176,1179,1182,1357,1370,1373],[198,199,200,201,205],"p",{},"Wolf proposes, a Wolf Manager approves each action with a second click, and nothing runs on its\nown. Every approval is a ",[202,203,204],"strong",{},"Wolf Response Action"," row (who, when, what, result; read-only for\neveryone) and a comment on the incident.",[207,208,209,225],"table",{},[210,211,212],"thead",{},[213,214,215,219,222],"tr",{},[216,217,218],"th",{},"Action",[216,220,221],{},"Proposed for",[216,223,224],{},"Applied by",[226,227,228,254],"tbody",{},[213,229,230,237,240],{},[231,232,233,236],"td",{},[202,234,235],{},"Block IP for N hours"," (1 to 168, default 24)",[231,238,239],{},"the public addresses of the incident's security events, from any source (Wolf, Suricata, Wazuh), for the attacked host",[231,241,242,243,248,249,253],{},"the Wolf Agent on that host, with its next push, when allowed there (below), and\u002For ",[244,245,247],"a",{"href":246},"#wazuh-active-response","Wazuh active response","; and ",[244,250,252],{"href":251},"#crowdsec","CrowdSec"," when set up",[213,255,256,268,271],{},[231,257,258,261,262,261,265],{},[202,259,260],{},"Disable user",", ",[202,263,264],{},"log out all sessions",[202,266,267],{},"revoke API keys",[231,269,270],{},"the users named by the site's own security events (failed logins, new IP or country, role granted, API key generated)",[231,272,273],{},"the Wolf site, at once",[275,276,277,285,288,291],"ul",{},[278,279,280,281,284],"li",{},"Approve from the incident's ",[202,282,283],{},"Response"," panel in the Wolf UI, or from the signed link in the\nalert (up to 5 per alert). The link only shows the proposal: a guest is sent to the login page,\nonly a logged-in Wolf Manager or System Manager gets the button, and only its POST acts. A\nforwarded email alone cannot act, and a link opened again says the action was done.",[278,286,287],{},"Only what Wolf proposed from the incident's own events can be approved: the API refuses any\nother action, target or host.",[278,289,290],{},"Administrator, Guest and the approver's own account are refused. Only a System Manager can act\non a System Manager. User actions apply to the Wolf site only.",[278,292,293,294,298],{},"Blocks are marked ",[295,296,297],"em",{},"Expired"," once their time is over (hourly).",[300,301,303],"h2",{"id":302},"blocking-on-the-host","Blocking on the host",[198,305,306],{},"The agent does nothing unless you allow it on that host.",[308,309,310],"caution",{},[198,311,312,313,317,318,321],{},"The agent refuses private, loopback and reserved addresses, and durations over a week, whatever\nthe site sends. It runs the command as a list of arguments, never through a shell. Without\n",[314,315,316],"code",{},"response.enabled",", each action comes back ",[295,319,320],{},"Failed"," with the reason, so the manager knows it was\nnot applied.",[323,324,326],"h3",{"id":325},"set-up","Set up",[328,329,330,353],"note",{},[198,331,332,333,336,337,340,341,344,345,348,349,352],{},"An agent installed before this fix has ",[314,334,335],{},"NoNewPrivileges=yes"," in ",[314,338,339],{},"\u002Fetc\u002Fsystemd\u002Fsystem\u002Fwolf-agent.service",", which stops ",[314,342,343],{},"sudo",": no block ever ran. Re-run ",[314,346,347],{},"install.sh",", or delete that line, then ",[314,350,351],{},"systemctl daemon-reload && systemctl restart wolf-agent",".",[198,354,355,357,358,361,362,365,366,369],{},[314,356,347],{}," does not install the helpers below: after an upgrade, copy ",[314,359,360],{},"wolf-block"," (or ",[314,363,364],{},"wolf-block-fail2ban",") again with the ",[314,367,368],{},"install"," line of its tab. Older copies let a shorter block of an address cut short a longer one.",[371,372,373,517],"tabs",{},[374,375,377,454,457,496],"tabs-item",{"label":376},"nftables",[378,379,385],"pre",{"className":380,"code":381,"filename":382,"language":383,"meta":384,"style":384},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","install -m 0755 -o root -g root agent\u002Fwolf-block.sh \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block\necho 'wolf-agent ALL=(root) NOPASSWD: \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block' > \u002Fetc\u002Fsudoers.d\u002Fwolf-block\nchmod 0440 \u002Fetc\u002Fsudoers.d\u002Fwolf-block\n","host","bash","",[314,386,387,420,443],{"__ignoreMap":384},[388,389,392,395,399,403,406,409,412,414,417],"span",{"class":390,"line":391},"line",1,[388,393,368],{"class":394},"sBMFI",[388,396,398],{"class":397},"sfazB"," -m",[388,400,402],{"class":401},"sbssI"," 0755",[388,404,405],{"class":397}," -o",[388,407,408],{"class":397}," root",[388,410,411],{"class":397}," -g",[388,413,408],{"class":397},[388,415,416],{"class":397}," agent\u002Fwolf-block.sh",[388,418,419],{"class":397}," \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block\n",[388,421,423,427,431,434,437,440],{"class":390,"line":422},2,[388,424,426],{"class":425},"s2Zo4","echo",[388,428,430],{"class":429},"sMK4o"," '",[388,432,433],{"class":397},"wolf-agent ALL=(root) NOPASSWD: \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block",[388,435,436],{"class":429},"'",[388,438,439],{"class":429}," >",[388,441,442],{"class":397}," \u002Fetc\u002Fsudoers.d\u002Fwolf-block\n",[388,444,446,449,452],{"class":390,"line":445},3,[388,447,448],{"class":394},"chmod",[388,450,451],{"class":401}," 0440",[388,453,442],{"class":397},[198,455,456],{},"In the agent config:",[378,458,463],{"className":459,"code":460,"filename":461,"language":462,"meta":384,"style":384},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\"response\": {\"enabled\": true}\n","\u002Fetc\u002Fwolf-agent\u002Fconfig.json","json",[314,464,465],{"__ignoreMap":384},[388,466,467,470,473,475,479,482,484,488,490,493],{"class":390,"line":391},[388,468,469],{"class":429},"\"",[388,471,472],{"class":397},"response",[388,474,469],{"class":429},[388,476,478],{"class":477},"sTEyZ",": ",[388,480,481],{"class":429},"{",[388,483,469],{"class":429},[388,485,487],{"class":486},"spNyl","enabled",[388,489,469],{"class":429},[388,491,492],{"class":429},":",[388,494,495],{"class":429}," true}\n",[198,497,498,499,501,502,261,505,508,509,512,513,516],{},"Restart the agent. ",[314,500,360],{}," adds the address to an nftables set (",[314,503,504],{},"inet wolf",[314,506,507],{},"blocked4"," \u002F\n",[314,510,511],{},"blocked6",") whose entries expire by themselves. ",[314,514,515],{},"nft list table inet wolf"," shows them. Blocking\nan address that is already blocked keeps the longer of the two blocks.",[374,518,520,530,644,646,733],{"label":519},"fail2ban",[198,521,522,523,525,526,529],{},"Where fail2ban already manages the firewall, ",[314,524,364],{}," bans in a jail of its own\n(",[314,527,528],{},"wolf","), with your usual ban action:",[378,531,533],{"className":380,"code":532,"filename":382,"language":383,"meta":384,"style":384},"cp agent\u002Ffail2ban\u002Fwolf.local \u002Fetc\u002Ffail2ban\u002Fjail.d\u002Fwolf.local && fail2ban-client reload\ninstall -m 0755 -o root -g root agent\u002Fwolf-block-fail2ban.sh \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban\ninstall -d -m 0700 \u002Fvar\u002Flib\u002Fwolf-block   # the expiries; writable from the agent's unit\necho 'wolf-agent ALL=(root) NOPASSWD: \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban' > \u002Fetc\u002Fsudoers.d\u002Fwolf-block\nchmod 0440 \u002Fetc\u002Fsudoers.d\u002Fwolf-block\n# reboots lose the scheduled unbans: sweep the expired ones every 5 minutes\necho '*\u002F5 * * * * root \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban --sweep >\u002Fdev\u002Fnull' > \u002Fetc\u002Fcron.d\u002Fwolf-block-fail2ban\n",[314,534,535,555,577,596,612,621,627],{"__ignoreMap":384},[388,536,537,540,543,546,549,552],{"class":390,"line":391},[388,538,539],{"class":394},"cp",[388,541,542],{"class":397}," agent\u002Ffail2ban\u002Fwolf.local",[388,544,545],{"class":397}," \u002Fetc\u002Ffail2ban\u002Fjail.d\u002Fwolf.local",[388,547,548],{"class":429}," &&",[388,550,551],{"class":394}," fail2ban-client",[388,553,554],{"class":397}," reload\n",[388,556,557,559,561,563,565,567,569,571,574],{"class":390,"line":422},[388,558,368],{"class":394},[388,560,398],{"class":397},[388,562,402],{"class":401},[388,564,405],{"class":397},[388,566,408],{"class":397},[388,568,411],{"class":397},[388,570,408],{"class":397},[388,572,573],{"class":397}," agent\u002Fwolf-block-fail2ban.sh",[388,575,576],{"class":397}," \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban\n",[388,578,579,581,584,586,589,592],{"class":390,"line":445},[388,580,368],{"class":394},[388,582,583],{"class":397}," -d",[388,585,398],{"class":397},[388,587,588],{"class":401}," 0700",[388,590,591],{"class":397}," \u002Fvar\u002Flib\u002Fwolf-block",[388,593,595],{"class":594},"sHwdD","   # the expiries; writable from the agent's unit\n",[388,597,599,601,603,606,608,610],{"class":390,"line":598},4,[388,600,426],{"class":425},[388,602,430],{"class":429},[388,604,605],{"class":397},"wolf-agent ALL=(root) NOPASSWD: \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban",[388,607,436],{"class":429},[388,609,439],{"class":429},[388,611,442],{"class":397},[388,613,615,617,619],{"class":390,"line":614},5,[388,616,448],{"class":394},[388,618,451],{"class":401},[388,620,442],{"class":397},[388,622,624],{"class":390,"line":623},6,[388,625,626],{"class":594},"# reboots lose the scheduled unbans: sweep the expired ones every 5 minutes\n",[388,628,630,632,634,637,639,641],{"class":390,"line":629},7,[388,631,426],{"class":425},[388,633,430],{"class":429},[388,635,636],{"class":397},"*\u002F5 * * * * root \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban --sweep >\u002Fdev\u002Fnull",[388,638,436],{"class":429},[388,640,439],{"class":429},[388,642,643],{"class":397}," \u002Fetc\u002Fcron.d\u002Fwolf-block-fail2ban\n",[198,645,456],{},[378,647,649],{"className":459,"code":648,"filename":461,"language":462,"meta":384,"style":384},"\"response\": {\"enabled\": true, \"command\": [\"sudo\", \"-n\", \"\u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban\", \"{ip}\", \"{seconds}\"]}\n",[314,650,651],{"__ignoreMap":384},[388,652,653,655,657,659,661,663,665,667,669,671,674,677,680,682,684,687,689,691,693,696,698,701,703,705,707,710,712,714,716,719,721,723,725,728,730],{"class":390,"line":391},[388,654,469],{"class":429},[388,656,472],{"class":397},[388,658,469],{"class":429},[388,660,478],{"class":477},[388,662,481],{"class":429},[388,664,469],{"class":429},[388,666,487],{"class":486},[388,668,469],{"class":429},[388,670,492],{"class":429},[388,672,673],{"class":429}," true,",[388,675,676],{"class":429}," \"",[388,678,679],{"class":486},"command",[388,681,469],{"class":429},[388,683,492],{"class":429},[388,685,686],{"class":429}," [",[388,688,469],{"class":429},[388,690,343],{"class":397},[388,692,469],{"class":429},[388,694,695],{"class":429},",",[388,697,676],{"class":429},[388,699,700],{"class":397},"-n",[388,702,469],{"class":429},[388,704,695],{"class":429},[388,706,676],{"class":429},[388,708,709],{"class":397},"\u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban",[388,711,469],{"class":429},[388,713,695],{"class":429},[388,715,676],{"class":429},[388,717,718],{"class":397},"{ip}",[388,720,469],{"class":429},[388,722,695],{"class":429},[388,724,676],{"class":429},[388,726,727],{"class":397},"{seconds}",[388,729,469],{"class":429},[388,731,732],{"class":429},"]}\n",[198,734,735,738,739,742,743,352],{},[314,736,737],{},"fail2ban-client get wolf banip"," lists the addresses. ",[314,740,741],{},"fail2ban-client set wolf unbanip IP"," lifts\none early. Without the jail, the helper refuses and says so, and the action comes back ",[295,744,320],{},[198,746,747],{},"Paths are relative to a checkout of the repository.",[323,749,751],{"id":750},"custom-command","Custom command",[198,753,754,757,758,760,761,763],{},[314,755,756],{},"response.command"," replaces the command. ",[314,759,718],{}," and ",[314,762,727],{}," are filled in.",[323,765,767],{"id":766},"how-fail2ban-durations-work","How fail2ban durations work",[198,769,770,771,774],{},"fail2ban has no per-ban duration: every ban gets the jail's ",[314,772,773],{},"bantime",". The jail's is the longest\nblock Wolf asks for (7 days), and the helper unbans each address when its own duration is over:",[275,776,777,788],{},[278,778,779,780,783,784,787],{},"each expiry is written to ",[314,781,782],{},"\u002Fvar\u002Flib\u002Fwolf-block\u002Ffail2ban.state",", and ",[314,785,786],{},"--sweep"," unbans those that\nare over. Banning an address again keeps the later expiry;",[278,789,790,791,794,795,797],{},"a transient systemd timer (",[314,792,793],{},"wolf-unban-\u003Cip>-\u003Ctime>",") runs ",[314,796,786],{}," at the expiry, so an earlier\ntimer leaves a longer ban alone.",[198,799,800],{},"Timers do not survive a reboot, and fail2ban restores its bans after one. Without the cron line, a\nblock could last up to the jail's 7 days. The helper also sweeps on each ban.",[300,802,247],{"id":803},"wazuh-active-response",[198,805,806,807,810,811,814,815,818,819,822],{},"With ",[202,808,809],{},"Block With"," set to ",[314,812,813],{},"wazuh"," or ",[314,816,817],{},"both"," (",[202,820,821],{},"Wolf Settings → Blocking","), an approved block runs\nthrough Wazuh active response on the Wazuh agent of the attacked host, through the Wazuh manager's\nAPI. It is the same approval, the same signed links, the same journal: only who applies the block\nchanges.",[207,824,825,834],{},[210,826,827],{},[213,828,829,831],{},[216,830,809],{},[216,832,833],{},"Who applies an approved block",[226,835,836,847,856],{},[213,837,838,844],{},[231,839,840,843],{},[314,841,842],{},"wolf_agent"," (default)",[231,845,846],{},"the Wolf Agent on the attacked host, as above",[213,848,849,853],{},[231,850,851],{},[314,852,813],{},[231,854,855],{},"Wazuh active response on that host's Wazuh agent",[213,857,858,862],{},[231,859,860],{},[314,861,817],{},[231,863,864,865,867],{},"each of them: two ",[202,866,204],{}," rows, one per executor",[198,869,870,871,873,874,876,877,814,879,881],{},"A block is proposed for the host that was attacked, not for the agent that sent the alert: a Wazuh\nor Suricata alert, read on the manager's or the sensor's host, or posted by the integration, is\nabout the host it names. Any other agent's event is about that agent's own host, whatever its\n",[314,872,382],{}," says, so an agent cannot point a block at another machine. With\n",[314,875,842],{},", a host without a Wolf Agent gets no block proposal; with ",[314,878,813],{},[314,880,817],{},", it does.",[883,884,886,890,905,1024,1039,1043,1054,1058],"steps",{"level":885},"3",[323,887,889],{"id":888},"define-a-timed-command-on-the-wazuh-manager","Define a timed command on the Wazuh manager",[198,891,892,893,896,897,900,901,904],{},"Wolf runs a ",[295,894,895],{},"named"," command, which Wazuh removes by itself when its timeout runs out. Add an\n",[314,898,899],{},"\u003Cactive-response>"," block for ",[314,902,903],{},"firewall-drop"," with the timeout you want, on a rule that never fires\nso that it only runs when Wolf asks, then restart the manager:",[378,906,911],{"className":907,"code":908,"filename":909,"language":910,"meta":384,"style":384},"language-xml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u003Cactive-response>\n  \u003Cdisabled>no\u003C\u002Fdisabled>\n  \u003Ccommand>firewall-drop\u003C\u002Fcommand>\n  \u003Clocation>local\u003C\u002Flocation>\n  \u003Crules_id>999999\u003C\u002Frules_id>\n  \u003Ctimeout>86400\u003C\u002Ftimeout>\n\u003C\u002Factive-response>\n","ossec.conf","xml",[314,912,913,925,946,962,980,998,1016],{"__ignoreMap":384},[388,914,915,918,922],{"class":390,"line":391},[388,916,917],{"class":429},"\u003C",[388,919,921],{"class":920},"swJcz","active-response",[388,923,924],{"class":429},">\n",[388,926,927,930,933,936,939,942,944],{"class":390,"line":422},[388,928,929],{"class":429},"  \u003C",[388,931,932],{"class":920},"disabled",[388,934,935],{"class":429},">",[388,937,938],{"class":477},"no",[388,940,941],{"class":429},"\u003C\u002F",[388,943,932],{"class":920},[388,945,924],{"class":429},[388,947,948,950,952,954,956,958,960],{"class":390,"line":445},[388,949,929],{"class":429},[388,951,679],{"class":920},[388,953,935],{"class":429},[388,955,903],{"class":477},[388,957,941],{"class":429},[388,959,679],{"class":920},[388,961,924],{"class":429},[388,963,964,966,969,971,974,976,978],{"class":390,"line":598},[388,965,929],{"class":429},[388,967,968],{"class":920},"location",[388,970,935],{"class":429},[388,972,973],{"class":477},"local",[388,975,941],{"class":429},[388,977,968],{"class":920},[388,979,924],{"class":429},[388,981,982,984,987,989,992,994,996],{"class":390,"line":614},[388,983,929],{"class":429},[388,985,986],{"class":920},"rules_id",[388,988,935],{"class":429},[388,990,991],{"class":477},"999999",[388,993,941],{"class":429},[388,995,986],{"class":920},[388,997,924],{"class":429},[388,999,1000,1002,1005,1007,1010,1012,1014],{"class":390,"line":623},[388,1001,929],{"class":429},[388,1003,1004],{"class":920},"timeout",[388,1006,935],{"class":429},[388,1008,1009],{"class":477},"86400",[388,1011,941],{"class":429},[388,1013,1004],{"class":920},[388,1015,924],{"class":429},[388,1017,1018,1020,1022],{"class":390,"line":629},[388,1019,941],{"class":429},[388,1021,921],{"class":920},[388,1023,924],{"class":429},[198,1025,1026,1027,1030,1031,1034,1035,1038],{},"Wazuh names the command with its timeout: ",[314,1028,1029],{},"firewall-drop86400"," (listed in\n",[314,1032,1033],{},"\u002Fvar\u002Fossec\u002Fetc\u002Fshared\u002Far.conf","). That timeout is the block's duration; the hours chosen at approval\nonly apply to the Wolf Agent's block. A script (",[314,1036,1037],{},"!firewall-drop",") is refused: Wazuh never removes it.",[323,1040,1042],{"id":1041},"create-a-wazuh-api-user","Create a Wazuh API user",[198,1044,1045,1046,1049,1050,1053],{},"A user allowed to read agents and run active response commands (",[314,1047,1048],{},"agent:read",",\n",[314,1051,1052],{},"active-response:command",").",[323,1055,1057],{"id":1056},"fill-wolf-settings-blocking","Fill Wolf Settings → Blocking",[207,1059,1060,1070],{},[210,1061,1062],{},[213,1063,1064,1067],{},[216,1065,1066],{},"Field",[216,1068,1069],{},"Value",[226,1071,1072,1084,1095,1119,1132],{},[213,1073,1074,1078],{},[231,1075,1076],{},[202,1077,809],{},[231,1079,1080,814,1082],{},[314,1081,813],{},[314,1083,817],{},[213,1085,1086,1091],{},[231,1087,1088],{},[202,1089,1090],{},"Wazuh Active Response Command",[231,1092,1093],{},[314,1094,1029],{},[213,1096,1097,1102],{},[231,1098,1099],{},[202,1100,1101],{},"Wazuh API URL",[231,1103,1104,1107,1108,1111,1112,261,1115,1118],{},[314,1105,1106],{},"https:\u002F\u002Fwazuh-manager:55000",". ",[314,1109,1110],{},"http:\u002F\u002F"," only to the same machine (",[314,1113,1114],{},"127.0.0.1",[314,1116,1117],{},"localhost","): the password goes with every login. Changing the URL asks for the password again.",[213,1120,1121,1129],{},[231,1122,1123,261,1126],{},[202,1124,1125],{},"Wazuh API User",[202,1127,1128],{},"Wazuh API Password",[231,1130,1131],{},"the user above",[213,1133,1134,1139],{},[231,1135,1136],{},[202,1137,1138],{},"Verify Wazuh TLS Certificate",[231,1140,1141],{},"on, unless the manager has a self-signed certificate on a trusted network",[275,1143,1144,1159,1168,1173],{},[278,1145,1146,1147,1151,1152,1155,1156,1158],{},"Wolf finds the Wazuh agent by the host's names (its Wolf hostname, its\n",[244,1148,1150],{"href":1149},"\u002Fsecurity\u002Fwazuh-suricata#aliases","aliases","), then by an address only one Wazuh agent has: hosts\nbehind one NAT share theirs. The manager (",[314,1153,1154],{},"000",") never runs a block. When no agent matches, the action is ",[295,1157,320],{}," with the reason; add a Wolf Entity\nAlias and approve again.",[278,1160,1161,1162,814,1165,1167],{},"The action is ",[295,1163,1164],{},"Applied",[295,1166,320],{}," at once, with Wazuh's answer, and journaled like any other.\nIt is recorded before Wolf calls Wazuh, so a block Wazuh applied always has its row.",[278,1169,806,1170,1172],{},[314,1171,817],{},", each executor has its own duration (the hours asked for the Wolf Agent, the\ncommand's timeout for Wazuh) and its own row. When Wazuh's half fails, it alone is proposed\nagain while the Wolf Agent's half waits for its agent.",[278,1174,1175],{},"Tried against a Wazuh 4.9.2 manager and agent: the address was dropped with iptables on the\nagent, and Wazuh removed the rule when the timeout ran out.",[300,1177,252],{"id":1178},"crowdsec",[198,1180,1181],{},"With a CrowdSec Local API (LAPI), approved blocks reach every bouncer of that LAPI (firewall, nginx,\nCloudflare), and Wolf and CrowdSec share detections. Off by default; runs every minute on the\ncentral site only.",[883,1183,1184,1188,1235,1239],{"level":885},[323,1185,1187],{"id":1186},"create-the-credentials","Create the credentials",[378,1189,1192],{"className":380,"code":1190,"filename":1191,"language":383,"meta":384,"style":384},"cscli bouncers add dodock-wolf   # prints the bouncer key: decisions in\ncscli machines add dodock-wolf --password '\u003Clong random password>'  # detections and blocks out\n","CrowdSec host",[314,1193,1194,1211],{"__ignoreMap":384},[388,1195,1196,1199,1202,1205,1208],{"class":390,"line":391},[388,1197,1198],{"class":394},"cscli",[388,1200,1201],{"class":397}," bouncers",[388,1203,1204],{"class":397}," add",[388,1206,1207],{"class":397}," dodock-wolf",[388,1209,1210],{"class":594},"   # prints the bouncer key: decisions in\n",[388,1212,1213,1215,1218,1220,1222,1225,1227,1230,1232],{"class":390,"line":422},[388,1214,1198],{"class":394},[388,1216,1217],{"class":397}," machines",[388,1219,1204],{"class":397},[388,1221,1207],{"class":397},[388,1223,1224],{"class":397}," --password",[388,1226,430],{"class":429},[388,1228,1229],{"class":397},"\u003Clong random password>",[388,1231,436],{"class":429},[388,1233,1234],{"class":594},"  # detections and blocks out\n",[323,1236,1238],{"id":1237},"fill-wolf-settings-crowdsec","Fill Wolf Settings → CrowdSec",[207,1240,1241,1254],{},[210,1242,1243],{},[213,1244,1245,1248,1251],{},[216,1246,1247],{},"Setting",[216,1249,1250],{},"Default",[216,1252,1253],{},"Effect",[226,1255,1256,1269,1290,1314,1334],{},[213,1257,1258,1263,1266],{},[231,1259,1260],{},[202,1261,1262],{},"Use CrowdSec",[231,1264,1265],{},"off",[231,1267,1268],{},"turns the integration on",[213,1270,1271,1285,1287],{},[231,1272,1273,261,1276,261,1279,261,1282],{},[202,1274,1275],{},"Local API URL",[202,1277,1278],{},"Bouncer API key",[202,1280,1281],{},"Machine ID",[202,1283,1284],{},"Machine password",[231,1286],{},[231,1288,1289],{},"the LAPI and the credentials above",[213,1291,1292,1297,1300],{},[231,1293,1294],{},[202,1295,1296],{},"Send detections",[231,1298,1299],{},"on",[231,1301,1302,1303,818,1306,1309,1310,1313],{},"security events with an IP, at or above ",[202,1304,1305],{},"Minimum severity sent",[314,1307,1308],{},"warning","), become LAPI alerts with the scenario ",[314,1311,1312],{},"dodock-wolf\u002F\u003Ccategory>",". Past events are not replayed.",[213,1315,1316,1321,1323],{},[231,1317,1318],{},[202,1319,1320],{},"Let CrowdSec decide on detections",[231,1322,1265],{},[231,1324,1325,1326,1329,1330,1333],{},"off: alerts carry ",[314,1327,1328],{},"remediation: false",", CrowdSec records them (",[314,1331,1332],{},"cscli alerts list",") and decides nothing. On: CrowdSec's profiles decide; the default profile bans the IP for 4 h, with no human approval.",[213,1335,1336,1341,1343],{},[231,1337,1338],{},[202,1339,1340],{},"Apply approved blocks",[231,1342,1299],{},[231,1344,1345,1346,1349,1350,1353,1354,1053],{},"an approved ",[202,1347,1348],{},"Block IP"," goes to the LAPI as a ",[314,1351,1352],{},"ban"," decision for the approved duration (origin ",[314,1355,1356],{},"dodock-wolf",[198,1358,1359,1362,1363,1365,1366,1369],{},[202,1360,1361],{},"Decisions in",": Wolf reads the LAPI's decisions (the whole list on the first run and every hour,\nthe changes in between), including CrowdSec's own detections, ",[314,1364,1198],{}," bans and the community\nblocklist when the LAPI is enrolled. A security event whose IP is under a decision gets\n",[314,1367,1368],{},"payload.crowdsec"," (type, origin, scenario, until) and one severity step more. Wolf's own blocks are\ntagged but not raised.",[198,1371,1372],{},"The agent still applies its own block when its responder is on, and the incident comment says what\nwas sent where. Tested against CrowdSec 1.6.4.",[1374,1375,1376],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}",{"title":384,"searchDepth":391,"depth":422,"links":1378},[1379,1384,1385],{"id":302,"depth":422,"text":303,"children":1380},[1381,1382,1383],{"id":325,"depth":445,"text":326},{"id":750,"depth":445,"text":751},{"id":766,"depth":445,"text":767},{"id":803,"depth":422,"text":247},{"id":1178,"depth":422,"text":252},"Block an attacking IP on the host, disable a user or revoke sessions, after a Wolf Manager approves. Off by default.","md",null,{},{"icon":88},{"title":85,"description":1386},"1LGA_mjf9HfaAqzBXCR-MpSWPQ4WkzZdYo2GqDhVfoc",[1394,1396],{"title":80,"path":81,"stem":82,"description":1395,"icon":83},"How the agent alerts you when the Wolf site itself is down.",{"title":96,"path":97,"stem":98,"description":1397,"icon":99},"Write a rule that reads like the brief - when X > Y for Z minutes, send alert.",1795021732439]