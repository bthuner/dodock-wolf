,"path":145,"stem":146,"icon":147},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":193,"title":85,"body":194,"description":953,"extension":954,"links":955,"meta":956,"navigation":957,"path":86,"seo":958,"stem":87,"__hash__":959},"docs_en\u002F3.agent\u002F6.response-actions.md",{"type":195,"value":196,"toc":945},"minimark",[197,206,269,294,299,302,317,322,683,686,690,702,706,713,737,740,743,746,925,938,941],[198,199,200,201,205],"p",{},"Wolf proposes, a Wolf Manager approves each action with a second click, and nothing runs on its\nown. Every approval is a ",[202,203,204],"strong",{},"Wolf Response Action"," row (who, when, what, result; read-only for\neveryone) and a comment on the incident.",[207,208,209,225],"table",{},[210,211,212],"thead",{},[213,214,215,219,222],"tr",{},[216,217,218],"th",{},"Action",[216,220,221],{},"Proposed for",[216,223,224],{},"Applied by",[226,227,228,249],"tbody",{},[213,229,230,237,240],{},[231,232,233,236],"td",{},[202,234,235],{},"Block IP for N hours"," (1 to 168, default 24)",[231,238,239],{},"the public addresses of the incident's security events, for the agent that saw each one",[231,241,242,243,248],{},"the agent, with its next push, when allowed on that host (below); and ",[244,245,247],"a",{"href":246},"#crowdsec","CrowdSec"," when set up",[213,250,251,263,266],{},[231,252,253,256,257,256,260],{},[202,254,255],{},"Disable user",", ",[202,258,259],{},"log out all sessions",[202,261,262],{},"revoke API keys",[231,264,265],{},"the users named by the site's own security events (failed logins, new IP or country, role granted, API key generated)",[231,267,268],{},"the Wolf site, at once",[270,271,272,280,283,286],"ul",{},[273,274,275,276,279],"li",{},"Approve from the incident's ",[202,277,278],{},"Response"," panel in the Wolf UI, or from the signed link in the\nalert (up to 5 per alert). The link only shows the proposal: a guest is sent to the login page,\nonly a logged-in Wolf Manager or System Manager gets the button, and only its POST acts. A\nforwarded email alone cannot act, and a link opened again says the action was done.",[273,281,282],{},"Only what Wolf proposed from the incident's own events can be approved: the API refuses any\nother action, target or agent.",[273,284,285],{},"Administrator, Guest and the approver's own account are refused. Only a System Manager can act\non a System Manager. User actions apply to the Wolf site only.",[273,287,288,289,293],{},"Blocks are marked ",[290,291,292],"em",{},"Expired"," once their time is over (hourly).",[295,296,298],"h2",{"id":297},"blocking-on-the-host","Blocking on the host",[198,300,301],{},"The agent does nothing unless you allow it on that host.",[303,304,305],"caution",{},[198,306,307,308,312,313,316],{},"The agent refuses private, loopback and reserved addresses, and durations over a week, whatever\nthe site sends. It runs the command as a list of arguments, never through a shell. Without\n",[309,310,311],"code",{},"response.enabled",", each action comes back ",[290,314,315],{},"Failed"," with the reason, so the manager knows it was\nnot applied.",[318,319,321],"h3",{"id":320},"set-up","Set up",[323,324,325,471],"tabs",{},[326,327,329,407,410,449],"tabs-item",{"label":328},"nftables",[330,331,337],"pre",{"className":332,"code":333,"filename":334,"language":335,"meta":336,"style":336},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","install -m 0755 -o root -g root agent\u002Fwolf-block.sh \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block\necho 'wolf-agent ALL=(root) NOPASSWD: \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block' > \u002Fetc\u002Fsudoers.d\u002Fwolf-block\nchmod 0440 \u002Fetc\u002Fsudoers.d\u002Fwolf-block\n","host","bash","",[309,338,339,373,396],{"__ignoreMap":336},[340,341,344,348,352,356,359,362,365,367,370],"span",{"class":342,"line":343},"line",1,[340,345,347],{"class":346},"sBMFI","install",[340,349,351],{"class":350},"sfazB"," -m",[340,353,355],{"class":354},"sbssI"," 0755",[340,357,358],{"class":350}," -o",[340,360,361],{"class":350}," root",[340,363,364],{"class":350}," -g",[340,366,361],{"class":350},[340,368,369],{"class":350}," agent\u002Fwolf-block.sh",[340,371,372],{"class":350}," \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block\n",[340,374,376,380,384,387,390,393],{"class":342,"line":375},2,[340,377,379],{"class":378},"s2Zo4","echo",[340,381,383],{"class":382},"sMK4o"," '",[340,385,386],{"class":350},"wolf-agent ALL=(root) NOPASSWD: \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block",[340,388,389],{"class":382},"'",[340,391,392],{"class":382}," >",[340,394,395],{"class":350}," \u002Fetc\u002Fsudoers.d\u002Fwolf-block\n",[340,397,399,402,405],{"class":342,"line":398},3,[340,400,401],{"class":346},"chmod",[340,403,404],{"class":354}," 0440",[340,406,395],{"class":350},[198,408,409],{},"In the agent config:",[330,411,416],{"className":412,"code":413,"filename":414,"language":415,"meta":336,"style":336},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\"response\": {\"enabled\": true}\n","\u002Fetc\u002Fwolf-agent\u002Fconfig.json","json",[309,417,418],{"__ignoreMap":336},[340,419,420,423,426,428,432,435,437,441,443,446],{"class":342,"line":343},[340,421,422],{"class":382},"\"",[340,424,425],{"class":350},"response",[340,427,422],{"class":382},[340,429,431],{"class":430},"sTEyZ",": ",[340,433,434],{"class":382},"{",[340,436,422],{"class":382},[340,438,440],{"class":439},"spNyl","enabled",[340,442,422],{"class":382},[340,444,445],{"class":382},":",[340,447,448],{"class":382}," true}\n",[198,450,451,452,455,456,256,459,462,463,466,467,470],{},"Restart the agent. ",[309,453,454],{},"wolf-block"," adds the address to an nftables set (",[309,457,458],{},"inet wolf",[309,460,461],{},"blocked4"," \u002F\n",[309,464,465],{},"blocked6",") whose entries expire by themselves. ",[309,468,469],{},"nft list table inet wolf"," shows them.",[326,472,474,485,580,582,670],{"label":473},"fail2ban",[198,475,476,477,480,481,484],{},"Where fail2ban already manages the firewall, ",[309,478,479],{},"wolf-block-fail2ban"," bans in a jail of its own\n(",[309,482,483],{},"wolf","), with your usual ban action:",[330,486,488],{"className":332,"code":487,"filename":334,"language":335,"meta":336,"style":336},"cp agent\u002Ffail2ban\u002Fwolf.local \u002Fetc\u002Ffail2ban\u002Fjail.d\u002Fwolf.local && fail2ban-client reload\ninstall -m 0755 -o root -g root agent\u002Fwolf-block-fail2ban.sh \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban\necho 'wolf-agent ALL=(root) NOPASSWD: \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban' > \u002Fetc\u002Fsudoers.d\u002Fwolf-block\nchmod 0440 \u002Fetc\u002Fsudoers.d\u002Fwolf-block\n# reboots lose the scheduled unbans: sweep the expired ones every 5 minutes\necho '*\u002F5 * * * * root \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban --sweep >\u002Fdev\u002Fnull' > \u002Fetc\u002Fcron.d\u002Fwolf-block-fail2ban\n",[309,489,490,510,532,547,556,563],{"__ignoreMap":336},[340,491,492,495,498,501,504,507],{"class":342,"line":343},[340,493,494],{"class":346},"cp",[340,496,497],{"class":350}," agent\u002Ffail2ban\u002Fwolf.local",[340,499,500],{"class":350}," \u002Fetc\u002Ffail2ban\u002Fjail.d\u002Fwolf.local",[340,502,503],{"class":382}," &&",[340,505,506],{"class":346}," fail2ban-client",[340,508,509],{"class":350}," reload\n",[340,511,512,514,516,518,520,522,524,526,529],{"class":342,"line":375},[340,513,347],{"class":346},[340,515,351],{"class":350},[340,517,355],{"class":354},[340,519,358],{"class":350},[340,521,361],{"class":350},[340,523,364],{"class":350},[340,525,361],{"class":350},[340,527,528],{"class":350}," agent\u002Fwolf-block-fail2ban.sh",[340,530,531],{"class":350}," \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban\n",[340,533,534,536,538,541,543,545],{"class":342,"line":398},[340,535,379],{"class":378},[340,537,383],{"class":382},[340,539,540],{"class":350},"wolf-agent ALL=(root) NOPASSWD: \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban",[340,542,389],{"class":382},[340,544,392],{"class":382},[340,546,395],{"class":350},[340,548,550,552,554],{"class":342,"line":549},4,[340,551,401],{"class":346},[340,553,404],{"class":354},[340,555,395],{"class":350},[340,557,559],{"class":342,"line":558},5,[340,560,562],{"class":561},"sHwdD","# reboots lose the scheduled unbans: sweep the expired ones every 5 minutes\n",[340,564,566,568,570,573,575,577],{"class":342,"line":565},6,[340,567,379],{"class":378},[340,569,383],{"class":382},[340,571,572],{"class":350},"*\u002F5 * * * * root \u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban --sweep >\u002Fdev\u002Fnull",[340,574,389],{"class":382},[340,576,392],{"class":382},[340,578,579],{"class":350}," \u002Fetc\u002Fcron.d\u002Fwolf-block-fail2ban\n",[198,581,409],{},[330,583,585],{"className":412,"code":584,"filename":414,"language":415,"meta":336,"style":336},"\"response\": {\"enabled\": true, \"command\": [\"sudo\", \"-n\", \"\u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban\", \"{ip}\", \"{seconds}\"]}\n",[309,586,587],{"__ignoreMap":336},[340,588,589,591,593,595,597,599,601,603,605,607,610,613,616,618,620,623,625,628,630,633,635,638,640,642,644,647,649,651,653,656,658,660,662,665,667],{"class":342,"line":343},[340,590,422],{"class":382},[340,592,425],{"class":350},[340,594,422],{"class":382},[340,596,431],{"class":430},[340,598,434],{"class":382},[340,600,422],{"class":382},[340,602,440],{"class":439},[340,604,422],{"class":382},[340,606,445],{"class":382},[340,608,609],{"class":382}," true,",[340,611,612],{"class":382}," \"",[340,614,615],{"class":439},"command",[340,617,422],{"class":382},[340,619,445],{"class":382},[340,621,622],{"class":382}," [",[340,624,422],{"class":382},[340,626,627],{"class":350},"sudo",[340,629,422],{"class":382},[340,631,632],{"class":382},",",[340,634,612],{"class":382},[340,636,637],{"class":350},"-n",[340,639,422],{"class":382},[340,641,632],{"class":382},[340,643,612],{"class":382},[340,645,646],{"class":350},"\u002Fusr\u002Flocal\u002Fsbin\u002Fwolf-block-fail2ban",[340,648,422],{"class":382},[340,650,632],{"class":382},[340,652,612],{"class":382},[340,654,655],{"class":350},"{ip}",[340,657,422],{"class":382},[340,659,632],{"class":382},[340,661,612],{"class":382},[340,663,664],{"class":350},"{seconds}",[340,666,422],{"class":382},[340,668,669],{"class":382},"]}\n",[198,671,672,675,676,679,680,682],{},[309,673,674],{},"fail2ban-client get wolf banip"," lists the addresses. ",[309,677,678],{},"fail2ban-client set wolf unbanip IP"," lifts\none early. Without the jail, the helper refuses and says so, and the action comes back ",[290,681,315],{},".",[198,684,685],{},"Paths are relative to a checkout of the repository.",[318,687,689],{"id":688},"custom-command","Custom command",[198,691,692,695,696,698,699,701],{},[309,693,694],{},"response.command"," replaces the command. ",[309,697,655],{}," and ",[309,700,664],{}," are filled in.",[318,703,705],{"id":704},"how-fail2ban-durations-work","How fail2ban durations work",[198,707,708,709,712],{},"fail2ban has no per-ban duration: every ban gets the jail's ",[309,710,711],{},"bantime",". The jail's is the longest\nblock Wolf asks for (7 days), and the helper unbans each address when its own duration is over:",[270,714,715,726],{},[273,716,717,718,721,722,725],{},"a transient systemd timer (",[309,719,720],{},"wolf-unban-\u003Cip>-\u003Ctime>",") runs ",[309,723,724],{},"fail2ban-client set wolf unbanip",";",[273,727,728,729,732,733,736],{},"each expiry is also written to ",[309,730,731],{},"\u002Fvar\u002Flib\u002Fwolf-block\u002Ffail2ban.state",", and ",[309,734,735],{},"--sweep"," unbans those\nthat are over.",[198,738,739],{},"Timers do not survive a reboot, and fail2ban restores its bans after one. Without the cron line, a\nblock could last up to the jail's 7 days. The helper also sweeps on each ban.",[295,741,247],{"id":742},"crowdsec",[198,744,745],{},"With a CrowdSec Local API (LAPI), approved blocks reach every bouncer of that LAPI (firewall, nginx,\nCloudflare), and Wolf and CrowdSec share detections. Off by default; runs every minute on the\ncentral site only.",[747,748,750,754,801,805],"steps",{"level":749},"3",[318,751,753],{"id":752},"create-the-credentials","Create the credentials",[330,755,758],{"className":332,"code":756,"filename":757,"language":335,"meta":336,"style":336},"cscli bouncers add dodock-wolf   # prints the bouncer key: decisions in\ncscli machines add dodock-wolf --password '\u003Clong random password>'  # detections and blocks out\n","CrowdSec host",[309,759,760,777],{"__ignoreMap":336},[340,761,762,765,768,771,774],{"class":342,"line":343},[340,763,764],{"class":346},"cscli",[340,766,767],{"class":350}," bouncers",[340,769,770],{"class":350}," add",[340,772,773],{"class":350}," dodock-wolf",[340,775,776],{"class":561},"   # prints the bouncer key: decisions in\n",[340,778,779,781,784,786,788,791,793,796,798],{"class":342,"line":375},[340,780,764],{"class":346},[340,782,783],{"class":350}," machines",[340,785,770],{"class":350},[340,787,773],{"class":350},[340,789,790],{"class":350}," --password",[340,792,383],{"class":382},[340,794,795],{"class":350},"\u003Clong random password>",[340,797,389],{"class":382},[340,799,800],{"class":561},"  # detections and blocks out\n",[318,802,804],{"id":803},"fill-wolf-settings-crowdsec","Fill Wolf Settings → CrowdSec",[207,806,807,820],{},[210,808,809],{},[213,810,811,814,817],{},[216,812,813],{},"Setting",[216,815,816],{},"Default",[216,818,819],{},"Effect",[226,821,822,835,856,881,901],{},[213,823,824,829,832],{},[231,825,826],{},[202,827,828],{},"Use CrowdSec",[231,830,831],{},"off",[231,833,834],{},"turns the integration on",[213,836,837,851,853],{},[231,838,839,256,842,256,845,256,848],{},[202,840,841],{},"Local API URL",[202,843,844],{},"Bouncer API key",[202,846,847],{},"Machine ID",[202,849,850],{},"Machine password",[231,852],{},[231,854,855],{},"the LAPI and the credentials above",[213,857,858,863,866],{},[231,859,860],{},[202,861,862],{},"Send detections",[231,864,865],{},"on",[231,867,868,869,872,873,876,877,880],{},"security events with an IP, at or above ",[202,870,871],{},"Minimum severity sent"," (",[309,874,875],{},"warning","), become LAPI alerts with the scenario ",[309,878,879],{},"dodock-wolf\u002F\u003Ccategory>",". Past events are not replayed.",[213,882,883,888,890],{},[231,884,885],{},[202,886,887],{},"Let CrowdSec decide on detections",[231,889,831],{},[231,891,892,893,896,897,900],{},"off: alerts carry ",[309,894,895],{},"remediation: false",", CrowdSec records them (",[309,898,899],{},"cscli alerts list",") and decides nothing. On: CrowdSec's profiles decide; the default profile bans the IP for 4 h, with no human approval.",[213,902,903,908,910],{},[231,904,905],{},[202,906,907],{},"Apply approved blocks",[231,909,865],{},[231,911,912,913,916,917,920,921,924],{},"an approved ",[202,914,915],{},"Block IP"," goes to the LAPI as a ",[309,918,919],{},"ban"," decision for the approved duration (origin ",[309,922,923],{},"dodock-wolf",").",[198,926,927,930,931,933,934,937],{},[202,928,929],{},"Decisions in",": Wolf reads the LAPI's decisions (the whole list on the first run and every hour,\nthe changes in between), including CrowdSec's own detections, ",[309,932,764],{}," bans and the community\nblocklist when the LAPI is enrolled. A security event whose IP is under a decision gets\n",[309,935,936],{},"payload.crowdsec"," (type, origin, scenario, until) and one severity step more. Wolf's own blocks are\ntagged but not raised.",[198,939,940],{},"The agent still applies its own block when its responder is on, and the incident comment says what\nwas sent where. Tested against CrowdSec 1.6.4.",[942,943,944],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki sp