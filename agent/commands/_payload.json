path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":183,"title":65,"body":184,"description":633,"extension":634,"links":635,"meta":636,"navigation":637,"path":66,"seo":638,"stem":67,"__hash__":639},"docs_en\u002F3.agent\u002F3.commands.md",{"type":185,"value":186,"toc":626},"minimark",[187,200,214,321,326,333,392,399,404,473,492,499,502,521,538,546,557,573,577,613,622],[188,189,190,191,195,196,199],"p",{},"Run commands as the ",[192,193,194],"code",{},"wolf-agent"," user, which owns the config:\n",[192,197,198],{},"sudo -u wolf-agent wolf-agent \u003Ccommand>",".",[188,201,202,203,206,207,210,211,199],{},"Global options: ",[192,204,205],{},"--config PATH"," (or ",[192,208,209],{},"$WOLF_AGENT_CONFIG","), ",[192,212,213],{},"-v",[215,216,217,230],"table",{},[218,219,220],"thead",{},[221,222,223,227],"tr",{},[224,225,226],"th",{},"Command",[224,228,229],{},"What it does",[231,232,233,244,254,264,278,293,307],"tbody",{},[221,234,235,241],{},[236,237,238],"td",{},[192,239,240],{},"register --url URL --token TOKEN [--bench PATH]...",[236,242,243],{},"Register the host, discover benches, write the config.",[221,245,246,251],{},[236,247,248],{},[192,249,250],{},"run",[236,252,253],{},"The daemon loop. This is what systemd runs.",[221,255,256,261],{},[236,257,258],{},[192,259,260],{},"discover [--bench PATH]",[236,262,263],{},"Show what bench discovery finds.",[221,265,266,271],{},[236,267,268],{},[192,269,270],{},"check [--from-start] [--status] [--bench PATH]",[236,272,273,274,277],{},"Collect once and print the JSON payload. Nothing is sent. The watchdog state goes to stderr. ",[192,275,276],{},"--status"," also asks the site for its health.",[221,279,280,285],{},[236,281,282],{},[192,283,284],{},"doctor [--json] [--offline]",[236,286,287,288,199],{},"Check what this host gives the agent and what to fix: registration and the Wolf site, each log, bench, queue Redis and nginx log, the Pilot export, the auth log or journal, response actions, the daemon. Read-only. Exits 1 when a check fails. See ",[289,290,292],"a",{"href":291},"#check-a-host","Check a host",[221,294,295,300],{},[236,296,297],{},[192,298,299],{},"mark-deployment --bench NAME [--site S] [--note TEXT] [--silence 15m]",[236,301,302,303,306],{},"Put a deployment marker on the Wolf timeline. ",[192,304,305],{},"--silence"," also opens a maintenance window that mutes notifications for that bench or site.",[221,308,309,314],{},[236,310,311],{},[192,312,313],{},"test-fallback",[236,315,316,317,320],{},"Send a test message through the ",[289,318,319],{"href":76},"watchdog"," fallback channels.",[322,323,325],"h3",{"id":324},"deprecated","Deprecated",[188,327,328,329,332],{},"Press v1 support was removed in 0.2. Its options are still accepted, so old scripts and units keep\nworking: each prints ",[192,330,331],{},"removed in 0.2: ignored"," to stderr and does nothing.",[215,334,335,345],{},[218,336,337],{},[221,338,339,342],{},[224,340,341],{},"Option or command",[224,343,344],{},"Since 0.2",[231,346,347,369,382],{},[221,348,349,366],{},[236,350,351,354,355,358,359,362,363],{},[192,352,353],{},"--platform"," on ",[192,356,357],{},"register",", ",[192,360,361],{},"discover"," and ",[192,364,365],{},"check",[236,367,368],{},"Ignored: benches are discovered as usual.",[221,370,371,376],{},[236,372,373],{},[192,374,375],{},"mark-deployment --source press",[236,377,378,379,199],{},"Recorded as ",[192,380,381],{},"manual",[221,383,384,389],{},[236,385,386],{},[192,387,388],{},"refresh",[236,390,391],{},"Does nothing and exits 0.",[188,393,394,395,199],{},"A host still on Press v1 stays on ",[289,396,398],{"href":397},"\u002Fgetting-started#staying-on-v010","v0.1.0",[400,401,403],"h2",{"id":402},"mark-a-deployment","Mark a deployment",[405,406,412],"pre",{"className":407,"code":408,"filename":409,"language":410,"meta":411,"style":411},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo -u wolf-agent wolf-agent mark-deployment --bench frappe-bench --site erp.example.com \\\n  --note \"ERPNext v15.42 + custom app 2.3\" --silence 15m\n","deploy.sh","bash","",[192,413,414,451],{"__ignoreMap":411},[415,416,419,423,427,430,432,435,438,441,444,447],"span",{"class":417,"line":418},"line",1,[415,420,422],{"class":421},"sBMFI","sudo",[415,424,426],{"class":425},"sfazB"," -u",[415,428,429],{"class":425}," wolf-agent",[415,431,429],{"class":425},[415,433,434],{"class":425}," mark-deployment",[415,436,437],{"class":425}," --bench",[415,439,440],{"class":425}," frappe-bench",[415,442,443],{"class":425}," --site",[415,445,446],{"class":425}," erp.example.com",[415,448,450],{"class":449},"sTEyZ"," \\\n",[415,452,454,457,461,464,467,470],{"class":417,"line":453},2,[415,455,456],{"class":425},"  --note",[415,458,460],{"class":459},"sMK4o"," \"",[415,462,463],{"class":425},"ERPNext v15.42 + custom app 2.3",[415,465,466],{"class":459},"\"",[415,468,469],{"class":425}," --silence",[415,471,472],{"class":425}," 15m\n",[188,474,475,476,479,480,484,485,488,489,199],{},"The marker is a ",[192,477,478],{},"deployment"," event. Rules with ",[481,482,483],"strong",{},"Require recent deployment"," only fire after one,\nand incidents link to the latest deployment of their scope. Text passed with ",[192,486,487],{},"--note"," is sent as is,\nwithout ",[289,490,491],{"href":71},"scrubbing",[188,493,494,495,498],{},"Pilot tasks, and ",[192,496,497],{},"bench migrate"," on sites running the Wolf App, are marked by themselves.",[400,500,292],{"id":501},"check-a-host",[405,503,506],{"className":407,"code":504,"filename":505,"language":410,"meta":411,"style":411},"sudo -u wolf-agent wolf-agent doctor\n","host",[192,507,508],{"__ignoreMap":411},[415,509,510,512,514,516,518],{"class":417,"line":418},[415,511,422],{"class":421},[415,513,426],{"class":425},[415,515,429],{"class":425},[415,517,429],{"class":425},[415,519,520],{"class":425}," doctor\n",[188,522,523,524,358,527,358,530,533,534,537],{},"Run it as the agent's user: root can read what the daemon cannot, and would hide problems. Each line is ",[481,525,526],{},"ok",[481,528,529],{},"WARN",[481,531,532],{},"FAIL"," or ",[192,535,536],{},"--"," (for information), with the fix after a warning or a failure:",[405,539,544],{"className":540,"code":542,"language":543,"meta":411},[541],"language-text","logs\n  ok   18 log file(s) readable\n  --   9 not written yet (read once they appear): bench-1\u002Ffrappe.web.log ...\n\nplatform\n FAIL  Pilot wolf: cannot read \u002Fvar\u002Flib\u002Fwolf-pilot-export\u002Fwolf.json\n        fix: systemctl restart wolf-pilot-export.service (it sets the wolf-agent group)\n","text",[192,545,542],{"__ignoreMap":411},[188,547,548,549,552,553,556],{},"It checks the files the daemon would tail and the benches it works from, not only the config. ",[192,550,551],{},"--json"," prints the checks as a list, ",[192,554,555],{},"--offline"," skips the call to the Wolf site. Nothing is written, and it exits 1 when a check fails, so it can gate an install script.",[188,558,559,560,563,564,567,568,572],{},"The daemon runs the same checks every hour (",[192,561,562],{},"setup_checks",") and sends them with a push: the Wolf UI's ",[481,565,566],{},"Monitoring"," page shows each host's setup, its problems and their fixes, and the ",[569,570,571],"em",{},"Host setup problem"," preset opens an incident while a check fails.",[400,574,576],{"id":575},"see-the-payload","See the payload",[405,578,580],{"className":407,"code":579,"filename":505,"language":410,"meta":411,"style":411},"sudo -u wolf-agent wolf-agent check --from-start | jq '.events[] | {type, category, title}'\n",[192,581,582],{"__ignoreMap":411},[415,583,584,586,588,590,592,595,598,601,604,607,610],{"class":417,"line":418},[415,585,422],{"class":421},[415,587,426],{"class":425},[415,589,429],{"class":425},[415,591,429],{"class":425},[415,593,594],{"class":425}," check",[415,596,597],{"class":425}," --from-start",[415,599,600],{"class":459}," |",[415,602,603],{"class":421}," jq",[415,605,606],{"class":459}," '",[415,608,609],{"class":425},".events[] | {type, category, title}",[415,611,612],{"class":459},"'\n",[188,614,615,618,619,621],{},[192,616,617],{},"--from-start"," reads the logs from the beginning instead of the saved offsets, which is useful to\ntest a parser on an existing file. ",[192,620,365],{}," never sends anything and never moves the offsets.",[623,624,625],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}ht