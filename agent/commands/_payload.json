"\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":65,"body":214,"description":687,"extension":688,"links":689,"meta":690,"navigation":691,"path":66,"seo":692,"stem":67,"__hash__":693},"docs_en\u002F3.agent\u002F3.commands.md",{"type":215,"value":216,"toc":680},"minimark",[217,230,244,351,356,363,446,453,458,527,546,553,556,575,592,600,611,627,631,667,676],[218,219,220,221,225,226,229],"p",{},"Run commands as the ",[222,223,224],"code",{},"wolf-agent"," user, which owns the config:\n",[222,227,228],{},"sudo -u wolf-agent wolf-agent \u003Ccommand>",".",[218,231,232,233,236,237,240,241,229],{},"Global options: ",[222,234,235],{},"--config PATH"," (or ",[222,238,239],{},"$WOLF_AGENT_CONFIG","), ",[222,242,243],{},"-v",[245,246,247,260],"table",{},[248,249,250],"thead",{},[251,252,253,257],"tr",{},[254,255,256],"th",{},"Command",[254,258,259],{},"What it does",[261,262,263,274,284,294,308,323,337],"tbody",{},[251,264,265,271],{},[266,267,268],"td",{},[222,269,270],{},"register --url URL --token TOKEN [--bench PATH]...",[266,272,273],{},"Register the host, discover benches, write the config.",[251,275,276,281],{},[266,277,278],{},[222,279,280],{},"run",[266,282,283],{},"The daemon loop. This is what systemd runs.",[251,285,286,291],{},[266,287,288],{},[222,289,290],{},"discover [--bench PATH]",[266,292,293],{},"Show what bench discovery finds.",[251,295,296,301],{},[266,297,298],{},[222,299,300],{},"check [--from-start] [--status] [--bench PATH]",[266,302,303,304,307],{},"Collect once and print the JSON payload. Nothing is sent. The watchdog state goes to stderr. ",[222,305,306],{},"--status"," also asks the site for its health.",[251,309,310,315],{},[266,311,312],{},[222,313,314],{},"doctor [--json] [--offline]",[266,316,317,318,229],{},"Check what this host gives the agent and what to fix: registration and the Wolf site, each log, bench, queue Redis and nginx log, the Pilot export, the auth log or journal, response actions, the daemon. Read-only. Exits 1 when a check fails. See ",[319,320,322],"a",{"href":321},"#check-a-host","Check a host",[251,324,325,330],{},[266,326,327],{},[222,328,329],{},"mark-deployment --bench NAME [--site S] [--note TEXT] [--silence 15m]",[266,331,332,333,336],{},"Put a deployment marker on the Wolf timeline. ",[222,334,335],{},"--silence"," also opens a maintenance window that mutes notifications for that bench or site.",[251,338,339,344],{},[266,340,341],{},[222,342,343],{},"test-fallback",[266,345,346,347,350],{},"Send a test message through the ",[319,348,349],{"href":76},"watchdog"," fallback channels.",[352,353,355],"h3",{"id":354},"deprecated","Deprecated",[218,357,358,359,362],{},"Press v1 support and the host resource metrics were removed in 0.2. Their options are still\naccepted, so old scripts, units and configs keep working: each prints ",[222,360,361],{},"removed in 0.2: ignored","\nto stderr and does nothing.",[245,364,365,375],{},[248,366,367],{},[251,368,369,372],{},[254,370,371],{},"Option or command",[254,373,374],{},"Since 0.2",[261,376,377,399,412,422],{},[251,378,379,396],{},[266,380,381,384,385,388,389,392,393],{},[222,382,383],{},"--platform"," on ",[222,386,387],{},"register",", ",[222,390,391],{},"discover"," and ",[222,394,395],{},"check",[266,397,398],{},"Ignored: benches are discovered as usual.",[251,400,401,406],{},[266,402,403],{},[222,404,405],{},"mark-deployment --source press",[266,407,408,409,229],{},"Recorded as ",[222,410,411],{},"manual",[251,413,414,419],{},[266,415,416],{},[222,417,418],{},"refresh",[266,420,421],{},"Does nothing and exits 0.",[251,423,424,430],{},[266,425,426,429],{},[222,427,428],{},"collect_host_metrics"," in the config",[266,431,432,433,435,436,438,439,442,443,445],{},"Ignored: the agent no longer measures host resources. ",[222,434,280],{}," logs the warning, ",[222,437,395],{}," prints it to stderr, ",[222,440,441],{},"doctor"," lists it, ",[222,444,387],{}," drops the key.",[218,447,448,449,229],{},"A host still on Press v1 stays on ",[319,450,452],{"href":451},"\u002Fgetting-started#staying-on-v010","v0.1.0",[454,455,457],"h2",{"id":456},"mark-a-deployment","Mark a deployment",[459,460,466],"pre",{"className":461,"code":462,"filename":463,"language":464,"meta":465,"style":465},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo -u wolf-agent wolf-agent mark-deployment --bench frappe-bench --site erp.example.com \\\n  --note \"ERPNext v15.42 + custom app 2.3\" --silence 15m\n","deploy.sh","bash","",[222,467,468,505],{"__ignoreMap":465},[469,470,473,477,481,484,486,489,492,495,498,501],"span",{"class":471,"line":472},"line",1,[469,474,476],{"class":475},"sBMFI","sudo",[469,478,480],{"class":479},"sfazB"," -u",[469,482,483],{"class":479}," wolf-agent",[469,485,483],{"class":479},[469,487,488],{"class":479}," mark-deployment",[469,490,491],{"class":479}," --bench",[469,493,494],{"class":479}," frappe-bench",[469,496,497],{"class":479}," --site",[469,499,500],{"class":479}," erp.example.com",[469,502,504],{"class":503},"sTEyZ"," \\\n",[469,506,508,511,515,518,521,524],{"class":471,"line":507},2,[469,509,510],{"class":479},"  --note",[469,512,514],{"class":513},"sMK4o"," \"",[469,516,517],{"class":479},"ERPNext v15.42 + custom app 2.3",[469,519,520],{"class":513},"\"",[469,522,523],{"class":479}," --silence",[469,525,526],{"class":479}," 15m\n",[218,528,529,530,533,534,538,539,542,543,229],{},"The marker is a ",[222,531,532],{},"deployment"," event. Rules with ",[535,536,537],"strong",{},"Require recent deployment"," only fire after one,\nand incidents link to the latest deployment of their scope. Text passed with ",[222,540,541],{},"--note"," is sent as is,\nwithout ",[319,544,545],{"href":71},"scrubbing",[218,547,548,549,552],{},"Pilot tasks, and ",[222,550,551],{},"bench migrate"," on sites running the Wolf App, are marked by themselves.",[454,554,322],{"id":555},"check-a-host",[459,557,560],{"className":461,"code":558,"filename":559,"language":464,"meta":465,"style":465},"sudo -u wolf-agent wolf-agent doctor\n","host",[222,561,562],{"__ignoreMap":465},[469,563,564,566,568,570,572],{"class":471,"line":472},[469,565,476],{"class":475},[469,567,480],{"class":479},[469,569,483],{"class":479},[469,571,483],{"class":479},[469,573,574],{"class":479}," doctor\n",[218,576,577,578,388,581,388,584,587,588,591],{},"Run it as the agent's user: root can read what the daemon cannot, and would hide problems. Each line is ",[535,579,580],{},"ok",[535,582,583],{},"WARN",[535,585,586],{},"FAIL"," or ",[222,589,590],{},"--"," (for information), with the fix after a warning or a failure:",[459,593,598],{"className":594,"code":596,"language":597,"meta":465},[595],"language-text","logs\n  ok   18 log file(s) readable\n  --   9 not written yet (read once they appear): bench-1\u002Ffrappe.web.log ...\n\nplatform\n FAIL  Pilot wolf: cannot read \u002Fvar\u002Flib\u002Fwolf-pilot-export\u002Fwolf.json\n        fix: systemctl restart wolf-pilot-export.service (it sets the wolf-agent group)\n","text",[222,599,596],{"__ignoreMap":465},[218,601,602,603,606,607,610],{},"It checks the files the daemon would tail and the benches it works from, not only the config. ",[222,604,605],{},"--json"," prints the checks as a list, ",[222,608,609],{},"--offline"," skips the call to the Wolf site. Nothing is written, and it exits 1 when a check fails, so it can gate an install script.",[218,612,613,614,617,618,621,622,626],{},"The daemon runs the same checks every hour (",[222,615,616],{},"setup_checks",") and sends them with a push: the Wolf UI's ",[535,619,620],{},"Monitoring"," page shows each host's setup, its problems and their fixes, and the ",[623,624,625],"em",{},"Host setup problem"," preset opens an incident while a check fails.",[454,628,630],{"id":629},"see-the-payload","See the payload",[459,632,634],{"className":461,"code":633,"filename":559,"language":464,"meta":465,"style":465},"sudo -u wolf-agent wolf-agent check --from-start | jq '.events[] | {type, category, title}'\n",[222,635,636],{"__ignoreMap":465},[469,637,638,640,642,644,646,649,652,655,658,661,664],{"class":471,"line":472},[469,639,476],{"class":475},[469,641,480],{"class":479},[469,643,483],{"class":479},[469,645,483],{"class":479},[469,647,648],{"class":479}," check",[469,650,651],{"class":479}," --from-start",[469,653,654],{"class":513}," |",[469,656,657],{"class":475}," jq",[469,659,660],{"class":513}," '",[469,662,663],{"class":479},".events[] | {type, category, title}",[469,665,666],{"class":513},"'\n",[218,668,669,672,673,675],{},[222,670,671],{},"--from-start"," reads the logs from the beginning instead of the saved offsets, which is useful to\ntest a parser on an existing file. ",[222,674,395],{}," never sends anything and never moves the offsets.",[677,678,679],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":465,"searchDepth":472,"depth":507,"links":681},[682,684,685,686],{"id":354,"depth":683,"text":355},3,{"id":456,"depth":507,"text":457},{"id":555,"depth":507,"text":322},{"id":629,"depth":507,"text":630},"The wolf-agent command line.","md",null,{},{"icon":68},{"title":65,"description":687},"pbgHiXTKgsCEyO4EaAeb39el6fZ1rcCXJmhLX4WeaYM",[695,697],{"title":60,"path":61,"stem":62,"description":696,"icon":63},"The agent's config.json, key by key.",{"title":70,"path":71,"stem":72,"description":698,"icon":73},"How the agent removes personal data and secrets from events before they leave the host.",1795111376642]