"\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":65,"body":214,"description":663,"extension":664,"links":665,"meta":666,"navigation":667,"path":66,"seo":668,"stem":67,"__hash__":669},"docs_en\u002F3.agent\u002F3.commands.md",{"type":215,"value":216,"toc":656},"minimark",[217,230,244,351,356,363,422,429,434,503,522,529,532,551,568,576,587,603,607,643,652],[218,219,220,221,225,226,229],"p",{},"Run commands as the ",[222,223,224],"code",{},"wolf-agent"," user, which owns the config:\n",[222,227,228],{},"sudo -u wolf-agent wolf-agent \u003Ccommand>",".",[218,231,232,233,236,237,240,241,229],{},"Global options: ",[222,234,235],{},"--config PATH"," (or ",[222,238,239],{},"$WOLF_AGENT_CONFIG","), ",[222,242,243],{},"-v",[245,246,247,260],"table",{},[248,249,250],"thead",{},[251,252,253,257],"tr",{},[254,255,256],"th",{},"Command",[254,258,259],{},"What it does",[261,262,263,274,284,294,308,323,337],"tbody",{},[251,264,265,271],{},[266,267,268],"td",{},[222,269,270],{},"register --url URL --token TOKEN [--bench PATH]...",[266,272,273],{},"Register the host, discover benches, write the config.",[251,275,276,281],{},[266,277,278],{},[222,279,280],{},"run",[266,282,283],{},"The daemon loop. This is what systemd runs.",[251,285,286,291],{},[266,287,288],{},[222,289,290],{},"discover [--bench PATH]",[266,292,293],{},"Show what bench discovery finds.",[251,295,296,301],{},[266,297,298],{},[222,299,300],{},"check [--from-start] [--status] [--bench PATH]",[266,302,303,304,307],{},"Collect once and print the JSON payload. Nothing is sent. The watchdog state goes to stderr. ",[222,305,306],{},"--status"," also asks the site for its health.",[251,309,310,315],{},[266,311,312],{},[222,313,314],{},"doctor [--json] [--offline]",[266,316,317,318,229],{},"Check what this host gives the agent and what to fix: registration and the Wolf site, each log, bench, queue Redis and nginx log, the Pilot export, the auth log or journal, response actions, the daemon. Read-only. Exits 1 when a check fails. See ",[319,320,322],"a",{"href":321},"#check-a-host","Check a host",[251,324,325,330],{},[266,326,327],{},[222,328,329],{},"mark-deployment --bench NAME [--site S] [--note TEXT] [--silence 15m]",[266,331,332,333,336],{},"Put a deployment marker on the Wolf timeline. ",[222,334,335],{},"--silence"," also opens a maintenance window that mutes notifications for that bench or site.",[251,338,339,344],{},[266,340,341],{},[222,342,343],{},"test-fallback",[266,345,346,347,350],{},"Send a test message through the ",[319,348,349],{"href":76},"watchdog"," fallback channels.",[352,353,355],"h3",{"id":354},"deprecated","Deprecated",[218,357,358,359,362],{},"Press v1 support was removed in 0.2. Its options are still accepted, so old scripts and units keep\nworking: each prints ",[222,360,361],{},"removed in 0.2: ignored"," to stderr and does nothing.",[245,364,365,375],{},[248,366,367],{},[251,368,369,372],{},[254,370,371],{},"Option or command",[254,373,374],{},"Since 0.2",[261,376,377,399,412],{},[251,378,379,396],{},[266,380,381,384,385,388,389,392,393],{},[222,382,383],{},"--platform"," on ",[222,386,387],{},"register",", ",[222,390,391],{},"discover"," and ",[222,394,395],{},"check",[266,397,398],{},"Ignored: benches are discovered as usual.",[251,400,401,406],{},[266,402,403],{},[222,404,405],{},"mark-deployment --source press",[266,407,408,409,229],{},"Recorded as ",[222,410,411],{},"manual",[251,413,414,419],{},[266,415,416],{},[222,417,418],{},"refresh",[266,420,421],{},"Does nothing and exits 0.",[218,423,424,425,229],{},"A host still on Press v1 stays on ",[319,426,428],{"href":427},"\u002Fgetting-started#staying-on-v010","v0.1.0",[430,431,433],"h2",{"id":432},"mark-a-deployment","Mark a deployment",[435,436,442],"pre",{"className":437,"code":438,"filename":439,"language":440,"meta":441,"style":441},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo -u wolf-agent wolf-agent mark-deployment --bench frappe-bench --site erp.example.com \\\n  --note \"ERPNext v15.42 + custom app 2.3\" --silence 15m\n","deploy.sh","bash","",[222,443,444,481],{"__ignoreMap":441},[445,446,449,453,457,460,462,465,468,471,474,477],"span",{"class":447,"line":448},"line",1,[445,450,452],{"class":451},"sBMFI","sudo",[445,454,456],{"class":455},"sfazB"," -u",[445,458,459],{"class":455}," wolf-agent",[445,461,459],{"class":455},[445,463,464],{"class":455}," mark-deployment",[445,466,467],{"class":455}," --bench",[445,469,470],{"class":455}," frappe-bench",[445,472,473],{"class":455}," --site",[445,475,476],{"class":455}," erp.example.com",[445,478,480],{"class":479},"sTEyZ"," \\\n",[445,482,484,487,491,494,497,500],{"class":447,"line":483},2,[445,485,486],{"class":455},"  --note",[445,488,490],{"class":489},"sMK4o"," \"",[445,492,493],{"class":455},"ERPNext v15.42 + custom app 2.3",[445,495,496],{"class":489},"\"",[445,498,499],{"class":455}," --silence",[445,501,502],{"class":455}," 15m\n",[218,504,505,506,509,510,514,515,518,519,229],{},"The marker is a ",[222,507,508],{},"deployment"," event. Rules with ",[511,512,513],"strong",{},"Require recent deployment"," only fire after one,\nand incidents link to the latest deployment of their scope. Text passed with ",[222,516,517],{},"--note"," is sent as is,\nwithout ",[319,520,521],{"href":71},"scrubbing",[218,523,524,525,528],{},"Pilot tasks, and ",[222,526,527],{},"bench migrate"," on sites running the Wolf App, are marked by themselves.",[430,530,322],{"id":531},"check-a-host",[435,533,536],{"className":437,"code":534,"filename":535,"language":440,"meta":441,"style":441},"sudo -u wolf-agent wolf-agent doctor\n","host",[222,537,538],{"__ignoreMap":441},[445,539,540,542,544,546,548],{"class":447,"line":448},[445,541,452],{"class":451},[445,543,456],{"class":455},[445,545,459],{"class":455},[445,547,459],{"class":455},[445,549,550],{"class":455}," doctor\n",[218,552,553,554,388,557,388,560,563,564,567],{},"Run it as the agent's user: root can read what the daemon cannot, and would hide problems. Each line is ",[511,555,556],{},"ok",[511,558,559],{},"WARN",[511,561,562],{},"FAIL"," or ",[222,565,566],{},"--"," (for information), with the fix after a warning or a failure:",[435,569,574],{"className":570,"code":572,"language":573,"meta":441},[571],"language-text","logs\n  ok   18 log file(s) readable\n  --   9 not written yet (read once they appear): bench-1\u002Ffrappe.web.log ...\n\nplatform\n FAIL  Pilot wolf: cannot read \u002Fvar\u002Flib\u002Fwolf-pilot-export\u002Fwolf.json\n        fix: systemctl restart wolf-pilot-export.service (it sets the wolf-agent group)\n","text",[222,575,572],{"__ignoreMap":441},[218,577,578,579,582,583,586],{},"It checks the files the daemon would tail and the benches it works from, not only the config. ",[222,580,581],{},"--json"," prints the checks as a list, ",[222,584,585],{},"--offline"," skips the call to the Wolf site. Nothing is written, and it exits 1 when a check fails, so it can gate an install script.",[218,588,589,590,593,594,597,598,602],{},"The daemon runs the same checks every hour (",[222,591,592],{},"setup_checks",") and sends them with a push: the Wolf UI's ",[511,595,596],{},"Monitoring"," page shows each host's setup, its problems and their fixes, and the ",[599,600,601],"em",{},"Host setup problem"," preset opens an incident while a check fails.",[430,604,606],{"id":605},"see-the-payload","See the payload",[435,608,610],{"className":437,"code":609,"filename":535,"language":440,"meta":441,"style":441},"sudo -u wolf-agent wolf-agent check --from-start | jq '.events[] | {type, category, title}'\n",[222,611,612],{"__ignoreMap":441},[445,613,614,616,618,620,622,625,628,631,634,637,640],{"class":447,"line":448},[445,615,452],{"class":451},[445,617,456],{"class":455},[445,619,459],{"class":455},[445,621,459],{"class":455},[445,623,624],{"class":455}," check",[445,626,627],{"class":455}," --from-start",[445,629,630],{"class":489}," |",[445,632,633],{"class":451}," jq",[445,635,636],{"class":489}," '",[445,638,639],{"class":455},".events[] | {type, category, title}",[445,641,642],{"class":489},"'\n",[218,644,645,648,649,651],{},[222,646,647],{},"--from-start"," reads the logs from the beginning instead of the saved offsets, which is useful to\ntest a parser on an existing file. ",[222,650,395],{}," never sends anything and never moves the offsets.",[653,654,655],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":441,"searchDepth":448,"depth":483,"links":657},[658,660,661,662],{"id":354,"depth":659,"text":355},3,{"id":432,"depth":483,"text":433},{"id":531,"depth":483,"text":322},{"id":605,"depth":483,"text":606},"The wolf-agent command line.","md",null,{},{"icon":68},{"title":65,"description":663},"6sB7XiVtlDr3TZzFWCV4uXAtos5K35Efz_KXdDEkPc4",[671,673],{"title":60,"path":61,"stem":62,"description":672,"icon":63},"The agent's config.json, key by key.",{"title":70,"path":71,"stem":72,"description":674,"icon":73},"How the agent removes personal data and secrets from events before they leave the host.",1795107942851]