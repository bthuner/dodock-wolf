lf","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":55,"body":214,"description":1160,"extension":1161,"links":1162,"meta":1163,"navigation":1164,"path":56,"seo":1165,"stem":57,"__hash__":1166},"docs_en\u002F3.agent\u002F1.collected.md",{"type":215,"value":216,"toc":1142},"minimark",[217,231,236,277,288,292,307,368,377,381,394,401,416,420,456,547,551,557,637,644,648,667,671,689,709,713,723,774,788,792,818,822,966,971,975,978,1011,1015,1018,1050,1115,1119],[218,219,220,221,225,226,230],"p",{},"Run ",[222,223,224],"code",{},"wolf-agent check"," to see the exact payload on your host. Each check below can be turned off or\ntuned in the ",[227,228,229],"a",{"href":61},"configuration",".",[232,233,235],"h2",{"id":234},"host","Host",[237,238,239,252],"table",{},[240,241,242],"thead",{},[243,244,245,249],"tr",{},[246,247,248],"th",{},"Metric",[246,250,251],{},"Notes",[253,254,255],"tbody",{},[243,256,257,267],{},[258,259,260,263,264],"td",{},[222,261,262],{},"agent_setup_failed",", ",[222,265,266],{},"agent_setup_warnings",[258,268,269,270,276],{},"every hour: the failures and warnings of the agent's own ",[227,271,273],{"href":272},"\u002Fagent\u002Fcommands#check-a-host",[222,274,275],{},"wolf-agent doctor"," run, listed on the Monitoring page",[218,278,279,280,283,284,230],{},"The agent does not measure the host's resources (CPU, memory, swap, disk, load): Frappe Cloud v2\nand ",[227,281,282],{"href":46},"Pilot"," report them. See ",[227,285,287],{"href":286},"#upgrading-from-01","Upgrading from 0.1",[232,289,291],{"id":290},"bench-logs","Bench logs",[218,293,294,295,298,299,302,303,306],{},"From ",[222,296,297],{},"\u003Cbench>\u002Flogs\u002F",", and the site-scoped ",[222,300,301],{},"sites\u002F\u003Csite>\u002Flogs\u002Ffrappe.web.log"," and ",[222,304,305],{},"scheduler.log",":",[237,308,309,319],{},[240,310,311],{},[243,312,313,316],{},[246,314,315],{},"Log",[246,317,318],{},"Becomes",[253,320,321,340,352],{},[243,322,323,334],{},[258,324,325,263,328,263,331],{},[222,326,327],{},"frappe.web.log",[222,329,330],{},"web.error.log",[222,332,333],{},"bench.log",[258,335,336,339],{},[222,337,338],{},"error"," events with the traceback",[243,341,342,346],{},[258,343,344],{},[222,345,305],{},[258,347,348,351],{},[222,349,350],{},"cron_failure"," events for failed scheduled jobs",[243,353,354,362],{},[258,355,356,263,359],{},[222,357,358],{},"worker.log",[222,360,361],{},"worker.error.log",[258,363,364,367],{},[222,365,366],{},"worker_failure"," events: worker crashes, OOM kills, failed jobs",[369,370,371],"note",{},[218,372,373,374,230],{},"Frappe logs \"Scheduled Job Failed\" at INFO, which the default logger drops. To catch every failing\ncron, also install the app on each site as a ",[227,375,376],{"href":41},"satellite",[232,378,380],{"id":379},"nginx-access-log","nginx access log",[218,382,383,384,263,387,263,390,393],{},"Per site and per minute of the log line's own time: ",[222,385,386],{},"http_requests",[222,388,389],{},"http_5xx",[222,391,392],{},"http_502",", plus\none aggregated event per (site, status, route) and minute. Each sample is stamped with the newest\nline of its minute, so a backlog read at once (after a restart or a rotation) lands in the minutes\nit happened, not as one spike when the agent reads it. A known site with no traffic reports zeros.",[218,395,396,397,400],{},"The site comes from ",[222,398,399],{},"$host"," when the log format includes it (a leading vhost field or a trailing\nquoted field), else from a per-site log file name, else the bench's only site.",[218,402,403,404,407,408,411,412,415],{},"The same lines feed ",[227,405,406],{"href":125},"web attack detection",": probes for secrets, admin panels,\ntraversal and injections become ",[222,409,410],{},"web_attack_probe"," events, and a secret-bearing file answered with\na 2xx becomes a critical ",[222,413,414],{},"web_sensitive_file_exposed"," event.",[232,417,419],{"id":418},"auth-log","Auth log",[218,421,294,422,263,425,428,429,432,433,263,436,263,439,442,443,263,446,263,449,263,452,455],{},[222,423,424],{},"\u002Fvar\u002Flog\u002Fauth.log",[222,426,427],{},"\u002Fvar\u002Flog\u002Fsecure",", or ",[222,430,431],{},"journalctl"," (",[222,434,435],{},"sshd",[222,437,438],{},"sshd-session",[222,440,441],{},"sudo",",\n",[222,444,445],{},"useradd",[222,447,448],{},"usermod",[222,450,451],{},"gpasswd",[222,453,454],{},"chsh","):",[237,457,458,468],{},[240,459,460],{},[243,461,462,465],{},[246,463,464],{},"Signal",[246,466,467],{},"Event",[253,469,470,480,491,501,516],{},[243,471,472,475],{},[258,473,474],{},"failed SSH logins, aggregated per source IP and minute of log time; root logins",[258,476,477],{},[222,478,479],{},"security",[243,481,482,485],{},[258,483,484],{},"a successful login from an address that failed 5+ times in the hour before",[258,486,487,490],{},[222,488,489],{},"ssh_login_after_failures"," (critical)",[243,492,493,496],{},[258,494,495],{},"failed sudo attempts, users outside sudoers",[258,497,498],{},[222,499,500],{},"sudo_failure",[243,502,503,506],{},[258,504,505],{},"new local accounts",[258,507,508,511,512,515],{},[222,509,510],{},"account_created","; a package's service account (system UID, no login shell): ",[222,513,514],{},"service_account_created"," (info)",[243,517,518,542],{},[258,519,520,521,263,523,263,526,263,529,263,532,263,535,538,539],{},"a user added to ",[222,522,441],{},[222,524,525],{},"wheel",[222,527,528],{},"admin",[222,530,531],{},"root",[222,533,534],{},"adm",[222,536,537],{},"docker"," or ",[222,540,541],{},"lxd",[258,543,544,490],{},[222,545,546],{},"admin_group_change",[232,548,550],{"id":549},"redis-and-rq","Redis and RQ",[218,552,553,554,455],{},"From the bench's queue Redis (",[222,555,556],{},"redis_queue",[237,558,559,568],{},[240,560,561],{},[243,562,563,565],{},[246,564,248],{},[246,566,567],{},"Meaning",[253,569,570,584,597,611,621],{},[243,571,572,577],{},[258,573,574],{},[222,575,576],{},"queue_length",[258,578,579,580,583],{},"length of every ",[222,581,582],{},"rq:queue:*"," list",[243,585,586,594],{},[258,587,588,263,591],{},[222,589,590],{},"rq_failed_jobs",[222,592,593],{},"rq_failed_jobs_added",[258,595,596],{},"failed-job registry size, and its increase per push",[243,598,599,604],{},[258,600,601],{},[222,602,603],{},"rq_long_running_jobs",[258,605,606,607,610],{},"started jobs older than ",[222,608,609],{},"rq.long_job_minutes"," (30)",[243,612,613,618],{},[258,614,615],{},[222,616,617],{},"rq_workers",[258,619,620],{},"live workers",[243,622,623,631],{},[258,624,625,263,628],{},[222,626,627],{},"redis_used_memory_percent",[222,629,630],{},"redis_evicted_keys",[258,632,633,634],{},"from ",[222,635,636],{},"INFO",[218,638,639,640,643],{},"Only the queue Redis is watched. The cache Redis is an LRU cache by design (",[222,641,642],{},"allkeys-lru","), so a\nfull cache and evictions are normal there.",[232,645,647],{"id":646},"backups","Backups",[218,649,650,653,654,657,658,662,663,666],{},[222,651,652],{},"backup_age_hours"," per site, from the newest ",[222,655,656],{},"sites\u002F\u003Csite>\u002Fprivate\u002Fbackups\u002F*-database.sql*",", every\n10 minutes. A site that never had a backup sends nothing, so ",[659,660,661],"em",{},"No backup for 26 h"," cannot fire for it.\nOffsite-only setups can point ",[222,664,665],{},"backups.dirs"," at a mounted directory per site.",[232,668,670],{"id":669},"tls-certificates","TLS certificates",[218,672,673,676,677,680,681,684,685,688],{},[222,674,675],{},"tls_days_left"," for every public site name and custom domain (",[222,678,679],{},"site_config.json"," ",[222,682,683],{},"domains","), every\nhour, in a background thread. The agent connects to ",[222,686,687],{},"\u003Cdomain>:443"," with SNI and reads the leaf\ncertificate without verifying it, so expired and self-signed certificates are measured too.",[218,690,691,692,263,695,263,698,263,701,704,705,708],{},"Skipped: ",[222,693,694],{},"localhost",[222,696,697],{},"*.localhost",[222,699,700],{},".local",[222,702,703],{},".test",", bare names, IP addresses and the ",[222,706,707],{},"example.*","\nnames. Unreachable domains are logged and skipped.",[232,710,712],{"id":711},"mariadb","MariaDB",[218,714,715,716,718,719,722],{},"Through the ",[222,717,711],{}," (or ",[222,720,721],{},"mysql",") client, with a site's own credentials written to a private\ntemporary option file, never on the command line:",[237,724,725,733],{},[240,726,727],{},[243,728,729,731],{},[246,730,248],{},[246,732,567],{},[253,734,735,751,761],{},[243,736,737,745],{},[258,738,739,263,742],{},[222,740,741],{},"db_threads_connected",[222,743,744],{},"db_connections_used_percent",[258,746,747,748],{},"against ",[222,749,750],{},"max_connections",[243,752,753,758],{},[258,754,755],{},[222,756,757],{},"db_slow_queries",[258,759,760],{},"increase per push",[243,762,763,771],{},[258,764,765,263,768],{},[222,766,767],{},"db_replication_lag_seconds",[222,769,770],{},"db_replication_running",[258,772,773],{},"on a replica",[218,775,776,777,780,781,538,784,787],{},"A site user may not read replica status (REPLICATION CLIENT \u002F SLAVE MONITOR). Then replication is\nskipped, unless ",[222,778,779],{},"mariadb.user"," \u002F ",[222,782,783],{},"password",[222,785,786],{},"mariadb.defaults_file"," names a monitoring user.\nWithout a client on the host, or for Postgres benches, nothing is sent.",[232,789,791],{"id":790},"processes","Processes",[218,793,294,794,797,798,801,802,805,806,809,810,812,813,780,815,415],{},[222,795,796],{},"supervisorctl status",", else ",[222,799,800],{},"systemctl list-units"," for units whose name contains the bench name.\n",[222,803,804],{},"bench_processes_down"," per bench counts processes that are STOPPED, EXITED, BACKOFF, FATAL or\nUNKNOWN (systemd: ",[222,807,808],{},"failed"," or a restart loop). A process entering FATAL \u002F UNKNOWN (systemd ",[222,811,808],{},")\nalso sends one ",[222,814,366],{},[222,816,817],{},"process_down",[232,819,821],{"id":820},"security-posture","Security posture",[237,823,824,837],{},[240,825,826],{},[243,827,828,831,834],{},[246,829,830],{},"Check",[246,832,833],{},"Every",[246,835,836],{},"Sends",[253,838,839,860,879,912,939],{},[243,840,841,847,850],{},[258,842,843],{},[844,845,846],"strong",{},"App versions",[258,848,849],{},"1 h",[258,851,852,855,856,859],{},[222,853,854],{},"app_version"," per bench and app, from ",[222,857,858],{},"apps\u002F\u003Capp>\u002F\u003Capp>\u002F__init__.py",". The Wolf site compares them with the GitHub Security Advisories of Frappe and ERPNext. Development versions are not sent.",[243,861,862,867,869],{},[258,863,864],{},[844,865,866],{},"Site settings",[258,868,849],{},[258,870,871,874,875,878],{},[222,872,873],{},"site_setting"," per site: two-factor authentication, password policy and minimum score, lockout, guest uploads, and the System Manager role's two-factor flag. Feeds the ",[227,876,877],{"href":140},"security score"," of sites other than the Wolf site.",[243,880,881,886,889],{},[258,882,883],{},[844,884,885],{},"Exposure",[258,887,888],{},"10 min",[258,890,891,894,895,898,899,263,902,905,906,263,909,230],{},[222,892,893],{},"exposed_services"," per host: bench ports listening beyond loopback (MariaDB 3306, Postgres 5432, Redis, socket.io 9000, gunicorn). ",[222,896,897],{},"site_config_risks"," per site: ",[222,900,901],{},"developer_mode",[222,903,904],{},"allow_tests",", a plain-HTTP ",[222,907,908],{},"host_name",[222,910,911],{},"allow_cors: \"*\"",[243,913,914,919,922],{},[258,915,916],{},[844,917,918],{},"File integrity",[258,920,921],{},"15 min",[258,923,924,927,928,302,931,934,935,230],{},[222,925,926],{},"integrity_files"," per bench; ",[222,929,930],{},"bench_code_changed",[222,932,933],{},"bench_config_changed"," events when an app's code, a site config or the nginx and supervisor config changes, telling a deployment from a change outside one. See ",[227,936,938],{"href":937},"\u002Fsecurity\u002Fdetection#file-integrity","Detection",[243,940,941,946,949],{},[258,942,943],{},[844,944,945],{},"Outbound connections",[258,947,948],{},"1 min",[258,950,951,954,955,958,959,962,963,230],{},[222,952,953],{},"bench_outbound_destinations"," per bench; a ",[222,956,957],{},"bench_new_outbound"," event for each public network and unusual port a bench's user had never used, after a 7-day learning period; ",[222,960,961],{},"bench_new_outbound_usual"," counts new ones on usual ports. See ",[227,964,938],{"href":965},"\u002Fsecurity\u002Fdetection#outbound-connections",[218,967,968,969,230],{},"See ",[227,970,938],{"href":125},[232,972,974],{"id":973},"optional-sources","Optional sources",[218,976,977],{},"When present on the host, the agent also tails:",[979,980,981,997],"ul",{},[982,983,984,987,988,992,993,996],"li",{},[844,985,986],{},"Suricata","'s EVE log, found from Suricata itself (",[227,989,991],{"href":990},"\u002Fsecurity\u002Fwazuh-suricata#turn-it-on","how","): ",[222,994,995],{},"network_ids_alert"," events;",[982,998,999,1002,1003,1006,1007,1010],{},[844,1000,1001],{},"Wazuh","'s ",[222,1004,1005],{},"alerts.json"," on the manager: ",[222,1008,1009],{},"hids_alert"," events.",[218,1012,968,1013,230],{},[227,1014,148],{"href":149},[232,1016,287],{"id":1017},"upgrading-from-01",[218,1019,1020,1021,263,1024,442,1027,263,1030,263,1033,263,1036,263,1039,302,1042,1045,1046,230],{},"The host resource metrics were removed in 0.2: ",[222,1022,1023],{},"cpu_usage",[222,1025,1026],{},"memory_used_percent",[222,1028,1029],{},"swap_used_percent",[222,1031,1032],{},"disk_used_percent",[222,1034,1035],{},"load_1m",[222,1037,1038],{},"load_5m",[222,1040,1041],{},"load_15m",[222,1043,1044],{},"load_per_core",".\nRead host resources in Frappe Cloud v2 or Pilot, or stay on ",[227,1047,1049],{"href":1048},"\u002Fgetting-started#staying-on-v010","v0.1.0",[979,1051,1052,1068,1084,1094,1102,1105],{},[982,1053,1054,1055,442,1058,263,1061,302,1064,1067],{},"The upgrade disables the enabled alert rules on these metrics, and the presets ",[659,1056,1057],{},"Disk almost full",[659,1059,1060],{},"High CPU",[659,1062,1063],{},"High memory",[659,1065,1066],{},"High load",", with a comment on each saying why. They are not\ndeleted. A rule you had disabled yourself is left as it is, without a comment.",[982,1069,1070,1071,1075,1076,1079,1080,1083],{},"The open incidents of these rules, enabled or disabled, are resolved, since nothing evaluates them\nany more. Each resolution is recorded in the ",[227,1072,1074],{"href":1073},"\u002Fsecurity\u002Fjournal#tamper-evident-journal","journal",".\n",[844,1077,1078],{},"PagerDuty"," channels hear about it, so the alert closes on call too; the other channels stay\nquiet, even with ",[844,1081,1082],{},"Notify On Resolve",": an upgrade pages nobody.",[982,1085,1086,1087,1090,1091,230],{},"It deletes the stored samples and rollups of these metrics, and records what it did in an\n",[844,1088,1089],{},"Error Log"," titled ",[659,1092,1093],{},"Dodock Wolf 0.2: host resource metrics removed",[982,1095,1096,1097,1101],{},"A rule on one of these metrics can no longer be enabled, in the form or through a\n",[227,1098,1100],{"href":1099},"\u002Falerts\u002Frules#rules-as-yaml","YAML import",": choose another metric. A disabled one stays, with its history.",[982,1103,1104],{},"A v0.1 agent still sends these metrics until you upgrade it: the Wolf site drops them without an\nerror.",[982,1106,1107,1108,1111,1112,1114],{},"The ",[222,1109,1110],{},"collect_host_metrics"," key of a v0.1 config is ignored, with a warning (see\n",[227,1113,60],{"href":61},").",[232,1116,1118],{"id":1117},"delivery-guarantees","Delivery guarantees",[979,1120,1121,1128,1135],{},[982,1122,1123,1124,1127],{},"Logs are read from the end on first start. Offsets are kept in\n",[222,1125,1126],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Ftail-state.json",", so restarts and log rotation lose nothing.",[982,1129,1130,1131,1134],{},"Failed pushes are spooled to ",[222,1132,1133],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Foutbox\u002F"," (capped at 50 MB) and replayed in\norder with exponential backoff.",[982,1136,1137,1138,1141],{},"Events are ",[227,1139,1140],{"href":71},"scrubbed"," of e-mail addresses, credentials, card numbers and IBANs\nbefore they are spooled.",{"title":1143,"searchDepth":1144,"depth":1145,"links":1146},"",1,2,[1147,1148,1149,1150,1151,1152,1153,1154,1155,1156,1157,1158,1159],{"id":234,"depth":1145,"text":235},{"id":290,"depth":1145,"text":291},{"id":379,"depth":1145,"text":380},{"id":418,"depth":1145,"text":419},{"id":549,"depth":1145,"text":550},{"id":646,"depth":1145,"text":647},{"id":669,"depth":1145,"text":670},{"id":711,"depth":1145,"text":712},{"id":790,"depth":1145,"text":791},{"id":820,"depth":1145,"text":821},{"id":973,"depth":1145,"text":974},{"id":1017,"depth":1145,"text":287},{"id":1117,"depth":1145,"text":1118},"Every metric and event the Wolf Agent sends, and where it reads it.","md",null,{},{"icon":58},{"title":55,"description":1160},"S4HPMkE0ymzrfd4HxspRgLsSyFw07P-nuXfeoFxsBvQ",[1168,1170],{"title":45,"path":46,"stem":47,"description":1169,"icon":48},"Run the Wolf Agent on a Frappe Pilot host and turn Pilot tasks into deployment events.",{"title":60,"path":61,"stem":62,"description":1171,"icon":63},"The agent's config.json, key by key.",1795111376354]