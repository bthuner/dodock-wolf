ed jobs",[381,382,383],"note",{},[198,384,385,386,210],{},"Frappe logs \"Scheduled Job Failed\" at INFO, which the default logger drops. To catch every failing\ncron, also install the app on each site as a ",[207,387,388],{"href":41},"satellite",[212,390,392],{"id":391},"nginx-access-log","nginx access log",[198,394,395,396,264,399,264,402,405],{},"Per site and per minute of the log line's own time: ",[202,397,398],{},"http_requests",[202,400,401],{},"http_5xx",[202,403,404],{},"http_502",", plus\none aggregated event per (site, status, route) and minute. Each sample is stamped with the newest\nline of its minute, so a backlog read at once (after a restart or a rotation) lands in the minutes\nit happened, not as one spike when the agent reads it. A known site with no traffic reports zeros.",[198,407,408,409,412],{},"The site comes from ",[202,410,411],{},"$host"," when the log format includes it (a leading vhost field or a trailing\nquoted field), else from a per-site log file name, else the bench's only site.",[198,414,415,416,419,420,423,424,427],{},"The same lines feed ",[207,417,418],{"href":135},"web attack detection",": probes for secrets, admin panels,\ntraversal and injections become ",[202,421,422],{},"web_attack_probe"," events, and a secret-bearing file answered with\na 2xx becomes a critical ",[202,425,426],{},"web_sensitive_file_exposed"," event.",[212,429,431],{"id":430},"auth-log","Auth log",[198,433,218,434,264,437,440,441,444,445,264,448,264,451,454,455,264,458,264,461,264,464,467],{},[202,435,436],{},"\u002Fvar\u002Flog\u002Fauth.log",[202,438,439],{},"\u002Fvar\u002Flog\u002Fsecure",", or ",[202,442,443],{},"journalctl"," (",[202,446,447],{},"sshd",[202,449,450],{},"sshd-session",[202,452,453],{},"sudo",",\n",[202,456,457],{},"useradd",[202,459,460],{},"usermod",[202,462,463],{},"gpasswd",[202,465,466],{},"chsh","):",[228,469,470,480],{},[231,471,472],{},[234,473,474,477],{},[237,475,476],{},"Signal",[237,478,479],{},"Event",[244,481,482,492,503,513,528],{},[234,483,484,487],{},[249,485,486],{},"failed SSH logins, aggregated per source IP and minute of log time; root logins",[249,488,489],{},[202,490,491],{},"security",[234,493,494,497],{},[249,495,496],{},"a successful login from an address that failed 5+ times in the hour before",[249,498,499,502],{},[202,500,501],{},"ssh_login_after_failures"," (critical)",[234,504,505,508],{},[249,506,507],{},"failed sudo attempts, users outside sudoers",[249,509,510],{},[202,511,512],{},"sudo_failure",[234,514,515,518],{},[249,516,517],{},"new local accounts",[249,519,520,523,524,527],{},[202,521,522],{},"account_created","; a package's service account (system UID, no login shell): ",[202,525,526],{},"service_account_created"," (info)",[234,529,530,554],{},[249,531,532,533,264,535,264,538,264,541,264,544,264,547,550,551],{},"a user added to ",[202,534,453],{},[202,536,537],{},"wheel",[202,539,540],{},"admin",[202,542,543],{},"root",[202,545,546],{},"adm",[202,548,549],{},"docker"," or ",[202,552,553],{},"lxd",[249,555,556,502],{},[202,557,558],{},"admin_group_change",[212,560,562],{"id":561},"redis-and-rq","Redis and RQ",[198,564,565,566,467],{},"From the bench's queue Redis (",[202,567,568],{},"redis_queue",[228,570,571,580],{},[231,572,573],{},[234,574,575,577],{},[237,576,239],{},[237,578,579],{},"Meaning",[244,581,582,596,609,623,633],{},[234,583,584,589],{},[249,585,586],{},[202,587,588],{},"queue_length",[249,590,591,592,595],{},"length of every ",[202,593,594],{},"rq:queue:*"," list",[234,597,598,606],{},[249,599,600,264,603],{},[202,601,602],{},"rq_failed_jobs",[202,604,605],{},"rq_failed_jobs_added",[249,607,608],{},"failed-job registry size, and its increase per push",[234,610,611,616],{},[249,612,613],{},[202,614,615],{},"rq_long_running_jobs",[249,617,618,619,622],{},"started jobs older than ",[202,620,621],{},"rq.long_job_minutes"," (30)",[234,624,625,630],{},[249,626,627],{},[202,628,629],{},"rq_workers",[249,631,632],{},"live workers",[234,634,635,643],{},[249,636,637,264,640],{},[202,638,639],{},"redis_used_memory_percent",[202,641,642],{},"redis_evicted_keys",[249,644,645,646],{},"from ",[202,647,648],{},"INFO",[198,650,651,652,655],{},"Only the queue Redis is watched. The cache Redis is an LRU cache by design (",[202,653,654],{},"allkeys-lru","), so a\nfull cache and evictions are normal there.",[212,657,659],{"id":658},"backups","Backups",[198,661,662,665,666,669,670,674,675,679,680,683,684,687],{},[202,663,664],{},"backup_age_hours"," per site, from the newest ",[202,667,668],{},"sites\u002F\u003Csite>\u002Fprivate\u002Fbackups\u002F*-database.sql*",", every\n10 minutes. A site that never had a backup sends nothing, so ",[671,672,673],"em",{},"No backup for 26 h"," cannot fire for it.\nOn Press benches it comes from the Press agent's newest successful ",[676,677,678],"strong",{},"Backup Site"," job instead\n(Press deletes offsite backups from the server), and a failed one sends a ",[202,681,682],{},"backup_failed"," event.\nOther offsite-only setups can point ",[202,685,686],{},"backups.dirs"," at a mounted directory per site.",[212,689,691],{"id":690},"tls-certificates","TLS certificates",[198,693,694,697,698,701,702,705,706,709],{},[202,695,696],{},"tls_days_left"," for every public site name and custom domain (",[202,699,700],{},"site_config.json"," ",[202,703,704],{},"domains","), every\nhour, in a background thread. The agent connects to ",[202,707,708],{},"\u003Cdomain>:443"," with SNI and reads the leaf\ncertificate without verifying it, so expired and self-signed certificates are measured too.",[198,711,712,713,264,716,264,719,264,722,725,726,729],{},"Skipped: ",[202,714,715],{},"localhost",[202,717,718],{},"*.localhost",[202,720,721],{},".local",[202,723,724],{},".test",", bare names, IP addresses and the ",[202,727,728],{},"example.*","\nnames. Unreachable domains are logged and skipped.",[212,731,733],{"id":732},"mariadb","MariaDB",[198,735,736,737,739,740,743],{},"Through the ",[202,738,732],{}," (or ",[202,741,742],{},"mysql",") client, with a site's own credentials written to a private\ntemporary option file, never on the command line:",[228,745,746,754],{},[231,747,748],{},[234,749,750,752],{},[237,751,239],{},[237,753,579],{},[244,755,756,772,782],{},[234,757,758,766],{},[249,759,760,264,763],{},[202,761,762],{},"db_threads_connected",[202,764,765],{},"db_connections_used_percent",[249,767,768,769],{},"against ",[202,770,771],{},"max_connections",[234,773,774,779],{},[249,775,776],{},[202,777,778],{},"db_slow_queries",[249,780,781],{},"increase per push",[234,783,784,792],{},[249,785,786,264,789],{},[202,787,788],{},"db_replication_lag_seconds",[202,790,791],{},"db_replication_running",[249,793,794],{},"on a replica",[198,796,797,798,801,802,550,805,808],{},"A site user may not read replica status (REPLICATION CLIENT \u002F SLAVE MONITOR). Then replication is\nskipped, unless ",[202,799,800],{},"mariadb.user"," \u002F ",[202,803,804],{},"password",[202,806,807],{},"mariadb.defaults_file"," names a monitoring user.\nWithout a client on the host, or for Postgres benches, nothing is sent.",[212,810,812],{"id":811},"processes","Processes",[198,814,218,815,818,819,822,823,826,827,830,831,833,834,801,836,839],{},[202,816,817],{},"supervisorctl status",", else ",[202,820,821],{},"systemctl list-units"," for units whose name contains the bench name.\n",[202,824,825],{},"bench_processes_down"," per bench counts processes that are STOPPED, EXITED, BACKOFF, FATAL or\nUNKNOWN (systemd: ",[202,828,829],{},"failed"," or a restart loop). A process entering FATAL \u002F UNKNOWN (systemd ",[202,832,829],{},")\nalso sends one ",[202,835,378],{},[202,837,838],{},"process_down"," event. Press benches run processes in containers\nand are skipped.",[212,841,843],{"id":842},"security-posture","Security posture",[228,845,846,859],{},[231,847,848],{},[234,849,850,853,856],{},[237,851,852],{},"Check",[237,854,855],{},"Every",[237,857,858],{},"Sends",[244,860,861,881,900,933,960],{},[234,862,863,868,871],{},[249,864,865],{},[676,866,867],{},"App versions",[249,869,870],{},"1 h",[249,872,873,876,877,880],{},[202,874,875],{},"app_version"," per bench and app, from ",[202,878,879],{},"apps\u002F\u003Capp>\u002F\u003Capp>\u002F__init__.py",". The Wolf site compares them with the GitHub Security Advisories of Frappe and ERPNext. Development versions are not sent.",[234,882,883,888,890],{},[249,884,885],{},[676,886,887],{},"Site settings",[249,889,870],{},[249,891,892,895,896,899],{},[202,893,894],{},"site_setting"," per site: two-factor authentication, password policy and minimum score, lockout, guest uploads, and the System Manager role's two-factor flag. Feeds the ",[207,897,898],{"href":150},"security score"," of sites other than the Wolf site.",[234,901,902,907,910],{},[249,903,904],{},[676,905,906],{},"Exposure",[249,908,909],{},"10 min",[249,911,912,915,916,919,920,264,923,926,927,264,930,210],{},[202,913,914],{},"exposed_services"," per host: bench ports listening beyond loopback (MariaDB 3306, Postgres 5432, Redis, socket.io 9000, gunicorn). ",[202,917,918],{},"site_config_risks"," per site: ",[202,921,922],{},"developer_mode",[202,924,925],{},"allow_tests",", a plain-HTTP ",[202,928,929],{},"host_name",[202,931,932],{},"allow_cors: \"*\"",[234,934,935,940,943],{},[249,936,937],{},[676,938,939],{},"File integrity",[249,941,942],{},"15 min",[249,944,945,948,949,314,952,955,956,210],{},[202,946,947],{},"integrity_files"," per bench; ",[202,950,951],{},"bench_code_changed",[202,953,954],{},"bench_config_changed"," events when an app's code, a site config or the nginx and supervisor config changes, telling a deployment from a change outside one. See ",[207,957,959],{"href":958},"\u002Fsecurity\u002Fdetection#file-integrity","Detection",[234,961,962,967,970],{},[249,963,964],{},[676,965,966],{},"Outbound connections",[249,968,969],{},"1 min",[249,971,972,975,976,979,980,983,984,210],{},[202,973,974],{},"bench_outbound_destinations"," per bench; a ",[202,977,978],{},"bench_new_outbound"," event for each public network and unusual port a bench's user had never used, after a 7-day learning period; ",[202,981,982],{},"bench_new_outbound_usual"," counts new ones on usual ports. See ",[207,985,959],{"href":986},"\u002Fsecurity\u002Fdetection#outbound-connections",[198,988,989,990,210],{},"See ",[207,991,959],{"href":135},[212,993,995],{"id":994},"optional-sources","Optional sources",[198,997,998],{},"When present on the host, the agent also tails:",[1000,1001,1002,1018],"ul",{},[1003,1004,1005,1008,1009,1013,1014,1017],"li",{},[676,1006,1007],{},"Suricata","'s EVE log, found from Suricata itself (",[207,1010,1012],{"href":1011},"\u002Fsecurity\u002Fwazuh-suricata#turn-it-on","how","): ",[202,1015,1016],{},"network_ids_alert"," events;",[1003,1019,1020,1023,1024,1027,1028,1031],{},[676,1021,1022],{},"Wazuh","'s ",[202,1025,1026],{},"alerts.json"," on the manager: ",[202,1029,1030],{},"hids_alert"," events.",[198,1033,989,1034,210],{},[207,1035,158],{"href":159},[212,1037,1039],{"id":1038},"delivery-guarantees","Delivery guarantees",[1000,1041,1042,1049,1056],{},[1003,1043,1044,1045,1048],{},"Logs are read from the end on first start. Offsets are kept in\n",[202,1046,1047],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Ftail-state.json",", so restarts and log rotation lose nothing.",[1003,1050,1051,1052,1055],{},"Failed pushes are spooled to ",[202,1053,1054],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Foutbox\u002F"," (capped at 50 MB) and replayed in\norder with exponential backoff.",[1003,1057,1058,1059,1062],{},"Events are ",[207,1060,1061],{"href":76},"scrubbed"," of e-mail addresses, credentials, card numbers and IBANs\nbefore they are spooled.",{"title":1064,"searchDepth":1065,"depth":1066,"links":1067},"",1,2,[1068,1069,1070,1071,1072,1073,1074,1075,1076,1077,1078,1079],{"id":214,"depth":1066,"text":215},{"id":303,"depth":1066,"text":304},{"id":391,"depth":1066,"text":392},{"id":430,"depth