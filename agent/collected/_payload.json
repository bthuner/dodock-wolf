e.",[218,454,455,456,459,460,463,464,467],{},"The same lines feed ",[227,457,458],{"href":125},"web attack detection",": probes for secrets, admin panels,\ntraversal and injections become ",[222,461,462],{},"web_attack_probe"," events, and a secret-bearing file answered with\na 2xx becomes a critical ",[222,465,466],{},"web_sensitive_file_exposed"," event.",[232,469,471],{"id":470},"auth-log","Auth log",[218,473,238,474,284,477,480,481,484,485,284,488,284,491,494,495,284,498,284,501,284,504,507],{},[222,475,476],{},"\u002Fvar\u002Flog\u002Fauth.log",[222,478,479],{},"\u002Fvar\u002Flog\u002Fsecure",", or ",[222,482,483],{},"journalctl"," (",[222,486,487],{},"sshd",[222,489,490],{},"sshd-session",[222,492,493],{},"sudo",",\n",[222,496,497],{},"useradd",[222,499,500],{},"usermod",[222,502,503],{},"gpasswd",[222,505,506],{},"chsh","):",[248,509,510,520],{},[251,511,512],{},[254,513,514,517],{},[257,515,516],{},"Signal",[257,518,519],{},"Event",[264,521,522,532,543,553,568],{},[254,523,524,527],{},[269,525,526],{},"failed SSH logins, aggregated per source IP and minute of log time; root logins",[269,528,529],{},[222,530,531],{},"security",[254,533,534,537],{},[269,535,536],{},"a successful login from an address that failed 5+ times in the hour before",[269,538,539,542],{},[222,540,541],{},"ssh_login_after_failures"," (critical)",[254,544,545,548],{},[269,546,547],{},"failed sudo attempts, users outside sudoers",[269,549,550],{},[222,551,552],{},"sudo_failure",[254,554,555,558],{},[269,556,557],{},"new local accounts",[269,559,560,563,564,567],{},[222,561,562],{},"account_created","; a package's service account (system UID, no login shell): ",[222,565,566],{},"service_account_created"," (info)",[254,569,570,594],{},[269,571,572,573,284,575,284,578,284,581,284,584,284,587,590,591],{},"a user added to ",[222,574,493],{},[222,576,577],{},"wheel",[222,579,580],{},"admin",[222,582,583],{},"root",[222,585,586],{},"adm",[222,588,589],{},"docker"," or ",[222,592,593],{},"lxd",[2