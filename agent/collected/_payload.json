ed jobs",[381,382,383],"note",{},[198,384,385,386,210],{},"Frappe logs \"Scheduled Job Failed\" at INFO, which the default logger drops. To catch every failing\ncron, also install the app on each site as a ",[207,387,388],{"href":41},"satellite",[212,390,392],{"id":391},"nginx-access-log","nginx access log",[198,394,395,396,264,399,264,402,405],{},"Per site and per minute of the log line's own time: ",[202,397,398],{},"http_requests",[202,400,401],{},"http_5xx",[202,403,404],{},"http_502",", plus\none aggregated event per (site, status, route) and minute. Each sample is stamped with the newest\nline of its minute, so a backlog read at once (after a restart or a rotation) lands in the minutes\nit happened, not as one spike when the agent reads it. A known site with no traffic reports zeros.",[198,407,408,409,412],{},"The site comes from ",[202,410,411],{},"$host"," when the log format includes it (a leading vhost field or a trailing\nquoted field), else from a per-site log file name, else the bench's only site.",[198,414,415,416,419,420,423,424,427],{},"The same lines feed ",[207,417,418],{"href":135},"web attack detection",": probes for secrets, admin panels,\ntraversal and injections become ",[202,421,422],{},"web_attack_probe"," events, and a secret-bearing file answered with\na 2xx becomes a critical ",[202,425,426],{},"web_sensitive_file_exposed"," event.",[212,429,431],{"id":430},"auth-log","Auth log",[198,433,218,434,264,437,440,441,444,445,264,448,264,451,454,455,264,458,264,461,264,464,467],{},[202,435,436],{},"\u002Fvar\u002Flog\u002Fauth.log",[202,438,439],{},"\u002Fvar\u002Flog\u002Fsecure",", or ",[202,442,443],{},"journalctl"," (",[202,446,447],{},"sshd",[202,449,450],{},"sshd-session",[202,452,453],{},"sudo",",\n",[202,456,457],{},"useradd",[202,459,460],{},"usermod",[202,462,463],{},"gpasswd",[202,465,466],{},"chsh","):",[228,469,470,480],{},[231,471,472],{},[234,473,474,477],{},[237,475,476],{},"Signal",[237,478,479],{},"Event",[244,481,482,492,503,513,528],{},[234,483,484,487],{},[249,485,486],{},"failed SSH logins, aggregated per source IP and minute of log time; root logins",[249,488,489],{},[202,490,491],{},"security",[234,493,494,497],{},[249,495,496],{},"a successful login from an address that failed 5+ times in the hour before",[249,498,499,502],{},[202,500,501],{},"ssh_login_after_failures"," (critical)",[234,504,505,508],{},[249,506,507],{},"failed sudo attempts, users outside sudoers",[249,509,510],{},[202,511,512],{},"sudo_failure",[234,514,515,518],{},[249,516,517],{},"new local accounts",[249,519,520,523,524,527],{},[202,521,522],{},"account_created","; a package's service account (system UID, no login shell): ",[202,525,526],{},"service_account_created"," (info)",[234,529,530,554],{},[249,531,532,533,264,535,264,538,264,541,264,544,264,547,550,551],{},"a user added to ",[202,534,453],{},[202,536,537],{},"wheel",[202,539,540],{},"admin",[202,542,543],{},"root",[202,545,546],{},"adm",[202,548,549],{},"docker"," or ",[202,552,553],{},"lxd",[249,555,556,502],{},[202,557,558],{},"admin_group_change",[212,560,562],{"id":561},"redis-and-rq","Redis and RQ",[198,564,565,566,467],{},"From the bench's queue Redis (",[202,567,568],{},"redis_queue",[228,570,571,580],{},[231,572,573],{},[234,574,575,577],{},[237,576,239],{},[237,578,579],{},"Meaning",[244,581,582,596,609,623,633],{},[234,583,584,589],{},[249,585,586],{},[202,587,588],{},"queue_length",[249,590,591,592,595],{},"length of every ",[202,593,594],{},"rq:queue:*"," list",[234,597,598,606],{},[249,599,600,264,603],{},[202,601,602],{},"rq_failed_jobs",[202,604,605],{},"rq_failed_jobs_added",[249,607,608],{},"failed-job registry size, and its increase per push",[234,610,611,616],{},[249,612,613],{},[202,614,615],{},"rq_long_running_jobs",[249,617,618,619,622],{},"started jobs older than ",[202,620,621],{},"rq.long_job_minutes"," (30)",[234,624,625,630],{},[249,626,627],{},[202,628,629],{},"rq_workers",[249,631,632],{},"live workers",[234,634,635,643],{},[249,636,637,264,640],{},[202,638,639],{},"redis_used_memory_percent",[202,641,642],{},"redis_evicted_keys",[249,644,645,646],{},"from ",[202,647,648],{},"INFO",[198,650,651,652,655],{},"Only the queue Redis is watched. The cache Redis is an LRU cache by design (",[202,653,654],{},"allkeys-lru","), so a\nfull cache and evictions are normal there.",[212,657,659],{"id":658},"backups","Backups",[198,661,662,665,666,669,670,674,675,678],{},[202,663,664],{},"backup_age_hours"," per site, from the newest ",[202,667,668],{},"sites\u002F\u003Csite>\u002Fprivate\u002Fbackups\u002F*-database.sql*",", every\n10 minutes. A site that never had a backup sends nothing, so ",[671,672,673],"em",{},"No backup for 26 h"," cannot fire for it.\nPress benches are skipped, since Press uploads backups offsite. Offsite-only setups can point\n",[202,676,677],{},"backups.dirs"," at a mounted directory per site.",[212,680,682],{"id":681},"tls-certificates","TLS certificates",[198,684,685,688,689,692,693,696,697,700],{},[202,686,687],{},"tls_days_left"," for every public site name and custom domain (",[202,690,691],{},"site_config.json"," ",[202,694,695],{},"domains","), every\nhour, in a background thread. The agent connects to ",[202,698,699],{},"\u003Cdomain>:443"," with SNI and reads the leaf\ncertificate without verifying it, so expired and self-signed certificates are measured too.",[198,702,703,704,264,707,264,710,264,713,716,717,720],{},"Skipped: ",[202,705,706],{},"localhost",[202,708,709],{},"*.localhost",[202,711,712],{},".local",[202,714,715],{},".test",", bare names, IP addresses and the ",[202,718,719],{},"example.*","\nnames. Unreachable domains are logged and skipped.",[212,722,724],{"id":723},"mariadb","MariaDB",[198,726,727,728,730,731,734],{},"Through the ",[202,729,723],{}," (or ",[202,732,733],{},"mysql",") client, with a site's own credentials written to a private\ntemporary option file, never on the command line:",[228,736,737,745],{},[231,738,739],{},[234,740,741,743],{},[237,742,239],{},[237,744,579],{},[244,746,747,763,773],{},[234,748,749,757],{},[249,750,751,264,754],{},[202,752,753],{},"db_threads_connected",[202,755,756],{},"db_connections_used_percent",[249,758,759,760],{},"against ",[202,761,762],{},"max_connections",[234,764,765,770],{},[249,766,767],{},[202,768,769],{},"db_slow_queries",[249,771,772],{},"increase per push",[234,774,775,783],{},[249,776,777,264,780],{},[202,778,779],{},"db_replication_lag_seconds",[202,781,782],{},"db_replication_running",[249,784,785],{},"on a replica",[198,787,788,789,792,793,550,796,799],{},"A site user may not read replica status (REPLICATION CLIENT \u002F SLAVE MONITOR). Then replication is\nskipped, unless ",[202,790,791],{},"mariadb.user"," \u002F ",[202,794,795],{},"password",[202,797,798],{},"mariadb.defaults_file"," names a monitoring user.\nWithout a client on the host, or for Postgres benches, nothing is sent.",[212,801,803],{"id":802},"processes","Processes",[198,805,218,806,809,810,813,814,817,818,821,822,824,825,792,827,830],{},[202,807,808],{},"supervisorctl status",", else ",[202,811,812],{},"systemctl list-units"," for units whose name contains the bench name.\n",[202,815,816],{},"bench_processes_down"," per bench counts processes that are STOPPED, EXITED, BACKOFF, FATAL or\nUNKNOWN (systemd: ",[202,819,820],{},"failed"," or a restart loop). A process entering FATAL \u002F UNKNOWN (systemd ",[202,823,820],{},")\nalso sends one ",[202,826,378],{},[202,828,829],{},"process_down"," event. Press benches run processes in containers\nand are skipped.",[212,832,834],{"id":833},"security-posture","Security posture",[228,836,837,850],{},[231,838,839],{},[234,840,841,844,847],{},[237,842,843],{},"Check",[237,845,846],{},"Every",[237,848,849],{},"Sends",[244,851,852,873,892,925,952],{},[234,853,854,860,863],{},[249,855,856],{},[857,858,859],"strong",{},"App versions",[249,861,862],{},"1 h",[249,864,865,868,869,872],{},[202,866,867],{},"app_version"," per bench and app, from ",[202,870,871],{},"apps\u002F\u003Capp>\u002F\u003Capp>\u002F__init__.py",". The Wolf site compares them with the GitHub Security Advisories of Frappe and ERPNext. Development versions are not sent.",[234,874,875,880,882],{},[249,876,877],{},[857,878,879],{},"Site settings",[249,881,862],{},[249,883,884,887,888,891],{},[202,885,886],{},"site_setting"," per site: two-factor authentication, password policy and minimum score, lockout, guest uploads, and the System Manager role's two-factor flag. Feeds the ",[207,889,890],{"href":150},"security score"," of sites other than the Wolf site.",[234,893,894,899,902],{},[249,895,896],{},[857,897,898],{},"Exposure",[249,900,901],{},"10 min",[249,903,904,907,908,911,912,264,915,918,919,264,922,210],{},[202,905,906],{},"exposed_services"," per host: bench ports listening beyond loopback (MariaDB 3306, Postgres 5432, Redis, socket.io 9000, gunicorn). ",[202,909,910],{},"site_config_risks"," per site: ",[202,913,914],{},"developer_mode",[202,916,917],{},"allow_tests",", a plain-HTTP ",[202,920,921],{},"host_name",[202,923,924],{},"allow_cors: \"*\"",[234,926,927,932,935],{},[249,928,929],{},[857,930,931],{},"File integrity",[249,933,934],{},"15 min",[249,936,937,940,941,314,944,947,948,210],{},[202,938,939],{},"integrity_files"," per bench; ",[202,942,943],{},"bench_code_changed",[202,945,946],{},"bench_config_changed"," events when an app's code, a site config or the nginx and supervisor config changes, telling a deployment from a change outside one. See ",[207,949,951],{"href":950},"\u002Fsecurity\u002Fdetection#file-integrity","Detection",[234,953,954,959,962],{},[249,955,956],{},[857,957,958],{},"Outbound connections",[249,960,961],{},"1 min",[249,963,964,967,968,971,972,975,976,210],{},[202,965,966],{},"bench_outbound_destinations"," per bench; a ",[202,969,970],{},"bench_new_outbound"," event for each public network and unusual port a bench's user had never used, after a 7-day learning period; ",[202,973,974],{},"bench_new_outbound_usual"," counts new ones on usual ports. See ",[207,977,951],{"href":978},"\u002Fsecurity\u002Fdetection#outbound-connections",[198,980,981,982,210],{},"See ",[207,983,951],{"href":135},[212,985,987],{"id":986},"optional-sources","Optional sources",[198,989,990],{},"When present on the host, the agent also tails:",[992,993,994,1010],"ul",{},[995,996,997,1000,1001,1005,1006,1009],"li",{},[857,998,999],{},"Suricata","'s EVE log, found from Suricata itself (",[207,1002,1004],{"href":1003},"\u002Fsecurity\u002Fwazuh-suricata#turn-it-on","how","): ",[202,1007,1008],{},"network_ids_alert"," events;",[995,1011,1012,1015,1016,1019,1020,1023],{},[857,1013,1014],{},"Wazuh","'s ",[202,1017,1018],{},"alerts.json"," on the manager: ",[202,1021,1022],{},"hids_alert"," events.",[198,1025,981,1026,210],{},[207,1027,158],{"href":159},[212,1029,1031],{"id":1030},"delivery-guarantees","Delivery guarantees",[992,1033,1034,1041,1048],{},[995,1035,1036,1037,1040],{},"Logs are read from the end on first start. Offsets are kept in\n",[202,1038,1039],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Ftail-state.json",", so restarts and log rotation lose nothing.",[995,1042,1043,1044,1047],{},"Failed pushes are spooled to ",[202,1045,1046],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Foutbox\u002F"," (capped at 50 MB) and replayed in\norder with exponential backoff.",[995,1049,1050,1051,1054],{},"Events are ",[207,1052,1053],{"href":76},"scrubbed"," of e-mail addresses, credentials, card numbers and IBANs\nbefore they are spooled.",{"title":1056,"searchDepth":1057,"depth":1058,"links":1059},"",1,2,[1060,1061,1062,1063,1064,1065,1066,1067,1068,1069,1070,1071],{"id":214,"depth":1058,"text":215},{"id":303,"depth":1058,"text":304},{"id":391,"depth":1058,"text":392},{"id":430,"depth":1058,"text":431},{"id":561,"depth":1058,"text":562},{"id":658,"depth":1058,"text":659},{"id":681,"depth":1058,"text":682},{"id":723,"depth":1058,"text":724},{"id":802,"depth":1058,"text":803},{"id":833,