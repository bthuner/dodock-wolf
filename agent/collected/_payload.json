485,486],{},"Signal",[227,488,489],{},"Event",[234,491,492,502,513,523,538],{},[224,493,494,497],{},[239,495,496],{},"failed SSH logins, aggregated per source IP and minute of log time; root logins",[239,498,499],{},[192,500,501],{},"security",[224,503,504,507],{},[239,505,506],{},"a successful login from an address that failed 5+ times in the hour before",[239,508,509,512],{},[192,510,511],{},"ssh_login_after_failures"," (critical)",[224,514,515,518],{},[239,516,517],{},"failed sudo attempts, users outside sudoers",[239,519,520],{},[192,521,522],{},"sudo_failure",[224,524,525,528],{},[239,526,527],{},"new local accounts",[239,529,530,533,534,537],{},[192,531,532],{},"account_created","; a package's service account (system UID, no login shell): ",[192,535,536],{},"service_account_created"," (info)",[224,539,540,564],{},[239,541,542,543,254,545,254,548,254,551,254,554,254,557,560,561],{},"a user added to ",[192,544,463],{},[192,546,547],{},"wheel",[192,549,550],{},"admin",[192,552,553],{},"root",[192,555,556],{},"adm",[192,558,559],{},"docker"," or ",[192,562,563],{},"lxd",[239,565,566,512],{},[192,567,568],{},"admin_group_change",[202,570,572],{"id":571},"redis-and-rq","Redis and RQ",[188,574,575,576,477],{},"From the bench's queue Redis (",[192,577,578],{},"redis_queue",[218,580,581,590],{},[221,582,583],{},[224,584,585,587],{},[227,586,229],{},[227,588,589],{},"Meaning",[234,591,592,606,619,633,643],{},[224,593,594,599],{},[239,595,596],{},[192,597,598],{},"queue_length",[239,600,601,602,605],{},"length of every ",[192,603,604],{},"rq:queue:*"," list",[224,607,608,616],{},[239,609,610,254,613],{},[192,611,612],{},"rq_failed_jobs",[192,614,615],{},"rq_failed_jobs_added",[239,617,618],{},"failed-job registry size, and its increase per push",[224,620,621,626],{},[239,622,623],{},[192,624,625],{},"rq_long_running_jobs",[239,627,628,629,632],{},"started jobs older than ",[192,630,631],{},"rq.long_job_minutes"," (30)",[224,634,635,640],{},[239,636,637],{},[192,638,639],