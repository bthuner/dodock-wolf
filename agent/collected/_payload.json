(",[222,730,731],{},"site_config.json"," ",[222,734,735],{},"domains","), every\nhour, in a background thread. The agent connects to ",[222,738,739],{},"\u003Cdomain>:443"," with SNI and reads the leaf\ncertificate without verifying it, so expired and self-signed certificates are measured too.",[218,742,743,744,284,747,284,750,284,753,756,757,760],{},"Skipped: ",[222,745,746],{},"localhost",[222,748,749],{},"*.localhost",[222,751,752],{},".local",[222,754,755],{},".test",", bare names, IP addresses and the ",[222,758,759],{},"example.*","\nnames. Unreachable domains are logged and skipped.",[232,762,764],{"id":763},"mariadb","MariaDB",[218,766,767,768,770,771,774],{},"Through the ",[222,769,763],{}," (or ",[222,772,773],{},"mysql",") client, with a site's own credentials written to a private\ntemporary option file, never on the command line:",[248,776,777,785],{},[251,778,779],{},[254,780,781,783],{},[257,782,259],{},[257,784,619],{},[264,786,787,803,813],{},[254,788,789,797],{},[269,790,791,284,794],{},[222,792,793],{},"db_threads_connected",[222,795,796],{},"db_connections_used_percent",[269,798,799,800],{},"against ",[222,801,802],{},"max_connections",[254,804,805,810],{},[269,806,807],{},[222,808,809],{},"db_slow_queries",[269,811,812],{},"increase per push",[254,814,815,823],{},[269,816,817,284,820],{},[222,818,819],{},"db_replication_lag_seconds",[222,821,822],{},"db_replication_running",[269,824,825],{},"on a replica",[218,827,828,829,832,833,590,836,839],{},"A site user may not read replica status (REPLICATION CLIENT \u002F SLAVE MONITOR). Then replication is\nskipped, unless ",[222,830,831],{},"mariadb.user"," \u002F ",[222,834,835],{},"password",[222,837,838],{},"mariadb.defaults_file"," names a monitoring user.\nWithout a client on the host, or for Postgres benches, nothing is sent.",[232,841,843],{"id":842},"processes","Processes",[218,845,238,846,849,850,853,854,857,858,861,862,864,865,832,867,467],{},[222,847,848],{},"supervisorctl status",", else ",[222,851,852],{},"systemctl list-units"," for units whose name contains the bench name.\n",[222,855,856],{},"bench_processes_down"," per bench counts processes that are STOPPED, EXITED, BACKOFF, FATAL or\nUNKNOWN (systemd: ",[222,859,860],{},"failed"," or a restart loop). A process entering FATAL \u002F UNKNOWN (systemd ",[222,863,860],{},")\nalso sends one ",[222,866,418],{},[222,868,869],{},"process_down",[232,871,873],{"id":872},"security-posture","Security posture",[248,875,876,889],{},[251,877,878],{},[254,879,880,883,886],{},[257,881,882],{},"Check",[257,884,885],{},"Every",[257,887,888],{},"Sends",[264,890,891,912,931,964,991],{},[254,892,893,899,902],{},[269,894,895],{},[896,897,898],"strong",{},"App versions",[269,900,901],{},"1 h",[269,903,904,907,908,911],{},[222,905,906],{},"app_version"," per bench and app, from ",[222,909,910],{},"apps\u002F\u003Capp>\u002F\u003Capp>\u002F__init__.py",". The Wolf site compares them with the GitHub Security Advisories of Frappe and ERPNext. Development versions are not sent.",[254,913,914,919,921],{},[269,915,916],{},[896,917,918],{},"Site settings",[269,920,901],{},[269,922,923,926,927,930],{},[222,924,925],{},"site_setting"," per site: two-factor authentication, password policy and minimum score, lockout, guest uploads, and the System Manager role's two-factor flag. Feeds the ",[227,928,929],{"href":140},"security score"," of sites other than the Wolf site.",[254,932,933,938,941],{},[269,934,935],{},[896,936,937],{},"Exposure",[269,939,940],{},"10 min",[269,942,943,946,947,950,951,284,954,957,958,284,961,230],{},[222,944,945],{},"exposed_services"," per host: bench ports listening beyond loopback (MariaDB 3306, Postgres 5432, Redis, socket.io 9000, gunicorn). ",[222,948,949],{},"site_config_risks"," per site: ",[222,952,953],{},"developer_mode",[222,955,956],{},"allow_tests",", a plain-HTTP ",[222,959,960],{},"host_name",[222,962,963],{},"allow_cors: \"*\"",[254,965,966,971,974],{},[269,967,968],{},[896,969,970],{},"File integrity",[269,972,973],{},"15 min",[269,975,976,979,980,354,983,986,987,230],{},[222,977,978],{},"integrity_files"," per bench; ",[222,981,982],{},"bench_code_changed",[222,984,985],{},"bench_config_changed"," events when an app's code, a site config or the nginx and supervisor config changes, telling a deployment from a change outside one. See ",[227,988,990],{"href":989},"\u002Fsecurity\u002Fdetection#file-integrity","Detection",[254,992,993,998,1001],{},[269,994,995],{},[896,996,997],{},"Outbound connections",[269,999,1000],{},"1 min",[269,1002,1003,1006,1007,1010,1011,1014,1015,230],{},[222,1004,1005],{},"bench_outbound_destinations"," per bench; a ",[222,1008,1009],{},"bench_new_outbound"," event for each public network and unusual port a bench's user had never used, after a 7-day learning period; ",[222,1012,1013],{},"bench_new_outbound_usual"," counts new ones on usual ports. See ",[227,1016,990],{"href":1017},"\u002Fsecurity\u002Fdetection#outbound-connections",[218,1019,1020,1021,230],{},"See ",[227,1022,990],{"href":125},[232,1024,1026],{"id":1025},"optional-sources","Optional sources",[218,1028,1029],{},"When present on the host, the agent also tails:",[1031,1032,1033,1049],"ul",{},[1034,1035,1036,1039,1040,1044,1045,1048],"li",{},[896,1037,1038],{},"Suricata","'s EVE log, found from Suricata itself (",[227,1041,1043],{"href":1042},"\u002Fsecurity\u002Fwazuh-suricata#turn-it-on","how","): ",[222,1046,1047],{},"network_ids_alert"," events;",[1034,1050,1051,1054,1055,1058,1059,1062],{},[896,1052,1053],{},"Wazuh","'s ",[222,1056,1057],{},"alerts.json"," on the manager: ",[222,1060,1061],{},"hids_alert"," events.",[218,1064,1020,1065,230],{},[227,1066,148],{"href":149},[232,1068,1070],{"id":1069},"delivery-guarantees","Delivery guarantees",[1031,1072,1073,1080,1087],{},[1034,1074,1075,1076,1079],{},"Logs are read from the end on first start. Offsets are kept in\n",[222,1077,1078],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Ftail-state.json",", so restarts and log rotation lose nothing.",[1034,1081,1082,1083,1086],{},"Failed pushes are spooled to ",[222,1084,1085],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Foutbox\u002F"," (capped at 50 MB) and replayed in\norder with exponential backoff.",[1034,1088,1089,1090,1093],{},"Events are ",[227,1091,1092],{"href":71},"scrubbed"," of e-mail addresses, credentials, card numbers and IBANs\nbefore they are spooled.",{"title":1095,"searchDepth":1096,"depth":1097,"links":1098},"",1,2,[1099,1100,1101,1102,1103,1104,1105,1106,1107,1108,1109,1110],{"id":234,"depth":1097,"text":235},{"id":343,"depth":1097,"text":344},{"id":431,"depth":1097,"text":432},{"id":470,"depth":1097,"text":471},{"id":601,"depth":1097,"text":602},{"id":698,"depth":1097,"text":699},{"id":721,"depth":1097,"text":722},{"id":763,"depth":1097,"text":764},{"id":842,"depth":1097,"text":843},{"id":872,"depth":1097,"text":873},{"id":1025,"depth":1097,"text":1026},{"id":1069,"depth":1097,"text":1070},"Every metric and event the Wolf Agent sends, and where it reads it.","md",null,{},{"icon":58},{"title":55,"description":1111},"BEqzczeNDq9CxAhMD6MBM-lYODsuGRdeTgGzlKMZiC0",[1119,1121],{"title":45,"path":46,"stem":47,"description":1120,"icon":48},"Run the Wolf Agent on a Frappe Pilot host and turn Pilot tasks into deployment events.",{"title":60,"path":61,"stem":62,"description":1122,"icon":63},"The agent's config.json, key by key.",1795107942386]