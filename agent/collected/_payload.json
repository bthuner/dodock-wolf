ed jobs",[381,382,383],"note",{},[198,384,385,386,210],{},"Frappe logs \"Scheduled Job Failed\" at INFO, which the default logger drops. To catch every failing\ncron, also install the app on each site as a ",[207,387,388],{"href":41},"satellite",[212,390,392],{"id":391},"nginx-access-log","nginx access log",[198,394,395,396,264,399,264,402,405],{},"Per site and per minute of the log line's own time: ",[202,397,398],{},"http_requests",[202,400,401],{},"http_5xx",[202,403,404],{},"http_502",", plus\none aggregated event per (site, status, route) and minute. Each sample is stamped with the newest\nline of its minute, so a backlog read at once (after a restart or a rotation) lands in the minutes\nit happened, not as one spike when the agent reads it. A known site with no traffic reports zeros.",[198,407,408,409,412],{},"The site comes from ",[202,410,411],{},"$host"," when the log format includes it (a leading vhost field or a trailing\nquoted field), else from a per-site log file name, else the bench's only site.",[198,414,415,416,419,420,423,424,427],{},"The same lines feed ",[207,417,418],{"href":135},"web attack detection",": probes for secrets, admin panels,\ntraversal and injections become ",[202,421,422],{},"web_attack_probe"," events, and a secret-bearing file answered with\na 2xx becomes a critical ",[202,425,426],{},"web_sensitive_file_exposed"," event.",[212,429,431],{"id":430},"auth-log","Auth log",[198,433,218,434,264,437,440,441,444,445,264,448,264,451,454,455,264,458,264,461,464],{},[202,435,436],{},"\u002Fvar\u002Flog\u002Fauth.log",[202,438,439],{},"\u002Fvar\u002Flog\u002Fsecure",", or ",[202,442,443],{},"journalctl"," (",[202,446,447],{},"sshd",[202,449,450],{},"sshd-session",[202,452,453],{},"sudo",",\n",[202,456,457],{},"useradd",[202,459,460],{},"usermod",[202,462,463],{},"gpasswd","):",[228,466,467,477],{},[231,468,469],{},[234,470,471,474],{},[237,472,473],{},"Signal",[237,475,476],{},"Event",[244,478,479,489,500,510,520],{},[234,480,481,484],{},[249,482,483],{},"failed SSH logins, aggregated per source IP and minute of log time; root logins",[249,485,486],{},[202,487,488],{},"security",[234,490,491,494],{},[249,492,493],{},"a successful login from an address that failed 5+ times in the hour before",[249,495,496,499],{},[202,497,498],{},"ssh_login_after_failures"," (critical)",[234,501,502,505],{},[249,503,504],{},"failed sudo attempts, users outside sudoers",[249,506,507],{},[202,508,509],{},"sudo_failure",[234,511,512,515],{},[249,513,514],{},"new local accounts",[249,516,517],{},[202,518,519],{},"account_created",[234,521,522,546],{},[249,523,524,525,264,527,264,530,264,533,264,536,264,539,542,543],{},"a user added to ",[202,526,453],{},[202,528,529],{},"wheel",[202,531,532],{},"admin",[202,534,535],{},"root",[202,537,538],{},"adm",[202,540,541],{},"docker"," or ",[202,544,545],{},"lxd",[249,547,548,499],{},[202,549,550],{},"admin_group_change",[212,552,554],{"id":553},"redis-and-rq","Redis and RQ",[198,556,557,558,464],{},"From the bench's queue Redis (",[202,559,560],{},"redis_queue",[228,562,563,572],{},[231,564,565],{},[234,566,567,569],{},[237,568,239],{},[237,570,571],{},"Meaning",[244,573,574,588,601,615,625],{},[234,575,576,581],{},[249,577,578],{},[202,579,580],{},"queue_length",[249,582,583,584,587],{},"length of every ",[202,585,586],{},"rq:queue:*"," list",[234,589,590,598],{},[249,591,592,264,595],{},[202,593,594],{},"rq_failed_jobs",[202,596,597],{},"rq_failed_jobs_added",[249,599,600],{},"failed-job registry size, and its increase per push",[234,602,603,608],{},[249,604,605],{},[202,606,607],{},"rq_long_running_jobs",[249,609,610,611,614],{},"started jobs older than ",[202,612,613],{},"rq.long_job_minutes"," (30)",[234,616,617,622],{},[249,618,619],{},[202,620,621],{},"rq_workers",[249,623,624],{},"live workers",[234,626,627,635],{},[249,628,629,264,632],{},[202,630,631],{},"redis_used_memory_percent",[202,633,634],{},"redis_evicted_keys",[249,636,637,638],{},"from ",[202,639,640],{},"INFO",[198,642,643,644,647],{},"Only the queue Redis is watched. The cache Redis is an LRU cache by design (",[202,645,646],{},"allkeys-lru","), so a\nfull cache and evictions are normal there.",[212,649,651],{"id":650},"backups","Backups",[198,653,654,657,658,661,662,666,667,670],{},[202,655,656],{},"backup_age_hours"," per site, from the newest ",[202,659,660],{},"sites\u002F\u003Csite>\u002Fprivate\u002Fbackups\u002F*-database.sql*",", every\n10 minutes. A site that never had a backup sends nothing, so ",[663,664,665],"em",{},"No backup for 26 h"," cannot fire for it.\nPress benches are skipped, since Press uploads backups offsite. Offsite-only setups can point\n",[202,668,669],{},"backups.dirs"," at a mounted directory per site.",[212,672,674],{"id":673},"tls-certificates","TLS certificates",[198,676,677,680,681,684,685,688,689,692],{},[202,678,679],{},"tls_days_left"," for every public site name and custom domain (",[202,682,683],{},"site_config.json"," ",[202,686,687],{},"domains","), every\nhour, in a background thread. The agent connects to ",[202,690,691],{},"\u003Cdomain>:443"," with SNI and reads the leaf\ncertificate without verifying it, so expired and self-signed certificates are measured too.",[198,694,695,696,264,699,264,702,264,705,708,709,712],{},"Skipped: ",[202,697,698],{},"localhost",[202,700,701],{},"*.localhost",[202,703,704],{},".local",[202,706,707],{},".test",", bare names, IP addresses and the ",[202,710,711],{},"example.*","\nnames. Unreachable domains are logged and skipped.",[212,714,716],{"id":715},"mariadb","MariaDB",[198,718,719,720,722,723,726],{},"Through the ",[202,721,715],{}," (or ",[202,724,725],{},"mysql",") client, with a site's own credentials written to a private\ntemporary option file, never on the command line:",[228,728,729,737],{},[231,730,731],{},[234,732,733,735],{},[237,734,239],{},[237,736,571],{},[244,738,739,755,765],{},[234,740,741,749],{},[249,742,743,264,746],{},[202,744,745],{},"db_threads_connected",[202,747,748],{},"db_connections_used_percent",[249,750,751,752],{},"against ",[202,753,754],{},"max_connections",[234,756,757,762],{},[249,758,759],{},[202,760,761],{},"db_slow_queries",[249,763,764],{},"increase per push",[234,766,767,775],{},[249,768,769,264,772],{},[202,770,771],{},"db_replication_lag_seconds",[202,773,774],{},"db_replication_running",[249,776,777],{},"on a replica",[198,779,780,781,784,785,542,788,791],{},"A site user may not read replica status (REPLICATION CLIENT \u002F SLAVE MONITOR). Then replication is\nskipped, unless ",[202,782,783],{},"mariadb.user"," \u002F ",[202,786,787],{},"password",[202,789,790],{},"mariadb.defaults_file"," names a monitoring user.\nWithout a client on the host, or for Postgres benches, nothing is sent.",[212,793,795],{"id":794},"processes","Processes",[198,797,218,798,801,802,805,806,809,810,813,814,816,817,784,819,822],{},[202,799,800],{},"supervisorctl status",", else ",[202,803,804],{},"systemctl list-units"," for units whose name contains the bench name.\n",[202,807,808],{},"bench_processes_down"," per bench counts processes that are STOPPED, EXITED, BACKOFF, FATAL or\nUNKNOWN (systemd: ",[202,811,812],{},"failed"," or a restart loop). A process entering FATAL \u002F UNKNOWN (systemd ",[202,815,812],{},")\nalso sends one ",[202,818,378],{},[202,820,821],{},"process_down"," event. Press benches run processes in containers\nand are skipped.",[212,824,826],{"id":825},"security-posture","Security posture",[228,828,829,842],{},[231,830,831],{},[234,832,833,836,839],{},[237,834,835],{},"Check",[237,837,838],{},"Every",[237,840,841],{},"Sends",[244,843,844,865,884,917,944],{},[234,845,846,852,855],{},[249,847,848],{},[849,850,851],"strong",{},"App versions",[249,853,854],{},"1 h",[249,856,857,860,861,864],{},[202,858,859],{},"app_version"," per bench and app, from ",[202,862,863],{},"apps\u002F\u003Capp>\u002F\u003Capp>\u002F__init__.py",". The Wolf site compares them with the GitHub Security Advisories of Frappe and ERPNext. Development versions are not sent.",[234,866,867,872,874],{},[249,868,869],{},[849,870,871],{},"Site settings",[249,873,854],{},[249,875,876,879,880,883],{},[202,877,878],{},"site_setting"," per site: two-factor authentication, password policy and minimum score, lockout, guest uploads, and the System Manager role's two-factor flag. Feeds the ",[207,881,882],{"href":150},"security score"," of sites other than the Wolf site.",[234,885,886,891,894],{},[249,887,888],{},[849,889,890],{},"Exposure",[249,892,893],{},"10 min",[249,895,896,899,900,903,904,264,907,910,911,264,914,210],{},[202,897,898],{},"exposed_services"," per host: bench ports listening beyond loopback (MariaDB 3306, Postgres 5432, Redis, socket.io 9000, gunicorn). ",[202,901,902],{},"site_config_risks"," per site: ",[202,905,906],{},"developer_mode",[202,908,909],{},"allow_tests",", a plain-HTTP ",[202,912,913],{},"host_name",[202,915,916],{},"allow_cors: \"*\"",[234,918,919,924,927],{},[249,920,921],{},[849,922,923],{},"File integrity",[249,925,926],{},"15 min",[249,928,929,932,933,314,936,939,940,210],{},[202,930,931],{},"integrity_files"," per bench; ",[202,934,935],{},"bench_code_changed",[202,937,938],{},"bench_config_changed"," events when an app's code, a site config or the nginx and supervisor config changes, telling a deployment from a change outside one. See ",[207,941,943],{"href":942},"\u002Fsecurity\u002Fdetection#file-integrity","Detection",[234,945,946,951,954],{},[249,947,948],{},[849,949,950],{},"Outbound connections",[249,952,953],{},"1 min",[249,955,956,959,960,963,964,967,968,210],{},[202,957,958],{},"bench_outbound_destinations"," per bench; a ",[202,961,962],{},"bench_new_outbound"," event for each public network and unusual port a bench's user had never used, after a 7-day learning period; ",[202,965,966],{},"bench_new_outbound_usual"," counts new ones on usual ports. See ",[207,969,943],{"href":970},"\u002Fsecurity\u002Fdetection#outbound-connections",[198,972,973,974,210],{},"See ",[207,975,943],{"href":135},[212,977,979],{"id":978},"optional-sources","Optional sources",[198,981,982],{},"When present on the host, the agent also tails:",[984,985,986,1002],"ul",{},[987,988,989,992,993,997,998,1001],"li",{},[849,990,991],{},"Suricata","'s EVE log, found from Suricata itself (",[207,994,996],{"href":995},"\u002Fsecurity\u002Fwazuh-suricata#turn-it-on","how","): ",[202,999,1000],{},"network_ids_alert"," events;",[987,1003,1004,1007,1008,1011,1012,1015],{},[849,1005,1006],{},"Wazuh","'s ",[202,1009,1010],{},"alerts.json"," on the manager: ",[202,1013,1014],{},"hids_alert"," events.",[198,1017,973,1018,210],{},[207,1019,158],{"href":159},[212,1021,1023],{"id":1022},"delivery-guarantees","Delivery guarantees",[984,1025,1026,1033,1040],{},[987,1027,1028,1029,1032],{},"Logs are read from the end on first start. Offsets are kept in\n",[202,1030,1031],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Ftail-state.json",", so restarts and log rotation lose nothing.",[987,1034,1035,1036,1039],{},"Failed pushes are spooled to ",[202,1037,1038],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Foutbox\u002F"," (capped at 50 MB) and replayed in\norder with exponential backoff.",[987,1041,1042,1043,1046],{},"Events are ",[207,1044,1045],{"href":76},"scrubbed"," of e-mail addresses, credentials, card numbers and IBANs\nbefore they are spooled.",{"title":1048,"searchDepth":1049,"depth":1050,"links":1051},"",1,2,[1052,1053,1054,1055,1056,1057,1058,1059,1060,1061,1062,1063],{"id":214,"depth":1050,"text":215},{"id":303,"depth":1050,"text":304},{"id":391,"depth":1050,"text":392},{"id":430,"depth":1050,"text":431},{"id":553,"depth":1050,"text":554},{"id":650,"depth":1050,"text":651},{"id":673,"depth":1050,"text":674},{"id":715,"depth":1050,"text":716},{"id":794,"depth":1050,"text":795},{"id":825,"depth":1050,"text":826},{"id":978,"depth":1050,"text":979},{"id":1022,"depth":1050,"text":1023},"Every metric and event the Wolf Agent sends, and where it reads it.","