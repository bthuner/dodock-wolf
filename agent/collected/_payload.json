],{},[227,752,229],{},[227,754,589],{},[234,756,757,773,783],{},[224,758,759,767],{},[239,760,761,254,764],{},[192,762,763],{},"db_threads_connected",[192,765,766],{},"db_connections_used_percent",[239,768,769,770],{},"against ",[192,771,772],{},"max_connections",[224,774,775,780],{},[239,776,777],{},[192,778,779],{},"db_slow_queries",[239,781,782],{},"increase per push",[224,784,785,793],{},[239,786,787,254,790],{},[192,788,789],{},"db_replication_lag_seconds",[192,791,792],{},"db_replication_running",[239,794,795],{},"on a replica",[188,797,798,799,802,803,560,806,809],{},"A site user may not read replica status (REPLICATION CLIENT \u002F SLAVE MONITOR). Then replication is\nskipped, unless ",[192,800,801],{},"mariadb.user"," \u002F ",[192,804,805],{},"password",[192,807,808],{},"mariadb.defaults_file"," names a monitoring user.\nWithout a client on the host, or for Postgres benches, nothing is sent.",[202,811,813],{"id":812},"processes","Processes",[188,815,208,816,819,820,823,824,827,828,831,832,834,835,802,837,437],{},[192,817,818],{},"supervisorctl status",", else ",[192,821,822],{},"systemctl list-units"," for units whose name contains the bench name.\n",[192,825,826],{},"bench_processes_down"," per bench counts processes that are STOPPED, EXITED, BACKOFF, FATAL or\nUNKNOWN (systemd: ",[192,829,830],{},"failed"," or a restart loop). A process entering FATAL \u002F UNKNOWN (systemd ",[192,833,830],{},")\nalso sends one ",[192,836,388],{},[192,838,839],{},"process_down",[202,841,843],{"id":842},"security-posture","Security posture",[218,845,846,859],{},[221,847,848],{},[224,849,850,853,856],{},[227,851,852],{},"Check",[227,854,855],{},"Every",[227,857,858],{},"Sends",[234,860,861,882,901,934,961],{},[224,862,863,869,872],{},[239,864,865],{},[866,867,868],"strong",{},"App versions",[239,870,871],{},"1 h",[239,873,874,877,878,881],{},[192,875,876],{},"app_version"," per bench and app, from ",[192,879,880],{},"apps\u002F\u003Capp>\u002F\u003Capp>\u002F__init__.py",". The Wolf site compares them with the GitHub Security Advisories of Frappe and ERPNext. Development versions are not sent.",[224,883,884,889,891],{},[239,885,886],{},[866,887,888],{},"Site settings",[239,890,871],{},[239,892,893,896,897,900],{},[192,894,895],{},"site_setting"," per site: two-factor authentication, password policy and minimum score, lockout, guest uploads, and the System Manager role's two-factor flag. Feeds the ",[197,898,899],{"href":140},"security score"," of sites other than the Wolf site.",[224,902,903,908,911],{},[239,904,905],{},[866,906,907],{},"Exposure",[239,909,910],{},"10 min",[239,912,913,916,917,920,921,254,924,927,928,254,931,200],{},[192,914,915],{},"exposed_services"," per host: bench ports listening beyond loopback (MariaDB 3306, Postgres 5432, Redis, socket.io 9000, gunicorn). ",[192,918,919],{},"site_config_risks"," per site: ",[192,922,923],{},"developer_mode",[192,925,926],{},"allow_tests",", a plain-HTTP ",[192,929,930],{},"host_name",[192,932,933],{},"allow_cors: \"*\"",[224,935,936,941,944],{},[239,937,938],{},[866,939,940],{},"File integrity",[239,942,943],{},"15 min",[239,945,946,949,950,324,953,956,957,200],{},[192,947,948],{},"integrity_files"," per bench; ",[192,951,952],{},"bench_code_changed",[192,954,955],{},"bench_config_changed"," events when an app's code, a site config or the nginx and supervisor config changes, telling a deployment from a change outside one. See ",[197,958,960],{"href":959},"\u002Fsecurity\u002Fdetection#file-integrity","Detection",[224,962,963,968,971],{},[239,964,965],{},[866,966,967],{},"Outbound connections",[239,969,970],{},"1 min",[239,972,973,976,977,980,981,984,985,200],{},[192,974,975],{},"bench_outbound_destinations"," per bench; a ",[192,978,979],{},"bench_new_outbound"," event for each public network and unusual port a bench's user had never used, after a 7-day learning period; ",[192,982,983],{},"bench_new_outbound_usual"," counts new ones on usual ports. See ",[197,986,960],{"href":987},"\u002Fsecurity\u002Fdetection#outbound-connections",[188,989,990,991,200],{},"See ",[197,992,960],{"href":125},[202,994,996],{"id":995},"optional-sources","Optional sources",[188,998,999],{},"When present on the host, the agent also tails:",[1001,1002,1003,1019],"ul",{},[1004,1005,1006,1009,1010,1014,1015,1018],"li",{},[866,1007,1008],{},"Suricata","'s EVE log, found from Suricata itself (",[197,1011,1013],{"href":1012},"\u002Fsecurity\u002Fwazuh-suricata#turn-it-on","how","): ",[192,1016,1017],{},"network_ids_alert"," events;",[1004,1020,1021,1024,1025,1028,1029,1032],{},[866,1022,1023],{},"Wazuh","'s ",[192,1026,1027],{},"alerts.json"," on the manager: ",[192,1030,1031],{},"hids_alert"," events.",[188,1034,990,1035,200],{},[197,1036,148],{"href":149},[202,1038,1040],{"id":1039},"delivery-guarantees","Delivery guarantees",[1001,1042,1043,1050,1057],{},[1004,1044,1045,1046,1049],{},"Logs are read from the end on first start. Offsets are kept in\n",[192,1047,1048],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Ftail-state.json",", so restarts and log rotation lose nothing.",[1004,1051,1052,1053,1056],{},"Failed pushes are spooled to ",[192,1054,1055],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Foutbox\u002F"," (capped at 50 MB) and replayed in\norder with exponential backoff.",[1004,1058,1059,1060,1063],{},"Events are ",[197,1061,1062],{"href":71},"scrubbed"," of e-mail addresses, credentials, card numbers and IBANs\nbefore they are spooled.",{"title":1065,"searchDepth":1066,"depth":1067,"links":1068},"",1,2,[1069,1070,1071,1072,1073,1074,1075,1076,1077,1078,1079,1080],{"id":204,"depth":1067,"text":205},{"id":313,"depth":1067,"text":314},{"id":401,"depth":1067,"text":402},{"id":440,"depth":1067,"text":441},{"id":571,"depth":1067,"text":572},{"id":668,"depth":1067,"text":669},{"id":691,"depth":1067,"text":692},{"id":733,"depth":1067,"text":734},{"id":812,"depth":1067,"text":813},{"id":842,"depth":1067,"text":843},{"id":995,"depth":1067,"text"