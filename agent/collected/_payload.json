,628],{},"failed-job registry size, and its increase per push",[234,630,631,636],{},[249,632,633],{},[202,634,635],{},"rq_long_running_jobs",[249,637,638,639,642],{},"started jobs older than ",[202,640,641],{},"rq.long_job_minutes"," (30)",[234,644,645,650],{},[249,646,647],{},[202,648,649],{},"rq_workers",[249,651,652],{},"live workers",[234,654,655,663],{},[249,656,657,264,660],{},[202,658,659],{},"redis_used_memory_percent",[202,661,662],{},"redis_evicted_keys",[249,664,665,666],{},"from ",[202,667,668],{},"INFO",[198,670,671,672,675],{},"Only the queue Redis is watched. The cache Redis is an LRU cache by design (",[202,673,674],{},"allkeys-lru","), so a\nfull cache and evictions are normal there.",[212,677,679],{"id":678},"backups","Backups",[198,681,682,685,686,689,690,694,695,699,700,703,704,707],{},[202,683,684],{},"backup_age_hours"," per site, from the newest ",[202,687,688],{},"sites\u002F\u003Csite>\u002Fprivate\u002Fbackups\u002F*-database.sql*",", every\n10 minutes. A site that never had a backup sends nothing, so ",[691,692,693],"em",{},"No backup for 26 h"," cannot fire for it.\nOn Press benches it comes from the Press agent's newest successful ",[696,697,698],"strong",{},"Backup Site"," job instead\n(Press deletes offsite backups from the server), and a failed one sends a ",[202,701,702],{},"backup_failed"," event.\nOther offsite-only setups can point ",[202,705,706],{},"backups.dirs"," at a mounted directory per site.",[212,709,711],{"id":710},"tls-certificates","TLS certificates",[198,713,714,717,718,721,722,725,726,729],{},[202,715,716],{},"tls_days_left"," for every public site name and custom domain (",[202,719,720],{},"site_config.json"," ",[202,723,724],{},"domains","), every\nhour, in a background thread. The agent connects to ",[202,727,728],{},"\u003Cdomain>:443"," with SNI and reads the leaf\ncertificate without verifying it, so expired and self-signed certificates are measured too.",[198,731,732,733,264,736,264,739,264,742,745,746,749],{},"Skipped: ",[202,734,735],{},"localhost",[202,737,738],{},"*.localhost",[202,740,741],{},".local",[202,743,744],{},".test",", bare names, IP addresses and the ",[202,747,748],{},"example.*","\nnames. Unreachable domains are logged and skipped.",[212,751,753],{"id":752},"mariadb","MariaDB",[198,755,756,757,759,760,763],{},"Through the ",[202,758,752],{}," (or ",[202,761,762],{},"mysql",") client, with a site's own credentials written to a private\ntemporary option file, never on the command line:",[228,765,766,774],{},[231,767,768],{},[234,769,770,772],{},[237,771,239],{},[237,773,599],{},[244,775,776,792,802],{},[234,777,778,786],{},[249,779,780,264,783],{},[202,781,782],{},"db_threads_connected",[202,784,785],{},"db_connections_used_percent",[249,787,788,789],{},"against ",[202,790,791],{},"max_connections",[234,793,794,799],{},[249,795,796],{},[202,797,798],{},"db_slow_queries",[249,800,801],{},"increase per push",[234,803,804,812],{},[249,805,806,264,809],{},[202,807,808],{},"db_replication_lag_seconds",[202,810,811],{},"db_replication_running",[249,813,814],{},"on a replica",[198,816,817,818,821,822,570,825,828],{},"A site user may not read replica status (REPLICATION CLIENT \u002F SLAVE MONITOR). Then replication is\nskipped, unless ",[202,819,820],{},"mariadb.user"," \u002F ",[202,823,824],{},"password",[202,826,827],{},"mariadb.defaults_file"," names a monitoring user.\nWithout a client on the host, or for Postgres benches, nothing is sent.",[212,830,832],{"id":831},"processes","Processes",[198,834,218,835,838,839,842,843,846,847,850,851,853,854,821,856,859],{},[202,836,837],{},"supervisorctl status",", else ",[202,840,841],{},"systemctl list-units"," for units whose name contains the bench name.\n",[202,844,845],{},"bench_processes_down"," per bench counts processes that are STOPPED, EXITED, BACKOFF, FATAL or\nUNKNOWN (systemd: ",[202,848,849],{},"failed"," or a restart loop). A process entering FATAL \u002F UNKNOWN (systemd ",[202,852,849],{},")\nalso sends one ",[202,855,398],{},[202,857,858],{},"process_down"," event. Press benches run processes in containers\nand are skipped.",[212,861,863],{"id":862},"security-posture","Security posture",[228,865,866,879],{},[231,867,868],{},[234,869,870,873,876],{},[237,871,872],{},"Check",[237,874,875],{},"Every",[237,877,878],{},"Sends",[244,880,881,901,920,953,980],{},[234,882,883,888,891],{},[249,884,885],{},[696,886,887],{},"App versions",[249,889,890],{},"1 h",[249,892,893,896,897,900],{},[202,894,895],{},"app_version"," per bench and app, from ",[202,898,899],{},"apps\u002F\u003Capp>\u002F\u003Capp>\u002F__init__.py",". The Wolf site compares them with the GitHub Security Advisories of Frappe and ERPNext. Development versions are not sent.",[234,902,903,908,910],{},[249,904,905],{},[696,906,907],{},"Site settings",[249,909,890],{},[249,911,912,915,916,919],{},[202,913,914],{},"site_setting"," per site: two-factor authentication, password policy and minimum score, lockout, guest uploads, and the System Manager role's two-factor flag. Feeds the ",[207,917,918],{"href":150},"security score"," of sites other than the Wolf site.",[234,921,922,927,930],{},[249,923,924],{},[696,925,926],{},"Exposure",[249,928,929],{},"10 min",[249,931,932,935,936,939,940,264,943,946,947,264,950,210],{},[202,933,934],{},"exposed_services"," per host: bench ports listening beyond loopback (MariaDB 3306, Postgres 5432, Redis, socket.io 9000, gunicorn). ",[202,937,938],{},"site_config_risks"," per site: ",[202,941,942],{},"developer_mode",[202,944,945],{},"allow_tests",", a plain-HTTP ",[202,948,949],{},"host_name",[202,951,952],{},"allow_cors: \"*\"",[234,954,955,960,963],{},[249,956,957],{},[696,958,959],{},"File integrity",[249,961,962],{},"15 min",[249,964,965,968,969,334,972,975,976,210],{},[202,966,967],{},"integrity_files"," per bench; ",[202,970,971],{},"bench_code_changed",[202,973,974],{},"bench_config_changed"," events when an app's code, a site config or the nginx and supervisor config changes, telling a deployment from a change outside one. See ",[207,977,979],{"href":978},"\u002Fsecurity\u002Fdetection#file-integrity","Detection",[234,981,982,987,990],{},[249,983,984],{},[696,985,986],{},"Outbound connections",[249,988,989],{},"1 min",[249,991,992,995,996,999,1000,1003,1004,210],{},[202,993,994],{},"bench_outbound_destinations"," per bench; a ",[202,997,998],{},"bench_new_outbound"," event for each public network and unusual port a bench's user had never used, after a 7-day learning period; ",[202,1001,1002],{},"bench_new_outbound_usual"," counts new ones on usual ports. See ",[207,1005,979],{"href":1006},"\u002Fsecurity\u002Fdetection#outbound-connections",[198,1008,1009,1010,210],{},"See ",[207,1011,979],{"href":135},[212,1013,1015],{"id":1014},"optional-sources","Optional sources",[198,1017,1018],{},"When present on the host, the agent also tails:",[1020,1021,1022,1038],"ul",{},[1023,1024,1025,1028,1029,1033,1034,1037],"li",{},[696,1026,1027],{},"Suricata","'s EVE log, found from Suricata itself (",[207,1030,1032],{"href":1031},"\u002Fsecurity\u002Fwazuh-suricata#turn-it-on","how","): ",[202,1035,1036],{},"network_ids_alert"," events;",[1023,1039,1040,1043,1044,1047,1048,1051],{},[696,1041,1042],{},"Wazuh","'s ",[202,1045,1046],{},"alerts.json"," on the manager: ",[202,1049,1050],{},"hids_alert"," events.",[198,1053,1009,1054,210],{},[207,1055,158],{"href":159},[212,1057,1059],{"id":1058},"delivery-guarantees","Delivery guarantees",[1020,1061,1062,1069,1076],{},[1023,1063,1064,1065,1068],{},"Logs are read from the end on first start. Offsets are kept in\n",[202,1066,1067],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Ftail-state.json",", so restarts and log rotation lose nothing.",[1023,1070,1071,1072,1075],{},"Failed pushes are spooled to ",[202,1073,1074],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Foutbox\u002F"," (capped at 50 MB) and replayed in\norder with exponential backoff.",[1023,1077,1078,1079,1082],{},"Events are 