de-scale",{"title":144,"path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"title":183,"path":184,"stem":185,"children":186,"icon":189},"Internals","\u002Finternals","7.internals\u002F1.index",[187,190,195,199,204,208],{"title":188,"path":184,"stem":185,"icon":189},"Frappe Cloud v2, read from its code","i-lucide-map",{"title":191,"path":192,"stem":193,"icon":194},"The applications","\u002Finternals\u002Fapps","7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Calls and trust","\u002Finternals\u002Finterop","7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flows","\u002Finternals\u002Fflows","7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Inside a customer server","\u002Finternals\u002Fcustomer-server","7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes for Wolf","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":168,"body":214,"description":619,"extension":620,"links":621,"meta":622,"navigation":623,"path":169,"seo":624,"stem":170,"__hash__":625},"docs_en\u002F6.reference\u002F3.metric-storage.md",{"type":215,"value":216,"toc":608},"minimark",[217,226,231,306,309,328,352,355,367,370,374,381,398,413,417,423,429,436,440,446,485,492,495,500,504,513,516,530,536,539,605],[218,219,220,221,225],"p",{},"At 50 hosts × 15 metrics every 30 s, raw samples are about 2 M rows a day. Wolf therefore keeps\nthree resolutions, each with its own retention in ",[222,223,224],"strong",{},"Wolf Settings → Retention",".",[227,228,230],"h2",{"id":229},"resolutions","Resolutions",[232,233,234,253],"table",{},[235,236,237],"thead",{},[238,239,240,244,247,250],"tr",{},[241,242,243],"th",{},"Resolution",[241,245,246],{},"DocType",[241,248,249],{},"Default retention",[241,251,252],{},"Read by",[254,255,256,271,290],"tbody",{},[238,257,258,262,265,268],{},[259,260,261],"td",{},"Raw samples",[259,263,264],{},"Wolf Metric Sample",[259,266,267],{},"48 hours",[259,269,270],{},"Rule windows up to 3 h, the 1 h chart",[238,272,273,276,284,287],{},[259,274,275],{},"1-minute rollups",[259,277,278,279,283],{},"Wolf Metric Rollup (",[280,281,282],"code",{},"resolution"," 60)",[259,285,286],{},"30 days",[259,288,289],{},"Windows up to 2 days (6 h and 24 h charts)",[238,291,292,295,300,303],{},[259,293,294],{},"1-hour rollups",[259,296,278,297,299],{},[280,298,282],{}," 3600)",[259,301,302],{},"365 days",[259,304,305],{},"Longer windows (7 d chart)",[218,307,308],{},"A rollup row stores, for one series (metric, host, bench, site, labels) in one bucket:",[310,311,312,316,319,322,325],"ul",{},[313,314,315],"li",{},"count;",[313,317,318],{},"sum;",[313,320,321],{},"min;",[313,323,324],{},"max;",[313,326,327],{},"the last value, with its time.",[218,329,330,331,334,335,334,338,334,341,334,344,347,348,351],{},"So ",[280,332,333],{},"avg",", ",[280,336,337],{},"min",[280,339,340],{},"max",[280,342,343],{},"sum",[280,345,346],{},"count"," and ",[280,349,350],{},"last"," over whole buckets equal the raw answer.",[218,353,354],{},"A read takes, in order:",[356,357,358,361,364],"ol",{},[313,359,360],{},"the coarsest resolution allowed for its window, up to the last rolled bucket;",[313,362,363],{},"then finer rollups;",[313,365,366],{},"then the raw samples not rolled up yet, so the newest minutes are always there.",[218,368,369],{},"A long window loses at most one bucket at its start: under a minute for 1-minute reads, under an\nhour for 1-hour reads.",[227,371,373],{"id":372},"rollups","Rollups",[218,375,376,377,380],{},"The ",[280,378,379],{},"rollup_metrics"," job runs every minute.",[310,382,383,386,392,395],{},[313,384,385],{},"It rolls closed minutes, 2 minutes after they end, and closed hours.",[313,387,388,389,225],{},"Its progress is in ",[222,390,391],{},"Wolf Rollup State",[313,393,394],{},"It recomputes whole buckets, so running it again never double counts.",[313,396,397],{},"Samples that arrive late, for example an agent replaying its spool, move the progress back.\nTheir buckets are rolled again, up to the raw retention.",[399,400,401],"tip",{},[218,402,403,404,407,408,412],{},"Rollups, like alert rules, depend on the scheduler tick. Set ",[280,405,406],{},"scheduler_tick_interval"," to 60 (see\n",[409,410,411],"a",{"href":31},"Install the Wolf App",").",[227,414,416],{"id":415},"purge","Purge",[218,418,419,422],{},[280,420,421],{},"purge_metrics"," runs hourly and applies the retention.",[424,425,426],"note",{},[218,427,428],{},"It never deletes raw samples or 1-minute rollups that are not rolled up yet.",[218,430,431,432,435],{},"Event retention (",[280,433,434],{},"event_retention_days",") is separate and unchanged by metric retention.",[227,437,439],{"id":438},"ingest-mode","Ingest mode",[218,441,442,443,225],{},"Set in ",[222,444,445],{},"Wolf Settings → Agents → Ingest Mode",[232,447,448,458],{},[235,449,450],{},[238,451,452,455],{},[241,453,454],{},"Mode",[241,456,457],{},"Behaviour",[254,459,460,475],{},[238,461,462,468],{},[259,463,464,467],{},[280,465,466],{},"async"," (default)",[259,469,470,471,474],{},"Validates a push, queues the inserts on the ",[280,472,473],{},"short"," queue and answers at once. A worker inserts the batch and attaches its events to open incidents. If the queue is unreachable, the push is stored inline.",[238,476,477,482],{},[259,478,479],{},[280,480,481],{},"sync",[259,483,484],{},"Stores during the request.",[218,486,487,488,225],{},"In both modes, the agent's last seen time, clock skew and Wolf's health are updated during the\nrequest. The answer an agent gets in each mode is in the\n",[409,489,491],{"href":490},"\u002Freference\u002Fprotocol#ingest-mode","protocol",[227,493,173],{"id":494},"performance",[218,496,497,498,225],{},"Metric rows are stored in metric and time order, and reads of known metrics scan the primary key\nby name range. Measured results at 100 hosts × 7 days are in\n",[409,499,173],{"href":174},[227,501,503],{"id":502},"optional-time-series-backend","Optional time-series backend",[505,506,507],"warning",{},[218,508,509,510,225],{},"Design only, ",[222,511,512],{},"not built",[218,514,515],{},"The read path goes through two functions:",[310,517,518,524],{},[313,519,520,523],{},[280,521,522],{},"rollups.aggregate()",", for rules;",[313,525,526,529],{},[280,527,528],{},"rollups.series_rows()",", for charts.",[218,531,532,533,225],{},"Writes go through ",[280,534,535],{},"events.insert_metrics()",[218,537,538],{},"A ClickHouse or TimescaleDB backend would implement those three:",[232,540,541,554],{},[235,542,543],{},[238,544,545,548,551],{},[241,546,547],{},"Part",[241,549,550],{},"ClickHouse",[241,552,553],{},"TimescaleDB",[254,555,556,570,592],{},[238,557,558,560,567],{},[259,559,261],{},[259,561,562,563,566],{},"A ",[280,564,565],{},"MergeTree"," table",[259,568,569],{},"A hypertable",[238,571,572,575,586],{},[259,573,574],{},"Minute and hour rollups",[259,576,577,578,581,582,585],{},"Materialized views (",[280,579,580],{},"AggregatingMergeTree"," with ",[280,583,584],{},"sumState\u002FminState\u002FmaxState\u002FargMaxState",")",[259,587,588,589],{},"Continuous aggregates with ",[280,590,591],{},"first\u002Flast",[238,593,594,597,600],{},[259,595,596],{},"Retention",[259,598,599],{},"TTL",[259,601,602],{},[280,603,604],{},"add_retention_policy",[218,606,607],{},"The watermark logic and the purge job would then be the database's job. Until a site needs more\nthan a few hundred hosts, the Frappe tables above are enough and keep Wolf a plain Frappe app.",{"title":609,"searchDepth":610,"depth":611,"links":612},"",1,2,[613,614,615,616,617,618],{"id":229,"depth":611,"text":230},{"id":372,"depth":611,"text":373},{"id":415,"depth":611,"text":416},{"id":438,"depth":611,"text":439},{"id":494,"depth":611,"text":173},{"id":502,"depth":611,"text":503},"How Wolf stores metrics at three resolutions, rolls them up, purges them and ingests pushes.","md",null,{},{"icon":171},{"title":168,"description":619},"9Mq_MGSo0IRLBz8NdrT7JJWehkdkyYBtmumMosRQQuk",[627,629],{"title":163,"path":164,"stem":165,"description":628,"icon":166},"The read and action APIs behind the Wolf UI at \u002Fwolf, their arguments, answers and access rules.",{"title":173,"path":174,"stem":175,"description":630,"icon":176},"Load test results at 100 hosts for 7 days, what changed to reach them, and how to run the test again.",1795108882433]