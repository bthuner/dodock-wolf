,432,433],{"class":256}," -t",[242,435,436],{"class":256}," .",[242,438,439],{"class":313},"           # app pure-python tests\n",[242,441,442,444,446,448,450,452,455],{"class":244,"line":292},[242,443,415],{"class":260},[242,445,418],{"class":256},[242,447,421],{"class":256},[242,449,424],{"class":256},[242,451,427],{"class":256},[242,453,454],{"class":256}," agent\u002Ftests",[242,456,457],{"class":313},"          # agent tests\n",[198,459,461],{"id":460},"wolf-ui","Wolf UI",[203,463,464,465,468,469,474,475,482,483,216],{},"The operator UI at ",[213,466,467],{},"\u002Fwolf"," is a Vue app built on ",[207,470,473],{"href":471,"rel":472},"https:\u002F\u002Fui.frappe.io",[211],"frappe-ui"," in\n",[207,476,479],{"href":477,"rel":478},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Ffrontend\u002F",[211],[213,480,481],{},"frontend\u002F","\n(",[207,484,487],{"href":485,"rel":486},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F19",[211],"#19",[489,490,491,495,498],"ul",{},[492,493,494],"li",{},"Desk keeps the configuration DocTypes and stays usable for everything the Wolf UI does not show\nyet.",[492,496,497],{},"Its views are added one by one. A view that is not built says so and links to Desk.",[492,499,500],{},"It reuses the Frappe session: guests are sent to the login page, users without the Wolf User or\nWolf Manager role get a 403.",[203,502,503,504,511],{},"Screenshots, light and dark, all taken on the demo bench after its 2AM scenario, are in\n",[207,505,508],{"href":506,"rel":507},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Fdocs\u002Fscreenshots\u002FREADME.md",[211],[213,509,510],{},"docs\u002Fscreenshots",".",[233,513,515],{"className":235,"code":514,"filename":481,"language":237,"meta":238,"style":238},"cd frontend\nyarn install\nyarn dev        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\nyarn test       # unit and component tests (Vitest)\nyarn build      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\nyarn e2e        # browser tests of that build (Playwright + axe), after `yarn build`\n",[213,516,517,526,534,545,556,567],{"__ignoreMap":238},[242,518,519,523],{"class":244,"line":245},[242,520,522],{"class":521},"s2Zo4","cd",[242,524,525],{"class":256}," frontend\n",[242,527,528,531],{"class":244,"line":292},[242,529,530],{"class":260},"yarn",[242,532,533],{"class":256}," install\n",[242,535,537,539,542],{"class":244,"line":536},3,[242,538,530],{"class":260},[242,540,541],{"class":256}," dev",[242,543,544],{"class":313},"        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\n",[242,546,548,550,553],{"class":244,"line":547},4,[242,549,530],{"class":260},[242,551,552],{"class":256}," test",[242,554,555],{"class":313},"       # unit and component tests (Vitest)\n",[242,557,559,561,564],{"class":244,"line":558},5,[242,560,530],{"class":260},[242,562,563],{"class":256}," build",[242,565,566],{"class":313},"      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\n",[242,568,570,572,575],{"class":244,"line":569},6,[242,571,530],{"class":260},[242,573,574],{"class":256}," e2e",[242,576,577],{"class":313},"        # browser tests of that build (Playwright + axe), after `yarn build`\n",[579,580,581],"note",{},[203,582,583,584,587],{},"Node 20.19 or newer is required. The build output is not committed:\n",[213,585,586],{},"bench build --app dodock_wolf"," produces it on the bench.",[589,590,592],"h3",{"id":591},"browser-tests","Browser tests",[203,594,595,596,599,600,603,604,607],{},"The browser tests (",[213,597,598],{},"frontend\u002Fe2e\u002F",") serve the production build as a bench would\n(",[213,601,602],{},"e2e\u002Fserver.mjs",") and answer every API call in the page (",[213,605,606],{},"e2e\u002Fapi.js","), so no Frappe is needed.",[203,609,610],{},"Each view must:",[489,612,613,616],{},[492,614,615],{},"render with no console error and no unanswered call;",[492,617,618],{},"pass axe with no serious or critical WCAG 2 A\u002FAA finding, in the light and the dark theme.",[203,620,621],{},"Keyboard navigation, reduced motion, acknowledging an incident and where keyboard focus goes are\nchecked too.",[203,623,624,627],{},[213,625,626],{},"e2e\u002Fstates.spec.js"," walks every view through loading, empty, filtered-empty, error, forbidden,\npartial, stale and disconnected. A view never claims \"nothing\" before it has read, or after a\nread failed, and a refusal says what may not be seen.",[203,629,630,631,634,635,638],{},"The tests need Chromium: run ",[213,632,633],{},"npx playwright install chromium",", or point ",[213,636,637],{},"WOLF_CHROMIUM"," at an\ninstalled one.",[203,640,641,642,511],{},"The APIs the UI reads are in ",[207,643,173],{"href":174},[198,645,647],{"id":646},"ci-checks","CI checks",[203,649,650,651,654,655,662],{},"Every pull request and every push to ",[213,652,653],{},"main"," runs\n",[207,656,659],{"href":657,"rel":658},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002F.github\u002Fworkflows\u002Fci.yml",[211],[213,660,661],{},".github\u002Fworkflows\u002Fci.yml",":",[316,664,665,675],{},[319,666,667],{},[322,668,669,672],{},[325,670,671],{},"Job",[325,673,674],{},"Runs on",[335,676,677,684,692,700,708,716],{},[322,678,679,682],{},[340,680,681],{},"Lint (ruff, shellcheck)",[340,683],{},[322,685,686,689],{},[340,687,688],{},"App tests",[340,690,691],{},"Python 3.12",[322,693,694,697],{},[340,695,696],{},"Agent tests",[340,698,699],{},"Python 3.9 and 3.14",[322,701,702,705],{},[340,703,704],{},"Wolf UI tests and build",[340,706,707],{},"Node 20.19 and 24",[322,709,710,713],{},[340,711,712],{},"Wolf UI browser tests",[340,714,715],{},"Playwright + axe",[322,717,718,721],{},[340,719,720],{},"Bench integration",[340,722,723],{},"MariaDB 10.6 and Postgres 16",[203,725,726],{},"To run the same checks local