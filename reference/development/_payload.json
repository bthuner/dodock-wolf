306,307,310,311,314,315,318,319,322,323,326,327,329],{},[213,308,309],{},"press-agent"," registers as ",[213,312,313],{},"f1-demo-press"," in Press mode. ",[213,316,317],{},"press-demo"," runs\n",[213,320,321],{},"bench generate-demo-press",": 7 days of history for 3 benches and 8 sites, then an incident cycle\nevery 30 minutes, with alerts sent to the stack's webhook sink (",[213,324,325],{},"docker compose logs catcher",").\n",[207,328,70],{"href":71}," lists what a cycle contains.",[198,331,333],{"id":332},"python-tests","Python tests",[237,335,338],{"className":239,"code":336,"filename":337,"language":241,"meta":242,"style":242},"python3 -m unittest discover -s tests -t .           # app pure-python tests\npython3 -m unittest discover -s agent\u002Ftests          # agent tests\n","repository root",[213,339,340,369],{"__ignoreMap":242},[246,341,342,345,348,351,354,357,360,363,366],{"class":248,"line":249},[246,343,344],{"class":264},"python3",[246,346,347],{"class":260}," -m",[246,349,350],{"class":260}," unittest",[246,352,353],{"class":260}," discover",[246,355,356],{"class":260}," -s",[246,358,359],{"class":260}," tests",[246,361,362],{"class":260}," -t",[246,364,365],{"class":260}," .",[246,367,368],{"class":303},"           # app pure-python tests\n",[246,370,371,373,375,377,379,381,384],{"class":248,"line":286},[246,372,344],{"class":264},[246,374,347],{"class":260},[246,376,350],{"class":260},[246,378,353],{"class":260},[246,380,356],{"class":260},[246,382,383],{"class":260}," agent\u002Ftests",[246,385,386],{"class":303},"          # agent tests\n",[198,388,390],{"id":389},"wolf-ui","Wolf UI",[203,392,393,394,397,398,403,404,411,412,216],{},"The operator UI at ",[213,395,396],{},"\u002Fwolf"," is a Vue app built on ",[207,399,402],{"href":400,"rel":401},"https:\u002F\u002Fui.frappe.io",[211],"frappe-ui"," in\n",[207,405,408],{"href":406,"rel":407},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Ffrontend\u002F",[211],[213,409,410],{},"frontend\u002F","\n(",[207,413,416],{"href":414,"rel":415},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F19",[211],"#19",[418,419,420,424,427],"ul",{},[421,422,423],"li",{},"Desk keeps the configuration DocTypes and stays usable for everything the Wolf UI does not show\nyet.",[421,425,426],{},"Its views are added one by one. A view that is not built says so and links to Desk.",[421,428,429],{},"It reuses the Frappe session: guests are sent to the login page, users without the Wolf User or\nWolf Manager role get a 403.",[203,431,432,433,440],{},"Screenshots, light and dark, all taken on the demo bench after its 2AM scenario, are in\n",[207,434,437],{"href":435,"rel":436},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Fdocs\u002Fscreenshots\u002FREADME.md",[211],[213,438,439],{},"docs\u002Fscreenshots",".",[237,442,444],{"className":239,"code":443,"filename":410,"language":241,"meta":242,"style":242},"cd frontend\nyarn install\nyarn dev        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\nyarn test       # unit and component tests (Vitest)\nyarn build      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\nyarn e2e        # browser tests of that build (Playwright + axe), after `yarn build`\n",[213,445,446,455,463,474,485,496],{"__ignoreMap":242},[246,447,448,452],{"class":248,"line":249},[246,449,451],{"class":450},"s2Zo4","cd",[246,453,454],{"class":260}," frontend\n",[246,456,457,460],{"class":248,"line":286},[246,458,459],{"class":264},"yarn",[246,461,462],{"class":260}," install\n",[246,464,466,468,471],{"class":248,"line":465},3,[246,467,459],{"class":264},[246,469,470],{"class":260}," dev",[246,472,473],{"class":303},"        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\n",[246,475,477,479,482],{"class":248,"line":476},4,[246,478,459],{"class":264},[246,480,481],{"class":260}," test",[246,483,484],{"class":303},"       # unit and component tests (Vitest)\n",[246,486,488,490,493],{"class":248,"line":487},5,[246,489,459],{"class":264},[246,491,492],{"class":260}," build",[246,494,495],{"class":303},"      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\n",[246,497,499,501,504],{"class":248,"line":498},6,[246,500,459],{"class":264},[246,502,503],{"class":260}," e2e",[246,505,506],{"class":303},"        # browser tests of that build (Playwright + axe), after `yarn build`\n",[508,509,510],"note",{},[203,511,512,513,516],{},"Node 20.19 or newer is required. The build output is not committed:\n",[213,514,515],{},"bench build --app dodock_wolf"," produces it on the bench.",[518,519,521],"h3",{"id":520},"browser-tests","Browser tests",[203,523,524,525,528,529,532,533,536],{},"The browser tests (",[213,526,527],{},"frontend\u002Fe2e\u002F",") serve the production build as a bench would\n(",[213,530,531],{},"e2e\u002Fserver.mjs",") and answer every API call in the page (",[213,534,535],{},"e2e\u002Fapi.js","), so no Frappe is needed.",[203,538,539],{},"Each view must:",[418,541,542,545],{},[421,543,544],{},"render with no console error and no unanswered call;",[421,546,547],{},"pass axe with no serious or critical WCAG 2 A\u002FAA finding, in the light and the dark theme.",[203,549,550],{},"Keyboard navigation, reduced motion, acknowledging an incident and where keyboard focus goes are\nchecked too.",[203,552,553,556],{},[213,554,555],{},"e2e\u002Fstates.spec.js"," walks every view through loading, empty, filtered-empty, error, forbidden,\npartial, stale and disconnected. A view never claims \"nothing\" before it has read, or after a\nread failed, and a refusal says what may not be seen.",[203,558,559,560,563,564,567],{},"The tests need Chromium: run ",[213,561,562],{},"npx playwright install chromium",", or point ",[213,565,566],{},"WOLF_CHROMIUM"," at an\ninstalled one.",[203,569,570,571,440],{},"The APIs the UI reads are in ",[2