\u002Ffrontend\u002F",[231],[233,396,397],{},"frontend\u002F","\n(",[227,400,403],{"href":401,"rel":402},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F19",[231],"#19",[405,406,407,411,414],"ul",{},[408,409,410],"li",{},"Desk keeps the configuration DocTypes and stays usable for everything the Wolf UI does not show\nyet.",[408,412,413],{},"Its views are added one by one. A view that is not built says so and links to Desk.",[408,415,416],{},"It reuses the Frappe session: guests are sent to the login page, users without the Wolf User or\nWolf Manager role get a 403.",[223,418,419,420,427],{},"Screenshots, light and dark, all taken on the demo bench after its 2AM scenario, are in\n",[227,421,424],{"href":422,"rel":423},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Fdocs\u002Fscreenshots\u002FREADME.md",[231],[233,425,426],{},"docs\u002Fscreenshots",".",[272,429,431],{"className":274,"code":430,"filename":397,"language":276,"meta":277,"style":277},"cd frontend\nyarn install\nyarn dev        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\nyarn test       # unit and component tests (Vitest)\nyarn build      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\nyarn e2e        # browser tests of that build (Playwright + axe), after `yarn build`\n",[233,432,433,442,450,461,472,483],{"__ignoreMap":277},[281,434,435,439],{"class":283,"line":284},[281,436,438],{"class":437},"s2Zo4","cd",[281,440,441],{"class":291}," frontend\n",[281,443,444,447],{"class":283,"line":310},[281,445,446],{"class":287},"yarn",[281,448,449],{"class":291}," install\n",[281,451,453,455,458],{"class":283,"line":452},3,[281,454,446],{"class":287},[281,456,457],{"class":291}," dev",[281,459,460],{"class":354},"        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\n",[281,462,464,466,469],{"class":283,"line":463},4,[281,465,446],{"class":287},[281,467,468],{"class":291}," test",[281,470,471],{"class":354},"       # unit and component tests (Vitest)\n",[281,473,475,477,480],{"class":283,"line":474},5,[281,476,446],{"class":287},[281,478,479],{"class":291}," build",[281,481,482],{"class":354},"      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\n",[281,484,486,488,491],{"class":283,"line":485},6,[281,487,446],{"class":287},[281,489,490],{"class":291}," e2e",[281,492,493],{"class":354},"        # browser tests of that build (Playwright + axe), after `yarn build`\n",[495,496,497],"note",{},[223,498,499,500,503],{},"Node 20.19 or newer is required. The build output is not committed:\n",[233,501,502],{},"bench build --app dodock_wolf"," produces it on the bench.",[256,505,507],{"id":506},"browser-tests","Browser tests",[223,509,510,511,514,515,518,519,522],{},"The browser tests (",[233,512,513],{},"frontend\u002Fe2e\u002F",") serve the production build as a bench would\n(",[233,516,517],{},"e2e\u002Fserver.mjs",") and answer every API call in the page (",[233,520,521],{},"e2e\u002Fapi.js","), so no Frappe is needed.",[223,524,525],{},"Each view must:",[405,527,528,531],{},[408,529,530],{},"render with no console error and no unanswered call;",[408,532,533],{},"pass axe with no serious or critical WCAG 2 A\u002FAA finding, in the light and the dark theme.",[223,535,536],{},"Keyboard navigation, reduced motion, acknowledging an incident and where keyboard focus goes are\nchecked too.",[223,538,539,542],{},[233,540,541],{},"e2e\u002Fstates.spec.js"," walks every view through loading, empty, filtered-empty, error, forbidden,\npartial, stale and disconnected. A view never claims \"nothing\" before it has read, or after a\nread failed, and a refusal says what may not be seen.",[223,544,545,546,549,550,553],{},"The tests need Chromium: run ",[233,547,548],{},"npx playwright install chromium",", or point ",[233,551,552],{},"WOLF_CHROMIUM"," at an\ninstalled one.",[223,555,556,557,427],{},"The APIs