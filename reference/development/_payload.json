\u002Fscreenshots",".",[242,399,401],{"className":244,"code":400,"filename":367,"language":246,"meta":247,"style":247},"cd frontend\nyarn install\nyarn dev        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\nyarn test       # unit and component tests (Vitest)\nyarn build      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\nyarn e2e        # browser tests of that build (Playwright + axe), after `yarn build`\n",[203,402,403,412,420,431,442,453],{"__ignoreMap":247},[251,404,405,409],{"class":253,"line":254},[251,406,408],{"class":407},"s2Zo4","cd",[251,410,411],{"class":261}," frontend\n",[251,413,414,417],{"class":253,"line":280},[251,415,416],{"class":257},"yarn",[251,418,419],{"class":261}," install\n",[251,421,423,425,428],{"class":253,"line":422},3,[251,424,416],{"class":257},[251,426,427],{"class":261}," dev",[251,429,430],{"class":324},"        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\n",[251,432,434,436,439],{"class":253,"line":433},4,[251,435,416],{"class":257},[251,437,438],{"class":261}," test",[251,440,441],{"class":324},"       # unit and component tests (Vitest)\n",[251,443,445,447,450],{"class":253,"line":444},5,[251,446,416],{"class":257},[251,448,449],{"class":261}," build",[251,451,452],{"class":324},"      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\n",[251,454,456,458,461],{"class":253,"line":455},6,[251,457,416],{"class":257},[251,459,460],{"class":261}," e2e",[251,462,463],{"class":324},"        # browser tests of that build (Playwright + axe), after `yarn build`\n",[465,466,467],"note",{},[193,468,469,470,473],{},"Node 20.19 or newer is required. The build output is not committed:\n",[203,471,472],{},"bench build --app dodock_wolf"," produces it on the bench.",[226,475,477],{"id":476},"browser-tests","Browser tests",[193,479,480,481,484,485,488,489,492],{},"The browser tests (",[203,482,483],{},"frontend\u002Fe2e\u002F",") serve the production build as a bench would\n(",[203,486,487],{},"e2e\u002Fserver.mjs",") and answer every API call in the page (",[203,490,491],{},"e2e\u002Fapi.js","), so no Frappe is needed.",[193,494,495],{},"Each view must:",[375,497,498,501],{},[378,499,500],{},"render with no console error and no unanswered call;",[378,502,503],{},"pass axe with no serious or critical WCAG 2 A\u002FAA finding, in the light and the dark theme.",[193,505,506],{},"Keyboard navigation, reduced motion, acknowledging an incident and where keyboard focus goes are\nchecked too.",[193,508,509,512],{},[203,510,511],{},"e2e\u002Fstates.spec.js"," walks every view through loading, empty, filtered-empty, error, forbidden,\npartial, stale and disconnected. A view never claims \"nothing\" before it has read, or after a\nread failed, and a refusal says what may not be seen.",[193,514,515,516,519,520,523],{},"The tests need Chromium: run ",[203,517,518],{},"npx playwright install chromium",", or point ",[203,521,522],{},"WOLF_CHROMIUM"," at an\ninstalled one.",[193,525,526,527,397],{},"The APIs the UI reads are in ",[197,528,163],{"href":164},[188,530,532],{"id":531},"ci-checks","CI checks",[193,534,535,536,539,540,547],{},"Every pull request and every push to ",[203,537,538],{},"main"," runs\n",[197,541,544],{"href":542,"rel":543},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002F.github\u002Fworkflows\u002Fci.yml",[201],[203,545,546],{},".github\u002Fworkflows\u002Fci.yml",":",[549,550,551,564],"table",{},[552,553,554],"thead",{},[555,556,557,561],"tr",{},[558,559,560],"th",{},"Job",[558,562,563],{},"Runs on",[565,566,567,575,583,591,599,607],"tbody",{},[555,568,569,573],{},[570,571,572],"td",{},"Lint (ruff, shellcheck)",[570,574],{},[555,576,577,580],{},[570,578,579],{},"App tests",[570,581,582],{},"Python 3.12",[555,584,585,588],{},[570,586,587],{},"Agent tests",[570,589,590],{},"Python 3.9 and 3.14",[555,592,593,596],{},[570,594,595],{},"Wolf U