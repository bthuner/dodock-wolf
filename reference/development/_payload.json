,423,424,426,428,430,433,435,437],{"class":244,"line":245},[242,425,295],{"class":260},[242,427,264],{"class":256},[242,429,267],{"class":256},[242,431,432],{"class":256}," ids",[242,434,283],{"class":256},[242,436,286],{"class":256},[242,438,289],{"class":256},[242,440,441,444],{"class":244,"line":292},[242,442,443],{"class":260},"python3",[242,445,446],{"class":256}," ids_scenario.py\n",[198,448,450],{"id":449},"python-tests","Python tests",[233,452,455],{"className":235,"code":453,"filename":454,"language":237,"meta":238,"style":238},"python3 -m unittest discover -s tests -t .           # app pure-python tests\npython3 -m unittest discover -s agent\u002Ftests          # agent tests\n","repository root",[213,456,457,485],{"__ignoreMap":238},[242,458,459,461,464,467,470,473,476,479,482],{"class":244,"line":245},[242,460,443],{"class":260},[242,462,463],{"class":256}," -m",[242,465,466],{"class":256}," unittest",[242,468,469],{"class":256}," discover",[242,471,472],{"class":256}," -s",[242,474,475],{"class":256}," tests",[242,477,478],{"class":256}," -t",[242,480,481],{"class":256}," .",[242,483,484],{"class":313},"           # app pure-python tests\n",[242,486,487,489,491,493,495,497,500],{"class":244,"line":292},[242,488,443],{"class":260},[242,490,463],{"class":256},[242,492,466],{"class":256},[242,494,469],{"class":256},[242,496,472],{"class":256},[242,498,499],{"class":256}," agent\u002Ftests",[242,501,502],{"class":313},"          # agent tests\n",[198,504,506],{"id":505},"wolf-ui","Wolf UI",[203,508,509,510,513,514,519,520,527,528,216],{},"The operator UI at ",[213,511,512],{},"\u002Fwolf"," is a Vue app built on ",[207,515,518],{"href":516,"rel":517},"https:\u002F\u002Fui.frappe.io",[211],"frappe-ui"," in\n",[207,521,524],{"href":522,"rel":523},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Ffrontend\u002F",[211],[213,525,526],{},"frontend\u002F","\n(",[207,529,532],{"href":530,"rel":531},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F19",[211],"#19",[534,535,536,540,543],"ul",{},[537,538,539],"li",{},"Desk keeps the configuration DocTypes and stays usable for everything the Wolf UI does not show\nyet.",[537,541,542],{},"Its views are added one by one. A view that is not built says so and links to Desk.",[537,544,545],{},"It reuses the Frappe session: guests are sent to the login page, users without the Wolf User or\nWolf Manager role get a 403.",[203,547,548,549,556],{},"Screenshots, light and dark, all taken on the demo bench after its 2AM scenario, are in\n",[207,550,553],{"href":551,"rel":552},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Fdocs\u002Fscreenshots\u002FREADME.md",[211],[213,554,555],{},"docs\u002Fscreenshots",".",[233,558,560],{"className":235,"code":559,"filename":526,"language":237,"meta":238,"style":238},"cd frontend\nyarn install\nyarn dev        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\nyarn test       # unit and component tests (Vitest)\nyarn build      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\nyarn e2e        # browser tests of that build (Playwright + axe), after `yarn build`\n",[213,561,562,571,579,590,601,612],{"__ignoreMap":238},[242,563,564,568],{"class":244,"line":245},[242,565,567],{"class":566},"s2Zo4","cd",[242,569,570],{"class":256}," frontend\n",[242,572,573,576],{"class":244,"line":292},[242,574,575],{"class":260},"yarn",[242,577,578],{"class":256}," install\n",[242,580,582,584,587],{"class":244,"line":581},3,[242,583,575],{"class":260},[242,585,586],{"class":256}," dev",[242,588,589],{"class":313},"        # Vite on the bench port + 80 (8080 for 8000), proxied to the bench\n",[242,591,593,595,598],{"class":244,"line":592},4,[242,594,575],{"class":260},[242,596,597],{"class":256}," test",[242,599,600],{"class":313},"       # unit and component tests (Vitest)\n",[242,602,604,606,609],{"class":244,"line":603},5,[242,605,575],{"class":260},[242,607,608],{"class":256}," build",[242,610,611],{"class":313},"      # writes dodock_wolf\u002Fpublic\u002Ffrontend and dodock_wolf\u002Fwww\u002Fwolf.html\n",[242,613,615,617,620],{"class":244,"line":614},6,[242,616,575],{"class":260},[242,618,619],{"class":256}," e2e",[242,621,622],{"class":313},"        # browser tests of that build (Playwright + axe), after `yarn build`\n",[624,625,626],"note",{},[203,627,628,629,632],{},"Node 20.19 or newer is required. The build output is not committed:\n",[213,630,631],{},"bench build --app dodock_wolf"," produces it on the bench.",[402,634,636],{"id":635},"browser-tests","Browser tests",[203,638,639,640,643,644,647,648,651],{},"The browser tests (",[213,641,642],{},"frontend\u002Fe2e\u002F",") serve the production build as a bench would\n(",[213,645,646],{},"e2e\u002Fserver.mjs",") and answer every API call in the page (",[213,649,650],{},"e2e\u002Fapi.js","), so no Frappe is needed.",[203,653,654],{},"Each view must:",[534,656,657,660],{},[537,658,659],{},"render with no console error and no unanswered call;",[537,661,662],{},"pass axe with no serious or critical WCAG 2 A\u002FAA finding, in the light and the dark theme.",[203,664,665],{},"Keyboard navigation, reduced motion, acknowledging an incident and where keyboard focus goes are\nchecked too.",[203,667,668,671],{},[213,669,670],{},"e2e\u002Fstates.spec.js"," walks every view through loading, empty, filtered-empty, error, forbidden,\npartial, stale and disconnected. A view never claims \"nothing\" before it has read, or after a\nread failed, and a refusal says what may not be seen.",[203,673,674,675,678,679,682],{},"The tests need Chromium: run ",[213,676,677],{},"npx playwright install chromium",", or point ",[213,680,681],{},"WOLF_CHROMIUM"," at an\ninstalled one.",[203,684,685,686,556],{},"The APIs the UI reads are in ",[207,687,173],{"href":174},[198,689,691],{"id":690},"ci-checks","CI checks",[203,693,694,695,698,699,706],{},"Every