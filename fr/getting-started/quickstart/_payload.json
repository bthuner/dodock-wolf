":130,"stem":131,"icon":132},"Signaux du site","\u002Ffr\u002Fsecurity\u002Fsite-signals","fr\u002F5.security\u002F2.site-signals","i-lucide-globe",{"title":134,"path":135,"stem":136,"icon":137},"Détection web et hôte","\u002Ffr\u002Fsecurity\u002Fdetection","fr\u002F5.security\u002F3.detection","i-lucide-radar",{"title":139,"path":140,"stem":141,"icon":142},"Accès et secrets","\u002Ffr\u002Fsecurity\u002Faccess","fr\u002F5.security\u002F4.access","i-lucide-key-round",{"title":144,"path":145,"stem":146,"icon":147},"Journal et leurres","\u002Ffr\u002Fsecurity\u002Fjournal","fr\u002F5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Conformité et posture","\u002Ffr\u002Fsecurity\u002Fcompliance","fr\u002F5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"Export SIEM","\u002Ffr\u002Fsecurity\u002Fsiem-export","fr\u002F5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh et Suricata","\u002Ffr\u002Fsecurity\u002Fwazuh-suricata","fr\u002F5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Référence","i-lucide-book-marked","\u002Ffr\u002Freference","fr\u002F6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Protocole de l'agent","\u002Ffr\u002Freference\u002Fprotocol","fr\u002F6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"API de l'UI","\u002Ffr\u002Freference\u002Fui-api","fr\u002F6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Stockage des métriques","\u002Ffr\u002Freference\u002Fmetric-storage","fr\u002F6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Ffr\u002Freference\u002Fperformance","fr\u002F6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Développement","\u002Ffr\u002Freference\u002Fdevelopment","fr\u002F6.reference\u002F5.development","i-lucide-code",{"id":193,"title":13,"body":194,"description":655,"extension":656,"links":657,"meta":658,"navigation":659,"path":14,"seo":660,"stem":15,"__hash__":661},"docs_fr\u002Ffr\u002F1.getting-started\u002F2.quickstart.md",{"type":195,"value":196,"toc":651},"minimark",[197,201,213,550,555,562,605,624,628,647],[198,199,200],"p",{},"Ce guide met en place Dodock Wolf sur un bench : la Wolf App sur un site, le Wolf Agent sur\nl'hôte, et une alerte par e-mail pour les pics de 502. Prévoyez un après-midi.",[198,202,203,207,208,212],{},[204,205,206],"strong",{},"Il vous faut :"," un bench Frappe 15 ou Dokos (Dodock 5), Node 20.19 ou ultérieur pour\n",[209,210,211],"code",{},"bench build",", un accès root sur l'hôte, et un site qui hébergera les données de Wolf (il peut\ns'agir d'un site existant).",[214,215,217,222,287,303,307,310,338,348,352,359,413,436,440,477,491,495,514,520,524,531],"steps",{"level":216},"3",[218,219,221],"h3",{"id":220},"installer-la-wolf-app","Installer la Wolf App",[223,224,230],"pre",{"className":225,"code":226,"filename":227,"language":228,"meta":229,"style":229},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","cd ~\u002Ffrappe-bench\nbench get-app https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\nbench --site wolf.example.com install-app dodock_wolf\nbench build --app dodock_wolf\n","bench","bash","",[209,231,232,245,257,274],{"__ignoreMap":229},[233,234,237,241],"span",{"class":235,"line":236},"line",1,[233,238,240],{"class":239},"s2Zo4","cd",[233,242,244],{"class":243},"sfazB"," ~\u002Ffrappe-bench\n",[233,246,248,251,254],{"class":235,"line":247},2,[233,249,227],{"class":250},"sBMFI",[233,252,253],{"class":243}," get-app",[233,255,256],{"class":243}," https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\n",[233,258,260,262,265,268,271],{"class":235,"line":259},3,[233,261,227],{"class":250},[233,263,264],{"class":243}," --site",[233,266,267],{"class":243}," wolf.example.com",[233,269,270],{"class":243}," install-app",[233,272,273],{"class":243}," dodock_wolf\n",[233,275,277,279,282,285],{"class":235,"line":276},4,[233,278,227],{"class":250},[233,280,281],{"class":243}," build",[233,283,284],{"class":243}," --app",[233,286,273],{"class":243},[198,288,289,290,293,294,297,298,302],{},"L'installation crée les rôles ",[204,291,292],{},"Wolf Manager"," et ",[204,295,296],{},"Wolf User",", un jeton d'enregistrement et les\n",[299,300,301],"a",{"href":102},"règles d'alerte prédéfinies",".",[218,304,306],{"id":305},"lancer-le-planificateur-chaque-minute","Lancer le planificateur chaque minute",[198,308,309],{},"Wolf évalue les règles chaque minute, mais Frappe 15 et Dodock ont par défaut un tick toutes les\n4 minutes.",[223,311,313],{"className":225,"code":312,"filename":227,"language":228,"meta":229,"style":229},"bench set-config -g scheduler_tick_interval 60\n# puis redémarrez le processus du planificateur du bench (supervisor ou systemd)\n",[209,314,315,332],{"__ignoreMap":229},[233,316,317,319,322,325,328],{"class":235,"line":236},[233,318,227],{"class":250},[233,320,321],{"class":243}," set-config",[233,323,324],{"class":243}," -g",[233,326,327],{"class":243}," scheduler_tick_interval",[233,329,331],{"class":330},"sbssI"," 60\n",[233,333,334],{"class":235,"line":247},[233,335,337],{"class":336},"sHwdD","# puis redémarrez le processus du planificateur du bench (supervisor ou systemd)\n",[339,340,341],"warning",{},[198,342,343,344,347],{},"Sans ce réglage, une alerte peut arriver jusqu'à 4 minutes en retard, et « déclencher après\n3 évaluations » signifie 12 minutes. La page ",[204,345,346],{},"Monitoring"," de la Wolf UI affiche le rythme en\nvigueur.",[218,349,351],{"id":350},"installer-lagent-sur-lhôte","Installer l'agent sur l'hôte",[198,353,354,355,358],{},"Ouvrez ",[204,356,357],{},"Wolf Settings → Agent install command"," et copiez la commande en une ligne. Elle\nressemble à ceci :",[223,360,363],{"className":225,"code":361,"filename":362,"language":228,"meta":229,"style":229},"curl -fsSL https:\u002F\u002Fraw.githubusercontent.com\u002Fbthuner\u002Fdodock-wolf\u002Fmain\u002Fagent\u002Finstall.sh \\\n  | sudo WOLF_URL=https:\u002F\u002Fwolf.example.com WOLF_TOKEN=\u003Cregistration token> bash\n","hôte",[209,364,365,380],{"__ignoreMap":229},[233,366,367,370,373,376],{"class":235,"line":236},[233,368,369],{"class":250},"curl",[233,371,372],{"class":243}," -fsSL",[233,374,375],{"class":243}," https:\u002F\u002Fraw.githubusercontent.com\u002Fbthuner\u002Fdodock-wolf\u002Fmain\u002Fagent\u002Finstall.sh",[233,377,379],{"class":378},"sTEyZ"," \\\n",[233,381,382,386,389,392,395,398,401,404,407,410],{"class":235,"line":247},[233,383,385],{"class":384},"sMK4o","  |",[233,387,388],{"class":250}," sudo",[233,390,391],{"class":243}," WOLF_URL=https:\u002F\u002Fwolf.example.com",[233,393,394],{"class":243}," WOLF_TOKEN=",[233,396,397],{"class":384},"\u003C",[233,399,400],{"class":243},"registration",[233,402,403],{"class":243}," toke",[233,405,406],{"class":378},"n",[233,408,409],{"class":384},">",[233,411,412],{"class":243}," bash\n",[198,414,415,416,419,420,423,424,427,428,431,432,435],{},"Le script installe l'agent dans ",[209,417,418],{},"\u002Fopt\u002Fwolf-agent"," (lié en ",[209,421,422],{},"\u002Fusr\u002Flocal\u002Fbin\u002Fwolf-agent","), crée un\nutilisateur système ",[209,425,426],{},"wolf-agent",", enregistre l'hôte, écrit ",[209,429,430],{},"\u002Fetc\u002Fwolf-agent\u002Fconfig.json"," et\ndémarre ",[209,433,434],{},"wolf-agent.service",". Il trouve vos benches tout seul.",[218,437,439],{"id":438},"vérifier-ce-que-voit-lagent","Vérifier ce que voit l'agent",[223,441,443],{"className":225,"code":442,"filename":362,"language":228,"meta":229,"style":229},"sudo -u wolf-agent wolf-agent discover\nsudo -u wolf-agent wolf-agent check --status\n",[209,444,445,461],{"__ignoreMap":229},[233,446,447,450,453,456,458],{"class":235,"line":236},[233,448,449],{"class":250},"sudo",[233,451,452],{"class":243}," -u",[233,454,455],{"class":243}," wolf-agent",[233,457,455],{"class":243},[233,459,460],{"class":243}," discover\n",[233,462,463,465,467,469,471,474],{"class":235,"line":247},[233,464,449],{"class":250},[233,466,452],{"class":243},[233,468,455],{"class":243},[233,470,455],{"class":243},[233,472,473],{"class":243}," check",[233,475,476],{"class":243}," --status\n",[198,478,479,482,483,486,487,490],{},[209,480,481],{},"discover"," liste les benches, les sites et les chemins des logs. ",[209,484,485],{},"check"," collecte une fois et\naffiche le JSON qu'il enverrait, sans l'envoyer. ",[209,488,489],{},"--status"," demande aussi au site son état de\nsanté.",[218,492,494],{"id":493},"ajouter-un-canal-à-une-règle","Ajouter un canal à une règle",[198,496,497,498,501,502,505,506,510,511,302],{},"Les règles prédéfinies ouvrent des incidents mais ne préviennent personne tant que vous n'avez pas\najouté de canal. Ouvrez ",[204,499,500],{},"Wolf Alert Rule → 502 spike after deployment",", ajoutez une ligne dans\n",[204,503,504],{},"Channels"," (type ",[507,508,509],"em",{},"Email",", votre adresse), enregistrez, puis cliquez sur ",[204,512,513],{},"Send test\nnotification",[198,515,516,517,519],{},"Voir ",[299,518,106],{"href":107}," pour Slack, Raven, PagerDuty et les autres types.",[218,521,523],{"id":522},"ouvrir-la-wolf-ui","Ouvrir la Wolf UI",[198,525,526,527,530],{},"Rendez-vous sur ",[209,528,529],{},"https:\u002F\u002Fwolf.example.com\u002Fwolf",". La vue d'ensemble liste les hôtes, les benches et\nles sites avec leurs dernières métriques et leurs incidents ouverts. L'hôte apparaît dans la minute\nqui suit le premier envoi.",[198,532,533,534,537,538,541,542,545,546,549],{},"Pour regarder un moment précis, sélectionnez une plage sur le graphique ",[204,535,536],{},"HTTP responses"," :\nfaites glisser la souris dessus, ou cliquez sur son premier puis son dernier point (au clavier :\nles flèches, puis deux fois Entrée). Le graphique, les chiffres sous ",[204,539,540],{},"In this window"," et les\npages Events et Errors ouvertes depuis ceux-ci couvrent alors cette plage. Les chiffres sous\n",[204,543,544],{},"Now",", les signaux et la liste des hôtes montrent toujours le présent. ",[204,547,548],{},"Back to a relative\nwindow"," revient aux dernières 24 heures.",[551,552,554],"h2",{"id":553},"marquer-vos-déploiements","Marquer vos déploiements",[198,556,557,558,561],{},"Les règles comme ",[507,559,560],{},"502 spike after deployment"," ne se déclenchent que si un déploiement a touché le\nmême périmètre récemment. Les migrations de bench sur le site Wolf, ainsi que les tâches Press et\nPilot, sont enregistrées automatiquement. Pour les autres benches, ajoutez une ligne à votre script\nde déploiement :",[223,563,566],{"className":225,"code":564,"filename":565,"language":228,"meta":229,"style":229},"sudo -u wolf-agent wolf-agent mark-deployment --bench frappe-bench --note \"v5.18.2\" --silence 15m\n","deploy.sh",[209,567,568],{"__ignoreMap":229},[233,569,570,572,574,576,578,581,584,587,590,593,596,599,602],{"class":235,"line":236},[233,571,449],{"class":250},[233,573,452],{"class":243},[233,575,455],{"class":243},[233,577,455],{"class":243},[233,579,580],{"class":243}," mark-deployment",[233,582,583],{"class":243}," --bench",[233,585,586],{"class":243}," frappe-bench",[233,588,589],{"class":243}," --note",[233,591,592],{"class":384}," \"",[233,594,595],{"class":243},"v5.18.2",[233,597,598],{"class":384},"\"",[233,600,601],{"class":243}," --silence",[233,603,604],{"class":243}," 15m\n",[198,606,607,608,610,611,614,615,618,619,623],{},"La configuration qui contient le secret de l'agent n'est lisible que par ",[209,609,426],{},", d'où le\n",[209,612,613],{},"sudo -u",". ",[209,616,617],{},"--silence 15m"," ouvre aussi une\n",[299,620,622],{"href":621},"\u002Ffr\u002Falerts\u002Frules#fen%C3%AAtres-de-maintenance","fenêtre de maintenance"," : les incidents continuent de\ns'ouvrir pendant le déploiement, mais leurs notifications attendent qu'il se termine.",[551,625,627],{"id":626},"pour-continuer","Pour continuer",[629,630,631,637,642],"ul",{},[632,633,634,635,302],"li",{},"Surveillez les autres sites du bench : ",[299,636,40],{"href":41},[632,638,639,640,302],{},"Ajustez ce que collecte l'agent : ",[299,641,65],{"href":66},[632,643,644,645,302],{},"Écrivez vos propres règles : ",[299,646,96],{"href":97},[648,649,650],"style",{},"html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki s