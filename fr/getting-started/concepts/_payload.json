oppement","\u002Ffr\u002Freference\u002Fdevelopment","fr\u002F6.reference\u002F5.development","i-lucide-code",{"id":193,"title":18,"body":194,"description":662,"extension":663,"links":664,"meta":665,"navigation":666,"path":19,"seo":667,"stem":20,"__hash__":668},"docs_fr\u002Ffr\u002F1.getting-started\u002F3.concepts.md",{"type":195,"value":196,"toc":654},"minimark",[197,202,206,276,284,288,329,376,380,532,536,539,602,606,624,628,650],[198,199,201],"h2",{"id":200},"périmètre-site-bench-hôte","Périmètre : site, bench, hôte",[203,204,205],"p",{},"Chaque enregistrement porte jusqu'à trois noms. Wolf les lit toujours dans cet ordre :",[207,208,209,225],"table",{},[210,211,212],"thead",{},[213,214,215,219,222],"tr",{},[216,217,218],"th",{},"Périmètre",[216,220,221],{},"Correspond à",[216,223,224],{},"Exemple",[226,227,228,246,261],"tbody",{},[213,229,230,237,240],{},[231,232,233],"td",{},[234,235,236],"strong",{},"site",[231,238,239],{},"un site Frappe",[231,241,242],{},[243,244,245],"code",{},"erp.client.com",[213,247,248,253,256],{},[231,249,250],{},[234,251,252],{},"bench",[231,254,255],{},"le bench qui le sert",[231,257,258],{},[243,259,260],{},"frappe-bench",[213,262,263,268,271],{},[231,264,265],{},[234,266,267],{},"hôte",[231,269,270],{},"la machine Linux sur laquelle tourne l'agent",[231,272,273],{},[243,274,275],{},"bench-01",[203,277,278,279,283],{},"Les enregistrements qui concernent tout l'hôte (CPU, disque, connexions SSH) n'ont pas de site.\nLes règles regroupent selon l'un de ces niveaux, et les\n",[280,281,282],"a",{"href":140},"périmètres utilisateur"," restreignent qui voit quoi.",[198,285,287],{"id":286},"dune-ligne-de-log-à-une-alerte","D'une ligne de log à une alerte",[289,290,295],"pre",{"className":291,"code":292,"language":293,"meta":294,"style":294},"language-mermaid shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","flowchart LR\n  L[Ligne de log, \u002Fproc, Redis] -->|agent| E[Wolf Event \u002F Wolf Metric Sample]\n  S[Hooks du site] --> E\n  E -->|règle, chaque minute| I[Wolf Incident]\n  I -->|ouverture, réouverture, résolution| C[Canaux]\n","mermaid","",[243,296,297,305,311,317,323],{"__ignoreMap":294},[298,299,302],"span",{"class":300,"line":301},"line",1,[298,303,304],{},"flowchart LR\n",[298,306,308],{"class":300,"line":307},2,[298,309,310],{},"  L[Ligne de log, \u002Fproc, Redis] -->|agent| E[Wolf Event \u002F Wolf Metric Sample]\n",[298,312,314],{"class":300,"line":313},3,[298,315,316],{},"  S[Hooks du site] --> E\n",[298,318,320],{"class":300,"line":319},4,[298,321,322],{},"  E -->|règle, chaque minute| I[Wolf Incident]\n",[298,324,326],{"class":300,"line":325},5,[298,327,328],{},"  I -->|ouverture, réouverture, résolution| C[Canaux]\n",[330,331,332,344,358,369],"ol",{},[333,334,335,336,339,340,343],"li",{},"L'",[234,337,338],{},"agent"," analyse les logs et lit l'état du système. Il envoie des événements et des\néchantillons de métriques toutes les ",[243,341,342],{},"push_interval"," (30 s).",[333,345,346,347,349,350,353,354,357],{},"Le ",[234,348,236],{}," les stocke. Les événements qui ont la même empreinte sont comptés sur une seule\nligne (",[234,351,352],{},"Count",", ",[234,355,356],{},"Last Seen",") au lieu de s'accumuler.",[333,359,360,361,364,365,368],{},"Chaque minute, chaque ",[234,362,363],{},"règle d'alerte"," lit sa fenêtre. Quand sa condition est remplie, elle\nouvre un ",[234,366,367],{},"incident"," par groupe, ou alimente l'incident déjà ouvert.",[333,370,371,372,375],{},"L'incident prévient ses ",[234,373,374],{},"canaux"," à son ouverture, à sa réouverture, à son escalade et à sa\nrésolution, jamais à chaque événement.",[198,377,379],{"id":378},"les-objets","Les objets",[207,381,382,392],{},[210,383,384],{},[213,385,386,389],{},[216,387,388],{},"DocType",[216,390,391],{},"Contenu",[226,393,394,437,464,480,503,513,522],{},[213,395,396,401],{},[231,397,398],{},[234,399,400],{},"Wolf Event",[231,402,403,404,353,407,353,410,353,413,353,416,353,419,422,423,426,427,353,430,353,433,436],{},"Quelque chose qui s'est produit : ",[243,405,406],{},"error",[243,408,409],{},"cron_failure",[243,411,412],{},"worker_failure",[243,414,415],{},"security",[243,417,418],{},"host_metric_alert",[243,420,421],{},"deployment",". Possède une catégorie (par exemple ",[243,424,425],{},"web_attack_probe","), une gravité (",[243,428,429],{},"info",[243,431,432],{},"warning",[243,434,435],{},"critical","), un périmètre, un compteur et une charge utile JSON.",[213,438,439,444],{},[231,440,441],{},[234,442,443],{},"Wolf Metric Sample",[231,445,446,447,353,450,353,453,456,457,460,461,463],{},"Une valeur d'une métrique (",[243,448,449],{},"cpu_usage",[243,451,452],{},"http_502",[243,454,455],{},"tls_days_left","…) pour un périmètre à un instant donné. Agrégée dans ",[234,458,459],{},"Wolf Metric Rollup"," par minute et par heure. Voir ",[280,462,178],{"href":179},".",[213,465,466,471],{},[231,467,468],{},[234,469,470],{},"Wolf Alert Rule",[231,472,473,477,478,463],{},[474,475,476],"em",{},"Quand X > Y pendant Z minutes, envoyer une alerte."," Signal, agrégation, fenêtre, regroupement, canaux. Voir ",[280,479,96],{"href":97},[213,481,482,487],{},[231,483,484],{},[234,485,486],{},"Wolf Incident",[231,488,489,490,353,493,496,497,500,501,463],{},"Des événements qui partagent une cause, pour un groupe d'une règle. Statut ",[243,491,492],{},"Open",[243,494,495],{},"Acknowledged"," ou ",[243,498,499],{},"Resolved",". Lié au déploiement qui l'a précédé. Voir ",[280,502,111],{"href":112},[213,504,505,510],{},[231,506,507],{},[234,508,509],{},"Wolf Silence",[231,511,512],{},"Une fenêtre de maintenance : les incidents s'ouvrent toujours, les notifications attendent.",[213,514,515,519],{},[231,516,517],{},[234,518,35],{},[231,520,521],{},"Un hôte enregistré, un site satellite ou une intégration, avec son dernier envoi et son décalage d'horloge.",[213,523,524,529],{},[231,525,526],{},[234,527,528],{},"Wolf Settings",[231,530,531],{},"Rétention, signaux, agents, export SIEM, renseignement sur les menaces.",[198,533,535],{"id":534},"gravité","Gravité",[203,537,538],{},"Chaque gravité a une couleur et une forme, pour ne jamais dépendre de la couleur seule :",[207,540,541,553],{},[210,542,543],{},[213,544,545,547,550],{},[216,546,535],{},[216,548,549],{},"Symbole",[216,551,552],{},"Signification",[226,554,555,567,579,591],{},[213,556,557,561,564],{},[231,558,559],{},[243,560,429],{},[231,562,563],{},"○",[231,565,566],{},"Bon à savoir. Se prête au résumé.",[213,568,569,573,576],{},[231,570,571],{},[243,572,432],{},[231,574,575],{},"◐",[231,577,578],{},"À regarder dans la journée.",[213,580,581,585,588],{},[231,582,583],{},[243,584,435],{},[231,586,587],{},"●",[231,589,590],{},"Quelqu'un est réveillé. Jamais mis en résumé.",[213,592,593,596,599],{},[231,594,595],{},"resolved",[231,597,598],{},"✓",[231,600,601],{},"Retour à la normale.",[198,603,605],{"id":604},"déploiements","Déploiements",[203,607,608,609,611,612,615,616,619,620,623],{},"Un événement ",[243,610,421],{}," marque le moment où le code a changé : un ",[243,613,614],{},"bench migrate"," sur le site\nWolf, une tâche Press ou Pilot, ou ",[243,617,618],{},"wolf-agent mark-deployment",". Les règles peuvent exiger un\ndéploiement récent (la règle prédéfinie ",[474,621,622],{},"502 spike after deployment","), et les incidents affichent\nle déploiement qui les a précédés, si bien que la chronologie se lit « les 502 ont commencé\n4 minutes après le déploiement de 01:47 ».",[198,625,627],{"id":626},"où-regarder","Où regarder",[629,630,631,641],"ul",{},[333,632,633,636,637,640],{},[234,634,635],{},"Wolf UI"," sur ",[243,638,639],{},"\u002Fwolf"," : vue d'ensemble, incidents, explorateurs, métriques, sécurité,\nmonitoring. Pour les Wolf Users et les Wolf Managers.",[333,642,643,646,647,463],{},[234,644,645],{},"Desk"," : tous les DocTypes, la configuration, des rapports comme ",[234,648,649],{},"Wolf Incident Metrics",[651,652,653],"style",{},"html .light .shiki sp