se logs catcher",[256,257,259],"h3",{"id":258},"suricata-et-wazuh","Suricata et Wazuh",[223,261,262,263,266,267,270],{},"Le profil ",[233,264,265],{},"ids"," fait tourner un vrai Suricata (avec ET Open) sur le réseau du bench et un vrai\nmanager Wazuh qui lit son journal nginx, chacun avec l'agent Wolf qui le lit. ",[233,268,269],{},"ids_scenario.py","\nenvoie ensuite un attaquant : la détection web de Wolf, Suricata et Wazuh le signalent chacun,\ndans un seul incident.",[272,273,278],"pre",{"className":274,"code":275,"filename":250,"language":276,"meta":277,"style":277},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","docker compose --profile ids up -d --build\npython3 ids_scenario.py\n","bash","",[233,279,280,308],{"__ignoreMap":277},[281,282,285,289,293,296,299,302,305],"span",{"class":283,"line":284},"line",1,[281,286,288],{"class":287},"sBMFI","docker",[281,290,292],{"class":291},"sfazB"," compose",[281,294,295],{"class":291}," --profile",[281,297,298],{"class":291}," ids",[281,300,301],{"class":291}," up",[281,303,304],{"class":291}," -d",[281,306,307],{"class":291}," --build\n",[281,309,311,314],{"class":283,"line":310},2,[281,312,313],{"class":287},"python3",[281,315,316],{"class":291}," ids_scenario.py\n",[218,318,320],{"id":319},"tests-python","Tests Python",[272,322,325],{"className":274,"code":323,"filename":324,"language":276,"meta":277,"style":277},"python3 -m unittest discover -s tests -t .           # tests Python purs de l'app\npython3 -m unittest discover -s agent\u002Ftests          # tests de l'agent\n","racine du dépôt",[233,326,327,356],{"__ignoreMap":277},[281,328,329,331,334,337,340,343,346,349,352],{"class":283,"line":284},[281,330,313],{"class":287},[281,332,333],{"class":291}," -m",[281,335,336],{"class":291}," unittest",[281,338,339],{"class":291}," discover",[281,341,342],{"class":291}," -s",[281,344,345],{"class":291}," tests",[281,347,348],{"class":291}," -t",[281,350,351],{"class":291}," .",[281,353,355],{"class":354},"sHwdD","           # tests Python purs de l'app\n",[281,357,358,360,362,364,366,368,371],{"class":283,"line":310},[281,359,313],{"class":287},[281,361,333],{"class":291},[281,363,336],{"class":291},[281,365,339],{"class":291},[281,367,342],{"class":291},[281,369,370],{"class":291}," agent\u002Ftests",[281,372,373],{"class":354},"          # tests de l'agent\n",[218,375,377],{"id":376},"wolf-ui","Wolf UI",[223,379,380,381,384,385,390,391,398,399,236],{},"L'interface opérateur à ",[233,382,383],{},"\u002Fwolf"," est une app Vue construite sur ",[227,386,389],{"href":387,"rel":388},"https:\u002F\u002Fui.frappe.io",[231],"frappe-ui","\ndans ",[227,392,395],{"href":393,"rel":394},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Ffrontend\u002F",[231],[233,396,397],{},"frontend\u002F","\n(",[227,400,403],{"href":401,"rel":402},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F19",[231],"#19",[405,406,407,411,414],"ul",{},[408,409,410],"li",{},"Le Desk conserve les DocTypes de configuration et reste utilisable pour tout ce que la Wolf UI\nn'affiche pas encore.",[408,412,413],{},"Ses vues sont ajoutées une par une. Une vue qui n'est pas encore réalisée le dit et renvoie vers\nle Desk.",[408,415,416],{},"Elle réutilise la session Frappe : les invités sont envoyés vers la page de connexion, les\nutilisateurs sans le rôle Wolf User ou Wolf Manager reçoivent un 403.",[223,418,419,420,427],{},"Des captures d'écran, en thème clair et sombre, toutes prises sur le bench de démonstration après\nson scénario de 2 h du matin, se trouvent dans\n",[227,421,424],{"href":422,"rel":423},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Fdocs\u002Fscreenshots\u002FREADME.md",[231],[233,425,426],{},"docs\u002Fscreenshots",".",[272,429,431],{"className":274,"code":430,"filename":397,"language":276,"meta":277,"style":277},"cd frontend\nyarn install\nyarn dev        # Vite sur le port du bench + 80 (8080 pour 8000), avec proxy vers le bench\nyarn test       # tests unitaires et de composants (Vitest)\nyarn build      # écrit dodock_wolf\u002Fpublic\u002Ffrontend et dodock_wolf\u002Fwww\u002Fwolf.html\nyarn e2e        # tests navigateur de ce build (Playwright + axe), après `yarn build`\n",[233,432,433,442,450,461,472,483],{"__ignoreMap":277},[281,434,435,439],{"class":283,"line":284},[281,436,438],{"class":437},"s2Zo4","cd",[281,440,441],{"class":291}," frontend\n",[281,443,444,447],{"class":283,"line":310},[281,445,446],{"class":287},"yarn",[281,448,449],{"class":291}," install\n",[281,451,453,455,458],{"class":283,"line":452},3,[281,454,446],{"class":287},[281,456,457],{"class":291}," dev",[281,459,460],{"class":354},"        # Vite sur le port du bench + 80 (8080 pour 8000), avec proxy vers le bench\n",[281,462,464,466,469],{"class":283,"line":463},4,[281,465,446],{"class":287},[281,467,468],{"class":291}," test",[281,470,471],{"class":354},"       # tests unitaires et de composants (Vitest)\n",[281,473,475,477,480],{"class":283,"line":474},5,[281,476,446],{"class":287},[281,478,479],{"class":291}," build",[281,481,482],{"class":354},"      # écrit dodock_wolf\u002Fpublic\u002Ffrontend et dodock_wolf\u002Fwww\u002Fwolf.html\n",[281,484,486,488,491],{"class":283,"line":485},6,[281,487,446],{"class":287},[281,489,490],{"class":291}," e2e",[281,492,493],{"class":354},"        # tests navigateur de ce build (Playwright + axe), après `yarn build`\n",[495,496,497],"note",{},[223,498,499,500,503],{},"Node 20.19 ou version ultérieure est requis. Le résultat du build n'est pas commité :\n",[233,501,502],{},"bench build --app dodock_wolf"," le produit sur le bench.",[256,505,507],{"id":506},"tests-navigateur","Tests navigateur",[223,509,510,511,514,515,518,519,522],{},"Les tests navigateur (",[233,512,513],{},"frontend\u002Fe2e\u002F",") servent le build de production comme le ferait un bench\n(",[233,516,517],{},"e2e\u002Fserver.mjs",") et répondent à chaque appel d'API de la page (",[233,520,521],{},"e2e\u002Fapi.js",") : aucun Frappe n'est\ndonc nécessaire.",[223,524,525],{},"Chaque vue doit :",[405,527,528,531],{},[408,529,530],{},"s'afficher sans erreur dans la console ni appel resté sans réponse ;",[408,532,533],{},"passer axe sans aucun constat WCAG 2 A\u002FAA grave ou critique, en thème clair comme en thème\nsombre.",[223,535,536],{},"La navigation au clavier, la réduction des animations, l'acquittement d'un incident et le\ndéplacement du focus clavier sont vérifiés aussi.",[223,538,539,542],{},[233,540,541],{},"e2e\u002Fstates.spec.js"," fait passer chaque vue par les états chargement, vide, vide après filtrage,\nerreur, interdit, partiel, obsolète et déconnecté. Une vue n'affirme jamais « rien » avant d'avoir\nlu, ou après un échec de lecture, et un refus indique ce qui ne peut pas être vu.",[223,544,545,546,549,550,553],{},"Les tests nécessitent Chromium : lancez ",[233,547,548],{},"npx playwright install chromium",", ou faites pointer\n",[233,551,552],{},"WOLF_CHROMIUM"," vers une installation existante.",[223,555,556,557,427],{},"Les API que lit l'UI sont décrites dans ",[227,558,163],{"href":164},[218,560,562],{"id":561},"vérifications-de-la-ci","Vérifications de la CI",[223,564,565,566,569,570,577],{},"Chaque pull request et chaque push sur ",[233,567,568],{},"main"," exécute\n",[227,571,574],{"href":572,"rel":573},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002F.github\u002Fworkflows\u002Fci.yml",[231],[233,575,576],{},".github\u002Fworkflows\u002Fci.yml"," :",[579,580,581,594],"table",{},[582,583,584],"thead",{},[585,586,587,591],"tr",{},[588,589,590],"th",{},"Job",[588,592,593],{},"Environnement",[595,596,597,605,613,621,629,637],"tbody",{},[585,598,599,603],{},[600,601,602],"td",{},"Lint (ruff, shellcheck)",[600,604],{},[585,606,607,610],{},[600,608,609],{},"Tests de l'app",[600,611,612],{},"Python 3.12",[585,614,615,618],{},[600,616,617]