4o","=",[246,259,261],{"class":260},"sfazB","registry.gitlab.com\u002Fdokos\u002Fdokos:latest",[246,263,265],{"class":264},"sBMFI"," docker",[246,267,268],{"class":260}," compose",[246,270,271],{"class":260}," --profile",[246,273,274],{"class":260}," press",[246,276,277],{"class":260}," up",[246,279,280],{"class":260}," -d",[246,282,283],{"class":260}," --build\n",[246,285,287,290,292,295,298,301],{"class":248,"line":286},2,[246,288,289],{"class":264},"docker",[246,291,268],{"class":260},[246,293,294],{"class":260}," logs",[246,296,297],{"class":260}," -f",[246,299,300],{"class":260}," press-demo",[246,302,304],{"class":303},"sHwdD","   # « history written up to ... », puis le direct\n",[203,306,307,310,311,314,315,318,319,322,323,326,327,329],{},[213,308,309],{},"press-agent"," s'enregistre sous le nom ",[213,312,313],{},"f1-demo-press"," en mode Press. ",[213,316,317],{},"press-demo"," lance\n",[213,320,321],{},"bench generate-demo-press"," : 7 jours d'historique pour 3 benches et 8 sites, puis un cycle\nd'incidents toutes les 30 minutes, avec des alertes envoyées au récepteur de webhooks de la pile\n(",[213,324,325],{},"docker compose logs catcher","). La page ",[207,328,70],{"href":71}," détaille un cycle.",[198,331,333],{"id":332},"tests-python","Tests Python",[237,335,338],{"className":239,"code":336,"filename":337,"language":241,"meta":242,"style":242},"python3 -m unittest discover -s tests -t .           # tests Python purs de l'app\npython3 -m unittest discover -s agent\u002Ftests          # tests de l'agent\n","racine du dépôt",[213,339,340,369],{"__ignoreMap":242},[246,341,342,345,348,351,354,357,360,363,366],{"class":248,"line":249},[246,343,344],{"class":264},"python3",[246,346,347],{"class":260}," -m",[246,349,350],{"class":260}," unittest",[246,352,353],{"class":260}," discover",[246,355,356],{"class":260}," -s",[246,358,359],{"class":260}," tests",[246,361,362],{"class":260}," -t",[246,364,365],{"class":260}," .",[246,367,368],{"class":303},"           # tests Python purs de l'app\n",[246,370,371,373,375,377,379,381,384],{"class":248,"line":286},[246,372,344],{"class":264},[246,374,347],{"class":260},[246,376,350],{"class":260},[246,378,353],{"class":260},[246,380,356],{"class":260},[246,382,383],{"class":260}," agent\u002Ftests",[246,385,386],{"class":303},"          # tests de l'agent\n",[198,388,390],{"id":389},"wolf-ui","Wolf UI",[203,392,393,394,397,398,403,404,411,412,216],{},"L'interface opérateur à ",[213,395,396],{},"\u002Fwolf"," est une app Vue construite sur ",[207,399,402],{"href":400,"rel":401},"https:\u002F\u002Fui.frappe.io",[211],"frappe-ui","\ndans ",[207,405,408],{"href":406,"rel":407},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Ffrontend\u002F",[211],[213,409,410],{},"frontend\u002F","\n(",[207,413,416],{"href":414,"rel":415},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fissues\u002F19",[211],"#19",[418,419,420,424,427],"ul",{},[421,422,423],"li",{},"Le Desk conserve les DocTypes de configuration et reste utilisable pour tout ce que la Wolf UI\nn'affiche pas encore.",[421,425,426],{},"Ses vues sont ajoutées une par une. Une vue qui n'est pas encore réalisée le dit et renvoie vers\nle Desk.",[421,428,429],{},"Elle réutilise la session Frappe : les invités sont envoyés vers la page de connexion, les\nutilisateurs sans le rôle Wolf User ou Wolf Manager reçoivent un 403.",[203,431,432,433,440],{},"Des captures d'écran, en thème clair et sombre, toutes prises sur le bench de démonstration après\nson scénario de 2 h du matin, se trouvent dans\n",[207,434,437],{"href":435,"rel":436},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Fdocs\u002Fscreenshots\u002FREADME.md",[211],[213,438,439],{},"docs\u002Fscreenshots",".",[237,442,444],{"className":239,"code":443,"filename":410,"language":241,"meta":242,"style":242},"cd frontend\nyarn install\nyarn dev        # Vite sur le port du bench + 80 (8080 pour 8000), avec proxy vers le bench\nyarn test       # tests unitaires et de composants (Vitest)\nyarn build      # écrit dodock_wolf\u002Fpublic\u002Ffrontend et dodock_wolf\u002Fwww\u002Fwolf.html\nyarn e2e        # tests navigateur de ce build (Playwright + axe), après `yarn build`\n",[213,445,446,455,463,474,485,496],{"__ignoreMap":242},[246,447,448,452],{"class":248,"line":249},[246,449,451],{"class":450},"s2Zo4","cd",[246,453,454],{"class":260}," frontend\n",[246,456,457,460],{"class":248,"line":286},[246,458,459],{"class":264},"yarn",[246,461,462],{"class":260}," install\n",[246,464,466,468,471],{"class":248,"line":465},3,[246,467,459],{"class":264},[246,469,470],{"class":260}," dev",[246,472,473],{"class":303},"        # Vite sur le port du bench + 80 (8080 pour 8000), avec proxy vers le bench\n",[246,475,477,479,482],{"class":248,"line":476},4,[246,478,459],{"class":264},[246,480,481],{"class":260}," test",[246,483,484],{"class":303},"       # tests unitaires et de composants (Vitest)\n",[246,486,488,490,493],{"class":248,"line":487},5,[246,489,459],{"class":264},[246,491,492],{"class":260}," build",[246,494,495],{"class":303},"      # écrit dodock_wolf\u002Fpublic\u002Ffrontend et dodock_wolf\u002Fwww\u002Fwolf.html\n",[246,497,499,501,504],{"class":248,"line":498},6,[246,500,459],{"class":264},[246,502,503],{"class":260}," e2e",[246,505,506],{"class":303},"        # tests navigateur de ce build (Playwright + axe), après `yarn build`\n",[508,509,510],"note",{},[203,511,512,513,516],{},"Node 20.19 ou version ultérieure est requis. Le résultat du build n'est pas commité :\n",[213,514,515],{},"bench build --app dodock_wolf"," le produit sur le bench.",[518,519,521],"h3",{"id":520},"tests-navigateur","Tests navigateur",[203,523,524,525,528,529,532,533,536],{},"Les tests navigateur (",[213,526,527],{},"frontend\u002Fe2e\u002F",") servent le build de production comme le ferait un bench\n(",[213,530,531],{},"e2e\u002Fserver.mjs",") et répondent à chaque appel d'API de la page (",[213,534,535],{},"e2e\u002Fapi.js",") : aucun Frappe n'est\ndonc nécessaire.",[203,538,539],{},"Chaque vue doit :",[418,541,542,545],{},[421,543,544],{},"s'afficher sans erreur dans la console ni appel resté sans réponse ;",[421,546,547],{},"passer axe sans aucun constat WCAG 2 A\u002FAA grave ou critique, en thème clair comme en thème\nsombre.",[203,549,550],{},"La navigation au clavier, la réduction des animations, l'acquittement d'un incident et le\ndéplacement du focus clavier sont vérifiés aussi.",[203,552,553,556],{},[213,554,555],{},"e2e\u002Fstates.spec.js"," fait passer chaque vue par les états chargement, vide, vide après filtrage,\nerreur, interdit, partiel, obsolète et déconnecté. Une vue n'affirme jamais « rien » avant d'avoir\nlu, ou après un échec de lecture, et un refus indique ce qui ne peut pas être vu.",[203,558,559,560,563,564,567],{},"Les tests nécessitent Chromium : lancez ",[213,561,562],{},"npx playwright install chromium",", ou faites pointer\n",[213,565,566],{},"WOLF_CHROMIUM"," vers une installation existante.",[203,569,570,571,440],{},"Les API que lit l'UI sont décrites dans ",[207,572,173],{"href":174},[198,574,576],{"id":575},"vérifications-de-la-ci","Vérifications de la CI",[203,578,579,580,583,584,591],{},"Chaque pull request et chaque push sur ",[213,581,582],{},"main"," exécute\n",[207,585,588],{"href":586,"rel":587},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002F.github\u002Fworkflows\u002Fci.yml",[211],[213,589,590],{},".github\u002Fworkflows\u002Fci.yml"," :",[593,594,595,608],"table",{},[596,597,598],"thead",{},[599,600,601,605],"tr",{},[602,603,604],"th",{},"Job",[602,606,607],{},"Environnement",[609,610,611,619,627,635,643,651],"tbody",{},[599,612,613,617],{},[614,615,616],"td",{},"Lint (ruff, shellcheck)",[614,618],{},[599,620,621,624],{},[614,622,623],{},"Tests de l'app",[614,625,626],{},"Python 3.12",[599,628,629,632],{},[614,630,631],{},"Tests de l'agent",[614,633,634],{},"Pytho