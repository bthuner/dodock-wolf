      # tests navigateur de ce build (Playwright + axe), après `yarn build`\n",[213,343,344,353,361,372,383,394],{"__ignoreMap":228},[232,345,346,350],{"class":234,"line":235},[232,347,349],{"class":348},"s2Zo4","cd",[232,351,352],{"class":242}," frontend\n",[232,354,355,358],{"class":234,"line":268},[232,356,357],{"class":238},"yarn",[232,359,360],{"class":242}," install\n",[232,362,364,366,369],{"class":234,"line":363},3,[232,365,357],{"class":238},[232,367,368],{"class":242}," dev",[232,370,371],{"class":264},"        # Vite sur le port du bench + 80 (8080 pour 8000), avec proxy vers le bench\n",[232,373,375,377,380],{"class":234,"line":374},4,[232,376,357],{"class":238},[232,378,379],{"class":242}," test",[232,381,382],{"class":264},"       # tests unitaires et de composants (Vitest)\n",[232,384,386,388,391],{"class":234,"line":385},5,[232,387,357],{"class":238},[232,389,390],{"class":242}," build",[232,392,393],{"class":264},"      # écrit dodock_wolf\u002Fpublic\u002Ffrontend et dodock_wolf\u002Fwww\u002Fwolf.html\n",[232,395,397,399,402],{"class":234,"line":396},6,[232,398,357],{"class":238},[232,400,401],{"class":242}," e2e",[232,403,404],{"class":264},"        # tests navigateur de ce build (Playwright + axe), après `yarn build`\n",[406,407,408],"note",{},[203,409,410,411,414],{},"Node 20.19 ou version ultérieure est requis. Le résultat du build n'est pas commité :\n",[213,412,413],{},"bench build --app dodock_wolf"," le produit sur le bench.",[416,417,419],"h3",{"id":418},"tests-navigateur","Tests navigateur",[203,421,422,423,426,427,430,431,434],{},"Les tests navigateur (",[213,424,425],{},"frontend\u002Fe2e\u002F",") servent le build de production comme le ferait un bench\n(",[213,428,429],{},"e2e\u002Fserver.mjs",") et répondent à chaque appel d'API de la page (",[213,432,433],{},"e2e\u002Fapi.js",") : aucun Frappe n'est\ndonc nécessaire.",[203,436,437],{},"Chaque vue doit :",[316,439,440,443],{},[319,441,442],{},"s'afficher sans erreur dans la console ni appel resté sans réponse ;",[319,444,445],{},"passer axe sans aucun constat WCAG 2 A\u002FAA grave ou critique, en thème clair comme en thème\nsombre.",[203,447,448],{},"La navigation au clavier, la réduction des animations, l'acquittement d'un incident et le\ndéplacement du focus clavier sont vérifiés aussi.",[203,450,451,454],{},[213,452,453],{},"e2e\u002Fstates.spec.js"," fait passer chaque vue par les états chargement, vide, vide après filtrage,\nerreur, interdit, partiel, obsolète et déconnecté. Une vue n'affirme jamais « rien » avant d'avoir\nlu, ou après un échec de lecture, et un refus indique ce qui ne peut pas être vu.",[203,456,457,458,461,462,465],{},"Les tests nécessitent Chromium : lancez ",[213,459,460],{},"npx playwright install chromium",", ou faites pointer\n",[213,463,464],{},"WOLF_CHROMIUM"," vers une installation existante.",[203,467,468,469,338],{},"Les API que lit l'UI sont décrites dans ",[207,470,173],{"href":174},[198,472,474],{"id":473},"vérifications-de-la-ci","Vérifications de la CI",[203,476,477,478,481,482,489],{},"Chaque pull request et chaque push sur ",[213,479,480],{},"main"," exécute\n",[207,483,486],{"href":484,"rel":485},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002F.github\u002Fworkflows\u002Fci.yml",[211],[213,487,488],{},".github\u002Fworkflows\u002Fci.yml"," :",[491,492,493,506],"table",{},[494,495,496],"thead",{},[497,498,499,503],"tr",{},[500,501,502],"th",{},"Job",[500,504,505],{},"Environnement",[507,508,509,517,525,533,541,549],"tbody",{},[497,510,511,515],{},[512,513,514],"td",{},"Lint (ruff, shellcheck)",[512,516],{},[497,518,519,522],{},[512,520,521],{},"Tests de l'app",[512,523,524],{},"Python 3.12",[497,526,527,530],{},[512,528,529],{},"Tests de l'agent",[512,531,532],{},"Python 3.9 et 3.14",[497,534,535,538],{},[512,536,537],{},"Tests et build de la Wolf UI",[512,539,540],{},"Node 20.19 et 24",[497,542,543,546],{},[512,544,545],{},"Tests navigateur de la Wolf UI",[512,547,