02Freference\u002Fdevelopment","fr\u002F6.reference\u002F5.development","i-lucide-code",{"id":193,"title":96,"body":194,"description":1007,"extension":1008,"links":1009,"meta":1010,"navigation":1011,"path":97,"seo":1012,"stem":98,"__hash__":1013},"docs_fr\u002Ffr\u002F4.alerts\u002F1.rules.md",{"type":195,"value":196,"toc":996},"minimark",[197,206,211,543,556,560,806,809,815,896,916,924,928,942,945,967,971,986,990],[198,199,200,201,205],"p",{},"Une ",[202,203,204],"strong",{},"Wolf Alert Rule"," lit une fenêtre de métriques ou d'événements chaque minute. Quand sa\ncondition est remplie, elle ouvre un incident par groupe et notifie ses canaux.",[207,208,210],"h2",{"id":209},"champs","Champs",[212,213,214,227],"table",{},[215,216,217],"thead",{},[218,219,220,224],"tr",{},[221,222,223],"th",{},"Champ",[221,225,226],{},"Signification",[228,229,230,262,293,330,361,371,381,407,417,431,445,455,465,475,485,497,507,524],"tbody",{},[218,231,232,238],{},[233,234,235],"td",{},[202,236,237],{},"Signal Type",[233,239,240,244,245,248,249,252,253,256,257,261],{},[241,242,243],"code",{},"metric"," : agrège des échantillons de métrique (ou leurs agrégats pour les fenêtres de plus de 3 h, voir ",[246,247,178],"a",{"href":179},"). ",[241,250,251],{},"event"," : compte des Wolf Events. ",[241,254,255],{},"sequence"," : un événement suivi d'un autre sur la même IP, le même utilisateur ou le même hôte, voir ",[246,258,260],{"href":259},"#r%C3%A8gles-de-s%C3%A9quence","Règles de séquence",".",[218,263,264,280],{},[233,265,266,269,270,273,274,273,277],{},[202,267,268],{},"Metric Name"," \u002F ",[202,271,272],{},"Event Type",", ",[202,275,276],{},"Event Category",[202,278,279],{},"Min Severity",[233,281,282,283,286,287,269,290,261],{},"Ce qu'il faut lire. Par exemple ",[241,284,285],{},"http_502",", ou ",[241,288,289],{},"security",[241,291,292],{},"web_attack_probe",[218,294,295,300],{},[233,296,297],{},[202,298,299],{},"Aggregation",[233,301,302,273,305,273,308,273,311,273,314,273,317,320,321,323,324,326,327,261],{},[241,303,304],{},"avg",[241,306,307],{},"min",[241,309,310],{},"max",[241,312,313],{},"sum",[241,315,316],{},"count",[241,318,319],{},"last",". Utilisez ",[241,322,307],{}," pour « est resté au-dessus pendant Z minutes » et ",[241,325,313],{}," pour les compteurs comme ",[241,328,329],{},"http_5xx",[218,331,332,340],{},[233,333,334,273,337],{},[202,335,336],{},"Operator",[202,338,339],{},"Threshold",[233,341,342,273,345,273,348,273,351,273,354,273,357,360],{},[241,343,344],{},">",[241,346,347],{},">=",[241,349,350],{},"\u003C",[241,352,353],{},"\u003C=",[241,355,356],{},"==",[241,358,359],{},"!="," comparé à un nombre.",[218,362,363,368],{},[233,364,365],{},[202,366,367],{},"Window Minutes",[233,369,370],{},"La période examinée. 5 par défaut.",[218,372,373,378],{},[233,374,375],{},[202,376,377],{},"Min Samples",[233,379,380],{},"Avec moins d'échantillons que ce nombre dans la fenêtre, la règle n'est pas en dépassement.",[218,382,383,388],{},[233,384,385],{},[202,386,387],{},"Group By",[233,389,390,273,393,273,396,273,399,402,403,406],{},[241,391,392],{},"host",[241,394,395],{},"bench",[241,397,398],{},"site",[241,400,401],{},"host_label"," (par exemple par point de montage de disque) ou ",[241,404,405],{},"none",". Un incident par groupe.",[218,408,409,414],{},[233,410,411],{},[202,412,413],{},"Filter Host \u002F Bench \u002F Site",[233,415,416],{},"Limite la règle à un périmètre.",[218,418,419,424],{},[233,420,421],{},[202,422,423],{},"Active From \u002F To",[233,425,426,427,430],{},"N'évalue la règle que dans cette plage horaire. Elle peut passer minuit (",[241,428,429],{},"04:00 → 01:00",").",[218,432,433,438],{},[233,434,435],{},[202,436,437],{},"Require Recent Deployment",[233,439,440,441,444],{},"Ne se déclenche que si un déploiement a touché le même bench, site ou hôte dans les dernières ",[202,442,443],{},"Deployment Window Minutes"," (30).",[218,446,447,452],{},[233,448,449],{},[202,450,451],{},"Fire \u002F Resolve After Evaluations",[233,453,454],{},"Nombre d'évaluations consécutives en dépassement (ou revenues à la normale), une par tick du planificateur, avant qu'un incident s'ouvre (ou se résolve automatiquement). 1 par défaut.",[218,456,457,462],{},[233,458,459],{},[202,460,461],{},"Separate Resolve Threshold",[233,463,464],{},"Hystérésis : déclencher au-dessus de 90, ne résoudre qu'une fois à 80 ou moins.",[218,466,467,472],{},[233,468,469],{},[202,470,471],{},"Cooldown Minutes",[233,473,474],{},"Redéclenche dans l'incident qui vient d'être résolu au lieu d'en ouvrir un nouveau. Une règle sur événements ne le rouvre que pour un événement postérieur à la résolution ; une règle sur métrique, tant que sa fenêtre reste en dépassement. 30 par défaut.",[218,476,477,482],{},[233,478,479],{},[202,480,481],{},"Auto Resolve",[233,483,484],{},"Résout l'incident quand la condition n'est plus remplie. Activé par défaut.",[218,486,487,492],{},[233,488,489],{},[202,490,491],{},"Channels",[233,493,494,495,261],{},"Où partent les alertes. Voir ",[246,496,106],{"href":107},[218,498,499,504],{},[233,500,501],{},[202,502,503],{},"Notify On Resolve",[233,505,506],{},"Prévient aussi les canaux quand l'incident est résolu, automatiquement ou à la main. Activé par défaut. PagerDuty en est toujours informé.",[218,508,509,517],{},[233,510,511,273,514],{},[202,512,513],{},"Escalate After Minutes",[202,515,516],{},"Escalation Channels",[233,518,519,520,523],{},"Si l'incident est toujours ",[241,521,522],{},"Open"," (non acquitté) ce délai après la première alerte, notifie une fois les canaux d'escalade.",[218,525,526,531],{},[233,527,528],{},[202,529,530],{},"Severity",[233,532,533,534,273,537,273,540,261],{},"Celle de l'incident : ",[241,535,536],{},"info",[241,538,539],{},"warning",[241,541,542],{},"critical",[198,544,545,546,273,549,552,553,261],{},"Le formulaire de la règle affiche ",[202,547,548],{},"Last Evaluated",[202,550,551],{},"Last Fired"," et ",[202,554,555],{},"Last Error",[207,557,559],{"id":558},"exemples","Exemples",[561,562,563,639,721],"tabs",{},[564,565,567,633],"tabs-item",{"label":566},"Pic de 502",[212,568,569,578],{},[215,570,571],{},[218,572,573,575],{},[221,574,223],{},[221,576,577],{},"Valeur",[228,579,580,588,596,604,616,625],{},[218,581,582,584],{},[233,583,237],{},[233,585,586],{},[241,587,243],{},[218,589,590,592],{},[233,591,268],{},[233,593,594],{},[241,595,285],{},[218,597,598,600],{},[233,599,299],{},[233,601,602],{},[241,603,313],{},[218,605,606,609],{},[233,607,608],{},"Operator, Threshold",[233,610,611,273,613],{},[241,612,347],{},[241,614,615],{},"10",[218,617,618,620],{},[233,619,367],{},[233,621,622],{},[241,623,624],{},"5",[218,626,627,629],{},[233,628,387],{},[233,630,631],{},[241,632,398],{},[198,634,635],{},[636,637,638],"em",{},"10 réponses 502 ou plus sur un site en 5 minutes.",[564,640,642,716],{"label":641},"Disque resté plein",[212,643,644,652],{},[215,645,646],{},[218,647,648,650],{},[221,649,223],{},[221,651,577],{},[228,653,654,662,671,679,690,699,707],{},[218,655,656,658],{},[233,657,237],{},[233,659,660],{},[241,661,243],{},[218,663,664,666],{},[233,665,268],{},[233,667,668],{},[241,669,670],{},"disk_used_percent",[218,672,673,675],{},[233,674,299],{},[233,676,677],{},[241,678,307],{},[218,680,681,683],{},[233,682,608],{},[233,684,685,273,687],{},[241,686,344],{},[241,688,689],{},"90",[218,691,692,694],{},[233,693,367],{},[233,695,696],{},[241,697,698],{},"15",[218,700,701,703],{},[233,702,387],{},[233,704,705],{},[241,706,401],{},[218,708,709,711],{},[233,710,461],{},[233,712,713],{},[241,714,715],{},"80",[198,717,718],{},[636,719,720],{},"Chaque échantillon d'un point de montage au-dessus de 90 % pendant 15 minutes. Résolu à 80 % ou\nmoins.",[564,722,724,801],{"label":723},"Cron de nuit",[212,725,726,734],{},[215,727,728],{},[218,729,730,732],{},[221,731,223],{},[221,733,577],{},[228,735,736,744,753,761,772,780,788],{},[218,737,738,740],{},[233,739,237],{},[233,741,742],{},[241,743,251],{},[218,745,746,748],{},[233,747,272],{},[233,749,750],{},[241,751,752],{},"cron_failure",[218,754,755,757],{},[233,756,299],{},[233,758,759],{},[241,760,316],{},[218,762,763,765],{},[233,764,608],{},[233,766,767,273,769],{},[241,768,347],{},[241,770,771],{},"1",[218,773,774,776],{},[233,775,367],{},[233,777,778],{},[241,779,615],{},[218,781,782,784],{},[233,783,387],{},[233,785,786],{},[241,787,398],{},[218,789,790,792],{},[233,791,423],{},[233,793,794,797,798],{},[241,795,796],{},"01:00"," → ",[241,799,800],{},"04:00",[198,802,803],{},[636,804,805],{},"Toute tâche planifiée en échec entre 01:00 et 04:00.",[207,807,260],{"id":808},"règles-de-séquence",[198,810,811,812,814],{},"Une règle de type ",[241,813,255],{}," se déclenche quand un événement d'une liste de catégories suit un\névénement d'une autre liste sur la même entité. Par exemple : un sondage web, puis une connexion SSH\ndepuis la même adresse dans l'heure.",[212,816,817,825],{},[215,818,819],{},[218,820,821,823],{},[221,822,223],{},[221,824,226],{},[228,826,827,839,849,859,886],{},[218,828,829,834],{},[233,830,831],{},[202,832,833],{},"First Event Categories",[233,835,836,837,261],{},"Catégories du premier événement, une par ligne, par exemple ",[241,838,292],{},[218,840,841,846],{},[233,842,843],{},[202,844,845],{},"First Event Min Severity",[233,847,848],{},"Seuls les premiers événements de cette gravité ou plus. Les filtres de périmètre s'appliquent au second événement.",[218,850,851,856],{},[233,852,853],{},[202,854,855],{},"Then Event Categories",[233,857,858],{},"Catégories de l'événement qui doit suivre, une par ligne.",[218,860,861,866],{},[233,862,863],{},[202,864,865],{},"Same",[233,867,868,871,872,875,876,879,880,882,883,430],{},[241,869,870],{},"ip"," : l'adresse distante du second événement (",[241,873,874],{},"payload.ip","), publique uniquement. ",[241,877,878],{},"user"," : le même utilisateur sur le même site. ",[241,881,392],{}," : le même hôte sous n'importe lequel de ses noms (",[202,884,885],{},"Wolf Entity Alias",[218,887,888,893],{},[233,889,890],{},[202,891,892],{},"Within Minutes",[233,894,895],{},"L'écart maximal entre les deux événements. 60 par défaut.",[897,898,899,903,910,913],"ul",{},[900,901,902],"li",{},"Le seuil compte les seconds événements vus dans la fenêtre.",[900,904,905,906,909],{},"Il y a un incident par valeur d'entité (",[241,907,908],{},"ip 203.0.113.5","), avec le périmètre de son second\névénement le plus récent.",[900,911,912],{},"L'écart court de la dernière occurrence du premier événement à la plus récente du second : les\nrépétitions regroupées dans un même enregistrement comptent. Une attaque par force brute de\nmilliers de premiers événements forme un seul candidat.",[900,914,915],{},"L'incident relie les deux événements. Un événement déjà rattaché à un autre incident y reste, et la\nchronologie de l'incident, qui commence au premier événement, le montre quand même.",[198,917,918,919,923],{},"Trois ",[246,920,922],{"href":921},"\u002Ffr\u002Falerts\u002Fpresets#s%C3%A9quences-entre-sources","règles prédéfinies"," l'utilisent.",[207,925,927],{"id":926},"fenêtres-de-maintenance","Fenêtres de maintenance",[198,929,930,931,934,935,273,938,941],{},"Un ",[202,932,933],{},"Wolf Silence"," (hôte, bench, site et\u002Fou règle, ",[202,936,937],{},"Starts At",[202,939,940],{},"Ends At",") laisse les incidents\ns'ouvrir, pour que la chronologie reste complète, mais retient leurs notifications. Les incidents\nencore ouverts à la fin de la fenêtre sont notifiés à ce moment-là.",[198,943,944],{},"Pour en créer un :",[897,946,947,954,961],{},[900,948,949,950,953],{},"dans Desk (",[202,951,952],{},"Wolf Silence → New",") ;",[900,955,956,957,960],{},"via l'API REST : ",[241,958,959],{},"POST \u002Fapi\u002Fresource\u002FWolf Silence"," ;",[900,962,963,964,261],{},"avec le marqueur de déploiement : ",[241,965,966],{},"wolf-agent mark-deployment --bench main --silence 15m",[207,968,970],{"id":969},"récapitulatifs","Récapitulatifs",[198,972,973,974,977,978,552,980,982,983,985],{},"Chaque ligne de canal peut utiliser un ",[202,975,976],{},"hourly digest"," (récapitulatif horaire) : les alertes\n",[241,979,536],{},[241,981,539],{}," sont regroupées en un seul message par destination. Les alertes ",[241,984,542],{},"\npartent toujours immédiatement, et PagerDuty n'est jamais regroupé.",[207,987,989],{"id":988},"tester-une-règle","Tester une règle",[198,991,992,995],{},[202,993,994],{},"Send test notification"," sur le formulaire de la règle envoie un TEST à chaque ligne de canal\nactive et affiche la réponse de chacune.",{"title":997,"searchDepth":998,"depth":999,"links":1000},"",1,2,[1001,1002,1003,1004,1005,1006],{"id":209,"depth":999,"text":210},{"id":558,"depth":999,"text":559},{"id":808,"depth":999,"text":260},{"id":926,"depth":999,"text":927},{"id":969,"depth":999,"text":970},{"id":988,"depth":999,"text":989},"Écrire une règle qui se lit comme le cahier des charges - quand X > Y pendant Z minutes, envoyer une alerte.","md",null,{},{"icon":99},{"title":96,"description":1007},"4RDeaexBQbb4eg9dHZI1T4OLntH_9R7f8Wqz2MmEFWE",[1015,1017],{"title":85,"path":86,"stem":87,"description":1016,"icon":88},"Bloquer une IP attaquante sur l'hôte, désactiver un utilisateur ou révoquer des sessions, après approbation d'un Wolf Manager. Désactivé par défaut.",{"title":101,"path":102,"stem":103,"description":1018,"icon":104},"Les règles installées avec l'app, ce que chacune surveille et quand elle se déclenche.",1794997698855]