dans son code","i-lucide-map",{"title":191,"path":192,"stem":193,"icon":194},"Les applications","\u002Ffr\u002Finternals\u002Fapps","fr\u002F7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Appels et confiance","\u002Ffr\u002Finternals\u002Finterop","fr\u002F7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flux","\u002Ffr\u002Finternals\u002Fflows","fr\u002F7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Dans un serveur client","\u002Ffr\u002Finternals\u002Fcustomer-server","fr\u002F7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes pour Wolf","\u002Ffr\u002Finternals\u002Fwolf","fr\u002F7.internals\u002F6.wolf",{"id":213,"title":70,"body":214,"description":666,"extension":667,"links":668,"meta":669,"navigation":670,"path":71,"seo":671,"stem":72,"__hash__":672},"docs_fr\u002Ffr\u002F3.agent\u002F4.scrubbing.md",{"type":215,"value":216,"toc":661},"minimark",[217,221,386,391,398,402,405,412,416,611,650,657],[218,219,220],"p",{},"Avant qu'un événement soit placé dans la file locale ou envoyé, l'agent nettoie son titre et chaque\nchaîne de sa charge utile : lignes d'exemple, tracebacks, messages, routes. Ce nettoyage (scrubbing)\nest actif par défaut.",[222,223,224,237],"table",{},[225,226,227],"thead",{},[228,229,230,234],"tr",{},[231,232,233],"th",{},"Quoi",[231,235,236],{},"Devient",[238,239,240,256,280,299,312,352,362,372],"tbody",{},[228,241,242,251],{},[243,244,245,246,250],"td",{},"adresses e-mail, y compris encodées en URL (",[247,248,249],"code",{},"jane%40example.com",")",[243,252,253],{},[247,254,255],{},"[EMAIL]",[228,257,258,275],{},[243,259,260,261,264,265,268,269,264,272],{},"valeurs des en-têtes ",[247,262,263],{},"Authorization:"," \u002F ",[247,266,267],{},"Proxy-Authorization:",", valeurs de ",[247,270,271],{},"Cookie:",[247,273,274],{},"Set-Cookie:",[243,276,277],{},[247,278,279],{},"[REDACTED]",[228,281,282,295],{},[243,283,284,285,288,289,288,292],{},"identifiants ",[247,286,287],{},"Bearer …",", ",[247,290,291],{},"token \u003Ckey>:\u003Csecret>",[247,293,294],{},"Basic …",[243,296,297],{},[247,298,279],{},[228,300,301,307],{},[243,302,303,304,250],{},"JWT (",[247,305,306],{},"eyJ….….…",[243,308,309],{},[247,310,311],{},"[JWT]",[228,313,314,348],{},[243,315,316,317,288,320,288,323,288,326,288,329,288,332,288,335,288,338,288,341,288,344,347],{},"valeurs de ",[247,318,319],{},"password",[247,321,322],{},"pwd",[247,324,325],{},"new_password",[247,327,328],{},"*_secret",[247,330,331],{},"*_token",[247,333,334],{},"api_key",[247,336,337],{},"sid",[247,339,340],{},"session_id",[247,342,343],{},"otp",[247,345,346],{},"signature",", dans les query strings, les formulaires, le JSON ou les représentations de dict Python",[243,349,350],{},[247,351,279],{},[228,353,354,357],{},[243,355,356],{},"nombres qui ressemblent à des numéros de carte (13 à 19 chiffres, clé de Luhn valide, chiffre d'émetteur de 2 à 6)",[243,358,359],{},[247,360,361],{},"[CARD]",[228,363,364,367],{},[243,365,366],{},"chaînes qui ressemblent à des IBAN (contrôle mod-97)",[243,368,369],{},[247,370,371],{},"[IBAN]",[228,373,374,380],{},[243,375,376,377],{},"adresses IP, uniquement avec ",[247,378,379],{},"\"ips\": true",[243,381,382,385],{},[247,383,384],{},"[IP:\u003C8 hex>]",", un hash à clé, stable pour un même agent",[387,388,390],"h2",{"id":389},"adresses-ip","Adresses IP",[218,392,393,394,397],{},"Les IP sont conservées par défaut, car les règles de force brute SSH et de « connexion admin depuis\nune nouvelle IP » reposent sur elles. Activez ",[247,395,396],{},"ips"," si les adresses sont pour vous des données\npersonnelles et que vous pouvez vous passer du regroupement par IP dans les titres.",[387,399,401],{"id":400},"ce-qui-ne-change-jamais","Ce qui ne change jamais",[218,403,404],{},"Le type, l'hôte, le bench, le site, l'horodatage et l'empreinte (fingerprint). Les empreintes sont\ncalculées sur les lignes brutes avant le nettoyage : le regroupement et la déduplication sur le site\nWolf fonctionnent donc de la même façon dans les deux cas.",[218,406,407,408,411],{},"Les métriques ne contiennent aucun texte libre et ne sont pas nettoyées. Le texte que vous saisissez\nvous-même (",[247,409,410],{},"mark-deployment --note",") est envoyé tel quel.",[387,413,415],{"id":414},"réglages","Réglages",[417,418,424],"pre",{"className":419,"code":420,"filename":421,"language":422,"meta":423,"style":423},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\"scrub\": {\n  \"enabled\": true,\n  \"ips\": false,\n  \"extra_patterns\": [\n    \"internal-\\\\d{4}\",\n    {\"pattern\": \"CUST-\\\\d{6}\", \"replacement\": \"[CUSTOMER]\"}\n  ],\n  \"keep\": [\"@dokos.io\", \"noreply@example.com\"]\n}\n","\u002Fetc\u002Fwolf-agent\u002Fconfig.json","json","",[247,425,426,448,466,480,495,515,566,572,606],{"__ignoreMap":423},[427,428,431,435,439,441,445],"span",{"class":429,"line":430},"line",1,[427,432,434],{"class":433},"sMK4o","\"",[427,436,438],{"class":437},"sfazB","scrub",[427,440,434],{"class":433},[427,442,444],{"class":443},"sTEyZ",": ",[427,446,447],{"class":433},"{\n",[427,449,451,454,458,460,463],{"class":429,"line":450},2,[427,452,453],{"class":433},"  \"",[427,455,457],{"class":456},"spNyl","enabled",[427,459,434],{"class":433},[427,461,462],{"class":433},":",[427,464,465],{"class":433}," true,\n",[427,467,469,471,473,475,477],{"class":429,"line":468},3,[427,470,453],{"class":433},[427,472,396],{"class":456},[427,474,434],{"class":433},[427,476,462],{"class":433},[427,478,479],{"class":433}," false,\n",[427,481,483,485,488,490,492],{"class":429,"line":482},4,[427,484,453],{"class":433},[427,486,487],{"class":456},"extra_patterns",[427,489,434],{"class":433},[427,491,462],{"class":433},[427,493,494],{"class":433}," [\n",[427,496,498,501,504,507,510,512],{"class":429,"line":497},5,[427,499,500],{"class":433},"    \"",[427,502,503],{"class":437},"internal-",[427,505,506],{"class":443},"\\\\",[427,508,509],{"class":437},"d{4}",[427,511,434],{"class":433},[427,513,514],{"class":433},",\n",[427,516,518,521,523,527,529,531,534,537,539,542,544,547,549,552,554,556,558,561,563],{"class":429,"line":517},6,[427,519,520],{"class":433},"    {",[427,522,434],{"class":433},[427,524,526],{"class":525},"sBMFI","pattern",[427,528,434],{"class":433},[427,530,462],{"class":433},[427,532,533],{"class":433}," \"",[427,535,536],{"class":437},"CUST-",[427,538,506],{"class":443},[427,540,541],{"class":437},"d{6}",[427,543,434],{"class":433},[427,545,546],{"class":433},",",[427,548,533],{"class":433},[427,550,551],{"class":525},"replacement",[427,553,434],{"class":433},[427,555,462],{"class":433},[427,557,533],{"class":433},[427,559,560],{"class":437},"[CUSTOMER]",[427,562,434],{"class":433},[427,564,565],{"class":433},"}\n",[427,567,569],{"class":429,"line":568},7,[427,570,571],{"class":433},"  ],\n",[427,573,575,577,580,582,584,587,589,592,594,596,598,601,603],{"class":429,"line":574},8,[427,576,453],{"class":433},[427,578,579],{"class":456},"keep",[427,581,434],{"class":433},[427,583,462],{"class":433},[427,585,586],{"class":433}," [",[427,588,434],{"class":433},[427,590,591],{"class":437},"@dokos.io",[427,593,434],{"class":433},[427,595,546],{"class":433},[427,597,533],{"class":433},[427,599,600],{"class":437},"noreply@example.com",[427,602,434],{"class":433},[427,604,605],{"class":433},"]\n",[427,607,609],{"class":429,"line":608},9,[427,610,565],{"class":433},[612,613,614,628,637],"field-group",{},[615,616,618],"field",{"name":487,"type":617},"array",[218,619,620,621,623,624,627],{},"Des regex supplémentaires : une chaîne (remplacée par ",[247,622,279],{},") ou\n",[247,625,626],{},"{\"pattern\", \"replacement\"}",". Les regex invalides sont journalisées et ignorées.",[615,629,630],{"name":579,"type":617},[218,631,632,633,636],{},"Valeurs jamais remplacées : chaînes exactes (sans tenir compte de la casse), ou ",[247,634,635],{},"@domain"," pour\nconserver toutes les adresses de ce domaine, comme vos propres e-mails système.",[615,638,640],{"name":457,"type":639},"boolean",[218,641,642,645,646,649],{},[247,643,644],{},"\"scrub\": false"," ou ",[247,647,648],{},"\"enabled\": false"," envoie les lignes telles quelles.",[218,651,652,653,656],{},"Lancez ",[247,654,655],{},"wolf-agent check"," pour voir exactement ce qui serait envoyé.",[658,659,660],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--sh