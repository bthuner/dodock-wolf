h","\nne peut donc pas se déclencher pour lui. Les installations qui ne sauvegardent que hors\nsite peuvent faire pointer ",[192,684,685],{},"backups.dirs"," vers un répertoire monté par site.",[202,688,690],{"id":689},"certificats-tls","Certificats TLS",[188,692,693,696,697,700,701,704,705,708],{},[192,694,695],{},"tls_days_left"," pour chaque nom de site public et chaque domaine personnalisé (",[192,698,699],{},"domains"," de\n",[192,702,703],{},"site_config.json","), toutes les heures, dans un thread d'arrière-plan. L'agent se connecte à\n",[192,706,707],{},"\u003Cdomain>:443"," avec SNI et lit le certificat feuille sans le vérifier : les certificats expirés et\nautosignés sont donc mesurés eux aussi.",[188,710,711,712,254,715,254,718,254,721,724,725,728],{},"Ignorés : ",[192,713,714],{},"localhost",[192,716,717],{},"*.localhost",[192,719,720],{},".local",[192,722,723],{},".test",", les noms sans domaine, les adresses IP et\nles noms ",[192,726,727],{},"example.*",". Les domaines injoignables sont journalisés et ignorés.",[202,730,732],{"id":731},"mariadb","MariaDB",[188,734,735,736,738,739,742],{},"Via le client ",[192,737,731],{}," (ou ",[192,740,741],{},"mysql","), avec les identifiants propres d'un site écrits dans un fichier\nd'options temporaire privé, jamais sur la ligne de commande :",[218,744,745,753],{},[221,746,747],{},[224,748,749,751],{},[227,750,229],{},[227,752,588],{},[234,754,755,771,781],{},[224,756,757,765],{},[239,758,759,254,762],{},[192,760,761],{},"db_threads_connected",[192,763,764],{},"db_connections_used_percent",[239,766,767,768],{},"rapporté à ",[192,769,770],{},"max_connections",[224,772,773,778],{},[239,774,775],{},[192,776,777],{},"db_slow_queries",[239,779,780],{},"augmentation par envoi",[224,782,783,791],{},[239,784,785,254,788],{},[192,786,787],{},"db_replication_lag_seconds",[192,789,790],{},"db_replication_running",[239,792,793],{},"sur un réplica",[188,795,796,797,800,801,804,805,808],{},"L'utilisateur d'un site n'a pas toujours le droit de lire l'état du réplica (REPLICATION CLIENT \u002F\nSLAVE MONITOR). La réplication est alors ignorée, sauf si ",[192,798,799],{},"mariadb.user"," \u002F ",[192,802,803],{},"password"," ou\n",[192,806,807],{},"mariadb.defaults_file"," désigne un utilisateur de supervision. Sans client sur l'hôte, ou pour les\nbenches Postgres, rien n'est envoyé.",[202,810,812],{"id":811},"processus","Processus",[188,814,208,815,818,819,822,823,826,827,830,831,833,834,800,836,200],{},[192,816,817],{},"supervisorctl status",", sinon ",[192,820,821],{},"systemctl list-units"," pour les unités dont le nom contient le\nnom du bench. ",[192,824,825],{},"bench_processes_down"," compte, par bench, les processus à l'état STOPPED, EXITED,\nBACKOFF, FATAL ou UNKNOWN (systemd : ",[192,828,829],{},"failed"," ou une boucle de redémarrage). Un processus qui passe\nen FATAL \u002F UNKNOWN (systemd ",[192,832,829],{},") envoie aussi un événement ",[192,835,389],{},[192,837,838],{},"process_down",[202,840,842],{"id":841},"posture-de-sécurité","Posture de sécurité",[218,844,845,858],{},[221,846,847],{},[224,848,849,852,855],{},[227,850,851],{},"Contrôle",[227,853,854],{},"Fréquence",[227,856,857],{},"Envoie",[234,859,860,881,900,934,962],{},[224,861,862,868,871],{},[239,863,864],{},[865,866,867],"strong",{},"Versions des apps",[239,869,870],{},"1 h",[239,872,873,876,877,880],{},[192,874,875],{},"app_version"," par bench et par app, depuis ",[192,878,879],{},"apps\u002F\u003Capp>\u002F\u003Capp>\u002F__init__.py",". Le site Wolf les compare aux GitHub Security Advisories de Frappe et d'ERPNext. Les versions de développement ne sont pas envoyées.",[224,882,883,888,890],{},[239,884,885],{},[865,886,887],{},"Réglages des sites",[239,889,870],{},[239,891,892,895,896,899],{},[192,893,894],{},"site_setting"," par site : authentification à deux facteurs, politique de mot de passe et score minimal, verrouillage de compte, envois de fichiers par les invités, et l'option deux facteurs du rôle System Manager. Alimente le ",[197,897,898],{"href":140},"score de sécurité"," des sites autres que le site Wolf.",[224,901,902,907,910],{},[239,903,904],{},[865,905,906],{},"Exposition",[239,908,909],{},"10 min",[239,911,912,915,916,919,920,254,923,926,927,930,931,200],{},[192,913,914],{},"exposed_services"," par hôte : ports du bench en écoute au-delà de la boucle locale (MariaDB 3306, Postgres 5432, Redis, socket.io 9000, gunicorn). ",[192,917,918],{},"site_config_risks"," par site : ",[192,921,922],{},"developer_mode",[192,924,925],{},"allow_tests",", un ",[192,928,929],{},"host_name"," en HTTP simple, ",[192,932,933],{},"allow_cors: \"*\"",[224,935,936,941,944],{},[239,937,938],{},[865,939,940],{},"Intégrité des fichiers",[239,942,943],{},"15 min",[239,945,946,949,950,953,954,957,958,200],{},[192,947,948],{},"integrity_files"," par bench ; des événements ",[192,951,952],{},"bench_code_changed"," et ",[192,955,956],{},"bench_config_changed"," quand le code d'une app, une configuration de site ou la configuration nginx et supervisor change, en distinguant un déploiement d'un changement hors déploiement. Voir ",[197,959,961],{"href":960},"\u002Ffr\u002Fsecurity\u002Fdetection#int%C3%A9grit%C3%A9-des-fichiers","Détection",[224,963,964,969,972],{},[239,965,966],{},[865,967,968],{},"Connexions sortantes",[239,970,971],{},"1 min",[239,973,974,977,978,981,982,985,986,200],{},[192,975,976],{},"bench_outbound_destinations"," par bench ; un événement ",[192,979,980],{},"bench_new_outbound"," pour chaque réseau public et port inhabituel que l'utilisateur d'un bench n'avait jamais utilisé, après 7 jours d'apprentissage ; ",[192,983,984],{},"bench_new_outbound_usual"," compte les nouveaux sur des ports habituels. Voir ",[197,987,961],{"href":988},"\u002Ffr\u002Fsecurity\u002Fdetection#connexions-sortantes",[188,990,991,992,200],{},"Voir ",[197,993,961],{"href":125},[202,995,997],{"id":996},"sources-optionnelles","Sources optionnelles",[188,999,1000],{},"Quand ils sont présents sur l'hôte, l'agent suit aussi :",[1002,1003,1004,1021],"ul",{},[1005,1006,1007,1008,1011,1012,1016,1017,1020],"li",{},"le journal EVE de ",[865,1009,1010],{},"Suricata",", trouvé auprès de Suricata lui-même (",[197,1013,1015],{"href":1014},"\u002Ffr\u002Fsecurity\u002Fwazuh-suricata#lactiver","comment",") : événements ",[192,1018,1019],{},"network_ids_alert"," ;",[1005,1022,1023,1024,1027,1028,1031,1032,200],{},"le fichier ",[192,1025,1026],{},"alerts.json"," de ",[865,1029,1030],{},"Wazuh"," sur le manager : événements ",[192,1033,1034],{},"hids_alert",[188,1036,991,1037,200],{},[197,1038,148],{"href":149},[202,1040,1042],{"id":1041},"garanties-de-livraison","Garanties de livraison",[1002,1044,1045,1052,1059],{},[1005,1046,1047,1048,1051],{},"Au premier démarrage, les journaux sont lus à partir de la fin. Les positions de lecture sont\nconservées dans ",[192,1049,1050],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Ftail-state.json"," : ni les redémarrages ni la rotation\ndes journaux ne font rien perdre.",[1005,1053,1054,1055,1058],{},"Les envois échoués sont placés dans la file locale (spool) ",[192,1056,1057],{},"\u002Fvar\u002Flib\u002Fwolf-agent\u002Fspool\u002Foutbox\u002F","\n(plafonnée à 50 Mo) et rejoués dans l'ordre, avec un délai exponentiel entre les tentatives.",[1005,1060,1061,1062,1065],{},"Les événements sont ",[197,1063,1064],{"href":71},"nettoyés"," des adresses e-mail, des identifiants, des\nnuméros de carte et des IBAN avant d'être placés dans la file locale.",{"title":1067,"searchDepth":1068,"depth":1069,"links":1070},"",1,2,[1071,1072,1073,1074,1075,1076,1077,1078,1079,1080,1081,1082],{"id":204,"depth":1069,"text":205},{"id":313,"depth":1069,"text":314},{"id":402,"depth":1069,"text":403},{"id":440,"depth":1069,"text":441},{"id":570,"depth":1069,"text":571},{"id":666,"depth":1069,"text":667},{"id":689,"depth":1069,"text":690},{"id":731,"depth":1069,"text":732},{"id":811,"depth":1069,"text":812},{"id":841,"depth":1069,"text":842},{"id":996,"depth":1069,"text":997},{"id":1041,"depth":1069,"text":1042},"Chaque métrique et chaque événement envoyés par le Wolf Agent, et l'endroit où il les lit.","md",null,{},{"icon":58},{"title":55,"description":1083},"xiy89tc5ULykMlCeniNp8RMZLBNY-gDtfN5w6WAxs7A",[1091,1093],{"title":45,"path":46,"stem":47,"description":1092,"icon":48},"Faites tourner le Wolf Agent sur un hôte Frappe Pilot et transformez les tâches Pilot en événements de déploiement.",{"title":60,"path":61,"stem":62,"description":1094,"icon":63},"Le fichier config.json de l'agent, clé par clé.",1795104293227]