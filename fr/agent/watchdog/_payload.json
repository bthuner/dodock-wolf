:304},[298,451,369],{"class":304},[298,453,454],{"class":308},"wolf@example.com",[298,456,305],{"class":304},[298,458,411],{"class":304},[298,460,369],{"class":304},[298,462,463],{"class":396},"to",[298,465,305],{"class":304},[298,467,333],{"class":304},[298,469,470],{"class":304}," [",[298,472,305],{"class":304},[298,474,475],{"class":308},"ops@example.com",[298,477,305],{"class":304},[298,479,480],{"class":304},"],\n",[298,482,484,486,489,491,493,495,498,500,502,504,507,509,511,513,516,518],{"class":300,"line":483},7,[298,485,442],{"class":304},[298,487,488],{"class":396},"user",[298,490,305],{"class":304},[298,492,333],{"class":304},[298,494,369],{"class":304},[298,496,497],{"class":308},"wolf",[298,499,305],{"class":304},[298,501,411],{"class":304},[298,503,369],{"class":304},[298,505,506],{"class":396},"password",[298,508,305],{"class":304},[298,510,333],{"class":304},[298,512,369],{"class":304},[298,514,515],{"class":308},"…",[298,517,305],{"class":304},[298,519,520],{"class":304},"}\n",[298,522,524],{"class":300,"line":523},8,[298,525,520],{"class":304},[527,528,529,540,576],"field-group",{},[530,531,533],"field",{"name":362,"type":532},"string",[218,534,535,536,539],{},"Envoie en POST ",[235,537,538],{},"{\"text\": \"...\"}",", que les webhooks entrants de Slack, Mattermost et Rocket.Chat\nacceptent.",[530,541,543],{"name":384,"type":542},"object",[218,544,545,547,548,550,551,553,554,557,558,547,560,562,563,565,566,547,568,354,570,547,572,575],{},[235,546,397],{},", ",[235,549,416],{}," (25 par défaut ; 587 avec ",[235,552,430],{},", 465 avec ",[235,555,556],{},"ssl","), ",[235,559,445],{},[235,561,463],{}," (liste ou\nvaleurs séparées par des virgules), ",[235,564,430],{}," (activé par défaut pour le port 587), ",[235,567,556],{},[235,569,488],{},[235,571,506],{},[235,573,574],{},"verify_tls",".",[530,577,579],{"name":253,"type":578},"number",[218,580,581,584],{},[235,582,583],{},"5"," par défaut.",[218,586,587,588,591],{},"Sans canal, le chien de garde se contente d'écrire dans le journal au niveau ERROR.\n",[235,589,590],{},"\"enabled\": false"," le désactive.",[288,593,598],{"className":594,"code":595,"filename":596,"language":597,"meta":294,"style":294},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo -u wolf-agent wolf-agent test-fallback   # après avoir modifié la configuration\nsudo -u wolf-agent wolf-agent check           # affiche l'état du chien de garde sur stderr\n","hôte","bash",[235,599,600,620],{"__ignoreMap":294},[298,601,602,605,608,611,613,616],{"class":300,"line":301},[298,603,604],{"class":396},"sudo",[298,606,607],{"class":308}," -u",[298,609,610],{"class":308}," wolf-agent",[298,612,610],{"class":308},[298,614,615],{"class":308}," test-fallback",[298,617,619],{"class":618},"sHwdD","   # après avoir modifié la configuration\n",[298,621,622,624,626,628,630,633],{"class":300,"line":321},[298,623,604],{"class":396},[298,625,607],{"class":308},[298,627,610],{"class":308},[298,629,610],{"class":308},[298,631,632],{"class":308}," check",[298,634,635],{"class":618},"           # affiche l'état du chien de garde sur stderr\n",[637,638,639],"tip",{},[218,640,641],{},"Faites pointer le canal de secours vers un canal qui ne dépend pas de l'hôte du site Wolf : un autre\nrelais de messagerie, ou un webhook de messagerie instantanée.",[227,643,645],{"id":644},"sur-la-chronologie-après-coup","Sur la chronologie après coup",[218,647,648,649,652,653,656],{},"Tant que ses règles sont en retard, le site enregistre un événement ",[235,650,651],{},"scheduler_stalled"," à chaque\nenvoi. La règle prédéfinie ",[222,654,655],{},"Scheduler stalled"," le transforme en incident dès que le planificateur\ntourne de nouveau : la panne apparaît ainsi sur la chronologie Wolf.",[658,659,660],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki