ns son code","i-lucide-map",{"title":191,"path":192,"stem":193,"icon":194},"Les applications","\u002Ffr\u002Finternals\u002Fapps","fr\u002F7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Appels et confiance","\u002Ffr\u002Finternals\u002Finterop","fr\u002F7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flux","\u002Ffr\u002Finternals\u002Fflows","fr\u002F7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Dans un serveur client","\u002Ffr\u002Finternals\u002Fcustomer-server","fr\u002F7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes pour Wolf","\u002Ffr\u002Finternals\u002Fwolf","fr\u002F7.internals\u002F6.wolf",{"id":213,"title":65,"body":214,"description":686,"extension":687,"links":688,"meta":689,"navigation":690,"path":66,"seo":691,"stem":67,"__hash__":692},"docs_fr\u002Ffr\u002F3.agent\u002F3.commands.md",{"type":215,"value":216,"toc":679},"minimark",[217,230,244,350,355,362,445,452,457,526,545,552,555,574,591,599,610,626,630,666,675],[218,219,220,221,225,226,229],"p",{},"Lancez les commandes en tant qu'utilisateur ",[222,223,224],"code",{},"wolf-agent",", propriétaire de la configuration :\n",[222,227,228],{},"sudo -u wolf-agent wolf-agent \u003Ccommand>",".",[218,231,232,233,236,237,240,241,229],{},"Options globales : ",[222,234,235],{},"--config PATH"," (ou ",[222,238,239],{},"$WOLF_AGENT_CONFIG","), ",[222,242,243],{},"-v",[245,246,247,260],"table",{},[248,249,250],"thead",{},[251,252,253,257],"tr",{},[254,255,256],"th",{},"Commande",[254,258,259],{},"Rôle",[261,262,263,274,284,294,308,323,337],"tbody",{},[251,264,265,271],{},[266,267,268],"td",{},[222,269,270],{},"register --url URL --token TOKEN [--bench PATH]...",[266,272,273],{},"Enregistre l'hôte, découvre les benches, écrit la configuration.",[251,275,276,281],{},[266,277,278],{},[222,279,280],{},"run",[266,282,283],{},"La boucle du démon. C'est ce que lance systemd.",[251,285,286,291],{},[266,287,288],{},[222,289,290],{},"discover [--bench PATH]",[266,292,293],{},"Affiche ce que trouve la découverte des benches.",[251,295,296,301],{},[266,297,298],{},[222,299,300],{},"check [--from-start] [--status] [--bench PATH]",[266,302,303,304,307],{},"Collecte une fois et affiche la charge utile JSON. Rien n'est envoyé. L'état du chien de garde part sur stderr. ",[222,305,306],{},"--status"," demande aussi au site son état de santé.",[251,309,310,315],{},[266,311,312],{},[222,313,314],{},"doctor [--json] [--offline]",[266,316,317,318,229],{},"Vérifie ce que l'hôte donne à l'agent et ce qu'il faut corriger : l'enregistrement et le site Wolf, chaque log, bench, Redis de file d'attente et log nginx, l'export Pilot, le log d'authentification ou le journal, les actions de réponse, le démon. Lecture seule. Sort avec le code 1 quand une vérification échoue. Voir ",[319,320,322],"a",{"href":321},"#v%C3%A9rifier-un-h%C3%B4te","Vérifier un hôte",[251,324,325,330],{},[266,326,327],{},[222,328,329],{},"mark-deployment --bench NAME [--site S] [--note TEXT] [--silence 15m]",[266,331,332,333,336],{},"Place un marqueur de déploiement sur la chronologie Wolf. ",[222,334,335],{},"--silence"," ouvre aussi une fenêtre de maintenance qui coupe les notifications pour ce bench ou ce site.",[251,338,339,344],{},[266,340,341],{},[222,342,343],{},"test-fallback",[266,345,346,347,229],{},"Envoie un message de test via les canaux de secours du ",[319,348,349],{"href":76},"chien de garde",[351,352,354],"h3",{"id":353},"obsolètes","Obsolètes",[218,356,357,358,361],{},"La prise en charge de Press v1 et les métriques de ressources de l'hôte ont été retirées en 0.2.\nLeurs options restent acceptées, pour que les anciens scripts, unités et configurations continuent\nde fonctionner : chacune écrit ",[222,359,360],{},"removed in 0.2: ignored"," sur stderr et ne fait rien.",[245,363,364,374],{},[248,365,366],{},[251,367,368,371],{},[254,369,370],{},"Option ou commande",[254,372,373],{},"Depuis la 0.2",[261,375,376,398,411,421],{},[251,377,378,395],{},[266,379,380,383,384,387,388,391,392],{},[222,381,382],{},"--platform"," sur ",[222,385,386],{},"register",", ",[222,389,390],{},"discover"," et ",[222,393,394],{},"check",[266,396,397],{},"Ignorée : les benches sont découverts comme d'habitude.",[251,399,400,405],{},[266,401,402],{},[222,403,404],{},"mark-deployment --source press",[266,406,407,408,229],{},"Enregistré comme ",[222,409,410],{},"manual",[251,412,413,418],{},[266,414,415],{},[222,416,417],{},"refresh",[266,419,420],{},"Ne fait rien et sort avec le code 0.",[251,422,423,429],{},[266,424,425,428],{},[222,426,427],{},"collect_host_metrics"," dans la configuration",[266,430,431,432,434,435,437,438,441,442,444],{},"Ignorée : l'agent ne mesure plus les ressources de l'hôte. ",[222,433,280],{}," écrit l'avertissement dans son journal, ",[222,436,394],{}," l'affiche sur stderr, ",[222,439,440],{},"doctor"," la liste, ",[222,443,386],{}," retire la clé.",[218,446,447,448,229],{},"Un hôte encore sous Press v1 reste en ",[319,449,451],{"href":450},"\u002Ffr\u002Fgetting-started#rester-en-v010","v0.1.0",[453,454,456],"h2",{"id":455},"marquer-un-déploiement","Marquer un déploiement",[458,459,465],"pre",{"className":460,"code":461,"filename":462,"language":463,"meta":464,"style":464},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo -u wolf-agent wolf-agent mark-deployment --bench frappe-bench --site erp.example.com \\\n  --note \"ERPNext v15.42 + custom app 2.3\" --silence 15m\n","deploy.sh","bash","",[222,466,467,504],{"__ignoreMap":464},[468,469,472,476,480,483,485,488,491,494,497,500],"span",{"class":470,"line":471},"line",1,[468,473,475],{"class":474},"sBMFI","sudo",[468,477,479],{"class":478},"sfazB"," -u",[468,481,482],{"class":478}," wolf-agent",[468,484,482],{"class":478},[468,486,487],{"class":478}," mark-deployment",[468,489,490],{"class":478}," --bench",[468,492,493],{"class":478}," frappe-bench",[468,495,496],{"class":478}," --site",[468,498,499],{"class":478}," erp.example.com",[468,501,503],{"class":502},"sTEyZ"," \\\n",[468,505,507,510,514,517,520,523],{"class":470,"line":506},2,[468,508,509],{"class":478},"  --note",[468,511,513],{"class":512},"sMK4o"," \"",[468,515,516],{"class":478},"ERPNext v15.42 + custom app 2.3",[468,518,519],{"class":512},"\"",[468,521,522],{"class":478}," --silence",[468,524,525],{"class":478}," 15m\n",[218,527,528,529,532,533,537,538,541,542,229],{},"Le marqueur est un événement ",[222,530,531],{},"deployment",". Les règles avec ",[534,535,536],"strong",{},"Exiger un déploiement récent"," ne se\ndéclenchent qu'après un déploiement, et les incidents sont liés au dernier déploiement de leur\npérimètre. Le texte passé avec ",[222,539,540],{},"--note"," est envoyé tel quel, sans ",[319,543,544],{"href":71},"nettoyage",[218,546,547,548,551],{},"Les tâches Pilot, ainsi que ",[222,549,550],{},"bench migrate"," sur les sites qui exécutent la Wolf App, sont\nmarquées automatiquement.",[453,553,322],{"id":554},"vérifier-un-hôte",[458,556,559],{"className":460,"code":557,"filename":558,"language":463,"meta":464,"style":464},"sudo -u wolf-agent wolf-agent doctor\n","hôte",[222,560,561],{"__ignoreMap":464},[468,562,563,565,567,569,571],{"class":470,"line":471},[468,564,475],{"class":474},[468,566,479],{"class":478},[468,568,482],{"class":478},[468,570,482],{"class":478},[468,572,573],{"class":478}," doctor\n",[218,575,576,577,387,580,387,583,586,587,590],{},"Lancez-la avec l'utilisateur de l'agent : root lit ce que le démon ne peut pas lire, et masquerait des problèmes. Chaque ligne vaut ",[534,578,579],{},"ok",[534,581,582],{},"WARN",[534,584,585],{},"FAIL"," ou ",[222,588,589],{},"--"," (pour information), avec la correction après un avertissement ou un échec :",[458,592,597],{"className":593,"code":595,"language":596,"meta":464},[594],"language-text","logs\n  ok   18 log file(s) readable\n  --   9 not written yet (read once they appear): bench-1\u002Ffrappe.web.log ...\n\nplatform\n FAIL  Pilot wolf: cannot read \u002Fvar\u002Flib\u002Fwolf-pilot-export\u002Fwolf.json\n        fix: systemctl restart wolf-pilot-export.service (it sets the wolf-agent group)\n","text",[222,598,595],{"__ignoreMap":464},[218,600,601,602,605,606,609],{},"Elle vérifie les fichiers que le démon suivrait et les benches à partir desquels il travaille, pas seulement la configuration. ",[222,603,604],{},"--json"," affiche les vérifications sous forme de liste, ",[222,607,608],{},"--offline"," n'appelle pas le site Wolf. Rien n'est écrit, et le code de sortie vaut 1 quand une vérification échoue, ce qui permet d'en faire une étape d'un script d'installation.",[218,611,612,613,616,617,620,621,625],{},"Le démon lance les mêmes vérifications toutes les heures (",[222,614,615],{},"setup_checks",") et les envoie avec un push : la page ",[534,618,619],{},"Supervision"," de la Wolf UI affiche la configuration de chaque hôte, ses problèmes et leurs corrections, et la règle prédéfinie ",[622,623,624],"em",{},"Host setup problem"," ouvre un incident tant qu'une vérification échoue.",[453,627,629],{"id":628},"voir-la-charge-utile","Voir la charge utile",[458,631,633],{"className":460,"code":632,"filename":558,"language":463,"meta":464,"style":464},"sudo -u wolf-agent wolf-agent check --from-start | jq '.events[] | {type, category, title}'\n",[222,634,635],{"__ignoreMap":464},[468,636,637,639,641,643,645,648,651,654,657,660,663],{"class":470,"line":471},[468,638,475],{"class":474},[468,640,479],{"class":478},[468,642,482],{"class":478},[468,644,482],{"class":478},[468,646,647],{"class":478}," check",[468,649,650],{"class":478}," --from-start",[468,652,653],{"class":512}," |",[468,655,656],{"class":474}," jq",[468,658,659],{"class":512}," '",[468,661,662],{"class":478},".events[] | {type, category, title}",[468,664,665],{"class":512},"'\n",[218,667,668,671,672,674],{},[222,669,670],{},"--from-start"," lit les journaux depuis le début au lieu des positions enregistrées, ce qui sert à\ntester un parseur sur un fichier existant. ",[222,673,394],{}," n'envoie jamais rien et ne déplace jamais les\npositions.",[676,677,678],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":464,"searchDepth":471,"depth":506,"links":680},[681,683,684,685],{"id":353,"depth":682,"text":354},3,{"id":455,"depth":506,"text":456},{"id":554,"depth":506,"text":322},{"id":628,"depth":506,"text":629},"La ligne de commande wolf-agent.","md",null,{},{"icon":68},{"title":65,"description":686},"r_IUrdInAYGnKzKh4cgVASmjIpXC_7ITg1AxtbsP_LQ",[694,696],{"title":60,"path":61,"stem":62,"description":695,"icon":63},"Le fichier config.json de l'agent, clé par clé.",{"title":70,"path":71,"stem":72,"description":697,"icon":73},"Comment l'agent retire les données personnelles et les secrets des événements avant qu'ils ne quittent l'hôte.",1795109741819]