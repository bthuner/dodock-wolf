oppement","\u002Ffr\u002Freference\u002Fdevelopment","fr\u002F6.reference\u002F5.development","i-lucide-code",{"id":193,"title":158,"body":194,"description":1621,"extension":1622,"links":1623,"meta":1624,"navigation":1625,"path":159,"seo":1626,"stem":160,"__hash__":1627},"docs_fr\u002Ffr\u002F5.security\u002F8.wazuh-suricata.md",{"type":195,"value":196,"toc":1600},"minimark",[197,206,274,278,283,294,368,433,442,446,491,500,503,506,509,513,562,569,573,583,657,735,744,782,785,789,792,1029,1038,1060,1063,1067,1081,1085,1100,1213,1216,1220,1226,1287,1293,1304,1310,1314,1323,1331,1345,1348,1352,1359,1425,1473,1477,1484,1496,1505,1509,1516,1535,1545,1558,1566,1579,1583,1596],[198,199,200,201,205],"p",{},"Suricata (IDS réseau) et Wazuh (IDS hôte) sont des sources facultatives. Quand ils tournent, Wolf\nlit leurs alertes et les place dans les mêmes incidents que ses propres signaux. Wolf n'en dépend\njamais : sans eux, la ",[202,203,204],"a",{"href":135},"détection web et hôte"," propre à l'agent reste\nactive.",[207,208,209,228],"table",{},[210,211,212],"thead",{},[213,214,215,219,222,225],"tr",{},[216,217,218],"th",{},"Source",[216,220,221],{},"Catégorie d'événement",[216,223,224],{},"Lu par",[216,226,227],{},"Règle prédéfinie",[229,230,231,252],"tbody",{},[213,232,233,237,243,246],{},[234,235,236],"td",{},"Suricata",[234,238,239],{},[240,241,242],"code",{},"network_ids_alert",[234,244,245],{},"le Wolf Agent, depuis le journal EVE",[234,247,248],{},[249,250,251],"em",{},"Network IDS alert (critical)",[213,253,254,257,262,269],{},[234,255,256],{},"Wazuh",[234,258,259],{},[240,260,261],{},"hids_alert",[234,263,264,265,268],{},"le Wolf Agent sur l'hôte du manager, depuis ",[240,266,267],{},"alerts.json",", ou l'intégration Wazuh",[234,270,271],{},[249,272,273],{},"Host intrusion alert (critical)",[275,276,236],"h2",{"id":277},"suricata",[279,280,282],"h3",{"id":281},"lactiver","L'activer",[198,284,285,286,289,290,293],{},"L'agent lit Suricata quand il trouve un journal EVE : ",[240,287,288],{},"suricata.eve_log",", sinon\n",[240,291,292],{},"\u002Fvar\u002Flog\u002Fsuricata\u002Feve.json"," s'il existe. Rien d'autre à configurer.",[295,296,302],"pre",{"className":297,"code":298,"filename":299,"language":300,"meta":301,"style":301},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\"suricata\": {\"enabled\": true, \"eve_log\": null, \"max_priority\": 3}\n","config.json","json","",[240,303,304],{"__ignoreMap":301},[305,306,309,313,316,318,322,325,327,331,333,336,339,342,345,347,349,352,354,357,359,361,365],"span",{"class":307,"line":308},"line",1,[305,310,312],{"class":311},"sMK4o","\"",[305,314,277],{"class":315},"sfazB",[305,317,312],{"class":311},[305,319,321],{"class":320},"sTEyZ",": ",[305,323,324],{"class":311},"{",[305,326,312],{"class":311},[305,328,330],{"class":329},"spNyl","enabled",[305,332,312],{"class":311},[305,334,335],{"class":311},":",[305,337,338],{"class":311}," true,",[305,340,341],{"class":311}," \"",[305,343,344],{"class":329},"eve_log",[305,346,312],{"class":311},[305,348,335],{"class":311},[305,350,351],{"class":311}," null,",[305,353,341],{"class":311},[305,355,356],{"class":329},"max_priority",[305,358,312],{"class":311},[305,360,335],{"class":311},[305,362,364],{"class":363},"sbssI"," 3",[305,366,367],{"class":311},"}\n",[207,369,370,383],{},[210,371,372],{},[213,373,374,377,380],{},[216,375,376],{},"Clé",[216,378,379],{},"Signification",[216,381,382],{},"Défaut",[229,384,385,399,419],{},[213,386,387,391,394],{},[234,388,389],{},[240,390,330],{},[234,392,393],{},"lire le journal EVE de Suricata",[234,395,396],{},[240,397,398],{},"true",[213,400,401,405,415],{},[234,402,403],{},[240,404,344],{},[234,406,407,408,411,412,414],{},"chemin du journal EVE. ",[240,409,410],{},"null"," utilise ",[240,413,292],{}," quand il existe",[234,416,417],{},[240,418,410],{},[213,420,421,425,428],{},[234,422,423],{},[240,424,356],{},[234,426,427],{},"ignorer les alertes dont la priorité est supérieure à cette valeur",[234,429,430],{},[240,431,432],{},"3",[198,434,435,438,439,441],{},[240,436,437],{},"\"suricata\": false"," le désactive. Voir ",[202,440,65],{"href":66},".",[279,443,445],{"id":444},"ce-quil-envoie","Ce qu'il envoie",[447,448,449,457,463,466,481,488],"ul",{},[450,451,452,453,456],"li",{},"Seuls les enregistrements ",[240,454,455],{},"alert"," sont lus.",[450,458,459,460,462],{},"Chaque paire (signature, adresse distante) donne un événement ",[240,461,242],{}," par intervalle\nd'envoi, avec un compteur. Au-delà de 500 paires dans un intervalle, les alertes sont seulement\ncomptées.",[450,464,465],{},"La gravité suit la priorité de la règle : 1 est critical, 2 warning, 3 info.",[450,467,468,469,472,473,476,477,480],{},"Le payload conserve la règle (SID, signature, catégorie, techniques ATT&CK issues de sa\nmétadonnée ",[240,470,471],{},"mitre_technique_id","), le flux (",[240,474,475],{},"flow_id",", ",[240,478,479],{},"community_id",", ports) et les champs de\ncouche applicative que Suricata ajoute aux alertes : hôte HTTP, URL, user agent, SNI TLS,\nrequête DNS.",[450,482,483,484,487],{},"L'adresse distante est la ",[240,485,486],{},"source"," de la règle quand elle est définie. Sinon, c'est l'extrémité du\nflux qui n'est pas l'une des adresses de cet hôte. Une règle sur la réponse du serveur nomme donc\ntoujours le client ; une connexion sortante nomme le serveur distant.",[450,489,490],{},"L'hôte HTTP ou le SNI associe l'alerte à un site.",[198,492,493,496,497,499],{},[494,495,227],"strong",{}," : ",[249,498,251],{}," se déclenche sur toute alerte de priorité 1,\npar hôte.",[198,501,502],{},"Testé avec Suricata 7 et ET Open : des sondages sqlmap, Zmap et de traversée de chemin contre nginx\nsont ressortis sous forme d'événements avec l'adresse du client, le site et la technique ATT&CK de\nla règle.",[275,504,256],{"id":505},"wazuh",[198,507,508],{},"Deux voies d'entrée. Utilisez la route de l'agent quand un Wolf Agent tourne sur l'hôte du manager\nWazuh ; sinon, utilisez la route d'intégration. Les deux traitent les alertes de la même façon.",[279,510,512],{"id":511},"ce-qui-est-conservé","Ce qui est conservé",[447,514,515,528,531,538,548,555],{},[450,516,517,518,496,520,523,524,527],{},"Les alertes de niveau supérieur ou égal au niveau minimal deviennent des événements\n",[240,519,261],{},[240,521,522],{},"wazuh.min_level"," sur la route de l'agent, le ",[240,525,526],{},"\u003Clevel>"," du bloc d'intégration\nsur la route d'intégration (7 dans les deux exemples ci-dessous). Le niveau 12 et au-delà est\ncritical, 7 à 11 warning, en dessous de 7 info.",[450,529,530],{},"Un événement par règle et par sujet (IP source, sinon hôte), avec un compteur.",[450,532,533,534,537],{},"Le groupe ",[240,535,536],{},"sca"," (évaluation de configuration) est écarté par défaut.",[450,539,533,540,543,544,547],{},[240,541,542],{},"dodock_wolf"," est toujours écarté. Ce sont les alertes de Wazuh sur l'",[202,545,546],{"href":155},"export\nSIEM"," de Wolf lui-même, pour que rien ne revienne en boucle.",[450,549,550,551,554],{},"L'hôte de l'événement est le nom de l'agent Wazuh. Pour les journaux que le manager a reçus par\nsyslog (agent ",[240,552,553],{},"000","), c'est le nom d'hôte figurant dans la ligne de journal, là où l'événement\ns'est produit.",[450,556,557,558,561],{},"Le payload conserve la règle (id, niveau, description, groupes, ",[240,559,560],{},"rule.mitre.id"," comme ATT&CK),\nl'agent Wazuh, l'IP source et l'utilisateur, et la première ligne de journal, nettoyée comme\ntout événement.",[198,563,564,496,566,568],{},[494,565,227],{},[249,567,273],{}," se déclenche sur toute alerte de niveau\n12 ou plus, par hôte.",[279,570,572],{"id":571},"route-de-lagent","Route de l'agent",[198,574,575,576,289,579,582],{},"Sur l'hôte du manager Wazuh, l'agent suit ",[240,577,578],{},"wazuh.alerts_log",[240,580,581],{},"\u002Fvar\u002Fossec\u002Flogs\u002Falerts\u002Falerts.json"," s'il existe.",[295,584,586],{"className":297,"code":585,"filename":299,"language":300,"meta":301,"style":301},"\"wazuh\": {\"enabled\": true, \"alerts_log\": null, \"min_level\": 7, \"exclude_groups\": [\"sca\"]}\n",[240,587,588],{"__ignoreMap":301},[305,589,590,592,594,596,598,600,602,604,606,608,610,612,615,617,619,621,623,626,628,630,633,636,638,641,643,645,648,650,652,654],{"class":307,"line":308},[305,591,312],{"class":311},[305,593,505],{"class":315},[305,595,312],{"class":311},[305,597,321],{"class":320},[305,599,324],{"class":311},[305,601,312],{"class":311},[305,603,330],{"class":329},[305,605,312],{"class":311},[305,607,335],{"class":311},[305,609,338],{"class":311},[305,611,341],{"class":311},[305,613,614],{"class":329},"alerts_log",[305,616,312],{"class":311},[305,618,335],{"class":311},[305,620,351],{"class":311},[305,622,341],{"class":311},[305,624,625],{"class":329},"min_level",[305,627,312],{"class":311},[305,629,335],{"class":311},[305,631,632],{"class":363}," 7",[305,634,635],{"class":311},",",[305,637,341],{"class":311},[305,639,640],{"class":329},"exclude_groups",[305,642,312],{"class":311},[305,644,335],{"class":311},[305,646,647],{"class":311}," [",[305,649,312],{"class":311},[305,651,536],{"class":315},[305,653,312],{"class":311},[305,655,656],{"class":311},"]}\n",[207,658,659,669],{},[210,660,661],{},[213,662,663,665,667],{},[216,664,376],{},[216,666,379],{},[216,668,382],{},[229,670,671,684,704,718],{},[213,672,673,677,680],{},[234,674,675],{},[240,676,330],{},[234,678,679],{},"lire le journal d'alertes de Wazuh",[234,681,682],{},[240,683,398],{},[213,685,686,690,700],{},[234,687,688],{},[240,689,614],{},[234,691,692,693,695,696,411,698,414],{},"chemin de ",[240,694,267],{},". ",[240,697,410],{},[240,699,581],{},[234,701,702],{},[240,703,410],{},[213,705,706,710,713],{},[234,707,708],{},[240,709,625],{},[234,711,712],{},"niveau de règle le plus bas envoyé",[234,714,715],{},[240,716,717],{},"7",[213,719,720,724,730],{},[234,721,722],{},[240,723,640],{},[234,725,726,727,729],{},"groupes de règles Wazuh écartés (",[240,728,542],{}," est toujours écarté)",[234,731,732],{},[240,733,734],{},"[\"sca\"]",[198,736,737,738,741,742,441],{},"L'utilisateur de l'agent doit pouvoir lire le journal d'alertes : ajoutez ",[240,739,740],{},"wolf-agent"," au groupe\n",[240,743,505],{},[295,745,749],{"className":746,"code":747,"language":748,"meta":301,"style":301},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo usermod -aG wazuh wolf-agent\nsudo systemctl restart wolf-agent\n","bash",[240,750,751,769],{"__ignoreMap":301},[305,752,753,757,760,763,766],{"class":307,"line":308},[305,754,756],{"class":755},"sBMFI","sudo",[305,758,759],{"class":315}," usermod",[305,761,762],{"class":315}," -aG",[305,764,765],{"class":315}," wazuh",[305,767,768],{"class":315}," wolf-agent\n",[305,770,772,774,777,780],{"class":307,"line":771},2,[305,773,756],{"class":755},[305,775,776],{"class":315}," systemctl",[305,778,779],{"class":315}," restart",[305,781,768],{"class":315},[198,783,784],{},"Les événements sont regroupés à raison d'un par règle et par sujet pour chaque intervalle d'envoi.",[279,786,788],{"id":787},"route-dintégration-wazuh","Route d'intégration Wazuh",[198,790,791],{},"Sans Wolf Agent sur l'hôte du manager, le démon d'intégration de Wazuh envoie lui-même ses alertes\nà Wolf.",[793,794,796,804,855,874,878,896,900,907],"steps",{"level":795},"4",[797,798,800,801],"h4",{"id":799},"enregistrer-une-source-de-type-integration","Enregistrer une source de type ",[240,802,803],{},"integration",[295,805,807],{"className":746,"code":806,"language":748,"meta":301,"style":301},"curl -X POST -H 'Content-Type: application\u002Fjson' \\\n  -d '{\"registration_token\": \"...\", \"hostname\": \"wazuh-manager\", \"kind\": \"integration\"}' \\\n  https:\u002F\u002Fwolf.example.com\u002Fapi\u002Fmethod\u002Fdodock_wolf.api.agent.register\n",[240,808,809,835,849],{"__ignoreMap":301},[305,810,811,814,817,820,823,826,829,832],{"class":307,"line":308},[305,812,813],{"class":755},"curl",[305,815,816],{"class":315}," -X",[305,818,819],{"class":315}," POST",[305,821,822],{"class":315}," -H",[305,824,825],{"class":311}," '",[305,827,828],{"class":315},"Content-Type: application\u002Fjson",[305,830,831],{"class":311},"'",[305,833,834],{"class":320}," \\\n",[305,836,837,840,842,845,847],{"class":307,"line":771},[305,838,839],{"class":315},"  -d",[305,841,825],{"class":311},[305,843,844],{"class":315},"{\"registration_token\": \"...\", \"hostname\": \"wazuh-manager\", \"kind\": \"integration\"}",[305,846,831],{"class":311},[305,848,834],{"class":320},[305,850,852],{"class":307,"line":851},3,[305,853,854],{"class":315},"  https:\u002F\u002Fwolf.example.com\u002Fapi\u002Fmethod\u002Fdodock_wolf.api.agent.register\n",[198,856,857,858,861,862,865,866,870,871,873],{},"La réponse donne ",[240,859,860],{},"agent_id"," et ",[240,863,864],{},"agent_secret",". Le secret n'est affiché qu'une fois (voir\n",[202,867,869],{"href":868},"\u002Ffr\u002Fsecurity\u002Faccess#secrets-des-agents","Secrets des agents","). Une source ",[240,872,803],{}," n'est jamais\nsignalée comme silencieuse, puisqu'elle ne s'exprime que lorsque Wazuh a une alerte.",[797,875,877],{"id":876},"installer-lintégration","Installer l'intégration",[198,879,880,881,861,884,887,888,891,892,895],{},"Copiez ",[240,882,883],{},"agent\u002Fwazuh\u002Fcustom-dodock-wolf",[240,885,886],{},"agent\u002Fwazuh\u002Fcustom-dodock-wolf.py"," depuis le dépôt vers\n",[240,889,890],{},"\u002Fvar\u002Fossec\u002Fintegrations\u002F",", avec le propriétaire ",[240,893,894],{},"root:wazuh"," et le mode 750. Le lanceur exécute le\nscript avec le Python propre à Wazuh.",[797,897,899],{"id":898},"configurer-le-manager","Configurer le manager",[198,901,902,903,906],{},"Ajoutez ceci à ",[240,904,905],{},"\u002Fvar\u002Fossec\u002Fetc\u002Fossec.conf",", puis redémarrez le manager :",[295,908,913],{"className":909,"code":910,"filename":911,"language":912,"meta":301,"style":301},"language-xml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u003Cintegration>\n  \u003Cname>custom-dodock-wolf\u003C\u002Fname>\n  \u003Chook_url>https:\u002F\u002Fwolf.example.com\u003C\u002Fhook_url>\n  \u003Capi_key>AGENT_ID:AGENT_SECRET\u003C\u002Fapi_key>\n  \u003Clevel>7\u003C\u002Flevel>\n  \u003Calert_format>json\u003C\u002Falert_format>\n\u003C\u002Fintegration>\n","ossec.conf","xml",[240,914,915,926,947,965,984,1002,1020],{"__ignoreMap":301},[305,916,917,920,923],{"class":307,"line":308},[305,918,919],{"class":311},"\u003C",[305,921,803],{"class":922},"swJcz",[305,924,925],{"class":311},">\n",[305,927,928,931,934,937,940,943,945],{"class":307,"line":771},[305,929,930],{"class":311},"  \u003C",[305,932,933],{"class":922},"name",[305,935,936],{"class":311},">",[305,938,939],{"class":320},"custom-dodock-wolf",[305,941,942],{"class":311},"\u003C\u002F",[305,944,933],{"class":922},[305,946,925],{"class":311},[305,948,949,951,954,956,959,961,963],{"class":307,"line":851},[305,950,930],{"class":311},[305,952,953],{"class":922},"hook_url",[305,955,936],{"class":311},[305,957,958],{"class":320},"https:\u002F\u002Fwolf.example.com",[305,960,942],{"class":311},[305,962,953],{"class":922},[305,964,925],{"class":311},[305,966,968,970,973,975,978,980,982],{"class":307,"line":967},4,[305,969,930],{"class":311},[305,971,972],{"class":922},"api_key",[305,974,936],{"class":311},[305,976,977],{"class":320},"AGENT_ID:AGENT_SECRET",[305,979,942],{"class":311},[305,981,972],{"class":922},[305,983,925],{"class":311},[305,985,987,989,992,994,996,998,1000],{"class":307,"line":986},5,[305,988,930],{"class":311},[305,990,991],{"class":922},"level",[305,993,936],{"class":311},[305,995,717],{"class":320},[305,997,942],{"class":311},[305,999,991],{"class":922},[305,1001,925],{"class":311},[305,1003,1005,1007,1010,1012,1014,1016,1018],{"class":307,"line":1004},6,[305,1006,930],{"class":311},[305,1008,1009],{"class":922},"alert_format",[305,1011,936],{"class":311},[305,1013,300],{"class":320},[305,1015,942],{"class":311},[305,1017,1009],{"class":922},[305,1019,925],{"class":311},[305,1021,1023,1025,1027],{"class":307,"line":1022},7,[305,1024,942],{"class":311},[305,1026,803],{"class":922},[305,1028,925],{"class":311},[198,1030,1031,1032,1034,1035,441],{},"Wazuh exécute le script pour chaque alerte de niveau supérieur ou égal à ",[240,1033,526],{},". Le script\nenvoie l'alerte à ",[240,1036,1037],{},"dodock_wolf.api.wazuh.alert",[447,1039,1040,1048,1051,1054],{},[450,1041,1042,1043,861,1045,1047],{},"Wolf la traite comme sur la route de l'agent (",[240,1044,536],{},[240,1046,542],{}," écartés ; la réponse donne\nla raison quand une alerte est ignorée).",[450,1049,1050],{},"La même règle et le même sujet dans un délai de 10 minutes incrémentent le compteur d'un même\névénement.",[450,1052,1053],{},"Le point d'accès accepte jusqu'à 600 appels par minute et par intégration, car Wazuh envoie un\nappel par alerte.",[450,1055,1056,1057,441],{},"Les erreurs vont dans ",[240,1058,1059],{},"\u002Fvar\u002Fossec\u002Flogs\u002Fintegrations.log",[198,1061,1062],{},"Testé avec un manager Wazuh 4.9.2, sur les deux routes : les lignes sshd et sudo qu'il a reçues par\nsyslog sont ressorties sous l'hôte qui les avait journalisées, avec les techniques ATT&CK de Wazuh.\nTrois alertes envoyées par son démon d'intégration sont devenues un seul événement avec un compteur\nde 3.",[275,1064,1066],{"id":1065},"entités-partagées-entre-les-sources","Entités partagées entre les sources",[198,1068,1069,1070,476,1073,1076,1077,1080],{},"Wolf, Suricata et Wazuh nomment différemment les mêmes choses : une adresse dans ",[240,1071,1072],{},"ip",[240,1074,1075],{},"src_ip"," ou\n",[240,1078,1079],{},"dest_ip",", un hôte par son nom d'hôte Wolf, son nom d'agent Wazuh ou l'une de ses adresses, un site\npar son nom ou l'un de ses domaines. À l'ingestion, Wolf les ramène à un seul ensemble d'entités.",[279,1082,1084],{"id":1083},"extraction","Extraction",[198,1086,1087,1088,1091,1092,1095,1096,1099],{},"Les entités de chaque événement ",[240,1089,1090],{},"security"," vont dans ",[240,1093,1094],{},"payload.entities"," et dans\n",[494,1097,1098],{},"Wolf Event Entity"," :",[207,1101,1102,1115],{},[210,1103,1104],{},[213,1105,1106,1109,1112],{},[216,1107,1108],{},"Type",[216,1110,1111],{},"Extrait de",[216,1113,1114],{},"Normalisé",[229,1116,1117,1145,1158,1171],{},[213,1118,1119,1123,1131],{},[234,1120,1121],{},[240,1122,1072],{},[234,1124,1125,476,1127,476,1129],{},[240,1126,1072],{},[240,1128,1075],{},[240,1130,1079],{},[234,1132,1133,1134,1137,1138,1141,1142,1144],{},"forme canonique (",[240,1135,1136],{},"::ffff:1.2.3.4"," devient ",[240,1139,1140],{},"1.2.3.4",", IPv6 compressée). Une adresse qui appartient à un hôte connu devient cet hôte : l'entité IP est l'autre partie. Un ",[240,1143,1079],{}," Suricata sur le serveur est l'hôte",[213,1146,1147,1152,1155],{},[234,1148,1149],{},[240,1150,1151],{},"host",[234,1153,1154],{},"l'hôte de l'événement, le nom de l'agent Wazuh",[234,1156,1157],{},"en minuscules, résolu via les alias. Un nom d'agent Wazuh ou un FQDN se résout vers son hôte",[213,1159,1160,1165,1168],{},[234,1161,1162],{},[240,1163,1164],{},"site",[234,1166,1167],{},"le site de l'événement, l'hôte HTTP ou le SNI TLS",[234,1169,1170],{},"en minuscules, résolu via les alias vers le site",[213,1172,1173,1178,1197],{},[234,1174,1175],{},[240,1176,1177],{},"user",[234,1179,1180,476,1182,476,1185,476,1188,476,1191,476,1194],{},[240,1181,1177],{},[240,1183,1184],{},"suser",[240,1186,1187],{},"username",[240,1189,1190],{},"srcuser",[240,1192,1193],{},"dstuser",[240,1195,1196],{},"users",[234,1198,1199,1200,476,1203,476,1206,476,1209,1212],{},"en minuscules. Les valeurs de remplissage (",[240,1201,1202],{},"-",[240,1204,1205],{},"unknown",[240,1207,1208],{},"none",[240,1210,1211],{},"guest","…) sont écartées",[198,1214,1215],{},"Au plus 10 valeurs par type et par événement.",[279,1217,1219],{"id":1218},"alias","Alias",[198,1221,1222,1225],{},[494,1223,1224],{},"Wolf Entity Alias"," associe un nom à un hôte ou à un site :",[207,1227,1228,1237],{},[210,1229,1230],{},[213,1231,1232,1235],{},[216,1233,1234],{},"Champ",[216,1236,379],{},[229,1238,1239,1251,1258,1266,1279],{},[213,1240,1241,1244],{},[234,1242,1243],{},"Kind",[234,1245,1246,1248,1249],{},[240,1247,1151],{}," ou ",[240,1250,1164],{},[213,1252,1253,1255],{},[234,1254,1219],{},[234,1256,1257],{},"l'autre nom : une adresse, un nom d'agent Wazuh, un FQDN, un domaine",[213,1259,1260,1263],{},[234,1261,1262],{},"Is",[234,1264,1265],{},"l'hôte ou le site canonique",[213,1267,1268,1270],{},[234,1269,218],{},[234,1271,1272,1275,1276],{},[240,1273,1274],{},"Auto"," (appris) ou ",[240,1277,1278],{},"Manual",[213,1280,1281,1284],{},[234,1282,1283],{},"Learnt from",[234,1285,1286],{},"ce qui a appris l'alias à Wolf",[198,1288,1289,1290,1292],{},"Wolf apprend les alias ",[240,1291,1274],{}," à partir :",[447,1294,1295,1298,1301],{},[450,1296,1297],{},"des enregistrements d'agents : l'adresse de l'agent, et les domaines des sites de ses benches ;",[450,1299,1300],{},"des envois depuis une nouvelle adresse ;",[450,1302,1303],{},"des alertes Wazuh concernant d'autres agents Wazuh : l'adresse de cet agent.",[198,1305,1306,1307,1309],{},"Quand deux outils nomment un hôte différemment, ajoutez un alias ",[240,1308,1278],{}," dans le Desk. Wolf\nn'écrase jamais un alias manuel. Les Wolf Managers peuvent modifier les alias ; les Wolf Users\npeuvent les lire.",[279,1311,1313],{"id":1312},"recherche-par-entité","Recherche par entité",[198,1315,1316,1317,476,1320,1099],{},"L'API de liste des événements accepte un filtre ",[240,1318,1319],{},"entity",[240,1321,1322],{},"kind:value",[295,1324,1329],{"className":1325,"code":1327,"language":1328,"meta":301},[1326],"language-text","ip:203.0.113.5\nhost:erp-01\nsite:erp.example.com\nuser:jane@example.com\n","text",[240,1330,1327],{"__ignoreMap":301},[198,1332,1333,1334,1337,1338,1341,1342,441],{},"Il retrouve ensemble les événements de Wolf, de Suricata et de Wazuh. Appelez\n",[240,1335,1336],{},"dodock_wolf.api.explore.list_events"," avec ",[240,1339,1340],{},"entity=…",", ou ",[240,1343,1344],{},"dodock_wolf.api.entities.find",[198,1346,1347],{},"Les lignes d'entités sont purgées chaque jour avec les événements auxquels elles appartiennent.",[275,1349,1351],{"id":1350},"quand-les-détecteurs-se-recoupent","Quand les détecteurs se recoupent",[198,1353,1354,1355,1358],{},"Les détecteurs propres à Wolf et ces sources se recoupent : les sondages web nginx de l'agent et\nSuricata, ses signaux du journal d'authentification et Wazuh. ",[494,1356,1357],{},"Wolf Settings → Overlapping\ndetectors"," (détecteurs qui se recoupent) a un mode pour chacun :",[207,1360,1361,1374],{},[210,1362,1363],{},[213,1364,1365,1368,1371],{},[216,1366,1367],{},"Paramètre",[216,1369,1370],{},"Détecteur propre à Wolf",[216,1372,1373],{},"Autre source",[229,1375,1376,1393],{},[213,1377,1378,1383,1388],{},[234,1379,1380],{},[494,1381,1382],{},"Web Attacks",[234,1384,1385],{},[240,1386,1387],{},"web_attack_probe",[234,1389,1390,1391],{},"Suricata, ",[240,1392,242],{},[213,1394,1395,1400,1420],{},[234,1396,1397],{},[494,1398,1399],{},"Host Logins and Accounts",[234,1401,1402,476,1405,476,1408,476,1411,476,1414,476,1417],{},[240,1403,1404],{},"ssh_failed_login",[240,1406,1407],{},"ssh_root_login",[240,1409,1410],{},"ssh_login_after_failures",[240,1412,1413],{},"sudo_failure",[240,1415,1416],{},"account_created",[240,1418,1419],{},"admin_group_change",[234,1421,1422,1423],{},"Wazuh, ",[240,1424,261],{},[207,1426,1427,1437],{},[210,1428,1429],{},[213,1430,1431,1434],{},[216,1432,1433],{},"Mode",[216,1435,1436],{},"Ce qui se passe",[229,1438,1439,1449,1463],{},[213,1440,1441,1446],{},[234,1442,1443],{},[240,1444,1445],{},"own",[234,1447,1448],{},"Par défaut, comme quand Wolf fonctionne seul : chacun émet ses propres événements.",[213,1450,1451,1456],{},[234,1452,1453],{},[240,1454,1455],{},"both",[234,1457,1458,1459,1462],{},"Un événement de Wolf et l'alerte de l'autre source forment un seul constat quand ils nomment la même IP distante, partagent une technique ATT&CK (ou que l'un n'en nomme aucune) et tombent dans ",[494,1460,1461],{},"Detector Match Minutes"," (10).",[213,1464,1465,1470],{},[234,1466,1467],{},[240,1468,1469],{},"external",[234,1471,1472],{},"Les événements propres à Wolf pour ce détecteur sont écartés à la réception tant que l'autre source couvre l'hôte.",[279,1474,1476],{"id":1475},"both-un-constat-deux-sources","Both : un constat, deux sources",[198,1478,1479,1480,1483],{},"Les deux événements sont conservés, et chacun compte toujours dans ses propres règles d'alerte. Le\nsecond est enregistré avec ",[494,1481,1482],{},"Same Finding As"," (même constat que) pointant vers le premier :",[447,1485,1486,1489],{},[450,1487,1488],{},"la chronologie l'affiche avec « même constat que … », avec un lien vers la ligne de la\npremière source ;",[450,1490,1491,1492,1495],{},"CrowdSec et l'",[202,1493,1494],{"href":155},"export SIEM"," l'ignorent quand le premier a été envoyé.\nUne alerte critique liée à un avertissement part tout de même vers un collecteur qui ne prend que\nle critique.",[198,1497,1498,476,1500,861,1502,1504],{},[240,1499,1413],{},[240,1501,1416],{},[240,1503,1419],{}," ne portent pas d'IP : ils ne sont jamais\nliés.",[279,1506,1508],{"id":1507},"external-wolf-sefface-puis-revient","External : Wolf s'efface, puis revient",[198,1510,1511,1512,1515],{},"Les événements propres à Wolf pour ce détecteur sont écartés tant que l'autre source a envoyé, dans\nl'heure, une alerte sur le même hôte (sous l'un de ses noms, voir ",[202,1513,1219],{"href":1514},"#alias",") qui surveille la\nmême chose :",[447,1517,1518,1521],{},[450,1519,1520],{},"Wazuh : une règle d'authentification, SSH, sudo ou de compte, ou une technique ATT&CK des signaux\nd'authentification (T1110, T1078, T1548, T1136, T1098). Une alerte d'intégrité de fichiers ne\nremplace pas la détection SSH.",[450,1522,1523,1524,1527,1528,1531,1532,1534],{},"Suricata : une alerte avec un contexte HTTP (",[240,1525,1526],{},"app_proto"," ",[240,1529,1530],{},"http",", un hôte ou une URL HTTP) ou une\ntechnique web (T1595, T1190, T1189, T1552). Une sonde Suricata sur une autre machine compte pour\nun hôte quand le ",[240,1533,1079],{}," de son alerte est l'une des adresses de cet hôte.",[198,1536,1537,1538,1540,1541,1544],{},"Quand l'autre source se tait pendant une heure, la détection propre à Wolf revient d'elle-même.\nChaque ",[494,1539,35],{}," compte les événements qu'il a envoyés et qui ont été écartés, dans ",[494,1542,1543],{},"Own\nEvents Given Way",", avec la dernière date.",[1546,1547,1548],"warning",{},[198,1549,1550,1551,1553,1554,1557],{},"En mode ",[240,1552,1469],{},", la détection propre à Wolf dépend de Suricata ou de Wazuh pour couvrir l'hôte.\nConsultez ",[494,1555,1556],{},"Own Events Given Way"," sur le Wolf Agent pour voir ce qu'il a cédé.",[198,1559,1560,1561,1565],{},"Le blocage ne fait pas partie de ces modes : un blocage approuvé peut passer par le Wolf Agent, la\n",[202,1562,1564],{"href":1563},"\u002Ffr\u002Fagent\u002Fresponse-actions#r%C3%A9ponse-active-de-wazuh","réponse active de Wazuh",", ou les deux.",[198,1567,1568,1569,1573,1574,1578],{},"Quel que soit le mode, le ",[202,1570,1572],{"href":1571},"\u002Ffr\u002Falerts\u002Fincidents#regroupement-par-ip-ou-utilisateur","regroupement par IP ou utilisateur","\nréunit les événements des deux sources dans un même incident, et les\n",[202,1575,1577],{"href":1576},"\u002Ffr\u002Falerts\u002Frules#r%C3%A8gles-de-s%C3%A9quence","règles de séquence"," les enchaînent : un scan, puis une\nconnexion depuis la même IP.",[275,1580,1582],{"id":1581},"prévu","Prévu",[198,1584,1585,1586,1590,1591,1595],{},"Sans Wazuh ni Suricata, l'agent surveille tout de même ",[202,1587,1589],{"href":1588},"\u002Ffr\u002Fsecurity\u002Fdetection#int%C3%A9grit%C3%A9-des-fichiers","l'intégrité des fichiers du bench","\net les ",[202,1592,1594],{"href":1593},"\u002Ffr\u002Fsecurity\u002Fdetection#connexions-sortantes","connexions sortantes"," des utilisateurs des benches.",[1597,1598,1599],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}",{"title":301,"searchDepth":308,"depth":771,"links":1601},[1602,1606,1611,1616,1620],{"id":277,"depth":771,"text":236,"children":1603},[1604,1605],{"id":281,"depth":851,"text":282},{"id":444,"depth":851,"text":445},{"id":505,"depth":771,"text":256,"children":1607},[1608,1609,1610],{"id":511,"depth":851,"text":512},{"id":571,"depth":851,"text":572},{"id":787,"depth":851,"text":788},{"id":1065,"depth":771,"text":1066,"children":1612},[1613,1614,1615],{"id":1083,"depth":851,"text":1084},{"id":1218,"depth":851,"text":1219},{"id":1312,"depth":851,"text":1313},{"id":1350,"depth":771,"text":1351,"children":1617},[1618,1619],{"id":1475,"depth":851,"text":1476},{"id":1507,"depth":851,"text":1508},{"id":1581,"depth":771,"text":1582},"Faites entrer les alertes Suricata et Wazuh dans Dodock Wolf, via l'agent ou l'intégration Wazuh, et retrouvez les événements de toutes les sources pour une IP, un hôte, un site ou un utilisateur.","md",null,{},{"icon":43},{"title":158,"description":1621},"UcHobSMh3__cKCSNbGQFUdGodWMEj4fVpWu6npH99Qc",[1629,1631],{"title":154,"path":155,"stem":156,"description":1630,"icon":109},"Envoyez les événements de sécurité de Wolf et son journal signé à un collecteur syslog en OCSF ou CEF, avec les paramètres qui fonctionnent pour rsyslog, Wazuh et Graylog.",{"title":168,"path":169,"stem":170,"description":1632,"icon":171},"Chaque point d'accès, champ et code de statut qu'utilisent le Wolf Agent, les satellites et les intégrations pour dialoguer avec le Wolf App (protocole v1).",1794955057746]