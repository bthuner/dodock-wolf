nt","\u002Ffr\u002Freference\u002Fdevelopment","fr\u002F6.reference\u002F5.development","i-lucide-code",{"id":193,"title":154,"body":194,"description":1145,"extension":1146,"links":1147,"meta":1148,"navigation":1149,"path":155,"seo":1150,"stem":156,"__hash__":1151},"docs_fr\u002Ffr\u002F5.security\u002F7.siem-export.md",{"type":195,"value":196,"toc":1135},"minimark",[197,210,215,456,470,518,522,560,564,580,584,599,602,620,626,630,655,659,662,769,1119,1131],[198,199,200,204,205,209],"p",{},[201,202,203],"strong",{},"Wolf Settings → SIEM export (syslog)"," (désactivé par défaut) envoie les événements de sécurité\nde Wolf et son journal signé à un collecteur syslog. Chaque minute, les événements qui\ncorrespondent aux filtres, ainsi que chaque entrée signée du journal, partent en syslog RFC 5424\n(facility ",[206,207,208],"code",{},"local0",") contenant du JSON OCSF ou du CEF.",[211,212,214],"h2",{"id":213},"paramètres","Paramètres",[216,217,218,234],"table",{},[219,220,221],"thead",{},[222,223,224,228,231],"tr",{},[225,226,227],"th",{},"Paramètre",[225,229,230],{},"Valeurs",[225,232,233],{},"Défaut",[235,236,237,251,263,277,302,315,331,352,371,390,412,444],"tbody",{},[222,238,239,245,248],{},[240,241,242],"td",{},[201,243,244],{},"Export to a SIEM",[240,246,247],{},"activé \u002F désactivé",[240,249,250],{},"désactivé",[222,252,253,258,261],{},[240,254,255],{},[201,256,257],{},"Collector host",[240,259,260],{},"un nom d'hôte ou une adresse. Avec TLS, il doit figurer dans le certificat du collecteur",[240,262],{},[222,264,265,270,272],{},[240,266,267],{},[201,268,269],{},"Port",[240,271],{},[240,273,274],{},[206,275,276],{},"514",[222,278,279,284,298],{},[240,280,281],{},[201,282,283],{},"Transport",[240,285,286,289,290,293,294,297],{},[206,287,288],{},"tcp",", ",[206,291,292],{},"tls"," (RFC 5425), ",[206,295,296],{},"udp"," (RFC 5426)",[240,299,300],{},[206,301,288],{},[222,303,304,309,312],{},[240,305,306],{},[201,307,308],{},"Verify the collector's certificate",[240,310,311],{},"activé \u002F désactivé (TLS)",[240,313,314],{},"activé",[222,316,317,322,329],{},[240,318,319],{},[201,320,321],{},"Collector CA file",[240,323,324,325,328],{},"un fichier PEM d'une autorité de certification privée, absolu ou relatif au site (",[206,326,327],{},"private\u002Ffiles\u002Fcollector-ca.pem","). Vide : les autorités du système",[240,330],{},[222,332,333,338,348],{},[240,334,335],{},[201,336,337],{},"Framing",[240,339,340,343,344,347],{},[206,341,342],{},"octet-counting"," ou ",[206,345,346],{},"newline"," (TCP et TLS, RFC 6587)",[240,349,350],{},[206,351,342],{},[222,353,354,359,367],{},[240,355,356],{},[201,357,358],{},"Message header",[240,360,361,343,364],{},[206,362,363],{},"rfc5424",[206,365,366],{},"none",[240,368,369],{},[206,370,363],{},[222,372,373,378,386],{},[240,374,375],{},[201,376,377],{},"Format",[240,379,380,343,383],{},[206,381,382],{},"ocsf",[206,384,385],{},"cef",[240,387,388],{},[206,389,382],{},[222,391,392,397,408],{},[240,393,394],{},[201,395,396],{},"Minimum severity",[240,398,399,289,402,289,405],{},[206,400,401],{},"info",[206,403,404],{},"warning",[206,406,407],{},"critical",[240,409,410],{},[206,411,404],{},[222,413,414,419,440],{},[240,415,416],{},[201,417,418],{},"Event types",[240,420,421,422,289,425,289,428,289,431,289,434,289,437],{},"séparés par des virgules : ",[206,423,424],{},"security",[206,426,427],{},"error",[206,429,430],{},"cron_failure",[206,432,433],{},"worker_failure",[206,435,436],{},"host_metric_alert",[206,438,439],{},"deployment",[240,441,442],{},[206,443,424],{},[222,445,446,451,454],{},[240,447,448],{},[201,449,450],{},"Send the journal",[240,452,453],{},"envoie aussi chaque entrée signée du journal (seq, empreinte, mac)",[240,455,314],{},[198,457,458,459,462,463,466,467,469],{},"Pour tester un collecteur, un Wolf Manager peut faire un POST sur ",[206,460,461],{},"dodock_wolf.api.siem.send_test",".\nIl envoie un message ",[206,464,465],{},"wolf_test"," avec les paramètres actuels, même quand ",[201,468,244],{}," est\ndésactivé :",[471,472,477],"pre",{"className":473,"code":474,"language":475,"meta":476,"style":476},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST -H \"Authorization: token \u003Capi_key>:\u003Capi_secret>\" \\\n  https:\u002F\u002Fwolf.example.com\u002Fapi\u002Fmethod\u002Fdodock_wolf.api.siem.send_test\n","bash","",[206,478,479,512],{"__ignoreMap":476},[480,481,484,488,492,495,498,502,505,508],"span",{"class":482,"line":483},"line",1,[480,485,487],{"class":486},"sBMFI","curl",[480,489,491],{"class":490},"sfazB"," -X",[480,493,494],{"class":490}," POST",[480,496,497],{"class":490}," -H",[480,499,501],{"class":500},"sMK4o"," \"",[480,503,504],{"class":490},"Authorization: token \u003Capi_key>:\u003Capi_secret>",[480,506,507],{"class":500},"\"",[480,509,511],{"class":510},"sTEyZ"," \\\n",[480,513,515],{"class":482,"line":514},2,[480,516,517],{"class":490},"  https:\u002F\u002Fwolf.example.com\u002Fapi\u002Fmethod\u002Fdodock_wolf.api.siem.send_test\n",[519,520,377],"h3",{"id":521},"format",[523,524,525,540],"ul",{},[526,527,528,531,532,535,536,539],"li",{},[201,529,530],{},"OCSF"," : JSON, Detection Finding (classe 2004). Techniques ATT&CK dans ",[206,533,534],{},"finding_info.attacks"," ;\nsite, bench et payload de Wolf sous ",[206,537,538],{},"unmapped",". La correspondance est la lecture que fait Wolf du\nschéma, pas un profil certifié.",[526,541,542,545,546,549,550,555,556,559],{},[201,543,544],{},"CEF"," : ATT&CK dans ",[206,547,548],{},"cs4",", listes de ",[551,552,554],"a",{"href":553},"\u002Ffr\u002Fsecurity\u002Fjournal#listes-de-r%C3%A9putation-dip","réputation d'IP","\ndans ",[206,557,558],{},"cs5",".",[519,561,563],{"id":562},"en-tête-du-message","En-tête du message",[523,565,566,575],{},[526,567,568,570,571,574],{},[206,569,363],{}," : un en-tête syslog avant chaque message : priorité, horodatage, le site comme nom\nd'hôte, ",[206,572,573],{},"dodock-wolf"," comme application, la catégorie de l'événement comme MSGID.",[526,576,577,579],{},[206,578,366],{}," : le JSON ou le CEF brut, pour les collecteurs qui décodent eux-mêmes le message, comme le\ndécodeur JSON de Wazuh et l'entrée CEF de Graylog.",[519,581,583],{"id":582},"transport-et-tramage","Transport et tramage",[523,585,586,589,594],{},[526,587,588],{},"Préférez TCP ou TLS. UDP envoie un datagramme par message, coupé à 8 Ko. Wolf ne peut pas savoir\nsi le collecteur a reçu quoi que ce soit, le curseur avance donc quand même.",[526,590,591,593],{},[206,592,342],{}," fait précéder chaque message de sa longueur. rsyslog, syslog-ng et l'entrée\nSyslog de Graylog le lisent.",[526,595,596,598],{},[206,597,346],{}," envoie un message par ligne ; un saut de ligne à l'intérieur d'un message devient une\nespace. Wazuh et l'entrée CEF de Graylog en ont besoin.",[519,600,601],{"id":292},"TLS",[523,603,604,609],{},[526,605,606,607,559],{},"Le certificat du collecteur est vérifié par rapport aux autorités du système, ou à\n",[201,608,321],{},[526,610,611,612,615,616,619],{},"Python 3.13 et versions ultérieures vérifient strictement : l'autorité doit avoir\n",[206,613,614],{},"basicConstraints=CA:TRUE"," et ",[206,617,618],{},"keyUsage=keyCertSign",", et le certificat du serveur doit avoir un\nAuthority Key Identifier.",[621,622,623],"caution",{},[198,624,625],{},"Désactiver la vérification du certificat fonctionne, mais toute personne sur le chemin peut alors\nlire l'export.",[211,627,629],{"id":628},"livraison","Livraison",[523,631,632,635,638,641,648],{},[526,633,634],{},"Un curseur n'avance qu'une fois un lot envoyé. Un collecteur indisponible retarde l'export ; rien\nn'est sauté.",[526,636,637],{},"Un échec au milieu d'un lot peut envoyer un message deux fois : la livraison est « au moins une\nfois ».",[526,639,640],{},"Les événements de moins de 2 minutes attendent l'exécution suivante, pour qu'une transaction\nvalidée un peu après son insertion ne soit pas sautée.",[526,642,643,644,647],{},"Les payloads partent tels qu'ils sont stockés (déjà ",[551,645,646],{"href":76},"nettoyés"," par\nl'agent), coupés à 4 Ko.",[526,649,650,651,559],{},"Les entrées du journal donnent au SIEM une copie externe de la chaîne : une ancre que Wolf ne\npeut pas réécrire. Voir ",[551,652,654],{"href":653},"\u002Ffr\u002Fsecurity\u002Fjournal#journal-infalsifiable","Journal infalsifiable",[211,656,658],{"id":657},"collecteurs","Collecteurs",[198,660,661],{},"Chaque recette a été testée contre le vrai collecteur (novembre 2026).",[216,663,664,683],{},[219,665,666],{},[222,667,668,671,673,675,677,680],{},[225,669,670],{},"Collecteur",[225,672,377],{},[225,674,563],{},[225,676,283],{},[225,678,679],{},"Tramage",[225,681,682],{},"Ce que vous obtenez",[235,684,685,708,729,749],{},[222,686,687,690,693,697,700,705],{},[240,688,689],{},"rsyslog 8.2404",[240,691,692],{},"OCSF ou CEF",[240,694,695],{},[206,696,363],{},[240,698,699],{},"UDP, TCP ou TLS",[240,701,702,704],{},[206,703,342],{}," (TCP\u002FTLS)",[240,706,707],{},"messages écrits tels qu'envoyés ; le MSGID est la catégorie de l'événement",[222,709,710,713,715,719,722,726],{},[240,711,712],{},"manager Wazuh 4.9.2",[240,714,530],{},[240,716,717],{},[206,718,366],{},[240,720,721],{},"TCP",[240,723,724],{},[206,725,346],{},[240,727,728],{},"une alerte Wazuh par constat, niveau selon la gravité",[222,730,731,734,736,740,742,746],{},[240,732,733],{},"Graylog 6.1, entrée CEF",[240,735,544],{},[240,737,738],{},[206,739,366],{},[240,741,721],{},[240,743,744],{},[206,745,346],{},[240,747,748],{},"chaque champ extrait (adresse source, ATT&CK, site, gravité)",[222,750,751,754,756,760,762,766],{},[240,752,753],{},"Graylog 6.1, entrée Syslog",[240,755,692],{},[240,757,758],{},[206,759,363],{},[240,761,699],{},[240,763,764],{},[206,765,342],{},[240,767,768],{},"messages stockés, JSON non découpé en champs",[770,771,772,793,1028,1113],"tabs",{},[773,774,776,785],"tabs-item",{"label":775},"rsyslog",[471,777,783],{"className":778,"code":780,"filename":781,"language":782,"meta":476},[779],"language-text","module(load=\"imptcp\")                     # TCP, à comptage d'octets ou par ligne\ninput(type=\"imptcp\" port=\"514\")\nmodule(load=\"imtcp\" StreamDriver.Name=\"gtls\" StreamDriver.Mode=\"1\" StreamDriver.AuthMode=\"anon\")\ninput(type=\"imtcp\" port=\"6514\")           # TLS (les DefaultNetstreamDriver* globaux pointent vers le certificat)\nmodule(load=\"imudp\")\ninput(type=\"imudp\" port=\"514\")\n","rsyslog.conf","text",[206,784,780],{"__ignoreMap":476},[198,786,787,788,289,790,792],{},"Les paramètres Wolf par défaut fonctionnent : ",[206,789,363],{},[206,791,342],{},", OCSF ou CEF.",[773,794,796,938,995,1011,1014],{"label":795},"Wazuh",[797,798,799,911,924],"ol",{},[526,800,801,802,805,806],{},"Sur le manager, ajoutez une entrée syslog à ",[206,803,804],{},"\u002Fvar\u002Fossec\u002Fetc\u002Fossec.conf"," :",[471,807,812],{"className":808,"code":809,"filename":810,"language":811,"meta":476,"style":476},"language-xml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u003Cremote>\n  \u003Cconnection>syslog\u003C\u002Fconnection>\n  \u003Cport>514\u003C\u002Fport>\n  \u003Cprotocol>tcp\u003C\u002Fprotocol>\n  \u003Callowed-ips>WOLF_SITE_ADDRESS\u002F32\u003C\u002Fallowed-ips>\n\u003C\u002Fremote>\n","ossec.conf","xml",[206,813,814,826,847,865,883,902],{"__ignoreMap":476},[480,815,816,819,823],{"class":482,"line":483},[480,817,818],{"class":500},"\u003C",[480,820,822],{"class":821},"swJcz","remote",[480,824,825],{"class":500},">\n",[480,827,828,831,834,837,840,843,845],{"class":482,"line":514},[480,829,830],{"class":500},"  \u003C",[480,832,833],{"class":821},"connection",[480,835,836],{"class":500},">",[480,838,839],{"class":510},"syslog",[480,841,842],{"class":500},"\u003C\u002F",[480,844,833],{"class":821},[480,846,825],{"class":500},[480,848,850,852,855,857,859,861,863],{"class":482,"line":849},3,[480,851,830],{"class":500},[480,853,854],{"class":821},"port",[480,856,836],{"class":500},[480,858,276],{"class":510},[480,860,842],{"class":500},[480,862,854],{"class":821},[480,864,825],{"class":500},[480,866,868,870,873,875,877,879,881],{"class":482,"line":867},4,[480,869,830],{"class":500},[480,871,872],{"class":821},"protocol",[480,874,836],{"class":500},[480,876,288],{"class":510},[480,878,842],{"class":500},[480,880,872],{"class":821},[480,882,825],{"class":500},[480,884,886,888,891,893,896,898,900],{"class":482,"line":885},5,[480,887,830],{"class":500},[480,889,890],{"class":821},"allowed-ips",[480,892,836],{"class":500},[480,894,895],{"class":510},"WOLF_SITE_ADDRESS\u002F32",[480,897,842],{"class":500},[480,899,890],{"class":821},[480,901,825],{"class":500},[480,903,905,907,909],{"class":482,"line":904},6,[480,906,842],{"class":500},[480,908,822],{"class":821},[480,910,825],{"class":500},[526,912,913,914,555,920,923],{},"Copiez le ",[551,915,919],{"href":916,"rel":917},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Fdocs\u002Fsiem\u002Fwazuh_dodock_wolf_rules.xml",[918],"nofollow","fichier de règles",[206,921,922],{},"\u002Fvar\u002Fossec\u002Fetc\u002Frules\u002F"," et redémarrez le manager. Il nécessite Wazuh 4.6 ou version\nultérieure.",[526,925,926,927,929,930,932,933,935,936,559],{},"Configurez Wolf ainsi : format ",[206,928,382],{},", en-tête du message ",[206,931,366],{},", transport ",[206,934,288],{},", tramage\n",[206,937,346],{},[216,939,940,953],{},[219,941,942],{},[222,943,944,947,950],{},[225,945,946],{},"Constat Wolf",[225,948,949],{},"Règle Wazuh",[225,951,952],{},"Niveau",[235,954,955,965,975,985],{},[222,956,957,959,962],{},[240,958,401],{},[240,960,961],{},"100901",[240,963,964],{},"3",[222,966,967,969,972],{},[240,968,404],{},[240,970,971],{},"100902",[240,973,974],{},"7",[222,976,977,979,982],{},[240,978,407],{},[240,980,981],{},"100903",[240,983,984],{},"12",[222,986,987,990,993],{},[240,988,989],{},"entrée du journal",[240,991,992],{},"100910",[240,994,964],{},[198,996,997,998,289,1001,1004,1005,289,1007,1010],{},"Les champs OCSF deviennent des champs Wazuh : ",[206,999,1000],{},"src_endpoint.ip",[206,1002,1003],{},"finding_info.title",",\n",[206,1006,534],{},[206,1008,1009],{},"unmapped.site",", etc.",[198,1012,1013],{},"Ne fonctionne pas avec Wazuh :",[523,1015,1016,1019,1022,1025],{},[526,1017,1018],{},"l'en-tête RFC 5424 : Wazuh ne l'analyse pas, seule une règle générique se déclenche ;",[526,1020,1021],{},"CEF : Wazuh n'a pas de décodeur pour ce format ;",[526,1023,1024],{},"les trames à comptage d'octets : elles sont abandonnées ;",[526,1026,1027],{},"TLS : l'entrée syslog de Wazuh n'en a pas. Placez un relais local (rsyslog, stunnel) devant\nquand le réseau entre Wolf et Wazuh n'est pas de confiance.",[773,1029,1031,1050,1098],{"label":1030},"Graylog",[198,1032,1033,1036,1037,1040,1041,929,1043,932,1045,1047,1048,559],{},[201,1034,1035],{},"Pour obtenir des champs"," : créez une entrée ",[201,1038,1039],{},"CEF TCP",", puis configurez Wolf ainsi : format\n",[206,1042,385],{},[206,1044,366],{},[206,1046,288],{},", tramage ",[206,1049,346],{},[523,1051,1052,1083,1089],{},[526,1053,1054,1055,289,1058,1061,1062,289,1065,1004,1068,289,1071,1074,1075,1078,1079,1082],{},"L'entrée extrait ",[206,1056,1057],{},"sourceAddress",[206,1059,1060],{},"deviceHostName"," (le site), ",[206,1063,1064],{},"mitre_attack",[206,1066,1067],{},"site",[206,1069,1070],{},"severity",[206,1072,1073],{},"event_class_id"," (la catégorie) et les ",[206,1076,1077],{},"digest"," \u002F ",[206,1080,1081],{},"mac"," du journal.",[526,1084,1085,1088],{},[206,1086,1087],{},"source"," est l'adresse du site Wolf.",[526,1090,1091,1092,1094,1095,559],{},"L'en-tête RFC 5424 perturbe cette entrée : ",[206,1093,1087],{}," devient ",[206,1096,1097],{},"-",[198,1099,1100,1103,1104,289,1106,1108,1109,1112],{},[201,1101,1102],{},"Pour seulement stocker"," : les entrées Syslog TCP, UDP ou TLS acceptent les paramètres par\ndéfaut (",[206,1105,363],{},[206,1107,342],{},"). Graylog garde le MSGID et le tiret des données structurées\nau début de ",[206,1110,1111],{},"message"," et ne découpe pas le JSON. Ajoutez un extracteur JSON ou une règle de\npipeline si vous choisissez cette voie.",[773,1114,1116],{"label":1115},"UniSOC et autres",[198,1117,1118],{},"UniSOC n'a pas été testé, faute d'instance. Tout collecteur qui accepte du syslog RFC 5424, du\nCEF ou des lignes JSON devrait fonctionner avec l'une des combinaisons ci-dessus.",[1120,1121,1122],"note",{},[198,1123,1124,1125,1128,1129,559],{},"Quand Wolf exporte vers un manager Wazuh que le Wolf Agent lit aussi, les alertes de Wazuh sur\nl'export de Wolf lui-même (groupe ",[206,1126,1127],{},"dodock_wolf",") sont toujours écartées, pour que rien ne revienne\nen boucle. Voir ",[551,1130,158],{"href":159},[1132,1133,1134],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .swJcz, html code.shiki .swJcz{--shiki-light:#E53935;--shiki-default:#F07178;--shiki-dark:#F07178}",{"title":476,"searchDepth":483,"depth":514,"links":1136},[1137,1143,1144],{"id":213,"depth":514,"text":214,"children":1138},[1139,1140,1141,1142],{"id":521,"depth":849,"text":377},{"id":562,"depth":849,"text":563},{"id":582,"depth":849,"text":583},{"id":292,"depth":849,"text":601},{"id":628,"depth":514,"text":629},{"id":657,"depth":514,"text":658},"Envoyez les événements de sécurité de Wolf et son journal signé à un collecteur syslog en OCSF ou CEF, avec les paramètres qui fonctionnent pour rsyslog, Wazuh et Graylog.","md",null,{},{"icon":109},{"title":154,"description":1145},"-ufnojR-lqELMxLcLLBS1DQTXUL42XKrLIJPtWX5iiY",[1153,1155],{"title":149,"path":150,"stem":151,"description":1154,"icon":152},"Suivez les échéances de déclaration NIS2, DORA et RGPD sur les incidents, rédigez le projet de rapport réglementaire, et lisez le score de sécurité de chaque site.",{"title":158,"path":159,"stem":160,"description":1156,"icon":43},"Faites entrer les alertes Suricata et Wazuh dans Dodock Wolf, via l'agent ou l'intégration Wazuh, et retrouvez les événements de toutes les sources pour une IP, un hôte, un site ou un utilisateur.",1795024208627]