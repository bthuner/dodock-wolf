":132},"Signaux du site","\u002Ffr\u002Fsecurity\u002Fsite-signals","fr\u002F5.security\u002F2.site-signals","i-lucide-globe",{"title":134,"path":135,"stem":136,"icon":137},"Détection web et hôte","\u002Ffr\u002Fsecurity\u002Fdetection","fr\u002F5.security\u002F3.detection","i-lucide-radar",{"title":139,"path":140,"stem":141,"icon":142},"Accès et secrets","\u002Ffr\u002Fsecurity\u002Faccess","fr\u002F5.security\u002F4.access","i-lucide-key-round",{"title":144,"path":145,"stem":146,"icon":147},"Journal et leurres","\u002Ffr\u002Fsecurity\u002Fjournal","fr\u002F5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Conformité et posture","\u002Ffr\u002Fsecurity\u002Fcompliance","fr\u002F5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"Export SIEM","\u002Ffr\u002Fsecurity\u002Fsiem-export","fr\u002F5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh et Suricata","\u002Ffr\u002Fsecurity\u002Fwazuh-suricata","fr\u002F5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Référence","i-lucide-book-marked","\u002Ffr\u002Freference","fr\u002F6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Protocole de l'agent","\u002Ffr\u002Freference\u002Fprotocol","fr\u002F6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"API de l'UI","\u002Ffr\u002Freference\u002Fui-api","fr\u002F6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Stockage des métriques","\u002Ffr\u002Freference\u002Fmetric-storage","fr\u002F6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Ffr\u002Freference\u002Fperformance","fr\u002F6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Développement","\u002Ffr\u002Freference\u002Fdevelopment","fr\u002F6.reference\u002F5.development","i-lucide-code",{"id":193,"title":139,"body":194,"description":500,"extension":501,"links":502,"meta":503,"navigation":504,"path":140,"seo":505,"stem":141,"__hash__":506},"docs_fr\u002Ffr\u002F5.security\u002F4.access.md",{"type":195,"value":196,"toc":490},"minimark",[197,202,206,247,255,259,269,317,320,372,375,394,407,411,414,429,436,439,451,455,469,475,481,485],[198,199,201],"h2",{"id":200},"rôles","Rôles",[203,204,205],"p",{},"L'installation du Wolf App crée deux rôles.",[207,208,209,222],"table",{},[210,211,212],"thead",{},[213,214,215,219],"tr",{},[216,217,218],"th",{},"Rôle",[216,220,221],{},"Peut",[223,224,225,237],"tbody",{},[213,226,227,234],{},[228,229,230],"td",{},[231,232,233],"strong",{},"Wolf Manager",[228,235,236],{},"tout voir et tout configurer, approuver les actions de réponse, modifier les lignes Wolf User Scope",[213,238,239,244],{},[228,240,241],{},[231,242,243],{},"Wolf User",[228,245,246],{},"lecture seule. Peut commenter les incidents. Peut être limité avec Wolf User Scope",[203,248,249,250,254],{},"System Manager a les mêmes droits que Wolf Manager. La Wolf UI, à ",[251,252,253],"code",{},"\u002Fwolf",", répond 403 aux\nutilisateurs qui n'ont ni le rôle Wolf User ni le rôle Wolf Manager.",[198,256,258],{"id":257},"wolf-user-scope","Wolf User Scope",[203,260,261,262,264,265,268],{},"Par défaut, un Wolf User voit tous les sites, benches et hôtes. Pour en limiter un, ajoutez des\nlignes ",[231,263,258],{}," à ",[251,266,267],{},"\u002Fapp\u002Fwolf-user-scope"," (Wolf Managers uniquement). Une ligne par\nautorisation :",[207,270,271,281],{},[210,272,273],{},[213,274,275,278],{},[216,276,277],{},"Champ",[216,279,280],{},"Valeur",[223,282,283,291,309],{},[213,284,285,288],{},[228,286,287],{},"User",[228,289,290],{},"le Wolf User",[213,292,293,296],{},[228,294,295],{},"Scope",[228,297,298,301,302,305,306],{},[251,299,300],{},"site",", ",[251,303,304],{},"bench"," ou ",[251,307,308],{},"host",[213,310,311,314],{},[228,312,313],{},"Value",[228,315,316],{},"le nom tel qu'il apparaît sur les Wolf Events",[203,318,319],{},"Par exemple :",[207,321,322,332],{},[210,323,324],{},[213,325,326,328,330],{},[216,327,287],{},[216,329,295],{},[216,331,313],{},[223,333,334,348,359],{},[213,335,336,343,345],{},[228,337,338],{},[339,340,342],"a",{"href":341},"mailto:jane@client.com","jane@client.com",[228,344,300],{},[228,346,347],{},"erp.client.com",[213,349,350,354,356],{},[228,351,352],{},[339,353,342],{"href":341},[228,355,300],{},[228,357,358],{},"shop.client.com",[213,360,361,367,369],{},[228,362,363],{},[339,364,366],{"href":365},"mailto:ops-team@dokos.io","ops-team@dokos.io",[228,368,308],{},[228,370,371],{},"bench-02",[203,373,374],{},"Un utilisateur restreint ne voit alors que les Wolf Events, Metric Samples et Rollups, Incidents,\nSilences et Agents dont le site, le bench ou l'hôte correspond à l'une de ses lignes. Cela\ns'applique aux vues liste, aux rapports, aux formulaires, aux recherches de liens, à la page Wolf\nOverview, aux graphiques et aux chronologies d'incidents.",[376,377,378,382,388,391],"ul",{},[379,380,381],"li",{},"Les lignes se combinent par OU.",[379,383,384,385,387],{},"Les enregistrements qui concernent tout un hôte (CPU, disque, connexions SSH : pas de site)\nnécessitent une ligne ",[251,386,308],{},".",[379,389,390],{},"Un Wolf User sans aucune ligne n'est pas restreint.",[379,392,393],{},"Les définitions des règles d'alerte restent lisibles par tous les Wolf Users.",[395,396,397],"note",{},[203,398,399,400,403,404,387],{},"Les User Permissions de Frappe ne permettent pas cela, car site, bench et hôte sont de simples\nchamps Data. Wolf utilise à la place les hooks ",[251,401,402],{},"permission_query_conditions"," et ",[251,405,406],{},"has_permission",[198,408,410],{"id":409},"secrets-des-agents","Secrets des agents",[203,412,413],{},"Chaque Wolf Agent s'authentifie avec un identifiant d'agent et un secret.",[376,415,416,419,426],{},[379,417,418],{},"Wolf ne stocke qu'une empreinte HMAC-SHA256 salée du secret.",[379,420,421,422,425],{},"Le secret est affiché une seule fois : à l'enregistrement, ou quand vous cliquez sur\n",[231,423,424],{},"Renouveler le secret"," dans le formulaire Wolf Agent.",[379,427,428],{},"Personne ne peut le relire depuis le site. Pour déplacer un agent ou récupérer une configuration\nperdue, faites tourner le secret ou enregistrez à nouveau l'hôte.",[203,430,431,432,435],{},"Les agents enregistrés avant l'introduction du hachage continuent de fonctionner : ",[251,433,434],{},"bench migrate","\nhache leur secret stocké et supprime la copie chiffrée.",[203,437,438],{},"Un site satellite conserve son propre secret chiffré dans ses Wolf Settings, puisqu'il doit\nl'envoyer. Le site central ne stocke que l'empreinte.",[203,440,441,444,445,448,449,387],{},[231,442,443],{},"Wolf Settings → Jeton d'enregistrement"," est le secret partagé que ",[251,446,447],{},"wolf-agent register --token"," doit\nprésenter. Laissez-le vide pour refuser les nouveaux enregistrements. Pour ne plus accepter les\névénements d'un agent, désactivez son ",[231,450,35],{},[198,452,454],{"id":453},"limite-de-débit-des-envois","Limite de débit des envois",[203,456,457,458,461,462,301,465,468],{},"Chaque agent, satellites compris, peut envoyer au plus ",[231,459,460],{},"Wolf Settings → Envois max. par minute","\nfois par minute (par défaut ",[251,463,464],{},"120",[251,466,467],{},"0"," désactive la limite). Les envois excédentaires reçoivent\nun HTTP 429. L'agent les garde dans sa file locale (spool) et réessaie avec un délai croissant.",[203,470,471,472,387],{},"Le point d'accès de l'intégration Wazuh a sa propre limite de 600 appels par minute, car Wazuh\nenvoie un appel par alerte. Voir ",[339,473,158],{"href":474},"\u002Ffr\u002Fsecurity\u002Fwazuh-suricata#route-dint%C3%A9gration-wazuh",[203,476,477,478,387],{},"Détails du protocole : ",[339,479,480],{"href":169},"Protocole",[198,482,484],{"id":483},"nettoyage-scrubbing","Nettoyage (scrubbing)",[203,486,487,488,387],{},"L'agent retire des événements les adresses e-mail, identifiants, numéros de carte et IBAN avant\nqu'ils ne quittent l'hôte. Les adresses IP sont conservées par défaut, car les règles de sécurité\nregroupent par IP. Voir ",[339,489,484],{"href":76},{"title":491,"searchDepth":492,"depth":493,"links":494},"",1,2,[495,496,497,498,499],{"id":200,"depth":493,"text":201},{"id":257,"depth":493,"text":258},{"id":409,"depth":493,"text":410},{"id":453,"depth":493,"text":454},{"id":483,"depth":493,"text":484},"Donnez à chacun le bon rôle Wolf, limitez un Wolf User à certains sites, benches ou hôtes, et gérez les secrets des agents et la limite de débit des envois.","md",null,{},{"icon":142},{"title":139,"description":500},"GTP8WGWdI0aYHTAVlWN8bktLf_LagH82Gr_MoZiceZs",[508,510],{"title":134,"path":135,"stem":136,"description":509,"icon":137},"Ce que le Wolf Agent détecte dans les journaux d'accès nginx et le journal d'authentification, quels services du bench et paramètres de site il signale comme exposés, et quelles règles prédéfinies alertent dessus.",{"title":144,"path":145,"stem":146,"description":511,"icon":147},"Vérifiez le journal infalsifiable, mettez en place des utilisateurs, clés API et chemins leurres, et étiquetez les événements venant d'IP présentes sur des listes de réputation.",1795080891509]