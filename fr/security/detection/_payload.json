u002Ffr\u002Freference\u002Fdevelopment","fr\u002F6.reference\u002F5.development","i-lucide-code",{"id":193,"title":134,"body":194,"description":949,"extension":950,"links":951,"meta":952,"navigation":953,"path":135,"seo":954,"stem":136,"__hash__":955},"docs_fr\u002Ffr\u002F5.security\u002F3.detection.md",{"type":195,"value":196,"toc":931},"minimark",[197,211,216,233,238,241,275,278,282,331,335,363,367,381,384,425,429,439,495,505,535,679,692,696,703,707,717,778,785,791,795,803,829,833,843,879,886,890,924,927],[198,199,200,201,205,206,210],"p",{},"Le Wolf Agent effectue sa propre détection web et hôte à partir des journaux qu'il suit déjà. Il\nn'a besoin ni de Wazuh, ni de Suricata, ni d'aucun paquet supplémentaire. Tous les constats sont\ndes événements ",[202,203,204],"code",{},"security",", nettoyés sur l'hôte avant leur envoi (voir\n",[207,208,209],"a",{"href":76},"Nettoyage (scrubbing)",").",[212,213,215],"h2",{"id":214},"attaques-web-depuis-nginx","Attaques web depuis nginx",[198,217,218,219,222,223,226,227,230,231,210],{},"L'agent lit les mêmes journaux d'accès nginx que pour ",[202,220,221],{},"http_5xx"," et ",[202,224,225],{},"http_502",". Rien à activer :\ndès que l'agent suit le journal nginx d'un bench, la détection des attaques web fonctionne. Les\nchemins des journaux se définissent par bench dans ",[202,228,229],{},"nginx_access_log"," (voir\n",[207,232,65],{"href":66},[234,235,237],"h3",{"id":236},"ce-qui-compte-comme-un-sondage","Ce qui compte comme un sondage",[198,239,240],{},"Une requête est un sondage quand elle :",[242,243,244,259,269,272],"ul",{},[245,246,247,248,251,252,251,255,258],"li",{},"cherche des secrets : ",[202,249,250],{},".env",", ",[202,253,254],{},".git\u002F",[202,256,257],{},"site_config.json",", clés, dumps ;",[245,260,261,262,251,265,268],{},"cherche des panneaux CMS et d'administration (",[202,263,264],{},"wp-login.php",[202,266,267],{},"phpmyadmin","…) ;",[245,270,271],{},"tente une traversée de chemin, une injection SQL, de commande ou de template, ou un XSS ;",[245,273,274],{},"vient d'un User-Agent de scanner (sqlmap, nuclei…).",[198,276,277],{},"Les cibles encodées en URL sont décodées deux fois avant la comparaison.",[234,279,281],{"id":280},"événements","Événements",[283,284,285,301],"table",{},[286,287,288],"thead",{},[289,290,291,295,298],"tr",{},[292,293,294],"th",{},"Catégorie",[292,296,297],{},"Gravité",[292,299,300],{},"Signification",[302,303,304,318],"tbody",{},[289,305,306,312,315],{},[307,308,309],"td",{},[202,310,311],{},"web_attack_probe",[307,313,314],{},"warning, critical dès qu'un client envoie 50 sondages ou plus",[307,316,317],{},"un événement par (site, client) et intervalle d'envoi, avec les règles touchées, les statuts, jusqu'à 10 cibles et les identifiants ATT&CK",[289,319,320,325,328],{},[307,321,322],{},[202,323,324],{},"web_sensitive_file_exposed",[307,326,327],{},"critical",[307,329,330],{},"un fichier contenant des secrets a reçu une réponse 2xx. Le fichier a probablement fuité",[234,332,334],{"id":333},"ce-qui-nest-pas-un-sondage","Ce qui n'est pas un sondage",[242,336,337,350],{},[245,338,339,340,251,343,346,347,210],{},"Les pièces jointes (",[202,341,342],{},"\u002Ffiles",[202,344,345],{},"\u002Fprivate\u002Ffiles",") et les téléchargements de sauvegardes autorisés\n(",[202,348,349],{},"\u002Fbackups",[245,351,352,353,251,356,251,359,362],{},"Un 2xx sous une route qui répond à tout sous-chemin par une page (",[202,354,355],{},"\u002Fapp\u002F",[202,357,358],{},"\u002Fwolf\u002F",[202,360,361],{},"\u002Fapi\u002F","…)\nn'est pas compté comme un fichier servi.",[234,364,366],{"id":365},"ladresse-du-client","L'adresse du client",[198,368,369,370,373,374,376,377,380],{},"Le client est ",[202,371,372],{},"$remote_addr",". Quand ",[202,375,372],{}," est un proxy de boucle locale ou privé, l'agent\nprend l'adresse publique la plus à droite de la liste ",[202,378,379],{},"X-Forwarded-For"," journalisée après lui :\ncelle que votre proxy a ajoutée. Les entrées les plus à gauche sont écrites par le client et ne\nsont pas dignes de confiance.",[234,382,101],{"id":383},"règles-prédéfinies",[283,385,386,396],{},[286,387,388],{},[289,389,390,393],{},[292,391,392],{},"Règle prédéfinie",[292,394,395],{},"Se déclenche quand",[302,397,398,412],{},[289,399,400,406],{},[307,401,402],{},[403,404,405],"em",{},"Web attack scan",[307,407,408,409,411],{},"100 requêtes ",[202,410,311],{}," ou plus en 10 min, par site (warning)",[289,413,414,419],{},[307,415,416],{},[403,417,418],{},"Sensitive file served",[307,420,421,422,424],{},"n'importe quel ",[202,423,324],{}," (critical). Changez les secrets",[212,426,428],{"id":427},"signaux-dintrusion-sur-lhôte","Signaux d'intrusion sur l'hôte",[198,430,431,432,251,435,438],{},"L'agent lit ",[202,433,434],{},"\u002Fvar\u002Flog\u002Fauth.log",[202,436,437],{},"\u002Fvar\u002Flog\u002Fsecure",", ou le journal systemd :",[440,441,446],"pre",{"className":442,"code":443,"language":444,"meta":445,"style":445},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","journalctl -o short-iso -t sshd -t sshd-session -t sudo -t useradd -t usermod -t gpasswd\n","bash","",[202,447,448],{"__ignoreMap":445},[449,450,453,457,461,464,467,470,472,475,477,480,482,485,487,490,492],"span",{"class":451,"line":452},"line",1,[449,454,456],{"class":455},"sBMFI","journalctl",[449,458,460],{"class":459},"sfazB"," -o",[449,462,463],{"class":459}," short-iso",[449,465,466],{"class":459}," -t",[449,468,469],{"class":459}," sshd",[449,471,466],{"class":459},[449,473,474],{"class":459}," sshd-session",[449,476,466],{"class":459},[449,478,479],{"class":459}," sudo",[449,481,466],{"class":459},[449,483,484],{"class":459}," useradd",[449,486,466],{"class":459},[449,488,489],{"class":459}," usermod",[449,491,466],{"class":459},[449,493,494],{"class":459}," gpasswd\n",[198,496,497,500,501,504],{},[202,498,499],{},"sshd-session"," couvre OpenSSH 9.8 et versions ultérieures. Le format ",[202,502,503],{},"short-iso"," conserve\nl'horodatage réel de chaque ligne.",[198,506,507,508,511,512,515,516,519,520,523,524,527,528,222,531,534],{},"Le paramètre ",[202,509,510],{},"auth_log"," choisit la source : ",[202,513,514],{},"null"," la détecte automatiquement, un chemin impose un\nfichier, ",[202,517,518],{},"\"journal\""," impose journalctl, ",[202,521,522],{},"false"," le désactive. L'installateur ajoute l'utilisateur\n",[202,525,526],{},"wolf-agent"," aux groupes ",[202,529,530],{},"adm",[202,532,533],{},"systemd-journal"," quand ils existent, afin qu'il puisse lire ces\njournaux sans être root.",[283,536,537,549],{},[286,538,539],{},[289,540,541,543,545,547],{},[292,542,294],{},[292,544,300],{},[292,546,297],{},[292,548,392],{},[302,550,551,570,586,603,621,641],{},[289,552,553,558,561,564],{},[307,554,555],{},[202,556,557],{},"ssh_failed_login",[307,559,560],{},"connexions SSH échouées, agrégées par IP source",[307,562,563],{},"warning, critical à partir de 20 dans un même événement",[307,565,566,569],{},[403,567,568],{},"SSH brute force"," : 20 ou plus en 10 min, par hôte (critical)",[289,571,572,577,580,583],{},[307,573,574],{},[202,575,576],{},"ssh_root_login",[307,578,579],{},"une connexion root",[307,581,582],{},"warning",[307,584,585],{},"aucune",[289,587,588,593,596,598],{},[307,589,590],{},[202,591,592],{},"ssh_login_after_failures",[307,594,595],{},"une connexion réussie depuis une adresse qui a échoué 5 fois ou plus dans l'heure précédente. Les compteurs d'échecs survivent aux intervalles d'envoi",[307,597,327],{},[307,599,600],{},[403,601,602],{},"SSH login after brute force",[289,604,605,610,613,615],{},[307,606,607],{},[202,608,609],{},"sudo_failure",[307,611,612],{},"mauvais mots de passe sudo, utilisateurs absents des sudoers",[307,614,582],{},[307,616,617,620],{},[403,618,619],{},"Repeated sudo failures"," : 3 ou plus en 10 min, par hôte",[289,622,623,628,634,636],{},[307,624,625],{},[202,626,627],{},"account_created",[307,629,630,633],{},[202,631,632],{},"useradd"," crée un compte local",[307,635,582],{},[307,637,638],{},[403,639,640],{},"New system account",[289,642,643,648,672,674],{},[307,644,645],{},[202,646,647],{},"admin_group_change",[307,649,650,651,251,654,251,657,251,660,251,663,251,665,668,669],{},"un utilisateur est ajouté à ",[202,652,653],{},"sudo",[202,655,656],{},"wheel",[202,658,659],{},"admin",[202,661,662],{},"root",[202,664,530],{},[202,666,667],{},"docker"," ou ",[202,670,671],{},"lxd",[307,673,327],{},[307,675,676],{},[403,677,678],{},"User added to admin group",[680,681,682],"tip",{},[198,683,684,686,687,691],{},[403,685,640],{}," se déclenche aussi lors d'un provisionnement planifié. Ouvrez un\n",[688,689,690],"strong",{},"Wolf Silence"," pour l'hôte pendant que vous le provisionnez.",[212,693,695],{"id":694},"exposition-et-risques-de-configuration-du-site","Exposition et risques de configuration du site",[198,697,698,699,702],{},"Toutes les ",[202,700,701],{},"exposure.interval"," (600 s par défaut), l'agent vérifie ce qu'exposent un hôte et ses\nsites.",[234,704,706],{"id":705},"services-du-bench-exposés","Services du bench exposés",[198,708,709,712,713,716],{},[202,710,711],{},"exposed_services",", par hôte, compte les ports du bench à l'écoute sur toutes les interfaces ou sur\nune adresse publique dans ",[202,714,715],{},"\u002Fproc\u002Fnet\u002Ftcp{,6}"," :",[283,718,719,729],{},[286,720,721],{},[289,722,723,726],{},[292,724,725],{},"Service",[292,727,728],{},"Port",[302,730,731,739,747,759,767],{},[289,732,733,736],{},[307,734,735],{},"MariaDB",[307,737,738],{},"3306",[289,740,741,744],{},[307,742,743],{},"Postgres",[307,745,746],{},"5432",[289,748,749,752],{},[307,750,751],{},"Redis",[307,753,754,755,758],{},"6379, 11000, 12000, 13000, ou les ports ",[202,756,757],{},"redis_*"," propres au bench",[289,760,761,764],{},[307,762,763],{},"socket.io",[307,765,766],{},"9000",[289,768,769,772],{},[307,770,771],{},"gunicorn",[307,773,774,775],{},"8000 ou ",[202,776,777],{},"webserver_port",[198,779,780,781,784],{},"Ajoutez des ports avec ",[202,782,783],{},"exposure.ports",", une table associant un port à un nom de service. Une\nadresse de réseau local n'est pas comptée.",[786,787,788],"note",{},[198,789,790],{},"Un socket à l'écoute ne prouve pas qu'il est joignable : un pare-feu peut encore bloquer ce qui est\ncompté.",[234,792,794],{"id":793},"risques-de-configuration-du-site","Risques de configuration du site",[198,796,797,800,801,716],{},[202,798,799],{},"site_config_risks",", par site, compte ces éléments dans ",[202,802,257],{},[242,804,805,811,816,823],{},[245,806,807,810],{},[202,808,809],{},"developer_mode"," ;",[245,812,813,810],{},[202,814,815],{},"allow_tests",[245,817,818,819,822],{},"un ",[202,820,821],{},"host_name"," en HTTP simple ;",[245,824,825,828],{},[202,826,827],{},"allow_cors: \"*\"",".",[234,830,832],{"id":831},"événements-et-règles-prédéfinies","Événements et règles prédéfinies",[198,834,835,836,222,839,842],{},"L'agent n'envoie les événements ",[202,837,838],{},"service_exposed",[202,840,841],{},"insecure_site_config"," que lorsque l'ensemble\nqu'il trouve change. Tous deux sont étiquetés T1190.",[283,844,845,853],{},[286,846,847],{},[289,848,849,851],{},[292,850,392],{},[292,852,395],{},[302,854,855,867],{},[289,856,857,862],{},[307,858,859],{},[403,860,861],{},"Bench service exposed",[307,863,864,866],{},[202,865,711],{}," supérieur à 0, par hôte (critical). Redis n'a pas de mot de passe par défaut",[289,868,869,874],{},[307,870,871],{},[403,872,873],{},"Development settings in production",[307,875,876,878],{},[202,877,799],{}," supérieur à 0, par site (warning)",[198,880,881,882,828],{},"Les deux métriques alimentent aussi le ",[207,883,885],{"href":884},"\u002Ffr\u002Fsecurity\u002Fcompliance#score-de-s%C3%A9curit%C3%A9","score de sécurité",[212,887,889],{"id":888},"désactiver-la-détection","Désactiver la détection",[283,891,892,902],{},[286,893,894],{},[289,895,896,899],{},[292,897,898],{},"Pour désactiv