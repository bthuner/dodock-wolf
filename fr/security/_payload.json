-map",{"title":191,"path":192,"stem":193,"icon":194},"Les applications","\u002Ffr\u002Finternals\u002Fapps","fr\u002F7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Appels et confiance","\u002Ffr\u002Finternals\u002Finterop","fr\u002F7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flux","\u002Ffr\u002Finternals\u002Fflows","fr\u002F7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Dans un serveur client","\u002Ffr\u002Finternals\u002Fcustomer-server","fr\u002F7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes pour Wolf","\u002Ffr\u002Finternals\u002Fwolf","fr\u002F7.internals\u002F6.wolf",{"id":213,"title":116,"body":214,"description":860,"extension":861,"links":862,"meta":863,"navigation":864,"path":112,"seo":865,"stem":113,"__hash__":866},"docs_fr\u002Ffr\u002F5.security\u002F1.index.md",{"type":215,"value":216,"toc":851},"minimark",[217,243,246,251,391,396,400,414,428,783,794,798,803,808,812],[218,219,220,221,225,226,230,231,234,235,238,239,242],"p",{},"Dodock Wolf détecte les attaques contre un site Frappe, son bench et ses hôtes. Il les corrèle\navec les signaux de santé (5xx, crons en échec, déploiements) dans les mêmes incidents. Chaque\nconstat de sécurité est un ",[222,223,224],"strong",{},"Wolf Event"," de type ",[227,228,229],"code",{},"security"," avec une ",[227,232,233],{},"category",", par exemple\n",[227,236,237],{},"ssh_login_after_failures"," ou ",[227,240,241],{},"permission_change",".",[218,244,245],{},"Wolf seul constitue le socle. Aucune fonction de sécurité n'a besoin de Wazuh ni de Suricata.\nQuand ils tournent sur vos hôtes, le Wolf Agent lit aussi leurs alertes.",[247,248,250],"h2",{"id":249},"origine-de-chaque-signal","Origine de chaque signal",[252,253,254,273],"table",{},[255,256,257],"thead",{},[258,259,260,264,267,270],"tr",{},[261,262,263],"th",{},"Source",[261,265,266],{},"Prérequis",[261,268,269],{},"Ce qu'elle voit",[261,271,272],{},"Page",[274,275,276,293,309,332,354,373],"tbody",{},[258,277,278,282,285,288],{},[279,280,281],"td",{},"Site Wolf",[279,283,284],{},"le Wolf App installé sur le site",[279,286,287],{},"connexions échouées et privilégiées, attributions de rôles, Server et Client Scripts, exécutions de la System Console, modifications de permissions, System Settings affaiblis, clés API, Webhooks, exports de données, leurres (honeytokens)",[279,289,290],{},[291,292,119],"a",{"href":120},[258,294,295,298,301,304],{},[279,296,297],{},"Wolf Agent : nginx",[279,299,300],{},"journaux d'accès nginx suivis par l'agent",[279,302,303],{},"sondages à la recherche de secrets, de panneaux CMS, traversées de chemin, injections, scanners ; fichiers secrets servis",[279,305,306],{},[291,307,308],{"href":125},"Détection",[258,310,311,314,324,327],{},[279,312,313],{},"Wolf Agent : journal d'authentification",[279,315,316,319,320,323],{},[227,317,318],{},"\u002Fvar\u002Flog\u002Fauth.log",", ",[227,321,322],{},"\u002Fvar\u002Flog\u002Fsecure"," ou le journal systemd",[279,325,326],{},"force brute SSH suivie d'une connexion, connexions root, échecs sudo, nouveaux comptes, modifications des groupes d'administration",[279,328,329],{},[291,330,308],{"href":331},"\u002Ffr\u002Fsecurity\u002Fdetection#signaux-dintrusion-sur-lh%C3%B4te",[258,333,334,337,346,349],{},[279,335,336],{},"Wolf Agent : exposition",[279,338,339,342,343],{},[227,340,341],{},"\u002Fproc\u002Fnet\u002Ftcp{,6}"," et ",[227,344,345],{},"site_config.json",[279,347,348],{},"services du bench à l'écoute au-delà de la boucle locale, paramètres de développement en production",[279,350,351],{},[291,352,308],{"href":353},"\u002Ffr\u002Fsecurity\u002Fdetection#exposition-et-risques-de-configuration-du-site",[258,355,356,359,362,369],{},[279,357,358],{},"Suricata (facultatif)",[279,360,361],{},"Suricata écrivant un journal EVE sur l'hôte",[279,363,364,365,368],{},"alertes d'IDS réseau (",[227,366,367],{},"network_ids_alert",")",[279,370,371],{},[291,372,148],{"href":149},[258,374,375,378,381,387],{},[279,376,377],{},"Wazuh (facultatif)",[279,379,380],{},"un manager Wazuh",[279,382,383,384,368],{},"alertes d'IDS hôte (",[227,385,386],{},"hids_alert",[279,388,389],{},[291,390,148],{"href":149},[218,392,393,394,242],{},"Les signaux qui n'existent qu'à l'intérieur d'un site (connexions, scripts, permissions) sont\ncaptés par le Wolf App de ce site. Pour les voir sur tous les sites d'un bench, installez l'app\nsur chacun d'eux et passez-les en mode satellite : voir ",[291,395,40],{"href":41},[247,397,399],{"id":398},"étiquettes-mitre-attck","Étiquettes MITRE ATT&CK",[218,401,402,403,405,406,409,410,413],{},"À l'ingestion, chaque événement ",[227,404,229],{}," reçoit une liste ",[227,407,408],{},"mitre_attack"," dans son payload : un\n",[227,411,412],{},"{id, name, tactic}"," par technique. Wolf fusionne la technique associée à la catégorie de\nl'événement avec les identifiants de techniques envoyés par l'agent. Les alertes Suricata et\nWazuh portent les techniques de la règle qui s'est déclenchée. Les événements transmis par les\nsatellites conservent les leurs.",[218,415,416,417,420,421,424,425,242],{},"Les étiquettes accompagnent l'événement jusqu'à l'",[291,418,419],{"href":145},"export SIEM"," : OCSF\nles place dans ",[227,422,423],{},"finding_info.attacks",", CEF dans ",[227,426,427],{},"cs4",[252,429,430,443],{},[255,431,432],{},[258,433,434,437,440],{},[261,435,436],{},"Catégorie",[261,438,439],{},"Émise par",[261,441,442],{},"ATT&CK",[274,444,445,458,470,481,493,505,516,528,541,553,569,585,600,613,628,640,655,667,677,689,701,713,725,737,748,759,771],{},[258,446,447,452,455],{},[279,448,449],{},[227,450,451],{},"ssh_failed_login",[279,453,454],{},"agent (auth)",[279,456,457],{},"T1110 Brute Force",[258,459,460,465,467],{},[279,461,462],{},[227,463,464],{},"ssh_root_login",[279,466,454],{},[279,468,469],{},"T1078.003 Local Accounts",[258,471,472,476,478],{},[2