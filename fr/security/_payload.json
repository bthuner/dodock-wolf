9],{},[279,638,639],{},"T1098",[258,641,642,650,652],{},[279,643,644,319,647],{},[227,645,646],{},"server_script_change",[227,648,649],{},"console_execution",[279,651,609],{},[279,653,654],{},"T1059.006 Python",[258,656,657,662,664],{},[279,658,659],{},[227,660,661],{},"client_script_change",[279,663,609],{},[279,665,666],{},"T1059.007 JavaScript",[258,668,669,673,675],{},[279,670,671],{},[227,672,241],{},[279,674,609],{},[279,676,527],{},[258,678,679,684,686],{},[279,680,681],{},[227,682,683],{},"security_settings_weakened",[279,685,609],{},[279,687,688],{},"T1562.001 Disable or Modify Tools",[258,690,691,696,698],{},[279,692,693],{},[227,694,695],{},"api_key_generated",[279,697,609],{},[279,699,700],{},"T1098.001 Additional Cloud Credentials",[258,702,703,708,710],{},[279,704,705],{},[227,706,707],{},"api_key_new_ip",[279,709,609],{},[279,711,712],{},"T1078 Valid Accounts, T1552 Unsecured Credentials",[258,714,715,720,722],{},[279,716,717],{},[227,718,719],{},"webhook_external",[279,721,609],{},[279,723,724],{},"T1567 Exfiltration Over Web Service",[258,726,727,732,734],{},[279,728,729],{},[227,730,731],{},"data_exfiltration",[279,733,609],{},[279,735,736],{},"T1567, T1030 Data Transfer Size Limits",[258,738,739,744,746],{},[279,740,741],{},[227,742,743],{},"user_impersonated",[279,745,609],{},[279,747,627],{},[258,749,750,755,757],{},[279,751,752],{},[227,753,754],{},"credentials_reset_by_other",[279,756,609],{},[279,758,527],{},[258,760,761,766,768],{},[279,762,763],{},[227,764,765],{},"password_reset_requested",[279,767,609],{},[279,769,770],{},"T1589.002 Email Addresses, T1110",[258,772,773,778,780],{},[279,774,775],{},[227,776,777],{},"honeytoken_triggered",[279,779,609],{},[279,781,782],{},"utilisateur leurre T1078, T1110 ; clé API leurre T1552 ; chemin leurre T1083",[218,784,785,786,789,790,242],{},"La page d'accueil de la Wolf UI, l'",[222,787,788],{},"Aperçu",", montre le score de sécurité de chaque site et son évolution sur 24 heures : voir ",[291,791,793],{"href":792},"\u002Ffr\u002Fgetting-started\u002Fquickstart#ouvrir-la-wolf-ui","Ouvrir la Wolf UI",[247,795,797],{"id":796},"alertes-et-réponse","Alertes et réponse",[218,799,800,801,242],{},"Chaque signal a une règle d'alerte prédéfinie. Les règles prédéfinies sont installées sans\ncanal : elles ouvrent des incidents mais ne notifient personne tant que vous n'ajoutez pas de\ncanal. Voir ",[291,802,96],{"href":97},[218,804,805,806,242],{},"Sur un incident de sécurité, un Wolf Manager peut approuver une réponse : bloquer une IP sur\nl'hôte, désactiver un utilisateur, fermer ses sessions ou révoquer ses clés API. Rien ne\ns'exécute sans cette approbation. Voir ",[291,807,80],{"href":81},[247,809,811],{"id":810},"pages-de-cette-section","Pages de cette section",[813,814,815,821,826,831,836,841,846],"card-group",{},[816,817,818],"card",{"icon":122,"title":119,"to":120},[218,819,820],{},"Connexions, scripts, permissions, paramètres, clés API et exports vus par le site Wolf, sans agent.",[816,822,823],{"icon":127,"title":124,"to":125},[218,824,825],{},"Attaques web depuis nginx, signaux d'intrusion depuis le journal d'authentification, services exposés.",[816,827,828],{"icon":132,"title":129,"to":130},[218,829,830],{},"Wolf Manager et Wolf User, Wolf User Scope, secrets d'agent hachés, limite de débit des envois.",[816,832,833],{"icon":137,"title":134,"to":135},[218,834,835],{},"Journal infalsifiable, leurres (honeytokens) et listes de réputation d'IP.",[816,837,838],{"icon":142,"title":139,"to":140},[218,839,840],{},"Échéances NIS2, DORA et RGPD sur les incidents, et score de sécurité par site.",[816,842,843],{"icon":104,"title":144,"to":145},[218,844,845],{},"Export syslog en OCSF ou CEF vers rsyslog, Wazuh, Graylog ou un autre collecteur.",[816,847,848],{"icon":43,"title":148,"to":149},[218,849,850],{},"Sources facultatives, et entités partagées entre toutes les sources.",{"title":852,"searchDepth":853,"depth":854,"links":855},"",1,2,[856,857,858,859],{"id":249,"depth":854,"text":250},{"id":398,"depth":854,"text":399},{"id":796,"depth":854,"text":797},{"id":810,"depth":854,"text":811},"Ce que Dodock Wolf détecte, d'où vient chaque signal de sécurité, et comment chaque événement est étiqueté avec MITRE ATT&CK.","md",null,{},{"icon":117},{"title":116,"description":860},"UCtskp46b0oT0W9Z09hfNn0fmGfDt6tmIFsUVboz_dM",[868,870],{"title":106,"path":107,"stem":108,"description":869,"icon":109},"Acquitter, assigner, fusionner, scinder et clôturer les incidents, et rédiger le post-mortem.",{"title":119,"path":120,"stem":121,"description":871,"icon":122},"Activez les signaux de sécurité que le site Wolf capte seul, sans agent, et configurez la base GeoIP pour les connexions depuis un nouveau pays.",1795111375902]