Ffr\u002Freference\u002Fdevelopment","fr\u002F6.reference\u002F5.development","i-lucide-code",{"id":193,"title":30,"body":194,"description":507,"extension":508,"links":509,"meta":510,"navigation":511,"path":31,"seo":512,"stem":32,"__hash__":513},"docs_fr\u002Ffr\u002F2.install\u002F1.wolf-app.md",{"type":195,"value":196,"toc":498},"minimark",[197,215,220,237,241,329,332,335,367,371,374,392,396,408,414,418,426,432,436,477,484,488,494],[198,199,200,201,205,206,210,211,214],"p",{},"La Wolf App (",[202,203,204],"code",{},"dodock_wolf",") tourne sur un site Frappe ou Dokos. Ce site devient le site Wolf\n",[207,208,209],"strong",{},"central"," : les agents lui envoient leurs données, les règles s'y exécutent, et la Wolf UI y est\nservie sur ",[202,212,213],{},"\u002Fwolf",".",[216,217,219],"h2",{"id":218},"prérequis","Prérequis",[221,222,223,227,234],"ul",{},[224,225,226],"li",{},"Frappe 15 ou Dokos (Dodock 5). Testé sur Dodock 5.18, MariaDB 10.6 et Postgres 16 et 17.",[224,228,229,230,233],{},"Node 20.19 ou ultérieur sur le bench, pour le ",[202,231,232],{},"bench build"," de la Wolf UI.",[224,235,236],{},"Un planificateur qui tourne chaque minute (voir plus bas).",[216,238,240],{"id":239},"installation","Installation",[242,243,249],"pre",{"className":244,"code":245,"filename":246,"language":247,"meta":248,"style":248},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","cd ~\u002Ffrappe-bench\nbench get-app https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\nbench --site wolf.example.com install-app dodock_wolf\nbench build --app dodock_wolf   # lie les fichiers statiques et construit la Wolf UI (\u002Fwolf)\nbench set-config -g scheduler_tick_interval 60\n","bench","bash","",[202,250,251,264,276,293,311],{"__ignoreMap":248},[252,253,256,260],"span",{"class":254,"line":255},"line",1,[252,257,259],{"class":258},"s2Zo4","cd",[252,261,263],{"class":262},"sfazB"," ~\u002Ffrappe-bench\n",[252,265,267,270,273],{"class":254,"line":266},2,[252,268,246],{"class":269},"sBMFI",[252,271,272],{"class":262}," get-app",[252,274,275],{"class":262}," https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\n",[252,277,279,281,284,287,290],{"class":254,"line":278},3,[252,280,246],{"class":269},[252,282,283],{"class":262}," --site",[252,285,286],{"class":262}," wolf.example.com",[252,288,289],{"class":262}," install-app",[252,291,292],{"class":262}," dodock_wolf\n",[252,294,296,298,301,304,307],{"class":254,"line":295},4,[252,297,246],{"class":269},[252,299,300],{"class":262}," build",[252,302,303],{"class":262}," --app",[252,305,306],{"class":262}," dodock_wolf",[252,308,310],{"class":309},"sHwdD","   # lie les fichiers statiques et construit la Wolf UI (\u002Fwolf)\n",[252,312,314,316,319,322,325],{"class":254,"line":313},5,[252,315,246],{"class":269},[252,317,318],{"class":262}," set-config",[252,320,321],{"class":262}," -g",[252,323,324],{"class":262}," scheduler_tick_interval",[252,326,328],{"class":327},"sbssI"," 60\n",[198,330,331],{},"Redémarrez ensuite le processus du planificateur.",[198,333,334],{},"L'installation crée :",[221,336,337,348,359],{},[224,338,339,340,343,344,347],{},"les rôles ",[207,341,342],{},"Wolf Manager"," (voit et configure tout) et ",[207,345,346],{},"Wolf User"," (lecture seule) ;",[224,349,350,351,354,355,358],{},"un ",[207,352,353],{},"jeton d'enregistrement"," aléatoire dans ",[207,356,357],{},"Wolf Settings",", utilisé par les agents pour\ns'enregistrer ;",[224,360,361,362,366],{},"les ",[363,364,365],"a",{"href":102},"règles d'alerte prédéfinies",", sans canal.",[216,368,370],{"id":369},"rythme-du-planificateur","Rythme du planificateur",[198,372,373],{},"Les règles d'alerte, les agrégats et les envois des satellites de Wolf sont planifiés chaque\nminute. Frappe 15 et Dodock ont par défaut un tick toutes les 4 minutes.",[375,376,377],"warning",{},[198,378,379,380,383,384,387,388,391],{},"Si ",[202,381,382],{},"scheduler_tick_interval"," n'est pas réglé sur ",[202,385,386],{},"60",", une alerte peut arriver jusqu'à 4 minutes\nen retard, et « déclencher après 3 évaluations » signifie 12 minutes. La page ",[207,389,390],{},"Monitoring"," de la\nWolf UI affiche le rythme en vigueur.",[216,393,395],{"id":394},"la-wolf-ui","La Wolf UI",[198,397,398,401,402,404,405,407],{},[202,399,400],{},"https:\u002F\u002F\u003Csite>\u002Fwolf"," est l'interface des opérateurs, une application Vue construite sur\nfrappe-ui. Elle réutilise la session Frappe : les invités sont renvoyés vers la page de connexion,\nles utilisateurs sans ",[207,403,346],{}," ni ",[207,406,342],{}," reçoivent une erreur 403. Desk conserve\nles DocTypes de configuration ; une vue que la Wolf UI n'a pas encore renvoie vers Desk.",[409,410],"screenshot",{"alt":411,"caption":412,"name":413},"Un incident dans la Wolf UI","Un incident : chronologie, marqueur de déploiement et événements regroupés sous l'incident.","incident",[216,415,417],{"id":416},"signaux-sans-agent","Signaux sans agent",[198,419,420,421,423,424,214],{},"Le site Wolf se surveille lui-même dès que l'application est installée : Scheduled Job Logs en\néchec, Error Logs et sauvegardes en échec, connexions Desk échouées, connexions privilégiées depuis\nune nouvelle IP ou un nouveau pays, attributions de rôles, engorgement de l'Email Queue et\nchangements à risque dans l'application. Chacun peut être désactivé dans ",[207,422,357],{},". Voir\n",[363,425,129],{"href":130},[198,427,428,429,214],{},"Pour obtenir les mêmes signaux depuis les autres sites du bench, installez-y aussi l'application,\nen tant que ",[363,430,431],{"href":41},"satellites",[216,433,435],{"id":434},"mise-à-jour","Mise à jour",[242,437,439],{"className":244,"code":438,"filename":246,"language":247,"meta":248,"style":248},"bench update --apps dodock_wolf   # ou : cd apps\u002Fdodock_wolf && git pull\nbench --site wolf.example.com migrate\nbench build --app dodock_wolf\n",[202,440,441,456,467],{"__ignoreMap":248},[252,442,443,445,448,451,453],{"class":254,"line":255},[252,444,246],{"class":269},[252,446,447],{"class":262}," update",[252,449,450],{"class":262}," --apps",[252,452,306],{"class":262},[252,454,455],{"class":309},"   # ou : cd apps\u002Fdodock_wolf && git pull\n",[252,457,458,460,462,464],{"class":254,"line":266},[252,459,246],{"class":269},[252,461,283],{"class":262},[252,463,286],{"class":262},[252,465,466],{"class":262}," migrate\n",[252,468,469,471,473,475],{"class":254,"line":278},[252,470,246],{"class":269},[252,472,300],{"class":262},[252,474,303],{"class":262},[252,476,292],{"class":262},[198,478,479,480,483],{},"Les migrations n'écrasent jamais les règles prédéfinies que vous avez modifiées. Un\n",[202,481,482],{},"bench migrate"," est enregistré comme déploiement sur la chronologie de Wolf.",[216,485,487],{"id":486},"pour-continuer","Pour continuer",[198,489,490,493],{},[363,491,492],{"href":36},"Installez l'agent"," sur chaque hôte.",[495,496,497],"style",{},"html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-styl