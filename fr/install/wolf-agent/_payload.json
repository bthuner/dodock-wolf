emd-journal"," et\n",[243,363,364],{},"frappe"," lorsqu'ils existent, pour qu'il lise les logs d'authentification, nginx et bench sans\nêtre root ;",[336,367,368,369,372],{},"enregistre l'hôte et écrit ",[243,370,371],{},"\u002Fetc\u002Fwolf-agent\u002Fconfig.json"," (mode 0600) ;",[336,374,375,376,346],{},"installe et démarre ",[243,377,378],{},"wolf-agent.service",[336,380,381,382,386,387,390],{},"sur un hôte ",[383,384,385],"a",{"href":46},"Frappe Pilot",", installe ",[243,388,389],{},"wolf-pilot-export",", une minuterie root\nqui copie les états des tâches et des processus du bench que l'agent ne peut pas lire lui-même.",[222,392,394],{"id":393},"options-dinstallation","Options d'installation",[396,397,398,411],"table",{},[399,400,401],"thead",{},[402,403,404,408],"tr",{},[405,406,407],"th",{},"Variable",[405,409,410],{},"Effet",[412,413,414,425,439,453,467,480],"tbody",{},[402,415,416,422],{},[417,418,419],"td",{},[243,420,421],{},"WOLF_URL",[417,423,424],{},"Le site Wolf central.",[402,426,427,432],{},[417,428,429],{},[243,430,431],{},"WOLF_TOKEN",[417,433,434,435,438],{},"Son jeton d'enregistrement (",[230,436,437],{},"Wolf Settings",").",[402,440,441,446],{},[417,442,443],{},[243,444,445],{},"WOLF_BENCHES",[417,447,448,449,452],{},"Chemins de benches séparés par des espaces, pour sauter la découverte automatique : ",[243,450,451],{},"\"\u002Fhome\u002Ffrappe\u002Ffrappe-bench \u002Fsrv\u002Fother-bench\"",".",[402,454,455,460],{},[417,456,457],{},[243,458,459],{},"WOLF_AGENT_SRC",[417,461,462,463,466],{},"Source pip : un répertoire local ou une URL ",[243,464,465],{},"git+https",". Par défaut : le répertoire du script, ou GitHub quand le script est lancé via curl.",[402,468,469,474],{},[417,470,471],{},[243,472,473],{},"WOLF_AGENT_REF",[417,475,476,477,452],{},"Référence Git pour une installation depuis GitHub. Par défaut ",[243,478,479],{},"main",[402,481,482,487],{},[417,483,484],{},[243,485,486],{},"WOLF_INSECURE=1",[417,488,489],{},"Désactive la vérification TLS pendant l'enregistrement et les envois (site Wolf avec certificat auto-signé).",[218,491,492,493,495,496,498],{},"Sans ",[243,494,421],{}," ni ",[243,497,431],{},", l'agent est installé mais pas enregistré. Enregistrez-le plus tard :",[235,500,502],{"className":237,"code":501,"filename":239,"language":240,"meta":241,"style":241},"sudo wolf-agent --config \u002Fetc\u002Fwolf-agent\u002Fconfig.json register --url https:\u002F\u002Fwolf.example.com --token \u003Ctoken>\nsudo chown wolf-agent: \u002Fetc\u002Fwolf-agent\u002Fconfig.json && sudo systemctl start wolf-agent\n",[243,503,504,540],{"__ignoreMap":241},[246,505,506,508,511,514,517,520,523,526,529,532,535,537],{"class":248,"line":249},[246,507,311],{"class":252},[246,509,510],{"class":256}," wolf-agent",[246,512,513],{"class":256}," --config",[246,515,516],{"class":256}," \u002Fetc\u002Fwolf-agent\u002Fconfig.json",[246,518,519],{"class":256}," register",[246,521,522],{"class":256}," --url",[246,524,525],{"class":256}," https:\u002F\u002Fwolf.example.com",[246,527,528],{"class":256}," --token",[246,530,531],{"class":270}," \u003C",[246,533,534],{"class":256},"toke",[246,536,292],{"class":263},[246,538,539],{"class":270},">\n",[246,541,542,544,547,550,552,555,557,560,563],{"class":248,"line":267},[246,543,311],{"class":252},[246,545,546],{"class":256}," chown",[246,548,549],{"class":256}," wolf-agent:",[246,551,516],{"class":256},[246,553,554],{"class":270}," &&",[246,556,274],{"class":252},[246,558,559],{"class":256}," systemctl",[246,561,562],{"class":256}," start",[246,564,565],{"class":256}," wolf-agent\n",[218,567,568,569,452],{},"Sans systemd (dans un conteneur), le script affiche la commande à lancer en tant que ",[243,570,352],{},[222,572,574],{"id":573},"découverte-des-benches","Découverte des benches",[218,576,577],{},"L'agent trouve les benches tout seul :",[579,580,581,595],"ul",{},[336,582,583,584,587,588,591,592,346],{},"un ",[243,585,586],{},"bench.toml",", ou un répertoire qui contient ",[