490],{"class":236},[226,609,490],{"class":236},[226,611,612],{"class":236}," discover\n",[202,614,616],{"id":615},"vérification","Vérification",[215,618,620],{"className":217,"code":619,"filename":219,"language":220,"meta":221,"style":221},"sudo -u wolf-agent wolf-agent check            # collecte une fois, affiche la charge utile, n'envoie rien\nsudo -u wolf-agent wolf-agent check --status   # demande aussi au site son état de santé\njournalctl -u wolf-agent -f\n",[223,621,622,639,657],{"__ignoreMap":221},[226,623,624,626,628,630,632,635],{"class":228,"line":229},[226,625,291],{"class":232},[226,627,605],{"class":236},[226,629,490],{"class":236},[226,631,490],{"class":236},[226,633,634],{"class":236}," check",[226,636,638],{"class":637},"sHwdD","            # collecte une fois, affiche la charge utile, n'envoie rien\n",[226,640,641,643,645,647,649,651,654],{"class":228,"line":247},[226,642,291],{"class":232},[226,644,605],{"class":236},[226,646,490],{"class":236},[226,648,490],{"class":236},[226,650,634],{"class":236},[226,652,653],{"class":236}," --status",[226,655,656],{"class":637},"   # demande aussi au site son état de santé\n",[226,658,660,663,665,667],{"class":228,"line":659},3,[226,661,662],{"class":232},"journalctl",[226,664,605],{"class":236},[226,666,490],{"class":236},[226,668,669],{"class":236}," -f\n",[198,671,672,673,675,676,679],{},"L'hôte apparaît dans la Wolf UI en moins d'une minute. Sur le site Wolf, il correspond à un\nenregistrement ",[210,674,35],{}," (",[223,677,678],{},"WAG-0001","…) qui porte son nom d'hôte.",[202,681,683],{"id":682},"identifiants","Identifiants",[198,685,686,687,690,691,693],{},"Le secret de l'agent n'est affiché qu'une fois, à l'enregistrement. Le site n'en conserve qu'un\nhash HMAC-SHA256 salé. Pour déplacer un agent ou récupérer une configuration perdue, cliquez sur\n",[210,688,689],{},"Rotate secret"," dans le formulaire ",[210,692,35],{},", ou enregistrez à nouveau l'hôte.",[198,695,696,697,700],{},"Si le site rejett