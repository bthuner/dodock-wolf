n.port+1>",". Elle s'applique à tous les benches Pilot de l'hôte : ne la définissez que sur les hôtes à un seul bench.",[459,485,487],{"name":486,"type":476},"pilot.token",[198,488,489],{},"Un jeton de l'Admin API limité au bench. S'il est défini, Wolf l'utilise tel quel.",[459,491,493],{"name":492,"type":476},"pilot.jwt_secret",[198,494,495,496,499],{},"Le ",[214,497,498],{},"[admin] jwt_secret"," du bench. Wolf en tire son propre jeton valable une heure.",[198,501,502,504,505,507,508,510,511,513,514,516],{},[214,503,421],{}," ou ",[214,506,435],{}," est nécessaire, sauf si l'utilisateur ",[214,509,286],{}," peut lire ",[214,512,255],{},". Les modes que Pilot donne à ",[214,515,255],{}," n'ont pas été vérifiés. Le fichier de configuration de l'agent est écrit avec le mode 0600.",[198,518,519,520,225],{},"La configuration complète est décrite dans ",[201,521,65],{"href":66},[523,524,525],"caution",{},[198,526,527,529,530,334,532,534],{},[214,528,435],{}," signe les sessions de l'Admin de Pilot. Quiconque le détient peut émettre des jetons limités au bench. Wolf ne lit ",[214,531,498],{},[214,533,255],{}," qu'à l'exécution et ne l'écrit jamais dans la configuration de Wolf.",[227,536,538],{"id":537},"ce-que-fait-wolf-sur-un-bench-pilot","Ce que fait Wolf sur un bench Pilot",[540,541,542,558],"table",{},[543,544,545],"thead",{},[546,547,548,552,555],"tr",{},[549,550,551],"th",{},"Domaine",[549,553,554],{},"Ce que fait Wolf",[549,556,557],{},"État",[559,560,561,583,605,626,642,667,685,706,735,748],"tbody",{},[546,562,563,567,580],{},[564,565,566],"td",{},"Découverte",[564,568,569,570,572,573,256,575,260,577,579],{},"Parcourt ",[214,571,251],{}," en plus des anciens globs. Un ",[214,574,255],{},[214,576,259],{},[214,578,263],{}," est traité comme un bench Pilot et lu avec ses vraies clés",[564,581,582],{},"fait, testé unitairement",[546,584,585,588,603],{},[564,586,587],{},"Sites",[564,589,590,591,594,595,598,599,602],{},"Lit ",[214,592,593],{},"sites\u002F*\u002Fsite_config.json",", ainsi que ",[214,596,597],{},"domains"," (chaînes simples ou ",[214,600,601],{},"{\"domain\": …, \"route\": …}",") pour la correspondance hôte → site",[564,604,582],{},[546,606,607,610,624],{},[564,608,609],{},"Logs des processus",[564,611,612,613,616,617,616,620,623],{},"Suit ",[214,614,615],{},"web",", ",[214,618,619],{},"schedule",[214,621,622],{},"worker_\u003Cqueues>_\u003Ci>"," et leurs fichiers stderr, pour le nommage systemd comme pour celui de supervisor",[564,625,582],{},[546,627,628,631,640],{},[564,629,630],{},"nginx",[564,632,612,633,636,637],{},[214,634,635],{},"\u003Cbench>\u002Flogs\u002Fnginx-access.log",", au format ",[214,638,639],{},"pilot_access",[564,641,582],{},[546,643,644,647,664],{},[564,645,646],{},"File d'attente Redis",[564,648,590,649,652,653,656,657,334,660,663],{},[214,650,651],{},"queue_length",", les registres RQ failed\u002Fstarted, les workers actifs et la mémoire\u002Fles évictions Redis depuis ",[214,654,655],{},"redis:\u002F\u002F127.0.0.1:\u003C[redis] queue_port>",". ",[214,658,659],{},"redis_queue",[214,661,662],{},"common_site_config.json"," est prioritaire quand il est présent",[564,665,666],{},"fait",[546,668,669,672,682],{},[564,670,671],{},"Sauvegardes, TLS, MariaDB",[564,673,674,675,678,679,681],{},"Comme sur n'importe quel bench : ",[214,676,677],{},"sites\u002F\u003Csite>\u002Fprivate\u002Fbackups\u002F",", chaque site et chaque entrée ",[214,680,597],{},", les identifiants de base de données du site",[564,683,684],{},"fait (générique)",[546,686,687,690,703],{},[564,688,689],{},"Processus",[564,691,692,695,696,699,700,702],{},[214,693,694],{},"supervisorctl status",", sinon les unités systemd dont le nom contient le nom du bench (",[214,697,698],{},"bench_processes_down","). Si les noms d'unités ou de programmes de Pilot ne contiennent pas le ",[214,701,259],{},", rien n'est signalé",[564,704,705],{},"non vérifié",[546,707,708,711,733],{},[564,709,710],{},"Déploiements",[564,712,713,714,717,718,720,721,724,725,728,729,732],{},"Un événement ",[214,715,716],{},"deployment"," (catégorie ",[214,719,345],{},") quand une tâche de mise à jour, de migration, de changement de branche, d'installation d'application, de build, de redémarrage ou de restauration ",[209,722,723],{},"démarre",", et un événement ",[214,726,727],{},"error"," (",[214,730,731],{},"pilot_task_failed",") quand l'une d'elles échoue. Lu depuis l'Admin API, ou depuis les fichiers de tâches",[564,734,582],{},[546,736,737,740,743],{},[564,738,739],{},"Interrupteur « Enable Wolf for this bench » dans Pilot",[564,741,742],{},"Demande une modification de frappe\u002Fpilot",[564,744,745],{},[209,746,747],{},"non fait",[546,749,750,753,758],{},[564,751,752],{},"Vrai hôte Pilot",[564,754,755],{},[209,756,757],{},"Pas encore testé",[564,759,760],{},"—",[198,762,763,764,225],{},"Les métriques elles-mêmes sont décrites dans ",[201,765,60],{"href":61},[227,767,769],{"id":768},"organisation-du-bench","Organisation du bench",[242,771,773],{"id":772},"benches","Benches",[198,775,495,776,779,780,783,784,787,788,225],{},[214,777,778],{},"install.sh"," de Pilot installe dans ",[214,781,782],{},"$HOME\u002Fpilot",". Les benches se trouvent par défaut dans ",[214,785,786],{},"~\u002Fpilot\u002Fbenches\u002F\u003Cname>\u002F",". Sur un VPS où seul root existe, l'installateur crée un utilisateur de bench non root, d'où le glob ",[214,789,251],{},[198,791,792,793,616,796,616,799,616,802,616,805,616,808,260,811,225],{},"Chaque bench contient ",[214,794,795],{},"apps\u002F",[214,797,798],{},"sites\u002F",[214,800,801],{},"env\u002F",[214,803,804],{},"logs\u002F",[214,806,807],{},"config\u002F",[214,809,810],{},"pids\u002F",[214,812,255],{},[242,814,255],{"id":815},"benchtoml",[198,817,818],{},"Wolf lit ces clés :",[540,820,821,831],{},[543,822,823],{},[546,824,825,828],{},[549,826,827],{},"Clé",[549,829,830],{},"Usage",[559,832,833,845,858,875,884],{},[546,834,835,839],{},[564,836,837],{},[214,838,259],{},[564,840,841,842,844],{},"Obligatoire, avec ",[214,843,263],{},". Le nom du bench et le marqueur Pilot",[546,846,847,852],{},[564,848,849],{},[214,850,851],{},"[redis] queue_port",[564,853,854,855],{},"Port du Redis de la file d'attente. Par défaut ",[214,856,857],{},"11000",[546,859,860,865],{},[564,861,862],{},[214,863,864],{},"[admin] port",[564,866,867,868,871,872],{},"Par défaut ",[214,869,870],{},"7000",". Le backend Admin écoute sur ",[214,873,874],{},"127.0.0.1:\u003Cport + 1>",[546,876,877,881],{},[564,878,879],{},[214,880,498],{},[564,882,883],{},"Lu uniquement à l'exécution, jamais écrit dans la configuration de Wolf",[546,885,886,891],{},[564,887,888],{},[214,889,890],{},"[production] enabled",[564,892,893],{},"Conservé pour information",[198,895,896,898,899,902,903,906,907,910,911,913,914,917],{},[214,897,255],{}," n'a ",[209,900,901],{},"aucune"," clé nginx ni de logs : « Nginx uses compiled-in defaults; it has no ",[214,904,905],{},"[nginx]"," table ». ",[214,908,909],{},"[monitor]"," ne nomme que le log de métriques propre à Pilot. Un ",[214,912,255],{}," qui n'est pas celui de Pilot (sans ",[214,915,916],{},"[bench] python",") passe toujours par l'ancien parseur défensif.",[242,919,609],{"id":920},"logs-des-processus",[198,922,923,924,350],{},"Les logs des processus vont dans ",[214,925,926],{},"\u003Cbench>\u002Flogs\u002F",[928,929,930,936,945],"ul",{},[931,932,933],"li",{},[214,934,935],{},"web.log",[931,937,938,941,942,225],{},[214,939,940],{},"worker_\u003Cqueue-slug>_\u003Ci>.log",". Le slug est la liste des files d'attente, où chaque suite de caractères non alphanumériques est remplacée par ",[214,943,944],{},"_",[931,946,947],{},[214,948,949],{},"schedule.log",[198,951,952,953,956,957,960,961,964],{},"stderr va dans ",[214,954,955],{},"\u003Clog>.error.log"," sous systemd (par exemple ",[214,958,959],{},"web.log.error.log",") et dans ",[214,962,963],{},"\u003Cname>.error.log"," sous supervisor. Wolf suit les deux graphies. Les fichiers absents ne coûtent rien.",[198,966,967,968,616,971,260,974,977],{},"Les fichiers ",[214,969,970],{},"frappe.web.log",[214,972,973],{},"scheduler.log",[214,975,976],{},"worker.log"," de Frappe sont suivis comme sur tous les benches.",[242,979,630],{"id":630},[198,981,982,983,334,986,988],{},"Le vhost de chaque site journalise ",[214,984,985],{},"location \u002F",[214,987,635],{},", avec ce format :",[270,990,993],{"className":991,"code":992,"language":630,"meta":275,"style":275},"language-nginx shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","log_format pilot_access '$pilot_client_addr [$time_local] \"$request_method $uri\" $status \"$host\" $request_time';\n",[214,994,995],{"__ignoreMap":275},[279,996,997,1000,1004,1007,1010,1013,1016,1018,1021,1024,1026,1029,1032,1035,1038,1040,1043,1046,1048,1051,1053,1055,1058,1060],{"class":281,"line":282},[279,998,999],{"class":363},"log_format ",[279,1001,1003],{"class":1002},"sTEyZ","pilot_access ",[279,1005,1006],{"class":289},"'",[279,1008,1009],{"class":363},"$",[279,1011,1012],{"class":1002},"pilot_client_addr",[279,1014,1015],{"class":289}," [",[279,1017,1009],{"class":363},[279,1019,1020],{"class":1002},"time_local",[279,1022,1023],{"class":289},"] \"",[279,1025,1009],{"class":363},[279,1027,1028],{"class":1002},"request_method",[279,1030,1031],{"class":363}," $",[279,1033,1034],{"class":1002},"uri",[279,1036,1037],{"class":289},"\" ",[279,1039,1009],{"class":363},[279,1041,1042],{"class":1002},"status",[279,1044,1045],{"class":289}," \"",[279,1047,1009],{"class":363},[279,1049,1050],{"class":1002},"host",[279,1052,1037],{"class":289},[279,1054,1009],{"class":363},[279,1056,1057],{"class":1002},"request_time",[279,1059,1006],{"class":289},[279,1061,1062],{"class":363},";\n",[198,1064,1065,1066,1069,1070,225],{},"Ce n'est pas le format combined : il n'a ni ident ni utilisateur, ni nombre d'octets, ni protocole. Le parseur nginx de Wolf l'accepte. Le lecteur de logs d'accès de Pilot utilise la même structure. ",[214,1067,1068],{},"$host"," est le site ou l'un de ses ",[214,1071,597],{},[242,1073,1075],{"id":1074},"tâches","Tâches",[198,1077,1078,1079,350],{},"Les opérations longues sont des tâches, stockées sous la forme ",[214,1080,1081],{},"\u003Cbench>\u002Ftasks\u002F\u003CYYYYMMDD-HHMMSS-hex>\u002F",[928,1083,1084,1115],{},[931,1085,1086,1089,1090,616,1093,616,1096,616,1099,616,1102,616,1105,1108,1109,616,1112,225],{},[214,1087,1088],{},"meta.json"," : ",[214,1091,1092],{},"task_id",[214,1094,1095],{},"command",[214,1097,1098],{},"args",[214,1100,1101],{},"queued_at",[214,1103,1104],{},"started_at",[214,1106,1107],{},"finished_at"," (UTC ISO-8601), ",[214,1110,1111],{},"exit_code",[214,1113,1114],{},"failure",[931,1116,1117,1089,1119,616,1122,616,1125,616,1128,504,1131,225],{},[214,1118,1042],{},[214,1120,1121],{},"queued",[214,1123,1124],{},"running",[214,1126,1127],{},"success",[214,1129,1130],{},"failed",[214,1132,1133],{},"killed",[198,1135,1136,1137,1140],{},"Les répertoires sont créés avec le mode ",[214,1138,1139],{},"0700"," : seul l'utilisateur du bench peut les lire.",[227,1142,1144],{"id":1143},"événements-de-déploiement-issus-des-tâches-pilot","Événements de déploiement issus des tâches Pilot",[198,1146,1147],{},"Wolf signale ces commandes de tâche :",[198,1149,1150,616,1153,616,1156,616,1159,616,1162,616,1165,616,1168,616,1171,616,1174,616,1177,616,1180,616,1183,616,1186,616,1189,616,1192,616,1195,616,1198,616,1201,225],{},[214,1151,1152],{},"update",[214,1154,1155],{},"retry-update",[214,1157,1158],{},"complete-migration",[214,1160,1161],{},"migrate",[214,1163,1164],{},"revert-migration",[214,1166,1167],{},"revert-apps",[214,1169,1170],{},"revert-site",[214,1172,1173],{},"switch-branch",[214,1175,1176],{},"get-and-install-app",[214,1178,1179],{},"install-app",[214,1181,1182],{},"uninstall-app",[214,1184,1185],{},"remove-app",[214,1187,1188],{},"build",[214,1190,1191],{},"restart-services",[214,1193,1194],{},"switch-lite-mode",[214,1196,1197],{},"setup-nginx",[214,1199,1200],{},"restore-site",[214,1202,1203],{},"reinstall-site",[198,1205,1206,1207,217,1210,1213],{},"Le site provient des arguments ",[214,1208,1209],{},"site",[214,1211,1212],{},"sites"," de la tâche. Le bench est le bench Pilot lui-même, puisque les tâches sont propres à chaque bench.",[242,1215,1217],{"id":1216},"sources-des-tâches","Sources des tâches",[198,1219,1220],{},"Wolf essaie deux sources, dans cet ordre.",[1222,1223,1224,1267],"ol",{},[931,1225,1226,1089,1229,1232,1233,1236,1237,1089,1240,1243,1244,256,1247,1249,1250,1253,1254,1256,1257,1259,1260,1262,1263,1266],{},[209,1227,1228],{},"Admin API",[214,1230,1231],{},"GET http:\u002F\u002F127.0.0.1:\u003Cadmin.port+1>\u002Fapi\u002Fv1\u002Ftasks?limit=100",". Elle renvoie des lignes ",[214,1234,1235],{},"TaskInfo.as_dict()",". Le point d'accès exige une session ",[209,1238,1239],{},"limitée au bench",[214,1241,1242],{},"Authorization: Bearer \u003CJWT>",". Pilot signe ces jetons localement en HS256 sur ",[214,1245,1246],{},"{\"sub\": \"admin\", \"iat\", \"exp\", \"scope\": \"bench\", \"jti\"}",[214,1248,498],{},", et les vérifie avec ",[214,1251,1252],{},"require: [\"exp\"]",". Wolf utilise ",[214,1255,486],{}," si vous en définissez un. Sinon, il émet un jeton valable une heure avec la même structure de claims, à partir de ",[214,1258,492],{}," ou de ",[214,1261,255],{}," quand Wolf peut le lire. Chaque jeton émis porte un jti ",[214,1264,1265],{},"wolf-…",", si bien qu'il apparaît dans les sessions actives de Pilot et peut être révoqué.",[931,1268,1269,1089,1272,260,1275,1277,1278,225],{},[209,1270,1271],{},"Fichiers de tâches",[214,1273,1274],{},"\u003Cbench>\u002Ftasks\u002F*\u002Fmeta.json",[214,1276,1042],{},". Cela ne fonctionne que si le Wolf Agent tourne sous l'utilisateur du bench, à cause du mode ",[214,1279,1139],{},[242,1281,1283],{"id":1282},"production-des-événements","Production des événements",[198,1285,1286,1287,225],{},"Les deux sources suivent les mêmes règles que sur les ",[201,1288,1289],{"href":46},"serveurs Press",[928,1291,1292,1304,1320,1326],{},[931,1293,713,1294,1296,1297,1299,1300,1303],{},[214,1295,716],{}," est envoyé au démarrage de la tâche, horodaté à ",[214,1298,1104],{},". Un incident qui survient pendant une longue migration s'y rattache, par exemple via la ",[201,1301,1302],{"href":102},"règle prédéfinie"," « 502 spike after deployment ».",[931,1305,713,1306,1308,1309,1311,1312,616,1315,260,1318,225],{},[214,1307,727],{}," est envoyé si la tâche se termine en ",[214,1310,1130],{},". Il porte ",[214,1313,1314],{},"failure.code",[214,1316,1317],{},"failure.message",[214,1319,1111],{},[931,1321,1322,1323,225],{},"Les identifiants des tâches signalées sont conservés 3 jours dans ",[214,1324,1325],{},"\u003Cspool_dir>\u002Fpilot-tasks.json",[931,1327,1328],{},"La première interrogation ignore l'historique et ne prend en compte que les tâches en file ou en cours.",[198,1330,1331,1332,1335,1336,225],{},"Cela remplace les marqueurs manuels ",[214,1333,1334],{},"wolf-agent mark-deployment --source pilot"," sur les benches Pilot. Les champs des événements sont décrits dans le ",[201,1337,1338],{"href":169},"protocole",[227,1340,1342],{"id":1341},"wolf-aux-côtés-du-monitoring-de-pilot","Wolf aux côtés du monitoring de Pilot",[198,1344,1345],{},"D'après la documentation de Pilot :",[928,1347,1348,1357,1367],{},[931,1349,1350,1353,1354,225],{},[214,1351,1352],{},"pilot-monitor.service"," collecte les métriques de l'hôte, de la base de données et du bench toutes les 10 s et interroge les sites de production toutes les 5 s. Ses logs vont dans ",[214,1355,1356],{},"system\u002Flogs\u002F",[931,1358,1359,1362,1363,1366],{},[214,1360,1361],{},"[resource_limits]"," déclenche des alertes de CPU, de mémoire, de disque et de disponibilité au bout de 5 minutes. Elles partent vers Central (sur les hôtes gérés par Central), vers ",[214,1364,1365],{},"webhook_endpoints"," (POST avec un en-tête Bearer) et par e-mail.",[931,1368,1369,1372,1373,1376],{},[214,1370,1371],{},"[telemetry]"," envoie les métriques et les logs (Fluent Bit suit ",[214,1374,1375],{},"benches\u002F*\u002Flogs\u002F*.log",") vers le point d'accès « Datum » d'une région, avec un jeton délivré par Central.",[198,1378,1379],{},"Wolf lit les mêmes fichiers locaux et n'interfère avec aucun de ces éléments. Ce qu'il ajoute sur un hôte Pilot auto-hébergé :",[928,1381,1382,1385,1388,1391],{},[931,1383,1384],{},"Les tracebacks, les tâches planifiées en échec et les plantages de workers, sous forme d'événements.",[931,1386,1387],{},"Les 5xx\u002F502 par site.",[931,1389,1390],{},"Les signaux SSH.",[931,1392,1393],{},"Des incidents rattachés à la tâche Pilot qui les a précédés.",[198,1395,1396],{},"Tout cela reste sur votre propre site Wolf.",[1398,1399,1400],"note",{},[198,1401,1402,1403,1405],{},"Les alertes de ressources de Pilot pourraient être dirigées vers Wolf via ",[214,1404,1365],{},", mais leur charge utile n'est pas documentée, donc Wolf ne les accepte pas encore.",[227,1407,1409],{"id":1408},"limites-et-points-non-vérifiés","Limites et points non vérifiés",[242,1411,1413],{"id":1412},"ce-dont-pilot-aurait-besoin","Ce dont Pilot aurait besoin",[198,1415,1416],{},"Ces éléments de l'issue #17 demandent des modifications ou des réponses de la part des mainteneurs de Pilot :",[1222,1418,1419,1437,1453,1462],{},[931,1420,1421,1424,1425,334,1428,728,1430,616,1433,1436],{},[209,1422,1423],{},"Interrupteur « Enable Wolf for this bench »."," Une table ",[214,1426,1427],{},"[wolf]",[214,1429,255],{},[214,1431,1432],{},"enabled",[214,1434,1435],{},"url",") et un réglage dans l'Admin, qui installerait et enregistrerait l'agent avec les chemins du bench. Cela relève de frappe\u002Fpilot, et rien de tel n'y existe aujourd'hui.",[931,1438,1439,1442,1443,1445,1446,1449,1450,1452],{},[209,1440,1441],{},"Un jeton machine pour l'Admin API."," Aujourd'hui, une session limitée au bench est soit une session par mot de passe de 24 h, soit un JWT signé avec ",[214,1444,435],{}," ou émis par le JWKS configuré. Un jeton ",[214,1447,1448],{},"tasks:read"," en lecture seule et de longue durée éviterait de partager ",[214,1451,435],{}," avec Wolf.",[931,1454,1455,1458,1459,225],{},[209,1456,1457],{},"Un flux d'événements de tâches"," (webhook ou SSE couvrant toutes les tâches) au lieu d'interroger ",[214,1460,1461],{},"\u002Ftasks",[931,1463,1464,1467,1468,260,1470,1472,1473,1475],{},[209,1465,1466],{},"Les modes des fichiers."," La confirmation que ",[214,1469,255],{},[214,1471,804],{}," restent lisibles par un groupe de monitoring, puisque les tâches sont en ",[214,1474,1139],{}," par conception.",[242,1477,1479],{"id":1478},"points-non-vérifiés","Points non vérifiés",[198,1481,1482],{},"Ces points proviennent de la lecture des sources et de tests unitaires sur des jeux de données construits à partir d'elles. Rien n'a été exécuté sur un hôte Pilot réel. En particulier, ceci n'a pas été testé :",[928,1484,1485,1488,1494,1499,1502],{},[931,1486,1487],{},"Le jeton émis face à un vrai backend Admin.",[931,1489,1490,1493],{},[214,1491,1492],{},"\u002Fapi\u002Fv1\u002Ftasks"," à travers les limites de débit de Pilot.",[931,1495,1496,1497,225],{},"Les permissions des fichiers pour un utilisateur autre que celui du bench, y compris les modes que Pilot donne à ",[214,1498,255],{},[931,1500,1501],{},"La graphie exacte du slug des files d'attente des workers sur un bench en fonctionnement.",[931,1503,1504],{},"Les noms exacts des unités systemd et des programmes supervisor de Pilot, dont dépendent les vérifications de processus.",[1506,1507,1508,1534,1539,1551,1556,1586,1590,1643,1647,1677,1681,1703,1707,1754,1758,1805,1810],"collapsible",{},[198,1509,1510,1511,1518,1519,1526,1527,225],{},"Tout le contenu de cette page a été lu dans frappe\u002Fpilot au commit ",[201,1512,1515],{"href":1513,"rel":1514},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fpilot\u002Ftree\u002F34613eade8008a15a9ae61d28fca2627db52e7b9",[205],[214,1516,1517],{}