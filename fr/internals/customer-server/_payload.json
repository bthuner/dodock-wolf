243,256,257,264],{},[258,259,260],"td",{},[261,262,263],"code",{},"atlas-guest-agent",[258,265,266,269,270,273],{},[261,267,268],{},"\u002Fusr\u002Flocal\u002Flib\u002Fatlas\u002Fatlas-guest-agent",". Quatre unités socket, ",[261,271,272],{},"atlas-guest-agent-{usage,freeze,grow,reboot}.socket",", sur les ports vsock 100000 à 100003 : l'hôte demande l'usage, gèle les systèmes de fichiers avant un instantané, agrandit le disque, redémarre. Un pare-feu dans la machine ne peut pas bloquer vsock",[243,275,276,281],{},[258,277,278],{},[261,279,280],{},"atlas-metadata.service",[258,282,283,284,287],{},"Interroge le service de métadonnées (",[261,285,286],{},"169.254.169.254",") toutes les 250 ms : nom d'hôte, adresse privée, MTU, routes. Avance l'horloge après un gel de la machine",[243,289,290,293],{},[258,291,292],{},"Clés SSH depuis les métadonnées",[258,294,295,298,299,302],{},[261,296,297],{},"\u002Fetc\u002Fssh\u002Fsshd_config.d\u002F90-atlas-mmds.conf"," : sshd lance ",[261,300,301],{},"atlas-guest-agent authorized-keys"," à chaque connexion. Une clé ajoutée dans la console ne modifie aucun fichier sur le serveur",[243,304,305,308],{},[258,306,307],{},"cloud-init",[258,309,310,313,314,317,318],{},[261,311,312],{},"\u002Fetc\u002Fcloud\u002Fcloud.cfg.d\u002F99-atlas-datasource.cfg",", source de données ",[261,315,316],{},"Atlas"," ; une console série sur ",[261,319,320],{},"ttyS0",[243,322,323,326],{},[258,324,325],{},"Réseau",[258,327,328,331,332,335],{},[261,329,330],{},"eth0",", une IPv6 privée ",[261,333,334],{},"fdaa:\u003Cregion>:\u003Ctenant>::\u003Cmachine>",", MTU 1380, IPv4 vers Internet par le NAT de l'hôte",[232,337,339],{"id":338},"venant-de-limage-pilot-de-cargo","Venant de l'image Pilot de Cargo",[237,341,342,350],{},[240,343,344],{},[243,345,346,348],{},[246,347,248],{},[246,349,251],{},[253,351,352,363,374,392,411,426,434,444],{},[243,353,354,357],{},[258,355,356],{},"Utilisateur",[258,358,359,362],{},[261,360,361],{},"frappe",", uid 1000. Tous les autres utilisateurs ordinaires de l'image Ubuntu sont supprimés",[243,364,365,368],{},[258,366,367],{},"Pilot",[258,369,370,373],{},[261,371,372],{},"\u002Fhome\u002Ffrappe\u002Fpilot",", à une version fixe",[243,375,376,379],{},[258,377,378],{},"Bench",[258,380,381,384,385,388,389],{},[261,382,383],{},"\u002Fhome\u002Ffrappe\u002Fpilot\u002Fbenches\u002Fdefault-bench",", sur MariaDB (",[261,386,387],{},"~\u002Fpilot\u002Fdatabases\u002Fmariadb\u002Frun\u002Fmysqld.sock","), ",[261,390,391],{},"restart_idle_seconds = 900",[243,393,394,397],{},[258,395,396],{},"Site",[258,398,399,402,403,406,407],{},[261,400,401],{},"site.local"," sur les images Site et Apps. Il est atteint par l'alias ",[261,404,405],{},"*.\u003Cregion domain>"," : ",[408,409,410],"strong",{},"le nom du dossier du site n'est pas son nom public",[243,412,413,416],{},[258,414,415],{},"Admin",[258,417,418,419,422,423],{},"Domaine ",[261,420,421],{},"admin.local",", atteint sous ",[261,424,425],{},"admin-vm-\u003Clabel>.\u003Cregion domain>",[243,427,428,431],{},[258,429,430],{},"nginx",[258,432,433],{},"Activé, sans TLS pour les noms de la région",[243,435,436,439],{},[258,437,438],{},"Le programme de domaines",[258,440,441],{},[261,442,443],{},"\u002Fusr\u002Fbin\u002Fbench-domain-provider",[243,445,446,449],{},[258,447,448],{},"Unités",[258,450,451,454,455,458,459],{},[261,452,453],{},"pilot-vm-memory.service"," (zswap, 1 Go de swap), ",[261,456,457],{},"pilot-prewarm.service",", ",[261,460,461],{},"pilot-grow-file-system@.service",[218,463,464],{},"Une image ne contient ni jeton, ni réglage de télémétrie, ni clé SSH, ni trace d'une équipe. Chaque construction génère un mot de passe Admin aléatoire et un mot de passe Administrator aléatoire dans la machine de construction. Le script de construction ne les renouvelle pas : ils sont donc probablement identiques sur tous les serveurs démarrés depuis une même image, jusqu'à ce que quelque chose les change (déduit, à vérifier).",[232,466,468],{"id":467},"venant-de-pilot-comme-sur-tout-hôte-pilot","Venant de Pilot, comme sur tout hôte Pilot",[470,471,472,513,526,537,561,583],"ul",{},[473,474,475,476,479,480,406,482,458,485,488,489,458,492,495,496,458,499,502,503,458,506,458,509,512],"li",{},"Des unités ",[408,477,478],{},"utilisateur"," systemd de ",[261,481,361],{},[261,483,484],{},"\u003Cbench>.target",[261,486,487],{},"\u003Cbench>-web"," (avec son socket), ",[261,490,491],{},"\u003Cbench>-socketio",[261,493,494],{},"\u003Cbench>-worker_pool…",", les deux Redis, ",[261,497,498],{},"\u003Cbench>-admin",[261,500,501],{},"\u003Cbench>-central-bootstrap"," ; et ",[261,504,505],{},"pilot-monitor.service",[261,507,508],{},"pilot-mariadb.service",[261,510,511],{},"pilot-certificates.timer",". Le défaut est le « mode lite » : un seul processus pour le web, le temps réel et les tâches.",[473,514,515,458,518,521,522,525],{},[261,516,517],{},"\u002Fetc\u002Fnginx\u002Fconf.d\u002F00-pilot.conf",[261,519,520],{},"\u002Fetc\u002Flogrotate.d\u002Fpilot"," (500 Mo, ",[261,523,524],{},"copytruncate","), des règles sudo pour nginx et certbot.",[473,527,528,529,532,533,536],{},"Des journaux dans ",[261,530,531],{},"\u003Cbench>\u002Flogs\u002F",", et les journaux de Frappe lui-même dans ",[261,534,535],{},"\u003Cbench>\u002Flogs\u002Fworkload\u002F"," sur un bench en bac à sable. Les unités écrivent dans des fichiers à cet endroit, pas dans le journal systemd.",[473,538,539,542,543,546,547,550,551,554,555,554,558,225],{},[261,540,541],{},"\u003Cbench>\u002Flogs\u002Fnginx-access.log",", dans le format propre à Pilot : ",[261,544,545],{},"$pilot_client_addr [$time_local] \"$request_method $uri\" $status \"$host\" $request_time",". Seul le ",[261,548,549],{},"location \u002F"," des sites est journalisé : ni ",[261,552,553],{},"\u002Fassets",", ni ",[261,556,557],{},"\u002Ffiles",[261,559,560],{},"\u002Fsocket.io",[473,562,563,564,458,567,570,571,458,574,458,577,458,580,225],{},"Des signaux locaux : ",[261,565,566],{},"logs\u002Fuptime.json.log",[261,568,569],{},"logs\u002Faudit_\u003Cyear>_\u003Cweek>.jsonl"," (les sessions et les connexions Admin, avec l'adresse), ",[261,572,573],{},"tasks\u002F\u003Cid>\u002F",[261,575,576],{},"~\u002Fpilot\u002Fsystem\u002Flogs\u002Fsystem-stats.log",[261,578,579],{},"updates_\u003Cyear>_\u003Cweek>.jsonl",[261,581,582],{},"central-requests_\u003Cyear>_\u003Cweek>.jsonl",[473,584,585,586,589],{},"Ni pare-feu d'hôte ni fail2ban. Le ",[261,587,588],{},"[firewall]"," de Pilot est une liste d'autorisation et de refus dans nginx.",[218,591,592,593,225],{},"La prise en charge de Pilot par Wolf lit déjà cette disposition : voir ",[222,594,45],{"href":46},[232,596,598],{"id":597},"venant-de-central-au-premier-démarrage","Venant de Central, au premier démarrage",[218,600,601,602,606],{},"Par les attributs de métadonnées (",[222,603,605],{"href":604},"\u002Ffr\u002Finternals\u002Finterop#les-secrets-en-route-vers-une-machine","le tableau",") :",[237,608,609,619],{},[240,610,611],{},[243,612,613,616],{},[246,614,615],{},"Marqueur",[246,617,618],{},"Fichier",[253,620,621,639,652,665,682,696],{},[243,622,623,634],{},[258,624,625,458,628,458,631],{},[261,626,627],{},"[central] enabled = true",[261,629,630],{},"bootstrapped = true",[261,632,633],{},"[[central.hostname_aliases]]",[258,635,636],{},[261,637,638],{},"~\u002Fpilot\u002Fbenches\u002Fcommon_config.toml",[243,640,641,649],{},[258,642,643,458,646],{},[261,644,645],{},"[telemetry] endpoint",[261,647,648],{},"token",[258,650,651],{},"Même fichier. Le jeton est un jeton d'écriture Datum de 7 jours, en clair",[243,653,654,662],{},[258,655,656,458,659],{},[261,657,658],{},"[admin] jwks_url",[261,660,661],{},"jwks_audience",[258,663,664],{},"Même fichier",[243,666,667,677],{},[258,668,669,672,673,676],{},[261,670,671],{},"fc_team"," (l'identifiant de l'équipe), les réglages SMTP d'une boîte aux lettres mutualisée, ",[261,674,675],{},"ai_keys"," pour un essai",[258,678,679],{},[261,680,681],{},"sites\u002Fcommon_site_config.json",[243,683,684,691],{},[258,685,686,687,690],{},"Les clés ",[261,688,689],{},"[s3]"," du bucket de sauvegarde, quand l'offre inclut du stockage",[258,692,693],{},[261,694,695],{},"bench.toml",[243,697,698,709],{},[258,699,700,458,703,458,706],{},[261,701,702],{},"pilot_endpoint",[261,704,705],{},"pilot_auth_token",[261,707,708],{},"cloud_server_url",[258,710,711,712],{},"Chaque ",[261,713,714],{},"site_config.json",[218,716,717,719,720,723,724,727,728,730],{},[261,718,702],{}," n'est ",[408,721,722],{},"pas"," un signe de Frappe Cloud v2 : un Pilot auto-hébergé en production l'écrit aussi. ",[261,725,726],{},"[central] enabled"," et ",[261,729,671],{}," en sont.",[732,733,734],"caution",{},[218,735,736,739,740,743],{},[261,737,738],{},"http:\u002F\u002F169.254.169.254\u002Flatest\u002Fmeta-data\u002Fattributes\u002Fpilot-central"," renvoie le ",[261,741,742],{},"X-Pilot-Token"," du serveur à tout processus hors du bac à sable du bench. Avec lui, un processus peut demander à Central les moyens de paiement de l'équipe, un jeton Datum ou un jeton de dépôt GitHub. Un outil sur le serveur ne doit jamais le lire. Un processus qui le fait est un signal qui mérite une alerte.",[227,745,747],{"id":746},"ce-qui-quitte-le-serveur","Ce qui quitte le serveur",[218,749,750,751,754],{},"Tout ce que Pilot envoie à Datum, d'après ",[261,752,753],{},"pilot\u002Fcore\u002Fserver\u002Fmonitoring_datum.py"," :",[237,756,757,770],{},[240,758,759],{},[243,760,761,764,767],{},[246,762,763],{},"Signal",[246,765,766],{},"Toutes les",[246,768,769],{},"Étiquettes",[253,771,772,799,815,827,850,867,881,898],{},[243,773,774,779,782],{},[258,775,776],{},[261,777,778],{},"pilot_sites",[258,780,781],{},"60 s",[258,783,784,406,787,458,790,458,793,458,796],{},[261,785,786],{},"state",[261,788,789],{},"up",[261,791,792],{},"down",[261,794,795],{},"app_error",[261,797,798],{},"maintenance",[243,800,801,807,810],{},[258,802,803,806],{},[261,804,805],{},"pilot_info"," (le signal de vie)",[258,808,809],{},"5 min",[258,811,812],{},[261,813,814],{},"version",[243,816,817,822,824],{},[258,818,819],{},[261,820,821],{},"pilot_database_up",[258,823,809],{},[258,825,826],{},"—",[243,828,829,837,839],{},[258,830,831,458,834],{},[261,832,833],{},"system_filesystem_size_bytes",[261,835,836],{},"system_filesystem_available_bytes",[258,838,809],{},[258,840,841,458,844,458,847],{},[261,842,843],{},"mountpoint",[261,845,846],{},"device",[261,848,849],{},"type",[243,851,852,857,859],{},[258,853,854],{},[261,855,856],{},"pilot_central_requests_last_5_minutes",[258,858,809],{},[258,860,861,458,864],{},[261,862,863],{},"method",[261,865,866],{},"result",[243,868,869,874,876],{},[258,870,871],{},[261,872,873],{},"pilot_site_backups",[258,875,809],{},[258,877,878],{},[261,879,880],{},"status",[243,882,883,888,890],{},[258,884,885],{},[261,886,887],{},"pilot_site_backup_failed",[258,889,809],{},[258,891,892],{},[408,893,894,897],{},[261,895,896],{},"site"," : le nom du site",[243,899,900,903,905],{},[258,901,902],{},"Les événements de mise à jour, en lignes de journal",[258,904,809],{},[258,906,907,458,910,913,914,458,916,458,919,923],{},[261,908,909],{},"app",[261,911,912],{},"repository",", les versions, ",[261,915,880],{},[261,917,918],{},"phase",[408,920,921],{},[261,922,896],{},", et jusqu'aux 8 192 derniers caractères de la sortie d'une tâche en échec",[218,925,926,927,931],{},"Et vers Central : les types d'événement de ",[222,928,930],{"href":929},"\u002Ffr\u002Finternals\u002Fflows#un-client-est-pr%C3%A9venu","Un client est prévenu",", avec un message.",[218,933,934,937,938,941],{},[408,935,936],{},"Ce qui reste sur le serveur"," : les métriques de CPU, de mémoire, de charge, de réseau et de MariaDB (Pilot les collecte toutes les 10 secondes, dans des fichiers locaux uniquement) ; le journal systemd ; les journaux d'accès et d'erreurs de nginx ; tous les journaux du bench ; les échecs du planificateur (scheduler) et des workers ; ",[261,939,940],{},"auth.log"," ; l'Error Log, l'Activity Log et l'Access Log de Frappe.",[218,943,944],{},"Le contrat de télémétrie de Beacon dit « la machine virtuelle d'un locataire n'envoie aucune métrique machine » et « un site n'est jamais une valeur d'étiquette ». La première affirmation tient. La seconde non : une sauvegarde en échec envoie le nom du site, et une mise à jour en échec envoie le site et sa sortie.",[227,946,948],{"id":947},"ce-que-la-plateforme-voit-de-lextérieur","Ce que la plateforme voit de l'extérieur",[218,950,951],{},"Sans rien dans le bench de la machine, par l'hôte et l'agent invité :",[470,953,954,957,968,971,974],{},[473,955,956],{},"le temps CPU, la mémoire (depuis le périphérique balloon), la taille, l'usage et les E\u002FS du disque, les octets et les paquets réseau à l'interface de la machine, avec des compteurs des ICMP, UDP, TCP SYN et TCP RST envoyés ;",[473,958,959,960,963,964,967],{},"la charge moyenne, ",[261,961,962],{},"\u002Fproc\u002Fmeminfo",", l'usage du système de fichiers racine et ",[261,965,966],{},"systemctl is-system-running",", depuis l'agent invité ;",[473,969,970],{},"si la machine répond à un ping, chaque minute ;",[473,972,973],{},"la sortie de la console série (128 Kio conservés, même si personne ne regarde) ;",[473,975,976],{},"au proxy : le nombre et la durée des requêtes pour les noms de la région, de façon agrégée.",[218,978,979],{},"Le personnel de Frappe qui a accès à un hôte peut prendre un instantané du disque ou le monter en mode de secours. La plateforme ne voit pas à l'intérieur du TLS d'un domaine personnalisé, et ne lit ni journal ni liste de processus de la machine.",[227,981,983],{"id":982},"comment-un-serveur-se-comporte","Comment un serveur se comporte",[237,985,986,996],{},[240,987,988],{},[243,989,990,993],{},[246,991,992],{},"Comportement",[246,994,995],{},"Conséquence pour un outil sur le serveur",[253,997,998,1012,1023,1034,1045,1056,1067,1084,1095],{},[243,999,1000,1009],{},[258,1001,1002,1005,1006],{},[408,1003,1004],{},"Veille."," Un serveur d'essai (et celui d'une équipe de préproduction) est gelé quand aucune requête n'arrive pendant un moment, et se réveille sur du trafic. Les connexions sortantes ne le maintiennent pas éveillé. Les serveurs payants sont créés avec ",[261,1007,1008],{},"sleep_after_idle_seconds: 0",[258,1010,1011],{},"Un minuteur s'arrête et reprend avec un saut de l'horloge. Le silence n'est pas une panne",[243,1013,1014,1020],{},[258,1015,1016,1019],{},[408,1017,1018],{},"Verrou d'essai."," Tant qu'un essai gratuit est ouvert : ni SSH, ni console web, ni Admin de Pilot",[258,1021,1022],{},"Rien ne peut être installé",[243,1024,1025,1031],{},[258,1026,1027,1030],{},[408,1028,1029],{},"Démarrage à chaud."," Les images Base et Apps reprennent depuis un instantané mémoire",[258,1032,1033],{},"L'identifiant de démarrage, l'identifiant de machine et les heures de début des processus peuvent être partagés entre les serveurs d'une même image (déduit). Le journal systemd démarre presque vide",[243,1035,1036,1042],{},[258,1037,1038,1041],{},[408,1039,1040],{},"Instantané."," Les systèmes de fichiers sont gelés jusqu'à 30 secondes",[258,1043,1044],{},"Un lecteur de journaux voit une pause dans les écritures",[243,1046,1047,1053],{},[258,1048,1049,1052],{},[408,1050,1051],{},"Redémarrage sur inactivité."," En mode lite, le processus du bench redémarre après 900 secondes sans travail",[258,1054,1055],{},"Ce n'est pas un crash",[243,1057,1058,1064],{},[258,1059,1060,1063],{},[408,1061,1062],{},"Pare-feu."," Désactivé par défaut, ce qui autorise tout dans les deux sens. Une fois activé, un sens sans règle bloque les nouvelles connexions",[258,1065,1066],{},"Le HTTPS sortant d'un agent a alors besoin d'une règle",[243,1068,1069,1081],{},[258,1070,1071,1074,1075,1078,1079],{},[408,1072,1073],{},"Connexions par la console."," La console web se connecte en root depuis une adresse côté hôte (",[261,1076,1077],{},"172.16.0.x",") avec une clé temporaire, ou sur ",[261,1080,320],{},[258,1082,1083],{},"Une connexion root inhabituelle que le client a lancée",[243,1085,1086,1092],{},[258,1087,1088,1091],{},[408,1089,1090],{},"Mise à jour automatique."," Pilot se met à jour à 00:00 UTC et redémarre chaque Admin",[258,1093,1094],{},"Les chemins peuvent changer d'une version à l'autre",[243,1096,1097,1107],{},[258,1098,1099,1102,1103,1106],{},[408,1100,1101],{},"Adresses dans les journaux."," Pour les noms de la région, nginx voit l'adresse privée du proxy ; le client est dans ",[261,1104,1105],{},"X-Forwarded-For",". Pour un domaine personnalisé, il arrive dans l'en-tête PROXY protocol",[258,1108,1109,1110],{},"Ne vous fiez à ceux-ci que depuis le réseau du proxy, ",[261,1111,1112],{},"fdaa:\u003Cregion>::\u002F64",{"title":1114,"searchDepth":1115,"depth":1116,"links":1117},"",1,2,[1118,1125,1126,1127],{"id":229,"depth":1116,"text":230,"children":1119},[1120,1122,1123,1124],{"id":234,"depth":1121,"text":235},3,{"id":338,"depth":1121,"text":339},{"id":467,"depth":1121,"text":468},{"id":597,"depth":1121,"text":598},{"id":746,"depth":1116,"text":747},{"id":947,"depth":1116,"text":948},{"id":982,"depth":1116,"text":983},"Ce que Frappe Cloud v2 met sur le serveur d'un client, ce qui en sort, et ce que la plateforme voit de l'extérieur.","md",null,{},{"icon":38},{"title":205,"description":1128},"3aCPl9G3xOsou5VK4Im15SwZ3eviWzlJFbctav95Ses",[1136,1138],{"title":200,"path":201,"stem":202,"description":1137,"icon":203},"Sept choses qui se passent sur Frappe Cloud v2, saut par saut, avec l'application à chaque étape.",{"title":209,"path":210,"stem":211,"description":1139,"icon":117},"Ce que la lecture de Frappe Cloud v2 change pour Dodock Wolf, ce qu'il faut construire à côté, et ce qui reste à vérifier sur un vrai serveur.",1795107947039]