,259,260],"thead",{},[261,262,263,267],"tr",{},[264,265,266],"th",{},"Objet",[264,268,269],{},"DocTypes",[271,272,273,307,318,332,362,377,404],"tbody",{},[261,274,275,279],{},[276,277,278],"td",{},"Équipes et droits",[276,280,281,284,285,288,289,292,293,292,296,299,300,302,303,306],{},[236,282,283],{},"Team"," (avec un ",[236,286,287],{},"tenant_id"," immuable sur 32 bits ; 0 est réservé à la plateforme), ",[236,290,291],{},"Team Member",", ",[236,294,295],{},"Team Role",[236,297,298],{},"Capability"," (18, sur deux plans : ",[236,301,230],{}," et ",[236,304,305],{},"atlas",")",[261,308,309,312],{},[276,310,311],{},"Régions",[276,313,314,317],{},[236,315,316],{},"Region"," : l'adresse d'Atlas, le domaine du proxy, un secret de webhook pour Atlas et un pour Cargo, la source de données de télémétrie",[261,319,320,323],{},[276,321,322],{},"Clés",[276,324,325,328,329,306],{},[236,326,327],{},"Central SSO Settings"," : trois clés de signature (voir ",[222,330,196],{"href":331},"\u002Ffr\u002Finternals\u002Finterop#cl%C3%A9s",[261,333,334,337],{},[276,335,336],{},"Serveurs",[276,338,339,342,343,346,347,292,350,292,353,292,356,292,359],{},[236,340,341],{},"Virtual Machine"," (l'enregistrement d'un serveur côté Central), ",[236,344,345],{},"Resource Action"," (une ligne par création, démarrage, arrêt, redimensionnement, suppression), ",[236,348,349],{},"Pilot Credential",[236,351,352],{},"VM Snapshot",[236,354,355],{},"Team SSH Key",[236,357,358],{},"Firewall Ruleset",[236,360,361],{},"WireGuard Device",[261,363,364,367],{},[276,365,366],{},"Sites et routes",[276,368,369,372,373,376],{},[236,370,371],{},"Site"," (seulement le site intégré à une image d'essai), ",[236,374,375],{},"Site Domain"," (une route du proxy par nom d'hôte)",[261,378,379,382],{},[276,380,381],{},"Facturation",[276,383,384,385,292,388,292,391,292,394,292,397,292,400,403],{},"Environ 55 DocTypes : ",[236,386,387],{},"Plan",[236,389,390],{},"Subscription",[236,392,393],{},"Invoice",[236,395,396],{},"Usage Day",[236,398,399],{},"Usage Rollup",[236,401,402],{},"Credit Wallet","…",[261,405,406,409],{},[276,407,408],{},"Fil d'activité",[276,410,411,414,415,418,419],{},[236,412,413],{},"Activity Event"," (conservé 365 jours), ",[236,416,417],{},"Team Notification",", 49 ",[236,420,421],{},"Notification Event Type",[218,423,424,425,428],{},"Il n'y a ",[241,426,427],{},"ni DocType Bench ni enregistrement de déploiement",". Ce que fait tourner un serveur est l'affaire de Pilot.",[218,430,431],{},[241,432,433],{},"Accepte.",[255,435,436,449],{},[258,437,438],{},[261,439,440,443,446],{},[264,441,442],{},"De",[264,444,445],{},"Entrée",[264,447,448],{},"Authentifié par",[271,450,451,465,495,517,530,549,564],{},[261,452,453,456,462],{},[276,454,455],{},"Une personne",[276,457,458,459],{},"La console et ",[236,460,461],{},"central.api.{servers,sites,snapshots,teams,ssh_keys,wireguard,firewall_rulesets,activity,…}",[276,463,464],{},"Une session Frappe, puis une capacité",[261,466,467,470,488],{},[276,468,469],{},"Pilot",[276,471,472,292,475,478,479,292,482,292,485],{},[236,473,474],{},"central.api.pilot.*",[236,476,477],{},"central.notification.api.report_pilot_event",", environ 28 ",[236,480,481],{},"central.billing.api.billing_api.*",[236,483,484],{},"central.api.email_oauth.*",[236,486,487],{},"central.api.integrations.github.*",[276,489,490,491,494],{},"En-tête ",[236,492,493],{},"X-Pilot-Token"," : 48 caractères hexadécimaux ; Central n'en stocke que le SHA-256. L'équipe et le serveur viennent toujours de l'identifiant, jamais de la requête",[261,496,497,500,505],{},[276,498,499],{},"Atlas et Cargo",[276,501,502],{},[236,503,504],{},"central.api.state_delivery.receive",[276,506,507,292,510,292,513,516],{},[236,508,509],{},"X-FC-Source",[236,511,512],{},"X-FC-Region",[236,514,515],{},"X-Frappe-Webhook-Signature"," (HMAC-SHA256 avec un secret par région et par émetteur)",[261,518,519,522,527],{},[276,520,521],{},"N'importe qui",[276,523,524],{},[236,525,526],{},"central.api.jwks.get_jwks",[276,528,529],{},"Rien : des clés publiques",[261,531,532,535,540],{},[276,533,534],{},"Un service facturé à l'usage",[276,536,537],{},[236,538,539],{},"central.billing.api.metering.report",[276,541,542,292,545,548],{},[236,543,544],{},"X-Central-Service",[236,546,547],{},"X-Central-Signature"," (HMAC)",[261,550,551,554,559],{},[276,552,553],{},"Grove",[276,555,556],{},[236,557,558],{},"central.api.grove.datum_token",[276,560,561],{},[236,562,563],{},"X-Grove-Token",[261,565,566,569,572],{},[276,567,568],{},"Les passerelles de paiement, GitHub",[276,570,571],{},"Leurs webhooks",[276,573,574],{},"Leurs propres signatures",[218,576,577,580],{},[241,578,579],{},"Appelle."," Atlas, le proxy, la passerelle WireGuard et Cargo de chaque région ; Pilot sur chaque serveur, à travers le proxy ; Datum d'une région, pour ses propres erreurs et jauges ; Grove ; Stripe, Razorpay, PayPal ; GitHub ; un site Helpdesk pour les tickets de support. Central n'est sur le réseau privé d'aucune région et n'ouvre jamais de session SSH vers un serveur.",[218,582,583,586,587,590,591,594],{},[241,584,585],{},"À un client, elle donne"," la console : les serveurs (créer, démarrer, arrêter, redémarrer, redimensionner, renommer, supprimer, mode de secours), les jeux de règles de pare-feu, les adresses publiques, les appareils WireGuard, les clés SSH, une console web, les instantanés, « ouvrir le bench » et « se connecter au site en tant qu'Administrator », les buckets, les clés IA, la facturation, les rôles d'équipe. Elle ne donne aucune page de jetons d'API et n'envoie aucun webhook à un client. Une clé d'API Frappe ordinaire d'un membre d'équipe fonctionne bien sur ",[236,588,589],{},"central.api.*"," (",[236,592,593],{},"suite_cloud"," s'appuie dessus), mais rien dans la console n'en délivre.",[228,596,597],{"id":305},"Atlas",[218,599,600,601,604],{},"Le gestionnaire de machines virtuelles d'",[241,602,603],{},"une région avec un fournisseur"," (AWS, Scaleway ou du matériel génériq