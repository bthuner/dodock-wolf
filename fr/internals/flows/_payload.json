65,"path":66,"stem":67,"icon":68},"Commandes","\u002Ffr\u002Fagent\u002Fcommands","fr\u002F3.agent\u002F3.commands","i-lucide-terminal",{"title":70,"path":71,"stem":72,"icon":73},"Nettoyage","\u002Ffr\u002Fagent\u002Fscrubbing","fr\u002F3.agent\u002F4.scrubbing","i-lucide-eraser",{"title":75,"path":76,"stem":77,"icon":78},"Chien de garde","\u002Ffr\u002Fagent\u002Fwatchdog","fr\u002F3.agent\u002F5.watchdog","i-lucide-heart-pulse",{"title":80,"path":81,"stem":82,"icon":83},"Actions de réponse","\u002Ffr\u002Fagent\u002Fresponse-actions","fr\u002F3.agent\u002F6.response-actions","i-lucide-shield-ban",{"title":85,"icon":86,"path":87,"stem":88,"children":89,"page":49},"Alertes et incidents","i-lucide-bell","\u002Ffr\u002Falerts","fr\u002F4.alerts",[90,95,100,105],{"title":91,"path":92,"stem":93,"icon":94},"Règles d'alerte","\u002Ffr\u002Falerts\u002Frules","fr\u002F4.alerts\u002F1.rules","i-lucide-sliders-horizontal",{"title":96,"path":97,"stem":98,"icon":99},"Règles prédéfinies","\u002Ffr\u002Falerts\u002Fpresets","fr\u002F4.alerts\u002F2.presets","i-lucide-list-todo",{"title":101,"path":102,"stem":103,"icon":104},"Canaux","\u002Ffr\u002Falerts\u002Fchannels","fr\u002F4.alerts\u002F3.channels","i-lucide-send",{"title":106,"path":107,"stem":108,"icon":109},"Incidents","\u002Ffr\u002Falerts\u002Fincidents","fr\u002F4.alerts\u002F4.incidents","i-lucide-siren",{"title":111,"path":112,"stem":113,"children":114,"icon":117},"Sécurité","\u002Ffr\u002Fsecurity","fr\u002F5.security\u002F1.index",[115,118,123,128,133,138,143,147],{"title":116,"path":112,"stem":113,"icon":117},"Vue d'ensemble de la sécurité","i-lucide-shield",{"title":119,"path":120,"stem":121,"icon":122},"Signaux du site","\u002Ffr\u002Fsecurity\u002Fsite-signals","fr\u002F5.security\u002F2.site-signals","i-lucide-globe",{"title":124,"path":125,"stem":126,"icon":127},"Détection web et hôte","\u002Ffr\u002Fsecurity\u002Fdetection","fr\u002F5.security\u002F3.detection","i-lucide-radar",{"title":129,"path":130,"stem":131,"icon":132},"Accès et secrets","\u002Ffr\u002Fsecurity\u002Faccess","fr\u002F5.security\u002F4.access","i-lucide-key-round",{"title":134,"path":135,"stem":136,"icon":137},"Journal et leurres","\u002Ffr\u002Fsecurity\u002Fjournal","fr\u002F5.security\u002F5.journal","i-lucide-book-lock",{"title":139,"path":140,"stem":141,"icon":142},"Conformité et posture","\u002Ffr\u002Fsecurity\u002Fcompliance","fr\u002F5.security\u002F6.compliance","i-lucide-scale",{"title":144,"path":145,"stem":146,"icon":104},"Export SIEM","\u002Ffr\u002Fsecurity\u002Fsiem-export","fr\u002F5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh et Suricata","\u002Ffr\u002Fsecurity\u002Fwazuh-suricata","fr\u002F5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Référence","i-lucide-book-marked","\u002Ffr\u002Freference","fr\u002F6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Protocole de l'agent","\u002Ffr\u002Freference\u002Fprotocol","fr\u002F6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"API de l'UI","\u002Ffr\u002Freference\u002Fui-api","fr\u002F6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Stockage des métriques","\u002Ffr\u002Freference\u002Fmetric-storage","fr\u002F6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Ffr\u002Freference\u002Fperformance","fr\u002F6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Développement","\u002Ffr\u002Freference\u002Fdevelopment","fr\u002F6.reference\u002F5.development","i-lucide-code",{"title":183,"path":184,"stem":185,"children":186,"icon":189},"Coulisses","\u002Ffr\u002Finternals","fr\u002F7.internals\u002F1.index",[187,190,195,199,204,208],{"title":188,"path":184,"stem":185,"icon":189},"Frappe Cloud v2, lu dans son code","i-lucide-map",{"title":191,"path":192,"stem":193,"icon":194},"Les applications","\u002Ffr\u002Finternals\u002Fapps","fr\u002F7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Appels et confiance","\u002Ffr\u002Finternals\u002Finterop","fr\u002F7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flux","\u002Ffr\u002Finternals\u002Fflows","fr\u002F7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Dans un serveur client","\u002Ffr\u002Finternals\u002Fcustomer-server","fr\u002F7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes pour Wolf","\u002Ffr\u002Finternals\u002Fwolf","fr\u002F7.internals\u002F6.wolf",{"id":213,"title":200,"body":214,"description":768,"extension":769,"links":770,"meta":771,"navigation":772,"path":201,"seo":773,"stem":202,"__hash__":774},"docs_fr\u002Ffr\u002F7.internals\u002F4.flows.md",{"type":215,"value":216,"toc":756},"minimark",[217,225,230,362,373,377,449,453,528,532,578,581,585,640,644,698,702],[218,219,220,221,224],"p",{},"Chaque étape nomme l'application qui agit. Les jetons et les en-têtes sont dans ",[222,223,196],"a",{"href":197},".",[226,227,229],"h2",{"id":228},"un-serveur-est-créé","Un serveur est créé",[231,232,233,253,281,299,311,330,340,353],"ol",{},[234,235,236,240,241,245,246,249,250,224],"li",{},[237,238,239],"strong",{},"Console → Central."," Un membre de l'équipe appelle ",[242,243,244],"code",{},"central.api.servers.create_server",". Central vérifie la capacité ",[242,247,248],{},"server:create"," et le contrôle de facturation, puis stocke une ",[242,251,252],{},"Resource Action",[234,254,255,258,259,262,263,266,267,270,271,270,274,270,277,280],{},[237,256,257],{},"Central."," Pour une image étiquetée ",[242,260,261],{},"purpose=pilot",", Central crée le ",[242,264,265],{},"X-Pilot-Token"," du serveur et prépare les quatre attributs de métadonnées (",[242,268,269],{},"pilot-central",", ",[242,272,273],{},"pilot-common-site-config",[242,275,276],{},"pilot-common-config",[242,278,279],{},"pilot-config",").",[234,282,283,286,287,290,291,294,295,298],{},[237,284,285],{},"Central → Atlas."," ",[242,288,289],{},"POST \u002Fapi\u002Fatlas\u002Fvirtual-machines"," avec l'image, la taille, les clés SSH, le ",[242,292,293],{},"user_data"," du client, le pare-feu, la mise en veille sur inactivité, les métadonnées et ",[242,296,297],{},"X-Tenant-ID",". Une requête qui échoue en transit est marquée incertaine et n'est jamais renvoyée toute seule.",[234,300,301,307,308,310],{},[237,302,303,304,224],{},"Atlas → ",[242,305,306],{},"metald"," Atlas choisit un hôte. ",[242,309,306],{}," clone le disque de l'image (ZFS), construit l'espace de noms réseau, enregistre l'adresse privée, démarre un Firecracker emprisonné (jail) et remplit le service de métadonnées.",[234,312,313,286,316,319,320,322,323,326,327,224],{},[237,314,315],{},"Dans la machine.",[242,317,318],{},"atlas-metadata.service"," définit le nom d'hôte, l'adresse privée et les routes. cloud-init exécute le ",[242,321,293],{},". Le ",[242,324,325],{},"\u003Cbench>-central-bootstrap.service"," de Pilot interroge les métadonnées toutes les 0,1 seconde jusqu'à ce que l'identifiant soit là, applique les trois réglages une fois, stocke les clés de Central et définit ",[242,328,329],{},"central.bootstrapped",[234,331,332,335,336,339],{},[237,333,334],{},"Atlas → Central."," L'hôte est lu toutes les 10 secondes ; un changement d'état est publié en ",[242,337,338],{},"vm.state",". Central réconcilie aussi toutes les 10 minutes, ce qui répare un rapport manqué.",[234,341,342,345,346,349,350,280],{},[237,343,344],{},"Central → Pilot."," Central construit le nom ",[242,347,348],{},"admin-vm-\u003Clabel>.\u003Cregion domain>"," à partir de l'adresse privée de la machine et demande à Pilot de l'adopter (",[242,351,352],{},"POST \u002Fapi\u002Fv1\u002Fsettings\u002Fadmin-domain",[234,354,355,286,358,361],{},[237,356,357],{},"Pilot → Central.",[242,359,360],{},"datum_token"," (refusé tant que Central ne connaît pas l'identifiant Atlas de la machine), puis la télémétrie démarre.",[218,363,364,365,368,369,372],{},"Un essai suit le même flux avec une image chaude qui contient déjà un site (",[242,366,367],{},"has_site=1",", reprise depuis un instantané mémoire) : Central attend ",[242,370,371],{},"\u002Fapi\u002Fmethod\u002Fping"," sur le site, s'y connecte en tant qu'Administrator et met son renommage en file d'attente.",[226,374,376],{"id":375},"un-nom-dhôte-est-routé","Un nom d'hôte est routé",[231,378,379,387,401,417,429,443],{},[234,380,381,286,384,224],{},[237,382,383],{},"Le site ou l'Admin → Pilot.",[242,385,386],{},"POST \u002Fsites\u002F\u003Csite>\u002Fdomains",[234,388,389,392,393,396,397,400],{},[237,390,391],{},"Pilot → le programme de domaines."," Pilot lance ",[242,394,395],{},"bench-domain-provider generate-dns-records",", puis ",[242,398,399],{},"register \u003Cdomain>",". Sur Frappe Cloud v2, ce programme vient de l'image de Cargo.",[234,402,403,286,406,409,410,413,414,224],{},[237,404,405],{},"Le programme → Central.",[242,407,408],{},"central.api.pilot.domain_records"," : le client est invité à définir un CNAME vers ",[242,411,412],{},"proxy.\u003Cregion domain>"," et un enregistrement TXT ",[242,415,416],{},"_frappe-verification.\u003Cdomain>",[234,418,419,286,421,424,425,428],{},[237,420,405],{},[242,422,423],{},"central.api.pilot.register_domain",". Central vérifie l'enregistrement TXT, puis lit ",[242,426,427],{},"http:\u002F\u002F\u003Cdomain>\u002F.well-known\u002Ffrappe-pre-authorize\u002F"," pour voir que le nom arrive réellement au proxy de la région.",[234,430,431,434,435,438,439,442],{},[237,432,433],{},"Central → le proxy."," Central stocke un ",[242,436,437],{},"Site Domain"," et envoie ",[242,440,441],{},"PATCH \u002Fv1\u002Fdomains\u002F\u003Cdomain>",". Les routes en échec sont retentées toutes les 5 minutes.",[234,444,445,448],{},[237,446,447],{},"Pilot."," Il écrit le bloc serveur nginx et, pour un domaine personnalisé, obtient lui-même le certificat : le proxy transmet le TLS de ce domaine jusqu'au serveur.",[226,450,452],{"id":451},"un-nombre-quitte-un-serveur","Un nombre quitte un serveur",[231,454,455,468,477,493,506,515],{},[234,456,457,460,461,464,465,224],{},[237,458,459],{},"Cargo → Central."," Quand l'hôte Datum de la région est prêt, le webhook de Cargo rapporte ",[242,462,463],{},"telemetry: Available"," avec l'adresse ",[242,466,467],{},"http:\u002F\u002Finternal-telemetry-svc.\u003Cregion domain>",[234,469,470,473,474,476],{},[237,471,472],{},"Central → la machine."," Cette adresse est dans l'attribut ",[242,475,276],{}," de chaque nouveau serveur.",[234,478,479,286,481,484,485,488,489,492],{},[237,480,357],{},[242,482,483],{},"central.api.pilot.datum_token"," renvoie un jeton de 7 jours dont le ",[242,486,487],{},"resource_id"," est l'identifiant Atlas de la machine. Pilot le stocke dans ",[242,490,491],{},"[telemetry] token"," et redemande quand il reste 24 heures ou moins.",[234,494,495,286,498,501,502,505],{},[237,496,497],{},"Pilot → Datum.",[242,499,500],{},"pilot-monitor.service"," envoie ",[242,503,504],{},"pilot_sites"," toutes les 60 secondes et le reste toutes les 5 minutes, par le réseau privé.",[234,507,508,511,512,514],{},[237,509,510],{},"Datum → ClickHouse."," Datum vérifie le jeton avec les clés que Cargo publie, appose ",[242,513,487],{}," sur chaque ligne et insère.",[234,516,517,520,521,524,525,527],{},[237,518,519],{},"Beacon → ClickHouse."," Chaque minute, Beacon exécute les règles arrivées à échéance de ",[242,522,523],{},"pilot\u002Fbeacon\u002Frules\u002F",". Il écarte toute ligne dont le ",[242,526,487],{}," n'est pas une machine virtuelle de l'arbre qu'Atlas lui a donné, ou a moins de 10 minutes.",[226,529,531],{"id":530},"une-personne-est-appelée","Une personne est appelée",[231,533,534,544,549,555,561,567,573],{},[234,535,536,539,540,543],{},[237,537,538],{},"Beacon."," Une règle renvoie une ligne pour une ressource. L'alerte est Pending, puis Firing après le ",[242,541,542],{},"pending_for"," de la règle.",[234,545,546,548],{},[237,547,538],{}," L'alerte rejoint un incident ouvert qui couvre la ressource ou son parent, ou un incident de la même règle, ou bien un nouvel incident Internal est créé.",[234,550,551,554],{},[237,552,553],{},"Beacon → messagerie instantanée."," Chaque nouvel incident est publié sur le webhook de messagerie instantanée.",[234,556,557,560],{},[237,558,559],{},"Beacon → les intervenants."," Pour High ou Critical : un e-mail à tous les intervenants, et l'escalade. Elle démarre aussitôt quand la ressource n'a pas de parent, après 90 secondes sinon (pour que l'alerte d'un hôte puisse absorber celles de ses machines).",[234,562,563,566],{},[237,564,565],{},"Beacon → Twilio."," Le premier intervenant est appelé. Le suivant après 2 minutes (Critical) ou 5 (High). Après le dernier, un nouveau tour 15 minutes plus tard, jusqu'à ce que quelqu'un acquitte.",[234,568,569,572],{},[237,570,571],{},"Twilio → Beacon."," Un appel décroché acquitte l'incident au nom de cet intervenant.",[234,574,575,577],{},[237,576,538],{}," Quand toutes les alertes sont rétablies, Beacon ne résout l'incident que s'il est Internal et que Beacon l'a créé. Sinon, il demande à une personne de le faire.",[218,579,580],{},"Un seul site ou un seul serveur en échec n'est pas une alerte Beacon, par conception. Les règles de Pilot exigent 3 sites et 20 % des sites d'un serveur hors service, ou 5 serveurs et 10 % de la région avec des sauvegardes en échec. Une défaillance isolée prend l'autre chemin :",[226,582,584],{"id":583},"un-client-est-prévenu","Un client est prévenu",[231,586,587,595,604,634],{},[234,588,589,286,591,594],{},[237,590,447],{},[242,592,593],{},"pilot-monitor"," ou une tâche lève un événement : un site a échoué à ses pings pendant 1 minute ; le CPU, la mémoire ou le disque sont restés au-dessus de la limite pendant 5 minutes ; une sauvegarde, une migration ou un certificat a échoué.",[234,596,597,599,600,603],{},[237,598,447],{}," L'événement part vers le fil de l'Admin, vers chaque ",[242,601,602],{},"[[webhook_endpoints]]"," et par e-mail.",[234,605,606,286,608,611,612,270,615,270,618,270,621,270,624,270,627,270,630,633],{},[237,607,357],{},[242,609,610],{},"central.notification.api.report_pilot_event",", avec l'un des types d'événement que Central accepte d'un Pilot (",[242,613,614],{},"site_unavailable",[242,616,617],{},"site_recovered",[242,619,620],{},"backup_failure",[242,622,623],{},"migration_failure",[242,625,626],{},"certificate_expiry",[242,628,629],{},"certificate_failed",[242,631,632],{},"resource_limit_breached","…).",[234,635,636,639],{},[237,637,638],{},"Central → l'équipe."," Une notification dans la console et par e-mail.",[226,641,643],{"id":642},"une-image-est-construite","Une image est construite",[231,645,646,652,658,684,693],{},[234,647,648,651],{},[237,649,650],{},"Cargo → GitHub."," Toutes les 2 heures, Cargo associe la version la plus récente de Pilot à la tête de chaque branche de Frappe qu'il suit.",[234,653,654,657],{},[237,655,656],{},"Cargo → Atlas."," Il loue une machine de construction sur l'image Ubuntu de base.",[234,659,660,663,664,667,668,671,672,675,676,679,680,683],{},[237,661,662],{},"Cargo → la machine."," En SSH, ",[242,665,666],{},"provision.sh"," : l'utilisateur ",[242,669,670],{},"frappe",", Pilot, le bench ",[242,673,674],{},"default-bench",", Frappe à un commit fixe, ",[242,677,678],{},"site.local"," pour les images Site et Apps, le mode production, ",[242,681,682],{},"pilot setup central",", le programme de domaines. Aucun secret n'est dans l'environnement de ce script.",[234,685,686,688,689,692],{},[237,687,656],{}," Arrêt de la machine, puis ",[242,690,691],{},"POST …\u002Factions\u002Fsnapshot"," avec les étiquettes. Les images Base et Apps gardent aussi un instantané mémoire, pour qu'un serveur démarre à chaud.",[234,694,695,697],{},[237,696,285],{}," Central liste les images par étiquette quand un serveur est créé. Cargo garde les 3 constructions les plus récentes et supprime les images plus anciennes.",[226,699,701],{"id":700},"une-région-démarre","Une région démarre",[231,703,704,710,719,732,741,746],{},[234,705,706,709],{},[237,707,708],{},"Le personnel de Frappe → Atlas."," Les hôtes sont enrôlés ; le site Atlas tourne dans une machine sur l'un d'eux.",[234,711,712,715,716,280],{},[237,713,714],{},"Atlas → la machine de Cargo."," Atlas crée une machine de la plateforme, y installe Pilot, un bench et le site Cargo en SSH, et lui remet deux jetons de 365 jours (l'API d'Atlas en tant que locataire 0 ; le proxy, pour les noms finissant par ",[242,717,718],{},"-svc",[234,720,721,286,724,727,728,731],{},[237,722,723],{},"Atlas → le proxy.",[242,725,726],{},"cargo.\u003Cregion domain>"," et ",[242,729,730],{},"cargo-pilot.\u003Cregion domain>"," sont routés.",[234,733,734,286,737,740],{},[237,735,736],{},"Central → Cargo.",[242,738,739],{},"cargo.api.webhooks.configure"," donne à Cargo l'adresse et le secret pour ses rapports.",[234,742,743,745],{},[237,744,656],{}," Cargo loue les machines de la grappe Garage et de l'hôte Datum, et les installe en SSH.",[234,747,748,286,750,270,753,755],{},[237,749,459],{},[242,751,752],{},"storage: Available",[242,754,463],{},". Central marque le Cargo de la région comme enregistré au premier rapport.",{"title":757,"searchDepth":758,"depth":759,"links":760},"",1,2,[761,762,763,764,765,766,767],{"id":228,"depth":759,"text":229},{"id":375,"depth":759,"text":376},{"id":451,"depth":759,"text":452},{"id":530,"depth":759,"text":531},{"id":583,"depth":759,"text":584},{"id":642,"depth":759,"text":643},{"id":700,"depth":759,"text":701},"Sept choses qui se passent sur Frappe Cloud v2, saut par saut, avec l'application à chaque étape.","md",null,{},{"icon":203},{"title":200,"description":768},"knyngiaPhxlSmuCV12iXmH0QBQzSqaXOPFxp36pOzsQ",[776,778],{"title":196,"path":197,"stem":198,"description":777,"icon":132},"Chaque lien entre deux applications de Frappe Cloud v2, avec son en-tête, son jeton et sa durée de vie.",{"title":205,"path":206,"stem":207,"description":779,"icon":38},"Ce que Frappe Cloud v2 met sur le serveur d'un client, ce qui en sort, et ce que la plateforme voit de l'extérieur.",1795109742889]