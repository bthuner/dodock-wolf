:146,"icon":147},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":193,"title":96,"body":194,"description":1365,"extension":1366,"links":1367,"meta":1368,"navigation":1369,"path":97,"seo":1370,"stem":98,"__hash__":1371},"docs_en\u002F4.alerts\u002F1.rules.md",{"type":195,"value":196,"toc":1356},"minimark",[197,206,209,258,261,266,595,607,611,855,858,864,945,965,973,977,990,993,1015,1019,1034,1038,1044,1048,1051,1131,1145,1297,1352],[198,199,200,201,205],"p",{},"A ",[202,203,204],"strong",{},"Wolf Alert Rule"," reads a window of metrics or events every minute. When its condition holds, it\nopens one incident per group and notifies its channels.",[198,207,208],{},"The top of the form reads the rule back in plain words, and redraws it as you change a field or\na channel, before you save:",[210,211,212],"blockquote",{},[198,213,214,215,218,219,222,223,226,227,230,231,222,234,237,238,241,242,245,246,249,250,253,254,257],{},"Opens a ",[202,216,217],{},"critical"," incident when ",[202,220,221],{},"the lowest"," ",[202,224,225],{},"disk_used_percent"," over the last ",[202,228,229],{},"5 min","\nis ",[202,232,233],{},"above",[202,235,236],{},"90",", ",[202,239,240],{},"per host and series (a disk, a queue...)",". It needs at least ",[202,243,244],{},"3"," samples in the window. It\nresolves by itself once the condition no longer holds; if it matches again within ",[202,247,248],{},"1 h"," of being\nresolved, the same incident reopens. It notifies ",[202,251,252],{},"ntfy"," and ",[202,255,256],{},"Email",", and again when it resolves.",[198,259,260],{},"If the sentence is not what you meant, the rule is not either.",[262,263,265],"h2",{"id":264},"fields","Fields",[267,268,269,282],"table",{},[270,271,272],"thead",{},[273,274,275,279],"tr",{},[276,277,278],"th",{},"Field",[276,280,281],{},"Meaning",[283,284,285,317,347,384,415,425,435,461,471,485,499,509,519,529,539,550,560,577],"tbody",{},[273,286,287,293],{},[288,289,290],"td",{},[202,291,292],{},"Signal Type",[288,294,295,299,300,303,304,307,308,311,312,316],{},[296,297,298],"code",{},"metric",": aggregate metric samples (or their rollups for windows over 3 h, see ",[301,302,178],"a",{"href":179},"). ",[296,305,306],{},"event",": count Wolf Events. ",[296,309,310],{},"sequence",": an event followed by another on the same IP, user or host, see ",[301,313,315],{"href":314},"#sequence-rules","Sequence rules",".",[273,318,319,334],{},[288,320,321,324,325,237,328,237,331],{},[202,322,323],{},"Metric Name"," \u002F ",[202,326,327],{},"Event Type",[202,329,330],{},"Event Category",[202,332,333],{},"Min Severity",[288,335,336,337,340,341,324,344,316],{},"What to read. For example ",[296,338,339],{},"http_502",", or ",[296,342,343],{},"security",[296,345,346],{},"web_attack_probe",[273,348,349,354],{},[288,350,351],{},[202,352,353],{},"Aggregation",[288,355,356,237,359,237,362,237,365,237,368,237,371,374,375,377,378,380,381,316],{},[296,357,358],{},"avg",[296,360,361],{},"min",[296,363,364],{},"max",[296,366,367],{},"sum",[296,369,370],{},"count",[296,372,373],{},"last",". Use ",[296,376,361],{}," for \"stayed above for Z minutes\" and ",[296,379,367],{}," for counters such as ",[296,382,383],{},"http_5xx",[273,385,386,394],{},[288,387,388,237,391],{},[202,389,390],{},"Operator",[202,392,393],{},"Threshold",[288,395,396,237,399,237,402,237,405,237,408,237,411,414],{},[296,397,398],{},">",[296,400,401],{},">=",[296,403,404],{},"\u003C",[296,406,407],{},"\u003C=",[296,409,410],{},"==",[296,412,413],{},"!="," against a number.",[273,416,417,422],{},[288,418,419],{},[202,420,421],{},"Window Minutes",[288,423,424],{},"The look-back. Default 5.",[273,426,427,432],{},[288,428,429],{},[202,430,431],{},"Min Samples",[288,433,434],{},"Fewer samples in the window than this, and the rule does not breach.",[273,436,437,442],{},[288,438,439],{},[202,440,441],{},"Group By",[288,443,444,237,447,237,450,237,453,456,457,460],{},[296,445,446],{},"host",[296,448,449],{},"bench",[296,451,452],{},"site",[296,454,455],{},"host_label"," (for example per disk mount) or ",[296,458,459],{},"none",". One incident per group.",[273,462,463,468],{},[288,464,465],{},[202,466,467],{},"Filter Host \u002F Bench \u002F Site",[288,469,470],{},"Limit the rule to one scope.",[273,472,473,478],{},[288,474,475],{},[202,476,477],{},"Active From \u002F To",[288,479,480,481,484],{},"Only evaluate in this window. It may wrap midnight (",[296,482,483],{},"04:00 → 01:00",").",[273,486,487,492],{},[288,488,489],{},[202,490,491],{},"Require Recent Deployment",[288,493,494,495,498],{},"Only fire if a deployment hit the same bench, site or host in the last ",[202,496,497],{},"Deployment Window Minutes"," (30).",[273,500,501,506],{},[288,502,503],{},[202,504,505],{},"Fire \u002F Resolve After Evaluations",[288,507,508],{},"Consecutive breached (or clear) evaluations, one per scheduler tick, before an incident opens (or auto-resolves). Default 1.",[273,510,511,516],{},[288,512,513],{},[202,514,515],{},"Separate Resolve Threshold",[288,517,518],{},"Hysteresis: fire above 90, resolve only once at or below 80.",[273,520,521,526],{},[288,522,523],{},[202,524,525],{},"Cooldown Minutes",[288,527,528],{},"Re-fire into the just-resolved incident instead of opening a new one. An event rule reopens it only for an event newer than the resolution; a metric rule, while its window still breaches. Default 30.",[273,530,531,536],{},[288,532,533],{},[202,534,535],{},"Auto Resolve",[288,537,538],{},"Resolve the incident when the condition clears. Default on.",[273,540,541,545],{},[288,542,543],{},[202,544,106],{},[288,546,547,548,316],{},"Where alerts go. See ",[301,549,106],{"href":107},[273,551,552,557],{},[288,553,554],{},[202,555,556],{},"Notify On Resolve",[288,558,559],{},"Also tell the channels when the incident resolves, automatically or by hand. Default on. PagerDuty always hears it.",[273,561,562,570],{},[288,563,564,237,567],{},[202,565,566],{},"Escalate After Minutes",[202,568,569],{},"Escalation Channels",[288,571,572,573,576],{},"If still ",[296,574,575],{},"Open"," (not acknowledged) this long after the first alert, notify the escalation channels once.",[273,578,579,584],{},[288,580,581],{},[202,582,583],{},"Severity",[288,585,586,587,237,590,237,593,316],{},"Of the incident: ",[296,588,589],{},"info",[296,591,592],{},"warning",[296,594,217],{},[198,596,597,598,237,601,253,604,316],{},"The rule form shows ",[202,599,600],{},"Last Evaluated",[202,602,603],{},"Last Fired",[202,605,606],{},"Last Error",[262,608,610],{"id":609},"examples","Examples",[612,613,614,690,770],"tabs",{},[615,616,618,684],"tabs-item",{"label":617},"502 spike",[267,619,620,629],{},[270,621,622],{},[273,623,624,626],{},[276,625,278],{},[276,627,628],{},"Value",[283,630,631,639,647,655,667,676],{},[273,632,633,635],{},[288,634,292],{},[288,636,637],{},[296,638,298],{},[273,640,641,643],{},[288,642,323],{},[288,644,645],{},[296,646,339],{},[273,648,649,651],{},[288,650,353],{},[288,652,653],{},[296,654,367],{},[273,656,657,660],{},[288,658,659],{},"Operator, Threshold",[288,661,662,237,664],{},[296,663,401],{},[296,665,666],{},"10",[273,668,669,671],{},[288,670,421],{},[288,672,673],{},[296,674,675],{},"5",[273,677,678,680],{},[288,679,441],{},[288,681,682],{},[296,683,452],{},[198,685,686],{},[687,688,689],"em",{},"10 or more 502 responses on a site within 5 minutes.",[615,691,693,765],{"label":692},"Disk stayed full",[267,694,695,703],{},[270,696,697],{},[273,698,699,701],{},[276,700,278],{},[276,702,628],{},[283,704,705,713,721,729,739,748,756],{},[273,706,707,709],{},[288,708,292],{},[288,710,711],{},[296,712,298],{},[273,714,715,717],{},[288,716,323],{},[288,718,719],{},[296,720,225],{},[273,722,723,725],{},[288,724,353],{},[288,726,727],{},[296,728,361],{},[273,730,731,733],{},[288,732,659],{},[288,734,735,237,737],{},[296,736,398],{},[296,738,236],{},[273,740,741,743],{},[288,742,421],{},[288,744,745],{},[296,746,747],{},"15",[273,749,750,752],{},[288,751,441],{},[288,753,754],{},[296,755,455],{},[273,757,758,760],{},[288,759,515],{},[288,761,762],{},[296,763,764],{},"80",[198,766,767],{},[687,768,769],{},"Every sample of a mount above 90 % for 15 minutes. Resolves at or below 80 %.",[615,771,773,850],{"label":772},"Night cron",[267,774,775,783],{},[270,776,777],{},[273,778,779,781],{},[276,780,278],{},[276,782,628],{},[283,784,785,793,802,810,821,829,837],{},[273,786,787,789],{},[288,788,292],{},[288,790,791],{},[296,792,306],{},[273,794,795,797],{},[288,796,327],{},[288,798,799],{},[296,800,801],{},"cron_failure",[273,803,804,806],{},[288,805,353],{},[288,807,808],{},[296,809,370],{},[273,811,812,814],{},[288,813,659],{},[288,815,816,237,818],{},[296,817,401],{},[296,819,820],{},"1",[273,822,823,825],{},[288,824,421],{},[288,826,827],{},[296,828,666],{},[273,830,831,833],{},[288,832,441],{},[288,834,835],{},[296,836,452],{},[273,838,839,841],{},[288,840,477],{},[288,842,843,846,847],{},[296,844,845],{},"01:00"," → ",[296,848,849],{},"04:00",[198,851,852],{},[687,853,854],{},"Any failed scheduled job between 01:00 and 04:00.",[262,856,315],{"id":857},"sequence-rules",[198,859,860,861,863],{},"A rule of type ",[296,862,310],{}," fires when an event of one list of categories follows an event of another\non the same entity. For example: a web probe, then an SSH login from the same address within the hour.",[267,865,866,874],{},[270,867,868],{},[273,869,870,872],{},[276,871,278],{},[276,873,281],{},[283,875,876,888,898,908,935],{},[273,877,878,883],{},[288,879,880],{},[202,881,882],{},"First Event Categories",[288,884,885,886,316],{},"Categories of the first event, one per line, for example ",[296,887,346],{},[273,889,890,895],{},[288,891,892],{},[202,893,894],{},"First Event Min Severity",[288,896,897],{},"Only first events at or above this severity. The scope filters apply to the second event.",[273,899,900,905],{},[288,901,902],{},[202,903,904],{},"Then Event Categories",[288,906,907],{},"Categories of the event that must follow, one per line.",[273,909,910,915],{},[288,911,912],{},[202,913,914],{},"Same",[288,916,917,920,921,924,925,928,929,931,932,484],{},[296,918,919],{},"ip",": the second event's remote address (",[296,922,923],{},"payload.ip","), public only. ",[296,926,927],{},"user",": the same user on the same site. ",[296,930,446],{},": the same host under any of its names (",[202,933,934],{},"Wolf Entity Alias",[273,936,937,942],{},[288,938,939],{},[202,940,941],{},"Within Minutes",[288,943,944],{},"The longest gap between the two events. Default 60.",[946,947,948,952,959,962],"ul",{},[949,950,951],"li",{},"The threshold counts the second events seen in the window.",[949,953,954,955,958],{},"There is one incident per entity value (",[296,956,957],{},"ip 203.0.113.5","), scoped like its newest second event.",[949,960,961],{},"The gap runs from the first event's last occurrence to the second's latest, so repeats folded into\none record count. A brute force of thousands of first events is one candidate.",[949,963,964],{},"The incident links both events. An event already in another incident stays there, and the\nincident's timeline, which starts at the first event, shows it anyway.",[198,966,967,968,972],{},"Three ",[301,969,971],{"href":970},"\u002Falerts\u002Fpresets#sequences-across-sources","presets"," use it.",[262,974,976],{"id":975},"maintenance-windows","Maintenance windows",[198,978,200,979,982,983,237,986,989],{},[202,980,981],{},"Wolf Silence"," (host, bench, site and\u002For rule, ",[202,984,985],{},"Starts At",[202,987,988],{},"Ends At",") keeps incidents\nopening, so the timeline stays complete, but holds back their notifications. Incidents still open\nwhen the window ends are notified then.",[198,991,992],{},"Create one:",[946,994,995,1002,1009],{},[949,996,997,998,1001],{},"in Desk (",[202,999,1000],{},"Wolf Silence → New",");",[949,1003,1004,1005,1008],{},"through the REST API: ",[296,1006,1007],{},"POST \u002Fapi\u002Fresource\u002FWolf Silence",";",[949,1010,1011,1012,316],{},"with the deployment marker: ",[296,1013,1014],{},"wolf-agent mark-deployment --bench main --silence 15m",[262,1016,1018],{"id":1017},"digests","Digests",[198,1020,1021,1022,1025,1026,253,1028,1030,1031,1033],{},"Each channel row can use an ",[202,1023,1024],{},"hourly digest",": ",[296,1027,589],{},[296,1029,592],{}," alerts are batched into one\nmessage per destination. ",[296,1032,217],{}," alerts are always sent at once, and PagerDuty is never\ndigested.",[262,1035,1037],{"id":1036},"test-a-rule","Test a rule",[198,1039,1040,1043],{},[202,1041,1042],{},"Send test notification"," on the rule form sends a TEST to every enabled channel row and shows\nwhat each one answered.",[262,1045,1047],{"id":1046},"rules-as-yaml","Rules as YAML",[198,1049,1050],{},"Alert rules can live in a file: in git, reviewed in a pull request, copied from one Wolf site to another.",[1052,1053,1058],"pre",{"className":1054,"code":1055,"language":1056,"meta":1057,"style":1057},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","bench --site wolf.example.com wolf-rules export -o rules.yaml           # every rule; --rule NAME for some\nbench --site wolf.example.com wolf-rules import rules.yaml              # what it would change\nbench --site wolf.example.com wolf-rules import rules.yaml --apply      # write it\n","bash","",[296,1059,1060,1091,1110],{"__ignoreMap":1057},[1061,1062,1065,1068,1072,1075,1078,1081,1084,1087],"span",{"class":1063,"line":1064},"line",1,[1061,1066,449],{"class":1067},"sBMFI",[1061,1069,1071],{"class":1070},"sfazB"," --site",[1061,1073,1074],{"class":1070}," wolf.example.com",[1061,1076,1077],{"class":1070}," wolf-rules",[1061,1079,1080],{"class":1070}," export",[1061,1082,1083],{"class":1070}," -o",[1061,1085,1086],{"class":1070}," rules.yaml",[1061,1088,1090],{"class":1089},"sHwdD","           # every rule; --rule NAME for some\n",[1061,1092,1094,1096,1098,1100,1102,1105,1107],{"class":1063,"line":1093},2,[1061,1095,449],{"class":1067},[1061,1097,1071],{"class":1070},[1061,1099,1074],{"class":1070},[1061,1101,1077],{"class":1070},[1061,1103,1104],{"class":1070}," import",[1061,1106,1086],{"class":1070},[1061,1108,1109],{"class":1089},"              # what it would change\n",[1061,1111,1113,1115,1117,1119,1121,1123,1125,1128],{"class":1063,"line":1112},3,[1061,1114,449],{"class":1067},[1061,1116,1071],{"class":1070},[1061,1118,1074],{"class":1070},[1061,1120,1077],{"class":1070},[1061,1122,1104],{"class":1070},[1061,1124,1086],{"class":1070},[1061,1126,1127],{"class":1070}," --apply",[1061,1129,1130],{"class":1089},"      # write it\n",[198,1132,1133,1134,1136,1137,1140,1141,1144],{},"In Desk, the ",[202,1135,204],{}," list's menu has ",[202,1138,1139],{},"Export to YAML"," (the selected rules, or all) and ",[202,1142,1143],{},"Import from YAML",", which previews first and applies only after a second click. Both need the Wolf Manager or System Manager role.",[1052,1146,1151],{"className":1147,"code":1148,"filename":1149,"language":1150,"meta":1057,"style":1057},"language-yaml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","version: 1\nrules:\n- rule_name: Disk almost full\n  enabled: 1\n  severity: critical\n  metric_name: disk_used_percent\n  aggregation: min\n  threshold: 90\n  group_by: host_label\n  channels:\n  - channel_type: ntfy\n    ntfy_server: https:\u002F\u002Fntfy.example.com\n    ntfy_topic: ops\n","rules.yaml","yaml",[296,1152,1153,1167,1175,1188,1198,1209,1220,1231,1242,1253,1261,1275,1286],{"__ignoreMap":1057},[1061,1154,1155,1159,1163],{"class":1063,"line":1064},[1061,1156,1158],{"class":1157},"swJcz","version",[1061,1160,1162],{"class":1161},"sMK4o",":",[1061,1164,1166],{"class":1165},"sbssI"," 1\n",[1061,1168,1169,1172],{"class":1063,"line":1093},[1061,1170,1171],{"class":1157},"rules",[1061,1173,1174],{"class":1161},":\n",[1061,1176,1177,1180,1183,1185],{"class":1063,"line":1112},[1061,1178,1179],{"class":1161},"-",[1061,1181,1182],{"class":1157}," rule_name",[1061,1184,1162],{"class":1161},[1061,1186,1187],{"class":1070}," Disk almost full\n",[1061,1189,1191,1194,1196],{"class":1063,"line":1190},4,[1061,1192,1193],{"class":1157},"  enabled",[1061,1195,1162],{"class":1161},[1061,1197,1166],{"class":1165},[1061,1199,1201,1204,1206],{"class":1063,"line":1200},5,[1061,1202,1203],{"class":1157},"  severity",[1061,1205,1162],{"class":1161},[1061,1207,1208],{"class":1070}," critical\n",[1061,1210,1212,1215,1217],{"class":1063,"line":1211},6,[1061,1213,1214],{"class":1157},"  metric_name",[1061,1216,1162],{"class":1161},[1061,1218,1219],{"class":1070}," disk_used_percent\n",[1061,1221,1223,1226,1228],{"class":1063,"line":1222},7,[1061,1224,1225],{"class":1157},"  aggregation",[1061,1227,1162],{"class":1161},[1061,1229,1230],{"class":1070}," min\n",[1061,1232,1234,1237,1239],{"class":1063,"line":1233},8,[1061,1235,1236],{"class":1157},"  threshold",[1061,1238,1162],{"class":1161},[1061,1240,1241],{"class":1165}," 90\n",[1061,1243,1245,1248,1250],{"class":1063,"line":1244},9,[1061,1246,1247],{"class":1157},"  group_by",[1061,1249,1162],{"class":1161},[1061,1251,1252],{"class":1070}," host_label\n",[1061,1254,1256,1259],{"class":1063,"line":1255},10,[1061,1257,1258],{"class":1157},"  channels",[1061,1260,1174],{"class":1161},[1061,1262,1264,1267,1270,1272],{"class":1063,"line":1263},11,[1061,1265,1266],{"class":1161},"  -",[1061,1268,1269],{"class":1157}," channel_type",[1061,1271,1162],{"class":1161},[1061,1273,1274],{"class":1070}," ntfy\n",[1061,1276,1278,1281,1283],{"class":1063,"line":1277},12,[1061,1279,1280],{"class":1157},"    ntfy_server",[1061,1282,1162],{"class":1161},[1061,1284,1285],{"class":1070}," https:\u002F\u002Fntfy.example.com\n",[1061,1287,1289,1292,1294],{"class":1063,"line":1288},13,[1061,1290,1291],{"class":1157},"    ntfy_topic",[1061,1293,1162],{"class":1161},[1061,1295,1296],{"class":1070}," ops\n",[946,1298,1299,1309,1318,1324,1330,1336,1349],{},[949,1300,1301,1304,1305,1308],{},[202,1302,1303],{},"Field names"," are the rule form's own. A rule lists only what differs from the defaults, and on import ",[202,1306,1307],{},"a field the file leaves out goes back to its default",": the file says all of a rule.",[949,1310,1311,1317],{},[202,1312,1313,1314],{},"Matched by ",[296,1315,1316],{},"rule_name",": a new name creates a rule, an existing one is updated. Rules not in the file are left alone.",[949,1319,1320,1323],{},[202,1321,1322],{},"Secrets are never written",": chat webhook URLs, tokens, the PagerDuty routing key, the SMS secret, every password field. A file that holds one is refused, to keep them out of git. A generic Webhook's URL and an SMS auth header template are not secret fields: they are exported.",[949,1325,1326,1329],{},[202,1327,1328],{},"Channels keep their stored secrets."," On import a channel matches the existing row of its type with the same settings (Email recipients, ntfy server and topic, Matrix room, SMS URL and numbers…). Slack, Mattermost and PagerDuty rows have nothing but their secret to tell them apart: they match by position, and only when the file keeps as many of them. A channel that matches nothing is new: when it needs a secret it comes in disabled, to set it in the form and then enable it.",[949,1331,1332,1335],{},[202,1333,1334],{},"Nothing half-applied",": an unknown field (a typo), a value the field cannot take (a Select option it does not have, a number that is not one), a rule the form would refuse or a name used twice makes the import apply nothing, and says which rule and why.",[949,1337,1338,1025,1341,1344,1345,1348],{},[202,1339,1340],{},"Quote times",[296,1342,1343],{},"active_from: '22:00'",". YAML reads an unquoted ",[296,1346,1347],{},"22:00"," as a number, and the import refuses it.",[949,1350,1351],{},"The evaluator's own state (last evaluation, last fired, hysteresis counters) is never exported nor imported.",[1353,1354,1355],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}htm