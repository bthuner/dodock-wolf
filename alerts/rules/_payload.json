:146,"icon":147},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":193,"title":96,"body":194,"description":1005,"extension":1006,"links":1007,"meta":1008,"navigation":1009,"path":97,"seo":1010,"stem":98,"__hash__":1011},"docs_en\u002F4.alerts\u002F1.rules.md",{"type":195,"value":196,"toc":994},"minimark",[197,206,211,542,555,559,805,808,814,895,915,923,927,940,943,965,969,984,988],[198,199,200,201,205],"p",{},"A ",[202,203,204],"strong",{},"Wolf Alert Rule"," reads a window of metrics or events every minute. When its condition holds, it\nopens one incident per group and notifies its channels.",[207,208,210],"h2",{"id":209},"fields","Fields",[212,213,214,227],"table",{},[215,216,217],"thead",{},[218,219,220,224],"tr",{},[221,222,223],"th",{},"Field",[221,225,226],{},"Meaning",[228,229,230,262,293,330,361,371,381,407,417,431,445,455,465,475,485,496,506,523],"tbody",{},[218,231,232,238],{},[233,234,235],"td",{},[202,236,237],{},"Signal Type",[233,239,240,244,245,248,249,252,253,256,257,261],{},[241,242,243],"code",{},"metric",": aggregate metric samples (or their rollups for windows over 3 h, see ",[246,247,178],"a",{"href":179},"). ",[241,250,251],{},"event",": count Wolf Events. ",[241,254,255],{},"sequence",": an event followed by another on the same IP, user or host, see ",[246,258,260],{"href":259},"#sequence-rules","Sequence rules",".",[218,263,264,280],{},[233,265,266,269,270,273,274,273,277],{},[202,267,268],{},"Metric Name"," \u002F ",[202,271,272],{},"Event Type",", ",[202,275,276],{},"Event Category",[202,278,279],{},"Min Severity",[233,281,282,283,286,287,269,290,261],{},"What to read. For example ",[241,284,285],{},"http_502",", or ",[241,288,289],{},"security",[241,291,292],{},"web_attack_probe",[218,294,295,300],{},[233,296,297],{},[202,298,299],{},"Aggregation",[233,301,302,273,305,273,308,273,311,273,314,273,317,320,321,323,324,326,327,261],{},[241,303,304],{},"avg",[241,306,307],{},"min",[241,309,310],{},"max",[241,312,313],{},"sum",[241,315,316],{},"count",[241,318,319],{},"last",". Use ",[241,322,307],{}," for \"stayed above for Z minutes\" and ",[241,325,313],{}," for counters such as ",[241,328,329],{},"http_5xx",[218,331,332,340],{},[233,333,334,273,337],{},[202,335,336],{},"Operator",[202,338,339],{},"Threshold",[233,341,342,273,345,273,348,273,351,273,354,273,357,360],{},[241,343,344],{},">",[241,346,347],{},">=",[241,349,350],{},"\u003C",[241,352,353],{},"\u003C=",[241,355,356],{},"==",[241,358,359],{},"!="," against a number.",[218,362,363,368],{},[233,364,365],{},[202,366,367],{},"Window Minutes",[233,369,370],{},"The look-back. Default 5.",[218,372,373,378],{},[233,374,375],{},[202,376,377],{},"Min Samples",[233,379,380],{},"Fewer samples in the window than this, and the rule does not breach.",[218,382,383,388],{},[233,384,385],{},[202,386,387],{},"Group By",[233,389,390,273,393,273,396,273,399,402,403,406],{},[241,391,392],{},"host",[241,394,395],{},"bench",[241,397,398],{},"site",[241,400,401],{},"host_label"," (for example per disk mount) or ",[241,404,405],{},"none",". One incident per group.",[218,408,409,414],{},[233,410,411],{},[202,412,413],{},"Filter Host \u002F Bench \u002F Site",[233,415,416],{},"Limit the rule to one scope.",[218,418,419,424],{},[233,420,421],{},[202,422,423],{},"Active From \u002F To",[233,425,426,427,430],{},"Only evaluate in this window. It may wrap midnight (",[241,428,429],{},"04:00 → 01:00",").",[218,432,433,438],{},[233,434,435],{},[202,436,437],{},"Require Recent Deployment",[233,439,440,441,444],{},"Only fire if a deployment hit the same bench, site or host in the last ",[202,442,443],{},"Deployment Window Minutes"," (30).",[218,446,447,452],{},[233,448,449],{},[202,450,451],{},"Fire \u002F Resolve After Evaluations",[233,453,454],{},"Consecutive breached (or clear) evaluations, one per scheduler tick, before an incident opens (or auto-resolves). Default 1.",[218,456,457,462],{},[233,458,459],{},[202,460,461],{},"Separate Resolve Threshold",[233,463,464],{},"Hysteresis: fire above 90, resolve only once at or below 80.",[218,466,467,472],{},[233,468,469],{},[202,470,471],{},"Cooldown Minutes",[233,473,474],{},"Re-fire into the just-resolved incident instead of opening a new one. An event rule reopens it only for an event newer than the resolution; a metric rule, while its window still breaches. Default 30.",[218,476,477,482],{},[233,478,479],{},[202,480,481],{},"Auto Resolve",[233,483,484],{},"Resolve the incident when the condition clears. Default on.",[218,486,487,491],{},[233,488,489],{},[202,490,106],{},[233,492,493,494,261],{},"Where alerts go. See ",[246,495,106],{"href":107},[218,497,498,503],{},[233,499,500],{},[202,501,502],{},"Notify On Resolve",[233,504,505],{},"Also tell the channels when the incident resolves, automatically or by hand. Default on. PagerDuty always hears it.",[218,507,508,516],{},[233,509,510,273,513],{},[202,511,512],{},"Escalate After Minutes",[202,514,515],{},"Escalation Channels",[233,517,518,519,522],{},"If still ",[241,520,521],{},"Open"," (not acknowledged) this long after the first alert, notify the escalation channels once.",[218,524,525,530],{},[233,526,527],{},[202,528,529],{},"Severity",[233,531,532,533,273,536,273,539,261],{},"Of the incident: ",[241,534,535],{},"info",[241,537,538],{},"warning",[241,540,541],{},"critical",[198,543,544,545,273,548,551,552,261],{},"The rule form shows ",[202,546,547],{},"Last Evaluated",[202,549,550],{},"Last Fired"," and ",[202,553,554],{},"Last Error",[207,556,558],{"id":557},"examples","Examples",[560,561,562,638,720],"tabs",{},[563,564,566,632],"tabs-item",{"label":565},"502 spike",[212,567,568,577],{},[215,569,570],{},[218,571,572,574],{},[221,573,223],{},[221,575,576],{},"Value",[228,578,579,587,595,603,615,624],{},[218,580,581,583],{},[233,582,237],{},[233,584,585],{},[241,586,243],{},[218,588,589,591],{},[233,590,268],{},[233,592,593],{},[241,594,285],{},[218,596,597,599],{},[233,598,299],{},[233,600,601],{},[241,602,313],{},[218,604,605,608],{},[233,606,607],{},"Operator, Threshold",[233,609,610,273,612],{},[241,611,347],{},[241,613,614],{},"10",[218,616,617,619],{},[233,618,367],{},[233,620,621],{},[241,622,623],{},"5",[218,625,626,628],{},[233,627,387],{},[233,629,630],{},[241,631,398],{},[198,633,634],{},[635,636,637],"em",{},"10 or more 502 responses on a site within 5 minutes.",[563,639,641,715],{"label":640},"Disk stayed full",[212,642,643,651],{},[215,644,645],{},[218,646,647,649],{},[221,648,223],{},[221,650,576],{},[228,652,653,661,670,678,689,698,706],{},[218,654,655,657],{},[233,656,237],{},[233,658,659],{},[241,660,243],{},[218,662,663,665],{},[233,664,268],{},[233,666,667],{},[241,668,669],{},"disk_used_percent",[218,671,672,674],{},[233,673,299],{},[233,675,676],{},[241,677,307],{},[218,679,680,682],{},[233,681,607],{},[233,683,684,273,686],{},[241,685,344],{},[241,687,688],{},"90",[218,690,691,693],{},[233,692,367],{},[233,694,695],{},[241,696,697],{},"15",[218,699,700,702],{},[233,701,387],{},[233,703,704],{},[241,705,401],{},[218,707,708,710],{},[233,709,461],{},[233,711,712],{},[241,713,714],{},"80",[198,716,717],{},[635,718,719],{},"Every sample of a mount above 90 % for 15 minutes. Resolves at or below 80 %.",[563,721,723,800],{"label":722},"Night cron",[212,724,725,733],{},[215,726,727],{},[218,728,729,731],{},[221,730,223],{},[221,732,576],{},[228,734,735,743,752,760,771,779,787],{},[218,736,737,739],{},[233,738,237],{},[233,740,741],{},[241,742,251],{},[218,744,745,747],{},[233,746,272],{},[233,748,749],{},[241,750,751],{},"cron_failure",[218,753,754,756],{},[233,755,299],{},[233,757,758],{},[241,759,316],{},[218,761,762,764],{},[233,763,607],{},[233,765,766,273,768],{},[241,767,347],{},[241,769,770],{},"1",[218,772,773,775],{},[233,774,367],{},[233,776,777],{},[241,778,614],{},[218,780,781,783],{},[233,782,387],{},[233,784,785],{},[241,786,398],{},[218,788,789,791],{},[233,790,423],{},[233,792,793,796,797],{},[241,794,795],{},"01:00"," → ",[241,798,799],{},"04:00",[198,801,802],{},[635,803,804],{},"Any failed scheduled job between 01:00 and 04:00.",[207,806,260],{"id":807},"sequence-rules",[198,809,810,811,813],{},"A rule of type ",[241,812,255],{}," fires when an event of one list of categories follows an event of another\non the same entity. For example: a web probe, then an SSH login from the same address within the hour.",[212,815,816,824],{},[215,817,818],{},[218,819,820,822],{},[221,821,223],{},[221,823,226],{},[228,825,826,838,848,858,885],{},[218,827,828,833],{},[233,829,830],{},[202,831,832],{},"First Event Categories",[233,834,835,836,261],{},"Categories of the first event, one per line, for example ",[241,837,292],{},[218,839,840,845],{},[233,841,842],{},[202,843,844],{},"First Event Min Severity",[233,846,847],{},"Only first events at or above this severity. The scope filters apply to the second event.",[218,849,850,855],{},[233,851,852],{},[202,853,854],{},"Then Event Categories",[233,856,857],{},"Categories of the event that must follow, one per line.",[218,859,860,865],{},[233,861,862],{},[202,863,864],{},"Same",[233,866,867,870,871,874,875,878,879,881,882,430],{},[241,868,869],{},"ip",": the second event's remote address (",[241,872,873],{},"payload.ip","), public only. ",[241,876,877],{},"user",": the same user on the same site. ",[241,880,392],{},": the same host under any of its names (",[202,883,884],{},"Wolf Entity Alias",[218,886,887,892],{},[233,888,889],{},[202,890,891],{},"Within Minutes",[233,893,894],{},"The longest gap between the two events. Default 60.",[896,897,898,902,909,912],"ul",{},[899,900,901],"li",{},"The threshold counts the second events seen in the window.",[899,903,904,905,908],{},"There is one incident per entity value (",[241,906,907],{},"ip 203.0.113.5","), scoped like its newest second event.",[899,910,911],{},"The gap runs from the first event's last occurrence to the second's latest, so repeats folded into\none record count. A brute force of thousands of first events is one candidate.",[899,913,914],{},"The incident links both events. An event already in another incident stays there, and the\nincident's timeline, which starts at the first event, shows it anyway.",[198,916,917,918,922],{},"Three ",[246,919,921],{"href":920},"\u002Falerts\u002Fpresets#sequences-across-sources","presets"," use it.",[207,924,926],{"id":925},"maintenance-windows","Maintenance windows",[198,928,200,929,932,933,273,936,939],{},[202,930,931],{},"Wolf Silence"," (host, bench, site and\u002For rule, ",[202,934,935],{},"Starts At",[202,937,938],{},"Ends At",") keeps incidents\nopening, so the timeline stays complete, but holds back their notifications. Incidents still open\nwhen the window ends are notified then.",[198,941,942],{},"Create one:",[896,944,945,952,959],{},[899,946,947,948,951],{},"in Desk (",[202,949,950],{},"Wolf Silence → New",");",[899,953,954,955,958],{},"through the REST API: ",[241,956,957],{},"POST \u002Fapi\u002Fresource\u002FWolf Silence",";",[899,960,961,962,261],{},"with the deployment marker: ",[241,963,964],{},"wolf-agent mark-deployment --bench main --silence 15m",[207,966,968],{"id":967},"digests","Digests",[198,970,971,972,975,976,551,978,980,981,983],{},"Each channel row can use an ",[202,973,974],{},"hourly digest",": ",[241,977,535],{},[241,979,538],{}," alerts are batched into one\nmessage per destination. ",[241,982,541],{}," alerts are always sent at once, and PagerDuty is never\ndigested.",[207,985,987],{"id":986},"test-a-rule","Test a rule",[198,989,990,993],{},[202,991,992],{},"Send test notification"," on the rule form sends a TEST to every enabled channel row and shows\nwhat each one answered.",{"title":995,"searchDepth":996,"depth":997,"links":998},"",1,2,[999,1000,1001,1002,1003,1004],{"id":209,"depth":997,"text":210},{"id":557,"depth":997,"text":558},{"id":807,"depth":997,"text":260},{"id":925,"depth":997,"text":926},{"id":967,"depth":997,"text":968},{"id":986,"depth":997,"text":987},"Write a rule that reads like the brief - when X > Y for Z minutes, send alert.","md",null,{},{"icon":99},{"title":96,"description":1005},"Tg50U8qMZtUtiHlcxtqR9CHkDkcQ6ifPZWw_OVtexOA",[1013,1015],{"title":85,"path":86,"stem":87,"description":1014,"icon":88},"Block an attacking IP on the host, disable a user or revoke sessions, after a Wolf Manager approves. Off by default.",{"title":101,"path":102,"stem":103,"description":1016,"icon":104},"The rules installed with the app, what each one watches, and when it fires.",1794957837892]