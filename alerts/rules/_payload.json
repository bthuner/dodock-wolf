gPkA",[1373,1375],{"title":85,"path":86,"stem":87,"description":1374,"icon":88},"Block an attacking IP on the host, disable a user or revoke sessions, after a Wolf Manager approves. Off by default.",{"title":101,"path":102,"stem":103,"description":1376,"icon":104},"The rules installed with the app, what each one watches, and when it fires.",1795042370670]