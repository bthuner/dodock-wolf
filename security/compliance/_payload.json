[{"data":1,"prerenderedAt":979},["ShallowReactive",2],{"navigation-en":3,"\u002Fsecurity\u002Fcompliance":182,"\u002Fsecurity\u002Fcompliance-surround":974},[4,23,50,84,110,151],{"title":5,"path":6,"stem":7,"children":8,"icon":22},"Getting started","\u002Fgetting-started","1.getting-started\u002F1.index",[9,12,17],{"title":10,"path":6,"stem":7,"icon":11},"Introduction","i-lucide-house",{"title":13,"path":14,"stem":15,"icon":16},"Quickstart","\u002Fgetting-started\u002Fquickstart","1.getting-started\u002F2.quickstart","i-lucide-timer",{"title":18,"path":19,"stem":20,"icon":21},"Concepts","\u002Fgetting-started\u002Fconcepts","1.getting-started\u002F3.concepts","i-lucide-shapes","i-lucide-rocket",{"title":24,"icon":25,"path":26,"stem":27,"children":28,"page":49},"Install","i-lucide-download","\u002Finstall","2.install",[29,34,39,44],{"title":30,"path":31,"stem":32,"icon":33},"Wolf App","\u002Finstall\u002Fwolf-app","2.install\u002F1.wolf-app","i-lucide-app-window",{"title":35,"path":36,"stem":37,"icon":38},"Wolf Agent","\u002Finstall\u002Fwolf-agent","2.install\u002F2.wolf-agent","i-lucide-server",{"title":40,"path":41,"stem":42,"icon":43},"Every site on a bench","\u002Finstall\u002Fevery-site","2.install\u002F3.every-site","i-lucide-network",{"title":45,"path":46,"stem":47,"icon":48},"Pilot benches","\u002Finstall\u002Fpilot","2.install\u002F5.pilot","i-lucide-plane",false,{"title":35,"icon":38,"path":51,"stem":52,"children":53,"page":49},"\u002Fagent","3.agent",[54,59,64,69,74,79],{"title":55,"path":56,"stem":57,"icon":58},"What is collected","\u002Fagent\u002Fcollected","3.agent\u002F1.collected","i-lucide-list-checks",{"title":60,"path":61,"stem":62,"icon":63},"Configuration","\u002Fagent\u002Fconfiguration","3.agent\u002F2.configuration","i-lucide-settings",{"title":65,"path":66,"stem":67,"icon":68},"Commands","\u002Fagent\u002Fcommands","3.agent\u002F3.commands","i-lucide-terminal",{"title":70,"path":71,"stem":72,"icon":73},"Scrubbing","\u002Fagent\u002Fscrubbing","3.agent\u002F4.scrubbing","i-lucide-eraser",{"title":75,"path":76,"stem":77,"icon":78},"Watchdog","\u002Fagent\u002Fwatchdog","3.agent\u002F5.watchdog","i-lucide-heart-pulse",{"title":80,"path":81,"stem":82,"icon":83},"Response actions","\u002Fagent\u002Fresponse-actions","3.agent\u002F6.response-actions","i-lucide-shield-ban",{"title":85,"icon":86,"path":87,"stem":88,"children":89,"page":49},"Alerts and incidents","i-lucide-bell","\u002Falerts","4.alerts",[90,95,100,105],{"title":91,"path":92,"stem":93,"icon":94},"Alert rules","\u002Falerts\u002Frules","4.alerts\u002F1.rules","i-lucide-sliders-horizontal",{"title":96,"path":97,"stem":98,"icon":99},"Preset rules","\u002Falerts\u002Fpresets","4.alerts\u002F2.presets","i-lucide-list-todo",{"title":101,"path":102,"stem":103,"icon":104},"Channels","\u002Falerts\u002Fchannels","4.alerts\u002F3.channels","i-lucide-send",{"title":106,"path":107,"stem":108,"icon":109},"Incidents","\u002Falerts\u002Fincidents","4.alerts\u002F4.incidents","i-lucide-siren",{"title":111,"path":112,"stem":113,"children":114,"icon":117},"Security","\u002Fsecurity","5.security\u002F1.index",[115,118,123,128,133,138,143,147],{"title":116,"path":112,"stem":113,"icon":117},"Security overview","i-lucide-shield",{"title":119,"path":120,"stem":121,"icon":122},"Site signals","\u002Fsecurity\u002Fsite-signals","5.security\u002F2.site-signals","i-lucide-globe",{"title":124,"path":125,"stem":126,"icon":127},"Web and host detection","\u002Fsecurity\u002Fdetection","5.security\u002F3.detection","i-lucide-radar",{"title":129,"path":130,"stem":131,"icon":132},"Access and secrets","\u002Fsecurity\u002Faccess","5.security\u002F4.access","i-lucide-key-round",{"title":134,"path":135,"stem":136,"icon":137},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":139,"path":140,"stem":141,"icon":142},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":144,"path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":183,"title":139,"body":184,"description":967,"extension":968,"links":969,"meta":970,"navigation":971,"path":140,"seo":972,"stem":141,"__hash__":973},"docs_en\u002F5.security\u002F6.compliance.md",{"type":185,"value":186,"toc":948},"minimark",[187,192,210,216,221,232,312,336,340,354,357,414,430,434,446,450,456,460,472,480,487,499,503,516,533,536,540,550,735,771,775,883,887,936,940],[188,189,191],"h2",{"id":190},"regulatory-reporting","Regulatory reporting",[193,194,195,196,200,201,205,206,209],"p",{},"A ",[197,198,199],"strong",{},"Wolf Incident"," has a section ",[202,203,204],"em",{},"Regulatory reporting (NIS2 \u002F DORA \u002F GDPR)"," with three flags.\nEach flag starts its own deadlines. The deadlines are shown on the incident, in Desk and in the\nWolf UI. For the rest of the incident workflow, see ",[207,208,106],"a",{"href":107},".",[211,212,213],"caution",{},[193,214,215],{},"Wolf tracks dates only. It does not decide whether an incident is significant, major or a\nbreach, and it sends nothing to an authority.",[217,218,220],"h3",{"id":219},"nis2-article-23","NIS2 Article 23",[193,222,223,224,227,228,231],{},"Tick ",[197,225,226],{},"Significant incident (NIS2 Art. 23)",". ",[197,229,230],{},"Aware since (NIS2)"," is set to now; correct it if\nyou learnt of the incident earlier.",[233,234,235,251],"table",{},[236,237,238],"thead",{},[239,240,241,245,248],"tr",{},[242,243,244],"th",{},"Obligation",[242,246,247],{},"Due",[242,249,250],{},"Record when sent",[252,253,254,271,286,299],"tbody",{},[239,255,256,260,266],{},[257,258,259],"td",{},"Early warning to the CSIRT or authority",[257,261,262,263],{},"24 h after ",[202,264,265],{},"Aware since",[257,267,268],{},[197,269,270],{},"Early warning sent at",[239,272,273,276,281],{},[257,274,275],{},"Incident notification",[257,277,278,279],{},"72 h after ",[202,280,265],{},[257,282,283],{},[197,284,285],{},"Incident notification sent at",[239,287,288,291,294],{},[257,289,290],{},"Final report",[257,292,293],{},"one month after the notification",[257,295,296],{},[197,297,298],{},"Final report sent at",[239,300,301,304,307],{},[257,302,303],{},"Intermediate report (Art. 23(4)(c))",[257,305,306],{},"the deadline the CSIRT or authority gave",[257,308,309],{},[197,310,311],{},"Intermediate report sent at",[313,314,315,322,333],"ul",{},[316,317,318,319,209],"li",{},"Until the notification is sent, the final report counts from the notification's deadline and\nis marked ",[202,320,321],{},"estimated",[316,323,324,325,328,329,332],{},"An intermediate report is only due when the CSIRT or the authority asks for one. Record\n",[197,326,327],{},"Intermediate report requested at"," and, if they gave one, ",[197,330,331],{},"Intermediate report due by",".\nWithout a deadline it is listed \"as asked\" and never reminded.",[316,334,335],{},"Art. 23(4)(e): while the incident is still open, the report draft reminds you that an ongoing\nincident gets a progress report at the final report's date, and the final report one month\nafter it is handled.",[217,337,339],{"id":338},"dora-article-19","DORA Article 19",[193,341,342,343,227,346,349,350,353],{},"For financial entities. Tick ",[197,344,345],{},"Major ICT-related incident (DORA Art. 19)",[197,347,348],{},"Aware since (DORA)","\nand ",[197,351,352],{},"Classified as major at"," are both set to now; correct them if needed.",[193,355,356],{},"The time limits follow Delegated Regulation (EU) 2025\u002F301, Art. 5:",[233,358,359,369],{},[236,360,361],{},[239,362,363,365,367],{},[242,364,244],{},[242,366,247],{},[242,368,250],{},[252,370,371,391,403],{},[239,372,373,376,386],{},[257,374,375],{},"Initial notification",[257,377,378,379,382,383,385],{},"4 h after ",[202,380,381],{},"Classified as major",", and no later than 24 h after ",[202,384,265],{},". A classification made later than those 24 h gives 4 h from the classification",[257,387,388],{},[197,389,390],{},"Initial notification sent at",[239,392,393,396,399],{},[257,394,395],{},"Intermediate report",[257,397,398],{},"72 h after the initial notification",[257,400,401],{},[197,402,311],{},[239,404,405,407,410],{},[257,406,290],{},[257,408,409],{},"one month after the latest intermediate report",[257,411,412],{},[197,413,298],{},[313,415,416,421,424,427],{},[316,417,418,419,209],{},"Until a report is sent, the next one counts from its deadline and is marked ",[202,420,321],{},[316,422,423],{},"Record the latest intermediate report: an updated one moves the final report's deadline.",[316,425,426],{},"The weekend and bank holiday extension of Art. 5(4) is not applied. It depends on the entity\nand its Member State, and an earlier deadline is always met.",[316,428,429],{},"DORA reports go through the authority's own templates. The report draft is a starting point.",[217,431,433],{"id":432},"gdpr-article-33","GDPR Article 33",[193,435,223,436,227,439,442,443,209],{},[197,437,438],{},"Personal data breach (GDPR Art. 33)",[197,440,441],{},"Aware since (GDPR)"," is set to now. The\nnotification to the supervisory authority (CNIL in France) is due 72 h after it. Record it in\n",[197,444,445],{},"Authority notified at",[217,447,449],{"id":448},"shared-fields","Shared fields",[193,451,452,455],{},[197,453,454],{},"Authority reference"," records the reference the authority gave. It appears in the report draft.",[217,457,459],{"id":458},"deadline-alerts","Deadline alerts",[193,461,462,463,467,468,471],{},"Every 5 minutes, the ",[464,465,466],"code",{},"check_deadlines"," job records one ",[464,469,470],{},"regulatory_deadline"," event per obligation:",[313,473,474,477],{},[316,475,476],{},"when it is due within 6 h;",[316,478,479],{},"again when it is overdue.",[193,481,482,483,486],{},"Each event is linked to the incident, so it is on its timeline, with a comment. The\n",[197,484,485],{},"Regulatory deadline"," preset alerts on them (critical).",[488,489,490],"warning",{},[193,491,492,493,495,496,209],{},"Like every preset, ",[202,494,485],{}," has no channels. Add the channels of whoever reports to\nthe CSIRT or the CNIL, or the reminders reach nobody. See ",[207,497,498],{"href":97},"Presets",[217,500,502],{"id":501},"report-draft","Report draft",[193,504,505,508,509,512,513,515],{},[197,506,507],{},"Regulatory report"," (Desk → ",[197,510,511],{},"Actions",") or ",[197,514,502],{}," (Wolf UI) builds a Markdown draft:",[313,517,518,521,524,527,530],{},[316,519,520],{},"the facts: incident, scope, severity, status, start and resolution times, authority reference,\nthe flags and their dates;",[316,522,523],{},"the deadlines, with what was sent and when;",[316,525,526],{},"the incident summary;",[316,528,529],{},"the postmortem's impact, root cause, lessons and measures, when there is one;",[316,531,532],{},"the timeline: events and comments.",[193,534,535],{},"It is a starting point for the authority's form. Check every fact before sending it.",[188,537,539],{"id":538},"security-score","Security score",[193,541,542,545,546,549],{},[197,543,544],{},"Wolf → Security"," (",[464,547,548],{},"\u002Fwolf\u002Fsecurity",") shows a score out of 100 per site, with every check, what\nWolf read and the fix.",[233,551,552,565],{},[236,553,554],{},[239,555,556,559,562],{},[242,557,558],{},"Check",[242,560,561],{},"Weight",[242,563,564],{},"Read from",[252,566,567,581,592,602,611,627,641,653,665,677,694,722],{},[239,568,569,572,575],{},[257,570,571],{},"Two-factor authentication for System Managers (global switch and the role)",[257,573,574],{},"3",[257,576,577,578],{},"System Settings and Role: on the Wolf site itself, else the agent's ",[464,579,580],{},"site_setting",[239,582,583,586,589],{},[257,584,585],{},"Password policy, minimum score 3",[257,587,588],{},"2",[257,590,591],{},"System Settings (as above)",[239,593,594,597,600],{},[257,595,596],{},"Lockout after 1–10 failed logins",[257,598,599],{},"1",[257,601,591],{},[239,603,604,607,609],{},[257,605,606],{},"Guests cannot upload files",[257,608,599],{},[257,610,591],{},[239,612,613,619,621],{},[257,614,615,616],{},"No development settings in ",[464,617,618],{},"site_config.json",[257,620,574],{},[257,622,623,624],{},"the site config on the Wolf site, else the agent's ",[464,625,626],{},"site_config_risks",[239,628,629,632,634],{},[257,630,631],{},"Bench services not listening beyond loopback",[257,633,574],{},[257,635,636,637,640],{},"the agent's ",[464,638,639],{},"exposed_services"," on the site's hosts",[239,642,643,646,648],{},[257,644,645],{},"A backup newer than 26 h",[257,647,588],{},[257,649,650],{},[464,651,652],{},"backup_age_hours",[239,654,655,658,660],{},[257,656,657],{},"TLS certificates valid for 14 days or more",[257,659,588],{},[257,661,662],{},[464,663,664],{},"tls_days_left",[239,666,667,670,672],{},[257,668,669],{},"HSTS for 180 days or more, on every domain",[257,671,599],{},[257,673,636,674],{},[464,675,676],{},"hsts_max_age_days",[239,678,679,689,691],{},[257,680,681,682,685,686],{},"SPF for the mail domain, ending in ",[464,683,684],{},"-all"," or ",[464,687,688],{},"~all",[257,690,599],{},[257,692,693],{},"DNS, for the domains of the outgoing Email Accounts (Wolf site only)",[239,695,696,705,707],{},[257,697,698,699,685,702],{},"DMARC policy ",[464,700,701],{},"quarantine",[464,703,704],{},"reject",[257,706,599],{},[257,708,709,710,713,714,717,718,721],{},"DNS, ",[464,711,712],{},"_dmarc.\u003Cdomain>",", then its parents' ",[464,715,716],{},"sp="," \u002F ",[464,719,720],{},"p="," (Wolf site only)",[239,723,724,727,729],{},[257,725,726],{},"No published security advisory applies to Frappe or ERPNext",[257,728,574],{},[257,730,636,731,734],{},[464,732,733],{},"app_version"," for the site's benches, and the Wolf site's own packages, against GitHub Security Advisories",[313,736,737,748,751,757,760],{},[316,738,739,740,743,744,747],{},"A check Wolf cannot read is ",[197,741,742],{},"unknown"," and counts as not passed. ",[464,745,746],{},"coverage"," says how much of\nthe weight Wolf could read.",[316,749,750],{},"The page lists the failed checks first, then the unknown ones, then the passed ones, the\nheaviest on top in each group. The bar next to the score has one segment per check, as wide as\nits weight: solid for failed and passed, hatched for unknown.",[316,752,753,756],{},[197,754,755],{},"+N"," on a failed or unknown check is what the score gains if that check alone passes.",[316,758,759],{},"Agent samples older than 3 h are not used.",[316,761,762,763,766,767,770],{},"The score is stored hourly as the ",[464,764,765],{},"security_score"," metric. The ",[197,768,769],{},"Security score low"," preset\nfires when a site's score is below 60.",[217,772,774],{"id":773},"where-the-inputs-come-from","Where the inputs come from",[313,776,777,794,804,818,862],{},[316,778,779,782,783,717,786,789,790,793],{},[197,780,781],{},"System Settings of other sites",": the agent reads them hourly from each site's database, with\nthe site's own credentials: five System Settings rows and the System Manager role's two-factor\nflag, nothing else. It uses the ",[464,784,785],{},"mariadb",[464,787,788],{},"mysql"," client or ",[464,791,792],{},"psql",". Without a client on the\nhost, those checks stay unknown. The Wolf site always reads its own settings.",[316,795,796,799,800,209],{},[197,797,798],{},"Exposure and site config",": see ",[207,801,803],{"href":802},"\u002Fsecurity\u002Fdetection#exposure-and-site-config-risks","Exposure and site-config risks",[316,805,806,809,810,813,814,817],{},[197,807,808],{},"HSTS",": with the hourly TLS check, the agent sends ",[464,811,812],{},"HEAD \u002F"," and reads\n",[464,815,816],{},"Strict-Transport-Security"," from the first response. Redirects are not followed. A missing\nheader counts as 0 days. No HTTP answer sends no sample, so the check stays unknown.",[316,819,820,823,824,827,828,831,832,685,834,836,837,840,841,844,845,685,848,851,852,855,856,858,859,861],{},[197,821,822],{},"SPF and DMARC",": the Wolf site reads DNS through the resolvers of ",[464,825,826],{},"\u002Fetc\u002Fresolv.conf",", for the\ndomains of its enabled outgoing Email Accounts, cached 1 h (10 min after a DNS failure, which\nmakes the check unknown). SPF needs one ",[464,829,830],{},"v=spf1"," record ending in ",[464,833,684],{},[464,835,688],{},";\n",[464,838,839],{},"redirect="," passes without being followed, ",[464,842,843],{},"include:"," is not followed. DMARC needs\n",[464,846,847],{},"p=quarantine",[464,849,850],{},"p=reject","; ",[464,853,854],{},"p=none"," fails. A subdomain without a record follows its parent's\n",[464,857,716],{}," (else ",[464,860,720],{},").",[316,863,864,867,868,871,872,875,876,878,879,882],{},[197,865,866],{},"Security advisories",": once a day, the Wolf site reads the published advisories of\n",[464,869,870],{},"frappe\u002Ffrappe"," and ",[464,873,874],{},"frappe\u002Ferpnext"," from the GitHub API, unauthenticated: nothing about the\ninstallation is sent. A copy older than 7 days is not used. The agent sends ",[464,877,733],{}," per\nbench and app hourly; development versions are not sent. Any advisory that applies fails the\ncheck; the evidence counts them by severity and names the version that fixes them all on that\nline. A major line no advisory of the last year names (Dodock, or a line out of support such as\n13.x) is unknown, never safe. Turn the check off with ",[197,880,881],{},"Wolf Settings → Check versions against\nGitHub Security Advisories","; it is then unknown.",[217,884,886],{"id":885},"related-presets","Related presets",[233,888,889,899],{},[236,890,891],{},[239,892,893,896],{},[242,894,895],{},"Preset",[242,897,898],{},"Fires when",[252,900,901,912,924],{},[239,902,903,907],{},[257,904,905],{},[202,906,769],{},[257,908,909,911],{},[464,910,765],{}," below 60, per site (warning)",[239,913,914,919],{},[257,915,916],{},[202,917,918],{},"Bench service exposed",[257,920,921,923],{},[464,922,639],{}," above 0, per host (critical)",[239,925,926,931],{},[257,927,928],{},[202,929,930],{},"Development settings in production",[257,932,933,935],{},[464,934,626],{}," above 0, per site (warning)",[217,937,939],{"id":938},"not-covered-yet","Not covered yet",[313,941,942,945],{},[316,943,944],{},"Advisories of other apps (HRMS, Dokos' own).",[316,946,947],{},"SPF and DMARC of the mail domains of sites other than the Wolf site.",{"title":949,"searchDepth":950,"depth":951,"links":952},"",1,2,[953,962],{"id":190,"depth":951,"text":191,"children":954},[955,957,958,959,960,961],{"id":219,"depth":956,"text":220},3,{"id":338,"depth":956,"text":339},{"id":432,"depth":956,"text":433},{"id":448,"depth":956,"text":449},{"id":458,"depth":956,"text":459},{"id":501,"depth":956,"text":502},{"id":538,"depth":951,"text":539,"children":963},[964,965,966],{"id":773,"depth":956,"text":774},{"id":885,"depth":956,"text":886},{"id":938,"depth":956,"text":939},"Track NIS2, DORA and GDPR reporting deadlines on incidents, draft the regulatory report, and read each site's security score.","md",null,{},{"icon":142},{"title":139,"description":967},"SFkHx0gqy9av8P1sgrRKHm3aCyoIJaCnZzcnrLfDgEU",[975,977],{"title":134,"path":135,"stem":136,"description":976,"icon":137},"Verify the tamper-evident journal, set up decoy users, API keys and paths, and tag events from IPs on reputation lists.",{"title":144,"path":145,"stem":146,"description":978,"icon":104},"Send Wolf's security events and signed journal to a syslog collector in OCSF or CEF, with the settings that work for rsyslog, Wazuh and Graylog.",1795104294812]