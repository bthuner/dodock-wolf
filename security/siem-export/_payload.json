1],{"id":233,"depth":534,"text":234,"children":1155},[1156,1157,1158,1159],{"id":541,"depth":866,"text":397},{"id":581,"depth":866,"text":378},{"id":600,"depth":866,"text":601},{"id":312,"depth":866,"text":619},{"id":646,"depth":534,"text":647},{"id":675,"depth":534,"text":676},"Send Wolf's security events and signed journal to a syslog collector in OCSF or CEF, with the settings that work for rsyslog, Wazuh and Graylog.","md",null,{},{"icon":104},{"title":144,"description":1162},"PJBfiuHLCOLOdXE2KFYl5zoL1ju48ZXoRuJ-Mxkf6Fk",[1170,1172],{"title":139,"path":140,"stem":141,"description":1171,"icon":142},"Track NIS2, DORA and GDPR reporting deadlines on incidents, draft the regulatory report, and read each site's security score.",{"title":148,"path":149,"stem":150,"description":1173,"icon":43},"Feed Suricata and Wazuh alerts into Dodock Wolf, through the agent or the Wazuh integration, and find every source's events for one IP, host, site or user.",1795109741085]