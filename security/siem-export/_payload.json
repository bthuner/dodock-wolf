le",{"title":144,"path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"title":183,"path":184,"stem":185,"children":186,"icon":189},"Internals","\u002Finternals","7.internals\u002F1.index",[187,190,195,199,204,208],{"title":188,"path":184,"stem":185,"icon":189},"Frappe Cloud v2, read from its code","i-lucide-map",{"title":191,"path":192,"stem":193,"icon":194},"The applications","\u002Finternals\u002Fapps","7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Calls and trust","\u002Finternals\u002Finterop","7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flows","\u002Finternals\u002Fflows","7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Inside a customer server","\u002Finternals\u002Fcustomer-server","7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes for Wolf","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":144,"body":214,"description":1162,"extension":1163,"links":1164,"meta":1165,"navigation":1166,"path":145,"seo":1167,"stem":146,"__hash__":1168},"docs_en\u002F5.security\u002F7.siem-export.md",{"type":215,"value":216,"toc":1152},"minimark",[217,230,235,476,490,538,542,579,582,598,602,617,620,638,644,648,673,677,680,786,1136,1148],[218,219,220,224,225,229],"p",{},[221,222,223],"strong",{},"Wolf Settings → SIEM export (syslog)"," (off by default) sends Wolf's security events and its\nsigned journal to a syslog collector. Every minute, the events that match the filters, and every\nsigned journal entry, go out as RFC 5424 syslog (facility ",[226,227,228],"code",{},"local0",") carrying OCSF JSON or CEF.",[231,232,234],"h2",{"id":233},"settings","Settings",[236,237,238,254],"table",{},[239,240,241],"thead",{},[242,243,244,248,251],"tr",{},[245,246,247],"th",{},"Setting",[245,249,250],{},"Values",[245,252,253],{},"Default",[255,256,257,271,283,297,322,335,351,372,391,410,432,464],"tbody",{},[242,258,259,265,268],{},[260,261,262],"td",{},[221,263,264],{},"Export to a SIEM",[260,266,267],{},"on \u002F off",[260,269,270],{},"off",[242,272,273,278,281],{},[260,274,275],{},[221,276,277],{},"Collector host",[260,279,280],{},"a host name or address. With TLS, it must be in the collector's certificate",[260,282],{},[242,284,285,290,292],{},[260,286,287],{},[221,288,289],{},"Port",[260,291],{},[260,293,294],{},[226,295,296],{},"514",[242,298,299,304,318],{},[260,300,301],{},[221,302,303],{},"Transport",[260,305,306,309,310,313,314,317],{},[226,307,308],{},"tcp",", ",[226,311,312],{},"tls"," (RFC 5425), ",[226,315,316],{},"udp"," (RFC 5426)",[260,319,320],{},[226,321,308],{},[242,323,324,329,332],{},[260,325,326],{},[221,327,328],{},"Verify the collector's certificate",[260,330,331],{},"on \u002F off (TLS)",[260,333,334],{},"on",[242,336,337,342,349],{},[260,338,339],{},[221,340,341],{},"Collector CA file",[260,343,344,345,348],{},"a PEM file of a private CA, absolute or relative to the site (",[226,346,347],{},"private\u002Ffiles\u002Fcollector-ca.pem","). Empty: the system CAs",[260,350],{},[242,352,353,358,368],{},[260,354,355],{},[221,356,357],{},"Framing",[260,359,360,363,364,367],{},[226,361,362],{},"octet-counting"," or ",[226,365,366],{},"newline"," (TCP and TLS, RFC 6587)",[260,369,370],{},[226,371,362],{},[242,373,374,379,387],{},[260,375,376],{},[221,377,378],{},"Message header",[260,380,381,363,384],{},[226,382,383],{},"rfc5424",[226,385,386],{},"none",[260,388,389],{},[226,390,383],{},[242,392,393,398,406],{},[260,394,395],{},[221,396,397],{},"Format",[260,399,400,363,403],{},[226,401,402],{},"ocsf",[226,404,405],{},"cef",[260,407,408],{},[226,409,402],{},[242,411,412,417,428],{},[260,413,414],{},[221,415,416],{},"Minimum severity",[260,418,419,309,422,309,425],{},[226,420,421],{},"info",[226,423,424],{},"warning",[226,426,427],{},"critical",[260,429,430],{},[226,431,424],{},[242,433,434,439,460],{},[260,435,436],{},[221,437,438],{},"Event types",[260,440,441,442,309,445,309,448,309,451,309,454,309,457],{},"comma-separated: ",[226,443,444],{},"security",[226,446,447],{},"error",[226,449,450],{},"cron_failure",[226,452,453],{},"worker_failure",[226,455,456],{},"host_metric_alert",[226,458,459],{},"deployment",[260,461,462],{},[226,463,444],{},[242,465,466,471,474],{},[260,467,468],{},[221,469,470],{},"Send the journal",[260,472,473],{},"also send every signed journal entry (seq, digest, mac)",[260,475,334],{},[218,477,478,479,482,483,486,487,489],{},"To check a collector, a Wolf Manager can POST to ",[226,480,481],{},"dodock_wolf.api.siem.send_test",". It sends one\n",[226,484,485],{},"wolf_test"," message with the current settings, even while ",[221,488,264],{}," is off:",[491,492,497],"pre",{"className":493,"code":494,"language":495,"meta":496,"style":496},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST -H \"Authorization: token \u003Capi_key>:\u003Capi_secret>\" \\\n  https:\u002F\u002Fwolf.example.com\u002Fapi\u002Fmethod\u002Fdodock_wolf.api.siem.send_test\n","bash","",[226,498,499,532],{"__ignoreMap":496},[500,501,504,508,512,515,518,522,525,528],"span",{"class":502,"line":503},"line",1,[500,505,507],{"class":506},"sBMFI","curl",[500,509,511],{"class":510},"sfazB"," -X",[500,513,514],{"class":510}," POST",[500,516,517],{"class":510}," -H",[500,519,521],{"class":520},"sMK4o"," \"",[500,523,524],{"class":510},"Authorization: token \u003Capi_key>:\u003Capi_secret>",[500,526,527],{"class":520},"\"",[500,529,531],{"class":530},"sTEyZ"," \\\n",[500,533,535],{"class":502,"line":534},2,[500,536,537],{"class":510},"  https:\u002F\u002Fwolf.example.com\u002Fapi\u002Fmethod\u002Fdodock_wolf.api.siem.send_test\n",[539,540,397],"h3",{"id":541},"format",[543,544,545,560],"ul",{},[546,547,548,551,552,555,556,559],"li",{},[221,549,550],{},"OCSF",": JSON, Detection Finding (class 2004). ATT&CK techniques in ",[226,553,554],{},"finding_info.attacks",";\nWolf's site, bench and payload under ",[226,557,558],{},"unmapped",". The mapping is Wolf's reading of the schema,\nnot a certified profile.",[546,561,562,565,566,309,569,574,575,578],{},[221,563,564],{},"CEF",": ATT&CK in ",[226,567,568],{},"cs4",[570,571,573],"a",{"href":572},"\u002Fsecurity\u002Fjournal#ip-reputation-lists","IP reputation"," lists in ",[226,576,577],{},"cs5",".",[539,580,378],{"id":581},"message-header",[543,583,584,593],{},[546,585,586,588,589,592],{},[226,587,383],{},": a syslog header before each message: priority, timestamp, the site as host name,\n",[226,590,591],{},"dodock-wolf"," as application, the event category as MSGID.",[546,594,595,597],{},[226,596,386],{},": the bare JSON or CEF, for collectors that decode the message themselves, such as\nWazuh's JSON decoder and Graylog's CEF input.",[539,599,601],{"id":600},"transport-and-framing","Transport and framing",[543,603,604,607,612],{},[546,605,606],{},"Prefer TCP or TLS. UDP sends one datagram per message, cut at 8 KB. Wolf cannot tell whether\nthe collector got anything, so the cursor moves anyway.",[546,608,609,611],{},[226,610,362],{}," precedes each message with its length. rsyslog, syslog-ng and Graylog's Syslog\ninput read it.",[546,613,614,616],{},[226,615,366],{}," sends one message per line; a line break inside a message becomes a space. Wazuh and\nGraylog's CEF input need it.",[539,618,619],{"id":312},"TLS",[543,621,622,627],{},[546,623,624,625,578],{},"The collector's certificate is checked against the system CAs, or ",[221,626,341],{},[546,628,629,630,633,634,637],{},"Python 3.13 and later verify strictly: the CA needs ",[226,631,632],{},"basicConstraints=CA:TRUE"," and\n",[226,635,636],{},"keyUsage=keyCertSign",", and the server certificate needs an Authority Key Identifier.",[639,640,641],"caution",{},[218,642,643],{},"Turning certificate verification off works, but anyone on the path can then read the export.",[231,645,647],{"id":646},"delivery","Delivery",[543,649,650,653,656,659,666],{},[546,651,652],{},"A cursor moves only after a batch is sent. A collector that is down delays the export; nothing\nis skipped.",[546,654,655],{},"A failure mid-batch can send a message twice: delivery is at least once.",[546,657,658],{},"Events younger than 2 minutes wait for the next run, so a transaction that commits a little\nafter it inserted is not skipped.",[546,660,661,662,665],{},"Payloads go out as they are stored (already ",[570,663,664],{"href":71},"scrubbed"," by the agent), cut at\n4 KB.",[546,667,668,669,578],{},"Journal entries give the SIEM an external copy of the chain: an anchor Wolf cannot rewrite. See\n",[570,670,672],{"href":671},"\u002Fsecurity\u002Fjournal#tamper-evident-journal","Tamper-evident journal",[231,674,676],{"id":675},"collectors","Collectors",[218,678,679],{},"Each recipe was tried against the real collector (November 2026).",[236,681,682,700],{},[239,683,684],{},[242,685,686,689,691,693,695,697],{},[245,687,688],{},"Collector",[245,690,397],{},[245,692,378],{},[245,694,303],{},[245,696,357],{},[245,698,699],{},"What you get",[255,701,702,725,746,766],{},[242,703,704,707,710,714,717,722],{},[260,705,706],{},"rsyslog 8.2404",[260,708,709],{},"OCSF or CEF",[260,711,712],{},[226,713,383],{},[260,715,716],{},"UDP, TCP or TLS",[260,718,719,721],{},[226,720,362],{}," (TCP\u002FTLS)",[260,723,724],{},"messages written as sent; MSGID is the event category",[242,726,727,730,732,736,739,743],{},[260,728,729],{},"Wazuh 4.9.2 manager",[260,731,550],{},[260,733,734],{},[226,735,386],{},[260,737,738],{},"TCP",[260,740,741],{},[226,742,366],{},[260,744,745],{},"one Wazuh alert per finding, level by severity",[242,747,748,751,753,757,759,763],{},[260,749,750],{},"Graylog 6.1, CEF input",[260,752,564],{},[260,754,755],{},[226,756,386],{},[260,758,738],{},[260,760,761],{},[226,762,366],{},[260,764,765],{},"every field extracted (source address, ATT&CK, site, severity)",[242,767,768,771,773,777,779,783],{},[260,769,770],{},"Graylog 6.1, Syslog input",[260,772,709],{},[260,774,775],{},[226,776,383],{},[260,778,716],{},[260,780,781],{},[226,782,362],{},[260,784,785],{},"messages stored, JSON not split into fields",[787,788,789,810,1046,1130],"tabs",{},[790,791,793,802],"tabs-item",{"label":792},"rsyslog",[491,794,800],{"className":795,"code":797,"filename":798,"language":799,"meta":496},[796],"language-text","module(load=\"imptcp\")                     # TCP, octet-counted or newline\ninput(type=\"imptcp\" port=\"514\")\nmodule(load=\"imtcp\" StreamDriver.Name=\"gtls\" StreamDriver.Mode=\"1\" StreamDriver.AuthMode=\"anon\")\ninput(type=\"imtcp\" port=\"6514\")           # TLS (global DefaultNetstreamDriver* point at the cert)\nmodule(load=\"imudp\")\ninput(type=\"imudp\" port=\"514\")\n","rsyslog.conf","text",[226,801,797],{"__ignoreMap":496},[218,803,804,805,309,807,809],{},"The default Wolf settings work: ",[226,806,383],{},[226,808,362],{},", OCSF or CEF.",[790,811,813,956,1013,1029,1032],{"label":812},"Wazuh",[814,815,816,928,942],"ol",{},[546,817,818,819,822,823],{},"On the manager, add a syslog input to ",[226,820,821],{},"\u002Fvar\u002Fossec\u002Fetc\u002Fossec.conf",":",[491,824,829],{"className":825,"code":826,"filename":827,"language":828,"meta":496,"style":496},"language-xml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u003Cremote>\n  \u003Cconnection>syslog\u003C\u002Fconnection>\n  \u003Cport>514\u003C\u002Fport>\n  \u003Cprotocol>tcp\u003C\u002Fprotocol>\n  \u003Callowed-ips>WOLF_SITE_ADDRESS\u002F32\u003C\u002Fallowed-ips>\n\u003C\u002Fremote>\n","ossec.conf","xml",[226,830,831,843,864,882,900,919],{"__ignoreMap":496},[500,832,833,836,840],{"class":502,"line":503},[500,834,835],{"class":520},"\u003C",[500,837,839],{"class":838},"swJcz","remote",[500,841,842],{"class":520},">\n",[500,844,845,848,851,854,857,860,862],{"class":502,"line":534},[500,846,847],{"class":520},"  \u003C",[500,849,850],{"class":838},"connection",[500,852,853],{"class":520},">",[500,855,856],{"class":530},"syslog",[500,858,859],{"class":520},"\u003C\u002F",[500,861,850],{"class":838},[500,863,842],{"class":520},[500,865,867,869,872,874,876,878,880],{"class":502,"line":866},3,[500,868,847],{"class":520},[500,870,871],{"class":838},"port",[500,873,853],{"class":520},[500,875,296],{"class":530},[500,877,859],{"class":520},[500,879,871],{"class":838},[500,881,842],{"class":520},[500,883,885,887,890,892,894,896,898],{"class":502,"line":884},4,[500,886,847],{"class":520},[500,888,889],{"class":838},"protocol",[500,891,853],{"class":520},[500,893,308],{"class":530},[500,895,859],{"class":520},[500,897,889],{"class":838},[500,899,842],{"class":520},[500,901,903,905,908,910,913,915,917],{"class":502,"line":902},5,[500,904,847],{"class":520},[500,906,907],{"class":838},"allowed-ips",[500,909,853],{"class":520},[500,911,912],{"class":530},"WOLF_SITE_ADDRESS\u002F32",[500,914,859],{"class":520},[500,916,907],{"class":838},[500,918,842],{"class":520},[500,920,922,924,926],{"class":502,"line":921},6,[500,923,859],{"class":520},[500,925,839],{"class":838},[500,927,842],{"class":520},[546,929,930,931,937,938,941],{},"Copy the ",[570,932,936],{"href":933,"rel":934},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Fdocs\u002Fsiem\u002Fwazuh_dodock_wolf_rules.xml",[935],"nofollow","rules file","\nto ",[226,939,940],{},"\u002Fvar\u002Fossec\u002Fetc\u002Frules\u002F"," and restart the manager. It needs Wazuh 4.6 or later.",[546,943,944,945,947,948,950,951,953,954,578],{},"Set Wolf to: format ",[226,946,402],{},", message header ",[226,949,386],{},", transport ",[226,952,308],{},", framing ",[226,955,366],{},[236,957,958,971],{},[239,959,960],{},[242,961,962,965,968],{},[245,963,964],{},"Wolf finding",[245,966,967],{},"Wazuh rule",[245,969,970],{},"Level",[255,972,973,983,993,1003],{},[242,974,975,977,980],{},[260,976,421],{},[260,978,979],{},"100901",[260,981,982],{},"3",[242,984,985,987,990],{},[260,986,424],{},[260,988,989],{},"100902",[260,991,992],{},"7",[242,994,995,997,1000],{},[260,996,427],{},[260,998,999],{},"100903",[260,1001,1002],{},"12",[242,1004,1005,1008,1011],{},[260,1006,1007],{},"journal entry",[260,1009,1010],{},"100910",[260,1012,982],{},[218,1014,1015,1016,309,1019,1022,1023,309,1025,1028],{},"The OCSF fields become Wazuh fields: ",[226,1017,1018],{},"src_endpoint.ip",[226,1020,1021],{},"finding_info.title",",\n",[226,1024,554],{},[226,1026,1027],{},"unmapped.site",", and so on.",[218,1030,1031],{},"Does not work with Wazuh:",[543,1033,1034,1037,1040,1043],{},[546,1035,1036],{},"the RFC 5424 header: Wazuh does not parse it, so only a generic rule fires;",[546,1038,1039],{},"CEF: Wazuh has no decoder for it;",[546,1041,1042],{},"octet-counted frames: they are dropped;",[546,1044,1045],{},"TLS: Wazuh's syslog input has none. Put a local relay (rsyslog, stunnel) in front when the\nnetwork between Wolf and Wazuh is not trusted.",[790,1047,1049,1068,1115],{"label":1048},"Graylog",[218,1050,1051,1054,1055,1058,1059,1061,1062,950,1064,953,1066,578],{},[221,1052,1053],{},"To get fields",": create a ",[221,1056,1057],{},"CEF TCP"," input, then set Wolf to: format ",[226,1060,405],{},", message header\n",[226,1063,386],{},[226,1065,308],{},[226,1067,366],{},[543,1069,1070,1100,1106],{},[546,1071,1072,1073,309,1076,1079,1080,309,1083,1022,1086,309,1089,1092,1093,1096,1097,578],{},"The input extracts ",[226,1074,1075],{},"sourceAddress",[226,1077,1078],{},"deviceHostName"," (the site), ",[226,1081,1082],{},"mitre_attack",[226,1084,1085],{},"site",[226,1087,1088],{},"severity",[226,1090,1091],{},"event_class_id"," (the category) and the journal's ",[226,1094,1095],{},"digest"," \u002F ",[226,1098,1099],{},"mac",[546,1101,1102,1105],{},[226,1103,1104],{},"source"," is the address of the Wolf site.",[546,1107,1108,1109,1111,1112,578],{},"The RFC 5424 header confuses this input: ",[226,1110,1104],{}," becomes ",[226,1113,1114],{},"-",[218,1116,1117,1120,1121,1022,1123,1125,1126,1129],{},[221,1118,1119],{},"To store only",": the Syslog TCP, UDP or TLS inputs accept the default settings (",[226,1122,383],{},[226,1124,362],{},"). Graylog keeps MSGID and the structured-data dash at the start of ",[226,1127,1128],{},"message","\nand does not split the JSON. Add a JSON extractor or a pipeline rule if you take this road.",[790,1131,1133],{"label":1132},"UniSOC and others",[218,1134,1135],{},"UniSOC has not been tried, for lack of an instance. Any collector that takes syslog with\nRFC 5424, CEF or JSON lines should work with one of the combinations above.",[1137,1138,1139],"note",{},[218,1140,1141,1142,1145,1146,578],{},"When Wolf exports to a Wazuh manager that the Wolf Agent also reads, Wazuh's alerts on Wolf's own\nexport (group ",[226,1143,1144],{},"dodock_wolf",") are always left out, so nothing loops back. See\n",[570,1147,148],{"href":149},[1149,1150,1151],"style",{},"html pre