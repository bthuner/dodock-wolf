inute, the events that match the filters, and every\nsigned journal entry, go out as RFC 5424 syslog (facility ",[206,207,208],"code",{},"local0",") carrying OCSF JSON or CEF.",[211,212,214],"h2",{"id":213},"settings","Settings",[216,217,218,234],"table",{},[219,220,221],"thead",{},[222,223,224,228,231],"tr",{},[225,226,227],"th",{},"Setting",[225,229,230],{},"Values",[225,232,233],{},"Default",[235,236,237,251,263,277,302,315,331,352,371,390,412,444],"tbody",{},[222,238,239,245,248],{},[240,241,242],"td",{},[201,243,244],{},"Export to a SIEM",[240,246,247],{},"on \u002F off",[240,249,250],{},"off",[222,252,253,258,261],{},[240,254,255],{},[201,256,257],{},"Collector host",[240,259,260],{},"a host name or address. With TLS, it must be in the collector's certificate",[240,262],{},[222,264,265,270,272],{},[240,266,267],{},[201,268,269],{},"Port",[240,271],{},[240,273,274],{},[206,275,276],{},"514",[222,278,279,284,298],{},[240,280,281],{},[201,282,283],{},"Transport",[240,285,286,289,290,293,294,297],{},[206,287,288],{},"tcp",", ",[206,291,292],{},"tls"," (RFC 5425), ",[206,295,296],{},"udp"," (RFC 5426)",[240,299,300],{},[206,301,288],{},[222,303,304,309,312],{},[240,305,306],{},[201,307,308],{},"Verify the collector's certificate",[240,310,311],{},"on \u002F off (TLS)",[240,313,314],{},"on",[222,316,317,322,329],{},[240,318,319],{},[201,320,321],{},"Collector CA file",[240,323,324,325,328],{},"a PEM file of a private CA, absolute or relative to the site (",[206,326,327],{},"private\u002Ffiles\u002Fcollector-ca.pem","). Empty: the system CAs",[240,330],{},[222,332,333,338,348],{},[240,334,335],{},[201,336,337],{},"Framing",[240,339,340,343,344,347],{},[206,341,342],{},"octet-counting"," or ",[206,345,346],{},"newline"," (TCP and TLS, RFC 6587)",[240,349,350],{},[206,351,342],{},[222,353,354,359,367],{},[240,355,356],{},[201,357,358],{},"Message header",[240,360,361,343,364],{},[206,362,363],{},"rfc5424",[206,365,366],{},"none",[240,368,369],{},[206,370,363],{},[222,372,373,378,386],{},[240,374,375],{},[201,376,377],{},"Format",[240,379,380,343,383],{},[206,381,382],{},"ocsf",[206,384,385],{},"cef",[240,387,388],{},[206,389,382],{},[222,391,392,397,408],{},[240,393,394],{},[201,395,396],{},"Minimum severity",[240,398,399,289,402,289,405],{},[206,400,401],{},"info",[206,403,404],{},"warning",[206,406,407],{},"critical",[240,409,410],{},[206,411,404],{},[222,413,414,419,440],{},[240,415,416],{},[201,417,418],{},"Event types",[240,420,421,422,289,425,289,428,289,431,289,434,289,437],{},"comma-separated: ",[206,423,424],{},"security",[206,426,427],{},"error",[206,429,430],{},"cron_failure",[206,432,433],{},"worker_failure",[206,435,436],{},"host_metric_alert",[206,438,439],{},"deployment",[240,441,442],{},[206,443,424],{},[222,445,446,451,454],{},[240,447,448],{},[201,449,450],{},"Send the journal",[240,452,453],{},"also send every signed journal entry (seq, digest, mac)",[240,455,314],{},[198,457,458,459,462,463,466,467,469],{},"To check a collector, a Wolf Manager can POST to ",[206,460,461],{},"dodock_wolf.api.siem.send_test",". It sends one\n",[206,464,465],{},"wolf_test"," message with the current settings, even while ",[201,468,244],{}," is off:",[471,472,477],"pre",{"className":473,"code":474,"language":475,"meta":476,"style":476},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -X POST -H \"Authorization: token \u003Capi_key>:\u003Capi_secret>\" \\\n  https:\u002F\u002Fwolf.example.com\u002Fapi\u002Fmethod\u002Fdodock_wolf.api.siem.send_test\n","bash","",[206,478,479,512],{"__ignoreMap":476},[480,481,484,488,492,495,498,502,505,508],"span",{"class":482,"line":483},"line",1,[480,485,487],{"class":486},"sBMFI","curl",[480,489,491],{"class":490},"sfazB"," -X",[480,493,494],{"class":490}," POST",[480,496,497],{"class":490}," -H",[480,499,501],{"class":500},"sMK4o"," \"",[480,503,504],{"class":490},"Authorization: token \u003Capi_key>:\u003Capi_secret>",[480,506,507],{"class":500},"\"",[480,509,511],{"class":510},"sTEyZ"," \\\n",[480,513,515],{"class":482,"line":514},2,[480,516,517],{"class":490},"  https:\u002F\u002Fwolf.example.com\u002Fapi\u002Fmethod\u002Fdodock_wolf.api.siem.send_test\n",[519,520,377],"h3",{"id":521},"format",[523,524,525,540],"ul",{},[526,527,528,531,532,535,536,539],"li",{},[201,529,530],{},"OCSF",": JSON, Detection Finding (class 2004). ATT&CK techniques in ",[206,533,534],{},"finding_info.attacks",";\nWolf's site, bench and payload under ",[206,537,538],{},"unmapped",". The mapping is Wolf's reading of the schema,\nnot a certified profile.",[526,541,542,545,546,289,549,554,555,558],{},[201,543,544],{},"CEF",": ATT&CK in ",[206,547,548],{},"cs4",[550,551,553],"a",{"href":552},"\u002Fsecurity\u002Fjournal#ip-reputation-lists","IP reputation"," lists in ",[206,556,557],{},"cs5",".",[519,560,358],{"id":561},"message-header",[523,563,564,573],{},[526,565,566,568,569,572],{},[206,567,363],{},": a syslog header before each message: priority, timestamp, the site as host name,\n",[206,570,571],{},"dodock-wolf"," as application, the event category as MSGID.",[526,574,575,577],{},[206,576,366],{},": the bare JSON or CEF, for collectors that decode the message themselves, such as\nWazuh's JSON decoder and Graylog's CEF input.",[519,579,581],{"id":580},"transport-and-framing","Transport and framing",[523,583,584,587,592],{},[526,585,586],{},"Prefer TCP or TLS. UDP sends one datagram per message, cut at 8 KB. Wolf cannot tell whether\nthe collector got anything, so the cursor moves anyway.",[526,588,589,591],{},[206,590,342],{}," precedes each message with its length. rsyslog, syslog-ng and Graylog's Syslog\ninput read it.",[526,593,594,596],{},[206,595,346],{}," sends one message per line; a line break inside a message becomes a space. Wazuh and\nGraylog's CEF input need it.",[519,598,599],{"id":292},"TLS",[523,601,602,607],{},[526,603,604,605,558],{},"The collector's certificate is checked against the system CAs, or ",[201,606,321],{},[526,608,609,610,613,614,617],{},"Python 3.13 and later verify strictly: the CA needs ",[206,611,612],{},"basicConstraints=CA:TRUE"," and\n",[206,615,616],{},"keyUsage=keyCertSign",", and the server certificate needs an Authority Key Identifier.",[619,620,621],"caution",{},[198,622,623],{},"Turning certificate verification off works, but anyone on the path can then read the export.",[211,625,627],{"id":626},"delivery","Delivery",[523,629,630,633,636,639,646],{},[526,631,632],{},"A cursor moves only after a batch is sent. A collector that is down delays the export; nothing\nis skipped.",[526,634,635],{},"A failure mid-batch can send a message twice: delivery is at least once.",[526,637,638],{},"Events younger than 2 minutes wait for the next run, so a transaction that commits a little\nafter it inserted is not skipped.",[526,640,641,642,645],{},"Payloads go out as they are stored (already ",[550,643,644],{"href":76},"scrubbed"," by the agent), cut at\n4 KB.",[526,647,648,649,558],{},"Journal entries give the SIEM an external copy of the chain: an anchor Wolf cannot rewrite. See\n",[550,650,652],{"href":651},"\u002Fsecurity\u002Fjournal#tamper-evident-journal","Tamper-evident journal",[211,654,656],{"id":655},"collectors","Collectors",[198,658,659],{},"Each recipe was tried against the real collector (November 2026).",[216,661,662,680],{},[219,663,664],{},[222,665,666,669,671,673,675,677],{},[225,667,668],{},"Collector",[225,670,377],{},[225,672,358],{},[225,674,283],{},[225,676,337],{},[225,678,679],{},"What you get",[235,681,682,705,726,746],{},[222,683,684,687,690,694,697,702],{},[240,685,686],{},"rsyslog 8.2404",[240,688,689],{},"OCSF or CEF",[240,691,692],{},[206,693,363],{},[240,695,696],{},"UDP, TCP or TLS",[240,698,699,701],{},[206,700,342],{}," (TCP\u002FTLS)",[240,703,704],{},"messages written as sent; MSGID is the event category",[222,706,707,710,712,716,719,723],{},[240,708,709],{},"Wazuh 4.9.2 manager",[240,711,530],{},[240,713,714],{},[206,715,366],{},[240,717,718],{},"TCP",[240,720,721],{},[206,722,346],{},[240,724,725],{},"one Wazuh alert per finding, level by severity",[222,727,728,731,733,737,739,743],{},[240,729,730],{},"Graylog 6.1, CEF input",[240,732,544],{},[240,734,735],{},[206,736,366],{},[240,738,718],{},[240,740,741],{},[206,742,346],{},[240,744,745],{},"every field extracted (source address, ATT&CK, site, severity)",[222,747,748,751,753,757,759,763],{},[240,749,750],{},"Graylog 6.1, Syslog input",[240,752,689],{},[240,754,755],{},[206,756,363],{},[240,758,696],{},[240,760,761],{},[206,762,342],{},[240,764,765],{},"messages stored, JSON not split into fields",[767,768,769,790,1026,1110],"tabs",{},[770,771,773,782],"tabs-item",{"label":772},"rsyslog",[471,774,780],{"className":775,"code":777,"filename":778,"language":779,"meta":476},[776],"language-text","module(load=\"imptcp\")                     # TCP, octet-counted or newline\ninput(type=\"imptcp\" port=\"514\")\nmodule(load=\"imtcp\" StreamDriver.Name=\"gtls\" StreamDriver.Mode=\"1\" StreamDriver.AuthMode=\"anon\")\ninput(type=\"imtcp\" port=\"6514\")           # TLS (global DefaultNetstreamDriver* point at the cert)\nmodule(load=\"imudp\")\ninput(type=\"imudp\" port=\"514\")\n","rsyslog.conf","text",[206,781,777],{"__ignoreMap":476},[198,783,784,785,289,787,789],{},"The default Wolf settings work: ",[206,786,363],{},[206,788,342],{},", OCSF or CEF.",[770,791,793,936,993,1009,1012],{"label":792},"Wazuh",[794,795,796,908,922],"ol",{},[526,797,798,799,802,803],{},"On the manager, add a syslog input to ",[206,800,801],{},"\u002Fvar\u002Fossec\u002Fetc\u002Fossec.conf",":",[471,804,809],{"className":805,"code":806,"filename":807,"language":808,"meta":476,"style":476},"language-xml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","\u003Cremote>\n  \u003Cconnection>syslog\u003C\u002Fconnection>\n  \u003Cport>514\u003C\u002Fport>\n  \u003Cprotocol>tcp\u003C\u002Fprotocol>\n  \u003Callowed-ips>WOLF_SITE_ADDRESS\u002F32\u003C\u002Fallowed-ips>\n\u003C\u002Fremote>\n","ossec.conf","xml",[206,810,811,823,844,862,880,899],{"__ignoreMap":476},[480,812,813,816,820],{"class":482,"line":483},[480,814,815],{"class":500},"\u003C",[480,817,819],{"class":818},"swJcz","remote",[480,821,822],{"class":500},">\n",[480,824,825,828,831,834,837,840,842],{"class":482,"line":514},[480,826,827],{"class":500},"  \u003C",[480,829,830],{"class":818},"connection",[480,832,833],{"class":500},">",[480,835,836],{"class":510},"syslog",[480,838,839],{"class":500},"\u003C\u002F",[480,841,830],{"class":818},[480,843,822],{"class":500},[480,845,847,849,852,854,856,858,860],{"class":482,"line":846},3,[480,848,827],{"class":500},[480,850,851],{"class":818},"port",[480,853,833],{"class":500},[480,855,276],{"class":510},[480,857,839],{"class":500},[480,859,851],{"class":818},[480,861,822],{"class":500},[480,863,865,867,870,872,874,876,878],{"class":482,"line":864},4,[480,866,827],{"class":500},[480,868,869],{"class":818},"protocol",[480,871,833],{"class":500},[480,873,288],{"class":510},[480,875,839],{"class":500},[480,877,869],{"class":818},[480,879,822],{"class":500},[480,881,883,885,888,890,893,895,897],{"class":482,"line":882},5,[480,884,827],{"class":500},[480,886,887],{"class":818},"allowed-ips",[480,889,833],{"class":500},[480,891,892],{"class":510},"WOLF_SITE_ADDRESS\u002F32",[480,894,839],{"class":500},[480,896,887],{"class":818},[480,898,822],{"class":500},[480,900,902,904,906],{"class":482,"line":901},6,[480,903,839],{"class":500},[480,905,819],{"class":818},[480,907,822],{"class":500},[526,909,910,911,917,918,921],{},"Copy the ",[550,912,916],{"href":913,"rel":914},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Fblob\u002Fmain\u002Fdocs\u002Fsiem\u002Fwazuh_dodock_wolf_rules.xml",[915],"nofollow","rules file","\nto ",[206,919,920],{},"\u002Fvar\u002Fossec\u002Fetc\u002Frules\u002F"," and restart the manager. It needs Wazuh 4.6 or later.",[526,923,924,925,927,928,930,931,933,934,558],{},"Set Wolf to: format ",[206,926,382],{},", message header ",[206,929,366],{},", transport ",[206,932,288],{},", framing ",[206,935,346],{},[216,937,938,951],{},[219,939,940],{},[222,941,942,945,948],{},[225,943,944],{},"Wolf finding",[225,946,947],{},"Wazuh rule",[225,949,950],{},"Level",[235,952,953,963,973,983],{},[222,954,955,957,960],{},[240,956,401],{},[240,958,959],{},"100901",[240,961,962],{},"3",[222,964,965,967,970],{},[240,966,404],{},[240,968,969],{},"100902",[240,971,972],{},"7",[222,974,975,977,980],{},[240,976,407],{},[240,978,979],{},"100903",[240,981,982],{},"12",[222,984,985,988,991],{},[240,986,987],{},"journal entry",[240,989,990],{},"100910",[240,992,962],{},[198,994,995,996,289,999,1002,1003,289,1005,1008],{},"The OCSF fields become Wazuh fields: ",[206,997,998],{},"src_endpoint.ip",[206,1000,1001],{},"finding_info.title",",\n",[206,1004,534],{},[206,1006,1007],{},"unmapped.site",", and so on.",[198,1010,1011],{},"Does not work with Wazuh:",[523,1013,1014,1017,1020,1023],{},[526,1015,1016],{},"the RFC 5424 header: Wazuh does not parse it, so only a generic rule fires;",[526,1018,1019],{},"CEF: Wazuh has no decoder for it;",[526,1021,1022],{},"octet-counted frames: they are dropped;",[526,1024,1025],{},"TLS: Wazuh's syslog input has none. Put a local relay (rsyslog, stunnel) in front when the\nnetwork between Wolf and Wazuh is not trusted.",[770,1027,1029,1048,1095],{"label":1028},"Graylog",[198,1030,1031,1034,1035,1038,1039,1041,1042,930,1044,933,1046,558],{},[201,1032,1033],{},"To get fields",": create a ",[201,1036,1037],{},"CEF TCP"," input, then set Wolf to: format ",[206,1040,385],{},", message header\n",[206,1043,366],{},[206,1045,288],{},[206,1047,346],{},[523,1049,1050,1080,1086],{},[526,1051,1052,1053,289,1056,1059,1060,289,1063,1002,1066,289,1069,1072,1073,1076,1077,558],{},"The input extracts ",[206,1054,1055],{},"sourceAddress",[206,1057,1058],{},"deviceHostName"," (the site), ",[206,1061,1062],{},"mitre_attack",[206,1064,1065],{},"site",[206,1067,1068],{},"severity",[206,1070,1071],{},"event_class_id"," (the category) and the journal's ",[206,1074,1075],{},"digest"," \u002F ",[206,1078,1079],{},"mac",[526,1081,1082,1085],{},[206,1083,1084],{},"source"," is the address of the Wolf site.",[526,1087,1088,1089,1091,1092,558],{},"The RFC 5424 header confuses this input: ",[206,1090,1084],{}," becomes ",[206,1093,1094],{},"-",[198,1096,1097,1100,1101,1002,1103,1105,1106,1109],{},[201,1098,1099],{},"To store only",": the Syslog TCP, UDP or TLS inputs accept the default settings (",[206,1102,363],{},[206,1104,342],{},"). Graylog keeps MSGID and the structured-data dash at the start of ",[206,1107,1108],{},"message","\nand does not split the JSON. Add a JSON extractor or a pipeline rule if you take this road.",[770,1111,1113],{"label":1112},"UniSOC and others",[198,1114,1115],{},"UniSOC has not been tried, for lack of an instance. Any collector that takes syslog with\nRFC 5424, CEF or JSON lines should work with one of the combinations above.",[1117,1118,1119],"note",{},[198,1120,1121,1122,1125,1126,558],{},"When Wolf exports to a Wazuh manager that the Wolf Agent also reads, Wazuh's alerts on Wolf's own\nexport (group ",[206,1123,1124],{},"dodock_wolf",") are always left out, so nothing loops back. See\n",[550,1127,158],{"href":159},[1129,1130,1131],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);te