[{"data":1,"prerenderedAt":958},["ShallowReactive",2],{"navigation-en":3,"\u002Fsecurity\u002Fsite-signals":212,"\u002Fsecurity\u002Fsite-signals-surround":953},[4,23,50,84,110,151,182],{"title":5,"path":6,"stem":7,"children":8,"icon":22},"Getting started","\u002Fgetting-started","1.getting-started\u002F1.index",[9,12,17],{"title":10,"path":6,"stem":7,"icon":11},"Introduction","i-lucide-house",{"title":13,"path":14,"stem":15,"icon":16},"Quickstart","\u002Fgetting-started\u002Fquickstart","1.getting-started\u002F2.quickstart","i-lucide-timer",{"title":18,"path":19,"stem":20,"icon":21},"Concepts","\u002Fgetting-started\u002Fconcepts","1.getting-started\u002F3.concepts","i-lucide-shapes","i-lucide-rocket",{"title":24,"icon":25,"path":26,"stem":27,"children":28,"page":49},"Install","i-lucide-download","\u002Finstall","2.install",[29,34,39,44],{"title":30,"path":31,"stem":32,"icon":33},"Wolf App","\u002Finstall\u002Fwolf-app","2.install\u002F1.wolf-app","i-lucide-app-window",{"title":35,"path":36,"stem":37,"icon":38},"Wolf Agent","\u002Finstall\u002Fwolf-agent","2.install\u002F2.wolf-agent","i-lucide-server",{"title":40,"path":41,"stem":42,"icon":43},"Every site on a bench","\u002Finstall\u002Fevery-site","2.install\u002F3.every-site","i-lucide-network",{"title":45,"path":46,"stem":47,"icon":48},"Pilot benches","\u002Finstall\u002Fpilot","2.install\u002F5.pilot","i-lucide-plane",false,{"title":35,"icon":38,"path":51,"stem":52,"children":53,"page":49},"\u002Fagent","3.agent",[54,59,64,69,74,79],{"title":55,"path":56,"stem":57,"icon":58},"What is collected","\u002Fagent\u002Fcollected","3.agent\u002F1.collected","i-lucide-list-checks",{"title":60,"path":61,"stem":62,"icon":63},"Configuration","\u002Fagent\u002Fconfiguration","3.agent\u002F2.configuration","i-lucide-settings",{"title":65,"path":66,"stem":67,"icon":68},"Commands","\u002Fagent\u002Fcommands","3.agent\u002F3.commands","i-lucide-terminal",{"title":70,"path":71,"stem":72,"icon":73},"Scrubbing","\u002Fagent\u002F