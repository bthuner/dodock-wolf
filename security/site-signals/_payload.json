path":145,"stem":146,"icon":147},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":193,"title":129,"body":194,"description":926,"extension":927,"links":928,"meta":929,"navigation":930,"path":130,"seo":931,"stem":131,"__hash__":932},"docs_en\u002F5.security\u002F2.site-signals.md",{"type":195,"value":196,"toc":910},"minimark",[197,206,213,218,224,351,367,390,394,400,573,576,582,586,592,664,667,673,690,693,707,724,728,744,748,761,817,826,829,832,837,897,900,904],[198,199,200,201,205],"p",{},"The site running Dodock Wolf records its own signals from Frappe's documents and requests. No\nagent is needed. Each signal has a switch in ",[202,203,204],"strong",{},"Wolf Settings",", and all are on by default.",[198,207,208,209,212],{},"These signals are only seen from inside a site. To get them for the other sites of a bench,\ninstall the Wolf App on each one in satellite mode: it captures the same signals, with the same\nswitches, and forwards them to the central site. See ",[210,211,40],"a",{"href":41},".",[214,215,217],"h2",{"id":216},"logins-and-roles","Logins and roles",[198,219,220,223],{},[202,221,222],{},"Wolf Settings → Local signals (this site)",":",[225,226,227,249],"table",{},[228,229,230],"thead",{},[231,232,233,237,240,243,246],"tr",{},[234,235,236],"th",{},"Setting",[234,238,239],{},"Category",[234,241,242],{},"What it records",[234,244,245],{},"Severity",[234,247,248],{},"Preset",[250,251,252,279,301,328],"tbody",{},[231,253,254,260,266,269,272],{},[255,256,257],"td",{},[202,258,259],{},"Capture failed logins",[255,261,262],{},[263,264,265],"code",{},"frappe_failed_login",[255,267,268],{},"a failed desk login (Activity Log), with the user and IP",[255,270,271],{},"warning",[255,273,274,278],{},[275,276,277],"em",{},"Repeated failed Frappe logins",": 5+ in 10 min, per site",[231,280,281,286,291,294,296],{},[255,282,283],{},[202,284,285],{},"Flag privileged logins from new IPs",[255,287,288],{},[263,289,290],{},"new_admin_ip",[255,292,293],{},"a privileged user logs in from an IP none of their earlier logins came from",[255,295,271],{},[255,297,298],{},[275,299,300],{},"Admin login from new IP",[231,302,303,308,313,320,323],{},[255,304,305],{},[202,306,307],{},"Flag privileged logins from new countries",[255,309,310],{},[263,311,312],{},"admin_login_new_country",[255,314,315,316],{},"a privileged login from a country none of the user's earlier logins came from. Needs a ",[210,317,319],{"href":318},"#geoip-database","GeoIP database",[255,321,322],{},"critical",[255,324,325],{},[275,326,327],{},"Admin login from new country",[231,329,330,335,340,343,346],{},[255,331,332],{},[202,333,334],{},"Flag users granted privileged roles",[255,336,337],{},[263,338,339],{},"privileged_user",[255,341,342],{},"an enabled user receives a privileged role",[255,344,345],{},"critical for System Manager or Administrator, else warning",[255,347,348],{},[275,349,350],{},"Privileged role granted",[198,352,353,356,357,360,361,360,364,212],{},[202,354,355],{},"Privileged Roles"," lists the roles that count as privileged, one per line. Default:\n",[263,358,359],{},"System Manager",", ",[263,362,363],{},"Administrator",[263,365,366],{},"Wolf Manager",[198,368,369,370,373,374,377,378,381,382,385,386,389],{},"The same section holds the non-security local signals: ",[202,371,372],{},"Capture failed Scheduled Job Logs","\n(",[263,375,376],{},"cron_failure",") and ",[202,379,380],{},"Capture Error Logs"," (failed backups as ",[263,383,384],{},"backup_failed","). ",[202,387,388],{},"Watch the Email\nQueue"," records Email Queue backlogs and sending errors.",[214,391,393],{"id":392},"risky-application-changes","Risky application changes",[198,395,396,399],{},[202,397,398],{},"Wolf Settings → Flag risky application changes"," (on by default) covers:",[225,401,402,416],{},[228,403,404],{},[231,405,406,408,411,414],{},[234,407,239],{},[234,409,410],{},"What raises it",[234,412,413],{},"ATT&CK",[234,415,248],{},[250,417,418,437,455,472,494,516,535,555],{},[231,419,420,425,428,431],{},[255,421,422],{},[263,423,424],{},"server_script_change",[255,426,427],{},"a Server Script created, enabled, or with its code, type or trigger changed",[255,429,430],{},"T1059.006",[255,432,433,436],{},[275,434,435],{},"Server Script can run new code"," (the event is critical for API and scheduled scripts or guest access)",[231,438,439,444,447,450],{},[255,440,441],{},[263,442,443],{},"client_script_change",[255,445,446],{},"the same for a Client Script",[255,448,449],{},"T1059.007",[255,451,452],{},[275,453,454],{},"Client Script can run new code",[231,456,457,462,465,467],{},[255,458,459],{},[263,460,461],{},"console_execution",[255,463,464],{},"each System Console run (Python or SQL)",[255,466,430],{},[255,468,469],{},[275,470,471],{},"System Console used",[231,473,474,479,486,489],{},[255,475,476],{},[263,477,478],{},"permission_change",[255,480,481,482],{},"see ",[210,483,485],{"href":484},"#permission-drift","Permission drift",[255,487,488],{},"T1098",[255,490,491],{},[275,492,493],{},"Permission rules changed",[231,495,496,501,507,510],{},[255,497,498],{},[263,499,500],{},"security_settings_weakened",[255,502,481,503],{},[210,504,506],{"href":505},"#weakened-settings","Weakened settings",[255,508,509],{},"T1562.001",[255,511,512,515],{},[275,513,514],{},"Security settings weakened"," (critical)",[231,517,518,523,526,529],{},[255,519,520],{},[263,521,522],{},"api_key_generated",[255,524,525],{},"a new API secret written for a user",[255,527,528],{},"T1098.001",[255,530,531,534],{},[275,532,533],{},"API key generated"," (the event is critical for privileged users)",[231,536,537,542,548,551],{},[255,538,539],{},[263,540,541],{},"api_key_new_ip",[255,543,481,544],{},[210,545,547],{"href":546},"#api-key-used-from-a-new-ip","API key used from a new IP",[255,549,550],{},"T1078, T1552",[255,552,553],{},[275,554,547],{},[231,556,557,562,565,568],{},[255,558,559],{},[263,560,561],{},"webhook_external",[255,563,564],{},"a Webhook created, enabled or pointed at another host",[255,566,567],{},"T1567",[255,569,570],{},[275,571,572],{},"Webhook to a new host",[198,574,575],{},"Editing a script's description or disabling a script raises nothing.",[577,578,579],"caution",{},[198,580,581],{},"Script events keep the first 300 characters of the code. A script that holds a secret puts part\nof it in the event.",[583,584,485],"h3",{"id":585},"permission-drift",[198,587,588,589,591],{},"All of these are ",[263,590,478],{}," events:",[593,594,595,613,638,648,658],"ul",{},[596,597,598,601,602,360,605,608,609,612],"li",{},[202,599,600],{},"Role Permission Manager",": add, update, remove and reset. Older Frappe versions write\n",[263,603,604],{},"update",[263,606,607],{},"remove"," and ",[263,610,611],{},"reset"," with raw SQL, so Wolf reads them from the request.",[596,614,615,618,619,622,623,360,626,629,630,633,634,637],{},[202,616,617],{},"Custom DocPerm"," saved or deleted anywhere else: Data Import, the REST API, code\n(",[263,620,621],{},"payload.kind"," is ",[263,624,625],{},"custom_docperm",[263,627,628],{},"via"," says how). Each event lists the rights granted and\nremoved. A new rule is compared with the DocType's standard rule, so the copies Frappe makes\nbefore the first custom change grant nothing. A right given to ",[263,631,632],{},"Guest"," or ",[263,635,636],{},"All"," is critical.",[596,639,640,643,644,647],{},[202,641,642],{},"User Permission"," that lets its user see more (",[263,645,646],{},"user_permission","). The first User Permission\nof a user for a DocType only restricts and raises nothing. A further value, an edit that allows\nanother value, user or DocType, or removing the last one (which lifts the restriction) raises an\nevent.",[596,649,650,653,654,657],{},[202,651,652],{},"Desk access",": a Website user (customer, supplier portal) given a desk role, which makes them\na System User (",[263,655,656],{},"desk_access",").",[596,659,660,663],{},[202,661,662],{},"Role Profile"," created or granting more roles.",[583,665,506],{"id":666},"weakened-settings",[198,668,669,670,672],{},"A System Settings save raises ",[263,671,500],{}," (critical) when it:",[593,674,675,678,681,684,687],{},[596,676,677],{},"turns off two-factor authentication, the password policy, one session per user, SSO-only login\nor logout on password reset;",[596,679,680],{},"lowers the minimum password score or the lockout duration;",[596,682,683],{},"allows more failed logins, or removes the lockout;",[596,685,686],{},"lengthens sessions;",[596,688,689],{},"lets guests upload files.",[583,691,547],{"id":692},"api-key-used-from-a-new-ip",[198,694,695,696,699,700,703,704,212],{},"Every successful request authenticated by an API key (",[263,697,698],{},"Authorization: token key:secret"," or\n",[263,701,702],{},"Basic",") records the key's address in ",[202,705,706],{},"Wolf API Key IP",[593,708,709,712,718,721],{},[596,710,711],{},"The key's first address, and any address in its first 24 h, form its baseline.",[596,713,714,715,717],{},"After that, an address outside every known \u002F24 (IPv4) or \u002F64 (IPv6) raises ",[263,716,541],{},",\ncritical for privileged users. A new address inside a known network is recorded silently.",[596,719,720],{},"Addresses unused for a year are forgotten. Deleting a row forgets an address.",[596,722,723],{},"The proposed responses are revoking the user's API keys and blocking the address.",[583,725,727],{"id":726},"limits","Limits",[593,729,730,737],{},[596,731,732,733,736],{},"Changes made with raw SQL (a patch, ",[263,734,735],{},"bench mariadb",") fire no document event and are not seen.\nPatches and migrations are skipped on purpose.",[596,738,739,740,743],{},"A User Permission restricted to one DocType (",[263,741,742],{},"applicable_for",") is counted with the user's\nothers for the same allowed DocType.",[214,745,747],{"id":746},"unusual-data-exports","Unusual data exports",[198,749,750,753,754,757,758,212],{},[202,751,752],{},"Wolf Settings → Flag unusual data exports"," (on by default) raises ",[263,755,756],{},"data_exfiltration","\n(T1567, T1030). Preset: ",[275,759,760],{},"Unusual data export",[593,762,763,777,790,811],{},[596,764,765,768,769,772,773,776],{},[202,766,767],{},"What counts",": report exports, Data Export, Data Import templates with records, bulk PDFs,\nand every list read (",[263,770,771],{},"frappe.client.get_list",", the list and report views,\n",[263,774,775],{},"\u002Fapi\u002Fresource\u002F\u003CDocType>","), whatever the page size. A script paging through a table adds up\nlike one big read.",[596,778,779,782,783,786,787,657],{},[202,780,781],{},"How",": the response size of each request counts towards the user's total for the clock\nhour. Every hour, the totals become ",[263,784,785],{},"user_export_bytes"," samples, one series per user\n(",[263,788,789],{},"labels.user",[596,791,792,795,796,799,800,803,804,799,807,810],{},[202,793,794],{},"When",": past ",[202,797,798],{},"Export Floor (MB per hour)"," (default ",[263,801,802],{},"50","), the hour is compared with the\nuser's largest hour over the last 14 days. Warning at ",[202,805,806],{},"Export Factor",[263,808,809],{},"5",") times\nthat hour, critical at 20 times. A user without any history is critical, except while the site\nitself has less than 14 days of history: then it is a warning.",[596,812,813,816],{},[202,814,815],{},"How often",": at most one event per user, hour and severity, so a warning can be followed by\na critical. The payload has the hour's bytes, requests and rows, the baseline, the ratio, the\nlast request and the IP.",[818,819,820],"note",{},[198,821,822,823,825],{},"The ",[263,824,785],{}," series names users. Anyone who may read the site's metrics in Wolf sees\nhow much each user took out per hour.",[198,827,828],{},"Not counted: files sent as they are (private files, backups), printing one document, and the\nfile of a background list export (its request is counted). An export spread across two clock\nhours is split in two. Satellites keep raw samples for 2 days, so their baseline covers 2 days,\nnot 14.",[214,830,319],{"id":831},"geoip-database",[198,833,834,836],{},[275,835,327],{}," needs an offline GeoIP database on the server. Wolf never calls\nan online lookup service.",[838,839,841,845,848,876,880,890,894],"steps",{"level":840},"3",[583,842,844],{"id":843},"download-a-database","Download a database",[198,846,847],{},"Either format works:",[593,849,850,861],{},[596,851,852,853,856,857,860],{},"a MaxMind-format ",[263,854,855],{},".mmdb"," file: GeoLite2-Country or GeoLite2-City (free MaxMind account),\nDB-IP \"IP to Country Lite\" (",[263,858,859],{},"dbip-country-lite-*.mmdb",", CC BY 4.0) or IPinfo Lite. Wolf reads\nit with its own reader, so no extra Python package is needed;",[596,862,863,864,867,868,871,872,875],{},"a CSV of ranges, one per line: ",[263,865,866],{},"start_ip,end_ip,CC"," (DB-IP or IPinfo \"country lite\" CSV),\ninteger ",[263,869,870],{},"start,end,CC,..."," (IP2Location LITE DB1) or ",[263,873,874],{},"network\u002Fprefix,CC",". Header lines are\nskipped.",[583,877,879],{"id":878},"set-the-path","Set the path",[198,881,882,883,886,887,212],{},"Set ",[202,884,885],{},"Wolf Settings → GeoIP Database"," to the file's path. A relative path is read from the site\ndirectory, for example ",[263,888,889],{},"private\u002Ffiles\u002Fdbip-country.mmdb",[583,891,893],{"id":892},"keep-it-fresh","Keep it fresh",[198,895,896],{},"Refresh the file monthly. Wolf reloads it when it changes.",[198,898,899],{},"Private and loopback addresses have no country. A user whose earlier logins all came from such\naddresses has no baseline yet, so nothing is flagged until a first public login is known.",[214,901,903],{"id":902},"turning-a-signal-off","Turning a signal off",[198,905,906,907,909],{},"Untick its switch in ",[202,908,204],{},". On a satellite, the same switches apply to the signals it\nforwards.",{"title":911,"searchDepth":912,"depth":913,"links":914},"",1,2,[915,916,923,924,925],{"id":216,"depth":913,"text":217},{"id":392,"depth":913,"text":393,"children":917},[918,920,921,922],{"id":585,"depth":919,"text":485},3,{"id":666,"depth":919,"text":506},{"id":692,"depth":919,"text":547},{"id":726,"depth":919,"text":727},{"id":746,"depth":913,"text":747},{"id":831,"depth":913,"text":319},{"id":902,"depth":913,"text":903},"Turn on the security signals the Wolf site captures by itself, with no agent, and set up the GeoIP database for new-country logins.","md",null,{},{"icon":132},{"title":129,"description":926},"1NzNxCFzwhzsmQGYU7Vcyghn3Tb5sj5TsRV5glnEhY4",[934,936],{"title":126,"path":122,"stem":123,"description":935,"icon":127},"What Dodock Wolf detects, where each security signal comes from, and how every event is tagged with MITRE ATT&CK.",{"title":134,"path":135,"stem":136,"description":937,"icon":137},"What the Wolf Agent detects in nginx access logs and the auth log, which bench services and site settings it reports as exposed, and which presets alert on them.",1795001842754]