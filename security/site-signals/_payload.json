[{"data":1,"prerenderedAt":928},["ShallowReactive",2],{"navigation-en":3,"\u002Fsecurity\u002Fsite-signals":182,"\u002Fsecurity\u002Fsite-signals-surround":923},[4,23,50,84,110,151],{"title":5,"path":6,"stem":7,"children":8,"icon":22},"Getting started","\u002Fgetting-started","1.getting-started\u002F1.index",[9,12,17],{"title":10,"path":6,"stem":7,"icon":11},"Introduction","i-lucide-house",{"title":13,"path":14,"stem":15,"icon":16},"Quickstart","\u002Fgetting-started\u002Fquickstart","1.getting-started\u002F2.quickstart","i-lucide-timer",{"title":18,"path":19,"stem":20,"icon":21},"Concepts","\u002Fgetting-started\u002Fconcepts","1.getting-started\u002F3.concepts","i-lucide-shapes","i-lucide-rocket",{"title":24,"icon":25,"path":26,"stem":27,"children":28,"page":49},"Install","i-lucide-download","\u002Finstall","2.install",[29,34,39,44],{"title":30,"path":31,"stem":32,"icon":33},"Wolf App","\u002Finstall\u002Fwolf-app","2.install\u002F1.wolf-app","i-lucide-app-window",{"title":35,"path":36,"stem":37,"icon":38},"Wolf Agent","\u002Finstall\u002Fwolf-agent","2.install\u002F2.wolf-agent","i-lucide-server",{"title":40,"path":41,"stem":42,"icon":43},"Every site on a bench","\u002Finstall\u002Fevery-site","2.install\u002F3.every-site","i-lucide-network",{"title":45,"path":46,"stem":47,"icon":48},"Pilot benches","\u002Finstall\u002Fpilot","2.install\u002F5.pilot","i-lucide-plane",false,{"title":35,"icon":38,"path":51,"stem":52,"children":53,"page":49},"\u002Fagent","3.agent",[54,59,64,69,74,79],{"title":55,"path":56,"stem":57,"icon":58},"What is collected","\u002Fagent\u002Fcollected","3.agent\u002F1.collected","i-lucide-list-checks",{"title":60,"path":61,"stem":62,"icon":63},"Configuration","\u002Fagent\u002Fconfiguration","3.agent\u002F2.configuration","i-lucide-settings",{"title":65,"path":66,"stem":67,"icon":68},"Commands","\u002Fagent\u002Fcommands","3.agent\u002F3.commands","i-lucide-terminal",{"title":70,"path":71,"stem":72,"icon":73},"Scrubbing","\u002Fagent\u002Fscrubbing","3.agent\u002F4.scrubbing","i-lucide-eraser",{"title":75,"path":76,"stem":77,"icon":78},"Watchdog","\u002Fagent\u002Fwatchdog","3.agent\u002F5.watchdog","i-lucide-heart-pulse",{"title":80,"path":81,"stem":82,"icon":83},"Response actions","\u002Fagent\u002Fresponse-actions","3.agent\u002F6.response-actions","i-lucide-shield-ban",{"title":85,"icon":86,"path":87,"stem":88,"children":89,"page":49},"Alerts and incidents","i-lucide-bell","\u002Falerts","4.alerts",[90,95,100,105],{"title":91,"path":92,"stem":93,"icon":94},"Alert rules","\u002Falerts\u002Frules","4.alerts\u002F1.rules","i-lucide-sliders-horizontal",{"title":96,"path":97,"stem":98,"icon":99},"Preset rules","\u002Falerts\u002Fpresets","4.alerts\u002F2.presets","i-lucide-list-todo",{"title":101,"path":102,"stem":103,"icon":104},"Channels","\u002Falerts\u002Fchannels","4.alerts\u002F3.channels","i-lucide-send",{"title":106,"path":107,"stem":108,"icon":109},"Incidents","\u002Falerts\u002Fincidents","4.alerts\u002F4.incidents","i-lucide-siren",{"title":111,"path":112,"stem":113,"children":114,"icon":117},"Security","\u002Fsecurity","5.security\u002F1.index",[115,118,123,128,133,138,143,147],{"title":116,"path":112,"stem":113,"icon":117},"Security overview","i-lucide-shield",{"title":119,"path":120,"stem":121,"icon":122},"Site signals","\u002Fsecurity\u002Fsite-signals","5.security\u002F2.site-signals","i-lucide-globe",{"title":124,"path":125,"stem":126,"icon":127},"Web and host detection","\u002Fsecurity\u002Fdetection","5.security\u002F3.detection","i-lucide-radar",{"title":129,"path":130,"stem":131,"icon":132},"Access and secrets","\u002Fsecurity\u002Faccess","5.security\u002F4.access","i-lucide-key-round",{"title":134,"path":135,"stem":136,"icon":137},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":139,"path":140,"stem":141,"icon":142},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":144,"path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":183,"title":119,"body":184,"description":916,"extension":917,"links":918,"meta":919,"navigation":920,"path":120,"seo":921,"stem":121,"__hash__":922},"docs_en\u002F5.security\u002F2.site-signals.md",{"type":185,"value":186,"toc":900},"minimark",[187,196,203,208,214,341,357,380,384,390,563,566,572,576,582,654,657,663,680,683,697,714,718,734,738,751,807,816,819,822,827,887,890,894],[188,189,190,191,195],"p",{},"The site running Dodock Wolf records its own signals from Frappe's documents and requests. No\nagent is needed. Each signal has a switch in ",[192,193,194],"strong",{},"Wolf Settings",", and all are on by default.",[188,197,198,199,202],{},"These signals are only seen from inside a site. To get them for the other sites of a bench,\ninstall the Wolf App on each one in satellite mode: it captures the same signals, with the same\nswitches, and forwards them to the central site. See ",[200,201,40],"a",{"href":41},".",[204,205,207],"h2",{"id":206},"logins-and-roles","Logins and roles",[188,209,210,213],{},[192,211,212],{},"Wolf Settings → Local signals (this site)",":",[215,216,217,239],"table",{},[218,219,220],"thead",{},[221,222,223,227,230,233,236],"tr",{},[224,225,226],"th",{},"Setting",[224,228,229],{},"Category",[224,231,232],{},"What it records",[224,234,235],{},"Severity",[224,237,238],{},"Preset",[240,241,242,269,291,318],"tbody",{},[221,243,244,250,256,259,262],{},[245,246,247],"td",{},[192,248,249],{},"Capture failed logins",[245,251,252],{},[253,254,255],"code",{},"frappe_failed_login",[245,257,258],{},"a failed desk login (Activity Log), with the user and IP",[245,260,261],{},"warning",[245,263,264,268],{},[265,266,267],"em",{},"Repeated failed Frappe logins",": 5+ in 10 min, per site",[221,270,271,276,281,284,286],{},[245,272,273],{},[192,274,275],{},"Flag privileged logins from new IPs",[245,277,278],{},[253,279,280],{},"new_admin_ip",[245,282,283],{},"a privileged user logs in from an IP none of their earlier logins came from",[245,285,261],{},[245,287,288],{},[265,289,290],{},"Admin login from new IP",[221,292,293,298,303,310,313],{},[245,294,295],{},[192,296,297],{},"Flag privileged logins from new countries",[245,299,300],{},[253,301,302],{},"admin_login_new_country",[245,304,305,306],{},"a privileged login from a country none of the user's earlier logins came from. Needs a ",[200,307,309],{"href":308},"#geoip-database","GeoIP database",[245,311,312],{},"critical",[245,314,315],{},[265,316,317],{},"Admin login from new country",[221,319,320,325,330,333,336],{},[245,321,322],{},[192,323,324],{},"Flag users granted privileged roles",[245,326,327],{},[253,328,329],{},"privileged_user",[245,331,332],{},"an enabled user receives a privileged role",[245,334,335],{},"critical for System Manager or Administrator, else warning",[245,337,338],{},[265,339,340],{},"Privileged role granted",[188,342,343,346,347,350,351,350,354,202],{},[192,344,345],{},"Privileged Roles"," lists the roles that count as privileged, one per line. Default:\n",[253,348,349],{},"System Manager",", ",[253,352,353],{},"Administrator",[253,355,356],{},"Wolf Manager",[188,358,359,360,363,364,367,368,371,372,375,376,379],{},"The same section holds the non-security local signals: ",[192,361,362],{},"Capture failed Scheduled Job Logs","\n(",[253,365,366],{},"cron_failure",") and ",[192,369,370],{},"Capture Error Logs"," (failed backups as ",[253,373,374],{},"backup_failed","). ",[192,377,378],{},"Watch the Email\nQueue"," records Email Queue backlogs and sending errors.",[204,381,383],{"id":382},"risky-application-changes","Risky application changes",[188,385,386,389],{},[192,387,388],{},"Wolf Settings → Flag risky application changes"," (on by default) covers:",[215,391,392,406],{},[218,393,394],{},[221,395,396,398,401,404],{},[224,397,229],{},[224,399,400],{},"What raises it",[224,402,403],{},"ATT&CK",[224,405,238],{},[240,407,408,427,445,462,484,506,525,545],{},[221,409,410,415,418,421],{},[245,411,412],{},[253,413,414],{},"server_script_change",[245,416,417],{},"a Server Script created, enabled, or with its code, type or trigger changed",[245,419,420],{},"T1059.006",[245,422,423,426],{},[265,424,425],{},"Server Script can run new code"," (the event is critical for API and scheduled scripts or guest access)",[221,428,429,434,437,440],{},[245,430,431],{},[253,432,433],{},"client_script_change",[245,435,436],{},"the same for a Client Script",[245,438,439],{},"T1059.007",[245,441,442],{},[265,443,444],{},"Client Script can run new code",[221,446,447,452,455,457],{},[245,448,449],{},[253,450,451],{},"console_execution",[245,453,454],{},"each System Console run (Python or SQL)",[245,456,420],{},[245,458,459],{},[265,460,461],{},"System Console used",[221,463,464,469,476,479],{},[245,465,466],{},[253,467,468],{},"permission_change",[245,470,471,472],{},"see ",[200,473,475],{"href":474},"#permission-drift","Permission drift",[245,477,478],{},"T1098",[245,480,481],{},[265,482,483],{},"Permission rules changed",[221,485,486,491,497,500],{},[245,487,488],{},[253,489,490],{},"security_settings_weakened",[245,492,471,493],{},[200,494,496],{"href":495},"#weakened-settings","Weakened settings",[245,498,499],{},"T1562.001",[245,501,502,505],{},[265,503,504],{},"Security settings weakened"," (critical)",[221,507,508,513,516,519],{},[245,509,510],{},[253,511,512],{},"api_key_generated",[245,514,515],{},"a new API secret written for a user",[245,517,518],{},"T1098.001",[245,520,521,524],{},[265,522,523],{},"API key generated"," (the event is critical for privileged users)",[221,526,527,532,538,541],{},[245,528,529],{},[253,530,531],{},"api_key_new_ip",[245,533,471,534],{},[200,535,537],{"href":536},"#api-key-used-from-a-new-ip","API key used from a new IP",[245,539,540],{},"T1078, T1552",[245,542,543],{},[265,544,537],{},[221,546,547,552,555,558],{},[245,548,549],{},[253,550,551],{},"webhook_external",[245,553,554],{},"a Webhook created, enabled or pointed at another host",[245,556,557],{},"T1567",[245,559,560],{},[265,561,562],{},"Webhook to a new host",[188,564,565],{},"Editing a script's description or disabling a script raises nothing.",[567,568,569],"caution",{},[188,570,571],{},"Script events keep the first 300 characters of the code. A script that holds a secret puts part\nof it in the event.",[573,574,475],"h3",{"id":575},"permission-drift",[188,577,578,579,581],{},"All of these are ",[253,580,468],{}," events:",[583,584,585,603,628,638,648],"ul",{},[586,587,588,591,592,350,595,598,599,602],"li",{},[192,589,590],{},"Role Permission Manager",": add, update, remove and reset. Older Frappe versions write\n",[253,593,594],{},"update",[253,596,597],{},"remove"," and ",[253,600,601],{},"reset"," with raw SQL, so Wolf reads them from the request.",[586,604,605,608,609,612,613,350,616,619,620,623,624,627],{},[192,606,607],{},"Custom DocPerm"," saved or deleted anywhere else: Data Import, the REST API, code\n(",[253,610,611],{},"payload.kind"," is ",[253,614,615],{},"custom_docperm",[253,617,618],{},"via"," says how). Each event lists the rights granted and\nremoved. A new rule is compared with the DocType's standard rule, so the copies Frappe makes\nbefore the first custom change grant nothing. A right given to ",[253,621,622],{},"Guest"," or ",[253,625,626],{},"All"," is critical.",[586,629,630,633,634,637],{},[192,631,632],{},"User Permission"," that lets its user see more (",[253,635,636],{},"user_permission","). The first User Permission\nof a user for a DocType only restricts and raises nothing. A further value, an edit that allows\nanother value, user or DocType, or removing the last one (which lifts the restriction) raises an\nevent.",[586,639,640,643,644,647],{},[192,641,642],{},"Desk access",": a Website user (customer, supplier portal) given a desk role, which makes them\na System User (",[253,645,646],{},"desk_access",").",[586,649,650,653],{},[192,651,652],{},"Role Profile"," created or granting more roles.",[573,655,496],{"id":656},"weakened-settings",[188,658,659,660,662],{},"A System Settings save raises ",[253,661,490],{}," (critical) when it:",[583,664,665,668,671,674,677],{},[586,666,667],{},"turns off two-factor authentication, the password policy, one session per user, SSO-only login\nor logout on password reset;",[586,669,670],{},"lowers the minimum password score or the lockout duration;",[586,672,673],{},"allows more failed logins, or removes the lockout;",[586,675,676],{},"lengthens sessions;",[586,678,679],{},"lets guests upload files.",[573,681,537],{"id":682},"api-key-used-from-a-new-ip",[188,684,685,686,689,690,693,694,202],{},"Every successful request authenticated by an API key (",[253,687,688],{},"Authorization: token key:secret"," or\n",[253,691,692],{},"Basic",") records the key's address in ",[192,695,696],{},"Wolf API Key IP",[583,698,699,702,708,711],{},[586,700,701],{},"The key's first address, and any address in its first 24 h, form its baseline.",[586,703,704,705,707],{},"After that, an address outside every known \u002F24 (IPv4) or \u002F64 (IPv6) raises ",[253,706,531],{},",\ncritical for privileged users. A new address inside a known network is recorded silently.",[586,709,710],{},"Addresses unused for a year are forgotten. Deleting a row forgets an address.",[586,712,713],{},"The proposed responses are revoking the user's API keys and blocking the address.",[573,715,717],{"id":716},"limits","Limits",[583,719,720,727],{},[586,721,722,723,726],{},"Changes made with raw SQL (a patch, ",[253,724,725],{},"bench mariadb",") fire no document event and are not seen.\nPatches and migrations are skipped on purpose.",[586,728,729,730,733],{},"A User Permission restricted to one DocType (",[253,731,732],{},"applicable_for",") is counted with the user's\nothers for the same allowed DocType.",[204,735,737],{"id":736},"unusual-data-exports","Unusual data exports",[188,739,740,743,744,747,748,202],{},[192,741,742],{},"Wolf Settings → Flag unusual data exports"," (on by default) raises ",[253,745,746],{},"data_exfiltration","\n(T1567, T1030). Preset: ",[265,749,750],{},"Unusual data export",[583,752,753,767,780,801],{},[586,754,755,758,759,762,763,766],{},[192,756,757],{},"What counts",": report exports, Data Export, Data Import templates with records, bulk PDFs,\nand every list read (",[253,760,761],{},"frappe.client.get_list",", the list and report views,\n",[253,764,765],{},"\u002Fapi\u002Fresource\u002F\u003CDocType>","), whatever the page size. A script paging through a table adds up\nlike one big read.",[586,768,769,772,773,776,777,647],{},[192,770,771],{},"How",": the response size of each request counts towards the user's total for the clock\nhour. Every hour, the totals become ",[253,774,775],{},"user_export_bytes"," samples, one series per user\n(",[253,778,779],{},"labels.user",[586,781,782,785,786,789,790,793,794,789,797,800],{},[192,783,784],{},"When",": past ",[192,787,788],{},"Export Floor (MB per hour)"," (default ",[253,791,792],{},"50","), the hour is compared with the\nuser's largest hour over the last 14 days. Warning at ",[192,795,796],{},"Export Factor",[253,798,799],{},"5",") times\nthat hour, critical at 20 times. A user without any history is critical, except while the site\nitself has less than 14 days of history: then it is a warning.",[586,802,803,806],{},[192,804,805],{},"How often",": at most one event per user, hour and severity, so a warning can be followed by\na critical. The payload has the hour's bytes, requests and rows, the baseline, the ratio, the\nlast request and the IP.",[808,809,810],"note",{},[188,811,812,813,815],{},"The ",[253,814,775],{}," series names users. Anyone who may read the site's metrics in Wolf sees\nhow much each user took out per hour.",[188,817,818],{},"Not counted: files sent as they are (private files, backups), printing one document, and the\nfile of a background list export (its request is counted). An export spread across two clock\nhours is split in two. Satellites keep raw samples for 2 days, so their baseline covers 2 days,\nnot 14.",[204,820,309],{"id":821},"geoip-database",[188,823,824,826],{},[265,825,317],{}," needs an offline GeoIP database on the server. Wolf never calls\nan online lookup service.",[828,829,831,835,838,866,870,880,884],"steps",{"level":830},"3",[573,832,834],{"id":833},"download-a-database","Download a database",[188,836,837],{},"Either format works:",[583,839,840,851],{},[586,841,842,843,846,847,850],{},"a MaxMind-format ",[253,844,845],{},".mmdb"," file: GeoLite2-Country or GeoLite2-City (free MaxMind account),\nDB-IP \"IP to Country Lite\" (",[253,848,849],{},"dbip-country-lite-*.mmdb",", CC BY 4.0) or IPinfo Lite. Wolf reads\nit with its own reader, so no extra Python package is needed;",[586,852,853,854,857,858,861,862,865],{},"a CSV of ranges, one per line: ",[253,855,856],{},"start_ip,end_ip,CC"," (DB-IP or IPinfo \"country lite\" CSV),\ninteger ",[253,859,860],{},"start,end,CC,..."," (IP2Location LITE DB1) or ",[253,863,864],{},"network\u002Fprefix,CC",". Header lines are\nskipped.",[573,867,869],{"id":868},"set-the-path","Set the path",[188,871,872,873,876,877,202],{},"Set ",[192,874,875],{},"Wolf Settings → GeoIP Database"," to the file's path. A relative path is read from the site\ndirectory, for example ",[253,878,879],{},"private\u002Ffiles\u002Fdbip-country.mmdb",[573,881,883],{"id":882},"keep-it-fresh","Keep it fresh",[188,885,886],{},"Refresh the file monthly. Wolf reloads it when it changes.",[188,888,889],{},"Private and loopback addresses have no country. A user whose earlier logins all came from such\naddresses has no baseline yet, so nothing is flagged until a first public login is known.",[204,891,893],{"id":892},"turning-a-signal-off","Turning a signal off",[188,895,896,897,899],{},"Untick its switch in ",[192,898,194],{},". On a satellite, the same switches apply to the signals it\nforwards.",{"title":901,"searchDepth":902,"depth":903,"links":904},"",1,2,[905,906,913,914,915],{"id":206,"depth":903,"text":207},{"id":382,"depth":903,"text":383,"children":907},[908,910,911,912],{"id":575,"depth":909,"text":475},3,{"id":656,"depth":909,"text":496},{"id":682,"depth":909,"text":537},{"id":716,"depth":909,"text":717},{"id":736,"depth":903,"text":737},{"id":821,"depth":903,"text":309},{"id":892,"depth":903,"text":893},"Turn on the security signals the Wolf site captures by itself, with no agent, and set up the GeoIP database for new-country logins.","md",null,{},{"icon":122},{"title":119,"description":916},"1NzNxCFzwhzsmQGYU7Vcyghn3Tb5sj5TsRV5glnEhY4",[924,926],{"title":116,"path":112,"stem":113,"description":925,"icon":117},"What Dodock Wolf detects, where each security signal comes from, and how every event is tagged with MITRE ATT&CK.",{"title":124,"path":125,"stem":126,"description":927,"icon":127},"What the Wolf Agent detects in nginx access logs and the auth log, which bench services and site settings it reports as exposed, and which presets alert on them.",1795104294644]