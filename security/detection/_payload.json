":145,"stem":146,"icon":147},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":193,"title":134,"body":194,"description":1194,"extension":1195,"links":1196,"meta":1197,"navigation":1198,"path":135,"seo":1199,"stem":136,"__hash__":1200},"docs_en\u002F5.security\u002F3.detection.md",{"type":195,"value":196,"toc":1175},"minimark",[197,210,215,232,237,240,274,277,281,330,334,362,366,380,384,425,429,439,495,505,536,680,693,697,704,708,718,779,786,792,796,804,829,833,843,879,886,890,896,1011,1084,1121,1125,1168,1171],[198,199,200,201,205,206,209],"p",{},"The Wolf Agent runs its own web and host detection from logs it already tails. It needs no\nWazuh, Suricata or extra package. All findings are ",[202,203,204],"code",{},"security"," events, scrubbed on the host\nbefore they are sent (see ",[207,208,75],"a",{"href":76},").",[211,212,214],"h2",{"id":213},"web-attacks-from-nginx","Web attacks from nginx",[198,216,217,218,221,222,225,226,229,230,209],{},"The agent reads the same nginx access logs it uses for ",[202,219,220],{},"http_5xx"," and ",[202,223,224],{},"http_502",". Nothing to turn\non: when the agent tails a bench's nginx log, web attack detection runs. Log paths are set per\nbench in ",[202,227,228],{},"nginx_access_log"," (see ",[207,231,65],{"href":66},[233,234,236],"h3",{"id":235},"what-counts-as-a-probe","What counts as a probe",[198,238,239],{},"A request is a probe when it:",[241,242,243,258,268,271],"ul",{},[244,245,246,247,250,251,250,254,257],"li",{},"looks for secrets: ",[202,248,249],{},".env",", ",[202,252,253],{},".git\u002F",[202,255,256],{},"site_config.json",", keys, dumps;",[244,259,260,261,250,264,267],{},"looks for CMS and admin panels (",[202,262,263],{},"wp-login.php",[202,265,266],{},"phpmyadmin","…);",[244,269,270],{},"tries path traversal, SQL, command or template injection, or XSS;",[244,272,273],{},"comes from a scanner User-Agent (sqlmap, nuclei…).",[198,275,276],{},"URL-encoded targets are decoded twice before matching.",[233,278,280],{"id":279},"events","Events",[282,283,284,300],"table",{},[285,286,287],"thead",{},[288,289,290,294,297],"tr",{},[291,292,293],"th",{},"Category",[291,295,296],{},"Severity",[291,298,299],{},"What it means",[301,302,303,317],"tbody",{},[288,304,305,311,314],{},[306,307,308],"td",{},[202,309,310],{},"web_attack_probe",[306,312,313],{},"warning, critical once a client sends 50+ probes",[306,315,316],{},"one event per (site, client) and push interval, with the rules hit, the statuses, up to 10 targets and the ATT&CK IDs",[288,318,319,324,327],{},[306,320,321],{},[202,322,323],{},"web_sensitive_file_exposed",[306,325,326],{},"critical",[306,328,329],{},"a secret-bearing file was answered with a 2xx. The file was probably leaked",[233,331,333],{"id":332},"what-is-not-a-probe","What is not a probe",[241,335,336,349],{},[244,337,338,339,250,342,345,346,209],{},"Attachments (",[202,340,341],{},"\u002Ffiles",[202,343,344],{},"\u002Fprivate\u002Ffiles",") and authorized backup downloads (",[202,347,348],{},"\u002Fbackups",[244,350,351,352,250,355,250,358,361],{},"A 2xx under a route that answers any sub-path with a page (",[202,353,354],{},"\u002Fapp\u002F",[202,356,357],{},"\u002Fwolf\u002F",[202,359,360],{},"\u002Fapi\u002F","…) is not\ncounted as a served file.",[233,363,365],{"id":364},"the-client-address","The client address",[198,367,368,369,372,373,375,376,379],{},"The client is ",[202,370,371],{},"$remote_addr",". When ",[202,374,371],{}," is a loopback or private proxy, the agent takes\nthe right-most public address of the ",[202,377,378],{},"X-Forwarded-For"," list logged after it: the one your proxy\nappended. The left-most entries are written by the client and are not trusted.",[233,381,383],{"id":382},"presets","Presets",[282,385,386,396],{},[285,387,388],{},[288,389,390,393],{},[291,391,392],{},"Preset",[291,394,395],{},"Fires when",[301,397,398,412],{},[288,399,400,406],{},[306,401,402],{},[403,404,405],"em",{},"Web attack scan",[306,407,408,409,411],{},"100+ ",[202,410,310],{}," requests in 10 min, per site (warning)",[288,413,414,419],{},[306,415,416],{},[403,417,418],{},"Sensitive file served",[306,420,421,422,424],{},"any ",[202,423,323],{}," (critical). Rotate the secrets",[211,426,428],{"id":427},"host-intrusion-signals","Host intrusion signals",[198,430,431,432,250,435,438],{},"The agent reads ",[202,433,434],{},"\u002Fvar\u002Flog\u002Fauth.log",[202,436,437],{},"\u002Fvar\u002Flog\u002Fsecure",", or the journal:",[440,441,446],"pre",{"className":442,"code":443,"language":444,"meta":445,"style":445},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","journalctl -o short-iso -t sshd -t sshd-session -t sudo -t useradd -t usermod -t gpasswd\n","bash","",[202,447,448],{"__ignoreMap":445},[449,450,453,457,461,464,467,470,472,475,477,480,482,485,487,490,492],"span",{"class":451,"line":452},"line",1,[449,454,456],{"class":455},"sBMFI","journalctl",[449,458,460],{"class":459},"sfazB"," -o",[449,462,463],{"class":459}," short-iso",[449,465,466],{"class":459}," -t",[449,468,469],{"class":459}," sshd",[449,471,466],{"class":459},[449,473,474],{"class":459}," sshd-session",[449,476,466],{"class":459},[449,478,479],{"class":459}," sudo",[449,481,466],{"class":459},[449,483,484],{"class":459}," useradd",[449,486,466],{"class":459},[449,488,489],{"class":459}," usermod",[449,491,466],{"class":459},[449,493,494],{"class":459}," gpasswd\n",[198,496,497,500,501,504],{},[202,498,499],{},"sshd-session"," covers OpenSSH 9.8 and later. The ",[202,502,503],{},"short-iso"," format keeps each line's real\ntimestamp.",[198,506,507,508,511,512,515,516,519,520,523,524,527,528,531,532,535],{},"The ",[202,509,510],{},"auth_log"," setting picks the source: ",[202,513,514],{},"null"," auto-detects, a path forces a file, ",[202,517,518],{},"\"journal\"","\nforces journalctl, ",[202,521,522],{},"false"," turns it off. The installer adds the ",[202,525,526],{},"wolf-agent"," user to the ",[202,529,530],{},"adm"," and\n",[202,533,534],{},"systemd-journal"," groups when they exist, so it can read these logs without root.",[282,537,538,550],{},[285,539,540],{},[288,541,542,544,546,548],{},[291,543,293],{},[291,545,299],{},[291,547,296],{},[291,549,392],{},[301,551,552,571,587,604,622,642],{},[288,553,554,559,562,565],{},[306,555,556],{},[202,557,558],{},"ssh_failed_login",[306,560,561],{},"failed SSH logins, aggregated per source IP",[306,563,564],{},"warning, critical at 20+ in one event",[306,566,567,570],{},[403,568,569],{},"SSH brute force",": 20+ in 10 min, per host (critical)",[288,572,573,578,581,584],{},[306,574,575],{},[202,576,577],{},"ssh_root_login",[306,579,580],{},"a root login",[306,582,583],{},"warning",[306,585,586],{},"none",[288,588,589,594,597,599],{},[306,590,591],{},[202,592,593],{},"ssh_login_after_failures",[306,595,596],{},"a successful login from an address that failed 5+ times in the hour before. Failure counts survive push intervals",[306,598,326],{},[306,600,601],{},[403,602,603],{},"SSH login after brute force",[288,605,606,611,614,616],{},[306,607,608],{},[202,609,610],{},"sudo_failure",[306,612,613],{},"wrong sudo passwords, users outside sudoers",[306,615,583],{},[306,617,618,621],{},[403,619,620],{},"Repeated sudo failures",": 3+ in 10 min, per host",[288,623,624,629,635,637],{},[306,625,626],{},[202,627,628],{},"account_created",[306,630,631,634],{},[202,632,633],{},"useradd"," creates a local account",[306,636,583],{},[306,638,639],{},[403,640,641],{},"New system account",[288,643,644,649,673,675],{},[306,645,646],{},[202,647,648],{},"admin_group_change",[306,650,651,652,250,655,250,658,250,661,250,664,250,666,669,670],{},"a user is added to ",[202,653,654],{},"sudo",[202,656,657],{},"wheel",[202,659,660],{},"admin",[202,662,663],{},"root",[202,665,530],{},[202,667,668],{},"docker"," or ",[202,671,672],{},"lxd",[306,674,326],{},[306,676,677],{},[403,678,679],{},"User added to admin group",[681,682,683],"tip",{},[198,684,685,687,688,692],{},[403,686,641],{}," fires on planned provisioning too. Open a ",[689,690,691],"strong",{},"Wolf Silence"," for the host\nwhile you provision it.",[211,694,696],{"id":695},"exposure-and-site-config-risks","Exposure and site-config risks",[198,698,699,700,703],{},"Every ",[202,701,702],{},"exposure.interval"," (default 600 s), the agent checks what a host and its sites expose.",[233,705,707],{"id":706},"exposed-bench-services","Exposed bench services",[198,709,710,713,714,717],{},[202,711,712],{},"exposed_services"," per host counts bench ports listening on all interfaces or on a public address\nin ",[202,715,716],{},"\u002Fproc\u002Fnet\u002Ftcp{,6}",":",[282,719,720,730],{},[285,721,722],{},[288,723,724,727],{},[291,725,726],{},"Service",[291,728,729],{},"Port",[301,731,732,740,748,760,768],{},[288,733,734,737],{},[306,735,736],{},"MariaDB",[306,738,739],{},"3306",[288,741,742,745],{},[306,743,744],{},"Postgres",[306,746,747],{},"5432",[288,749,750,753],{},[306,751,752],{},"Redis",[306,754,755,756,759],{},"6379, 11000, 12000, 13000, or the bench's own ",[202,757,758],{},"redis_*"," ports",[288,761,762,765],{},[306,763,764],{},"socket.io",[306,766,767],{},"9000",[288,769,770,773],{},[306,771,772],{},"gunicorn",[306,774,775,776],{},"8000 or ",[202,777,778],{},"webserver_port",[198,780,781,782,785],{},"Add ports with ",[202,783,784],{},"exposure.ports",", a map of port to service name. A LAN address is not counted.",[787,788,789],"note",{},[198,790,791],{},"A listening socket is not proof of reachability: a firewall may still block what is counted.",[233,793,795],{"id":794},"site-config-risks","Site config risks",[198,797,798,801,802,717],{},[202,799,800],{},"site_config_risks"," per site counts these in ",[202,803,256],{},[241,805,806,812,817,823],{},[244,807,808,811],{},[202,809,810],{},"developer_mode",";",[244,813,814,811],{},[202,815,816],{},"allow_tests",[244,818,819,820,811],{},"a plain-HTTP ",[202,821,822],{},"host_name",[244,824,825,828],{},[202,826,827],{},"allow_cors: \"*\"",".",[233,830,832],{"id":831},"events-and-presets","Events and presets",[198,834,835,836,221,839,842],{},"The agent sends ",[202,837,838],{},"service_exposed",[202,840,841],{},"insecure_site_config"," events only when the set it finds\nchanges. Both are tagged T1190.",[282,844,845,853],{},[285,846,847],{},[288,848,849,851],{},[291,850,392],{},[291,852,395],{},[301,854,855,867],{},[288,856,857,862],{},[306,858,859],{},[403,860,861],{},"Bench service exposed",[306,863,864,866],{},[202,865,712],{}," above 0, per host (critical). Redis has no password by default",[288,868,869,874],{},[306,870,871],{},[403,872,873],{},"Development settings in production",[306,875,876,878],{},[202,877,800],{}," above 0, per site (warning)",[198,880,881,882,828],{},"Both metrics also feed the ",[207,883,885],{"href":884},"\u002Fsecurity\u002Fcompliance#security-score","security score",[211,887,889],{"id":888},"file-integrity","File integrity",[198,891,699,892,895],{},[202,893,894],{},"integrity.interval"," (default 900 s), the agent compares what a bench is made of with its\nbaseline:",[282,897,898,908],{},[285,899,900],{},[288,901,902,905],{},[291,903,904],{},"Watched",[291,906,907],{},"What a change means",[301,909,910,971,987],{},[288,911,912,948],{},[306,913,914,915,918,919,250,922,250,925,928,929,932,933,936,937,940,941,221,944,947],{},"each app under ",[202,916,917],{},"apps\u002F\u003Capp>\u002F"," (not ",[202,920,921],{},".git",[202,923,924],{},"node_modules",[202,926,927],{},"public\u002Fdist"," and other ",[202,930,931],{},"dist","\u002F",[202,934,935],{},"build"," output, ",[202,938,939],{},"*.egg-info",", caches, compiled ",[202,942,943],{},".pyc",[202,945,946],{},".mo"," files)",[306,949,950,951,953,954,957,958,960,961,964,965,967,968,970],{},"with the app's git commit unchanged: code changed outside a deployment (a web shell, a patched file), ",[689,952,326],{},". With a new commit: a deployment, ",[689,955,956],{},"info",", with both commits, or ",[689,959,583],{}," when it added Python under a ",[202,962,963],{},"www\u002F"," folder. Without a git checkout (an archive install, an image without ",[202,966,921],{},"), Wolf cannot tell: ",[689,969,583],{},", saying so",[288,972,973,982],{},[306,974,975,978,979],{},[202,976,977],{},"sites\u002Fcommon_site_config.json",", each ",[202,980,981],{},"sites\u002F\u003Csite>\u002Fsite_config.json",[306,983,984,986],{},[689,985,583],{},". Only the names of the keys added, changed or removed are sent, never their values",[288,988,989,1006],{},[306,990,991,992,995,996,999,1000,221,1003],{},"the bench's ",[202,993,994],{},"config\u002F"," (the nginx and supervisor files it generates, not ",[202,997,998],{},"pids\u002F","), ",[202,1001,1002],{},"\u002Fetc\u002Fnginx",[202,1004,1005],{},"\u002Fetc\u002Fsupervisor",[306,1007,1008,1010],{},[689,1009,583],{},": someone may have redirected traffic or started a process",[241,1012,1013,1020,1023,1026,1041,1048,1055,1058,1073],{},[244,1014,1015,1016,1019],{},"Each scan hashes only what changed size or modification time; every ",[202,1017,1018],{},"integrity.full_scan_interval","\n(24 h) it hashes everything again, so a file whose size and time were put back is still caught.",[244,1021,1022],{},"While git holds a lock in an app (a pull or a checkout in progress), the app is judged at the\nnext scan, so a deployment is not read as tampering halfway through.",[244,1024,1025],{},"Files over 32 MB are compared by size and time only, and a pass stops after 200,000 files; what\nis left keeps its baseline until the next pass.",[244,1027,1028,1029,1032,1033,1036,1037,1040],{},"The first scan of a path is its baseline and raises nothing. The baseline is kept in the spool\ndirectory (",[202,1030,1031],{},"integrity-state.json",", mode 0600): a restart does not hide what changed meanwhile.\n",[202,1034,1035],{},"wolf-agent check"," never moves it. Site config values are kept as HMACs under a key of this\ninstall (",[202,1038,1039],{},"integrity.key",", 0600).",[244,1042,1043,1044,1047],{},"A bench or site discovery misses for a while keeps its baseline for 7 days. An app removed from\n",[202,1045,1046],{},"apps\u002F",", a site or a config path that is gone is reported once, as removed (warning).",[244,1049,1050,1051,1054],{},"A file or folder the agent cannot read keeps its baseline instead of reading as deleted:\n",[202,1052,1053],{},"integrity_unreadable"," counts them.",[244,1056,1057],{},"A site config rewritten with the same keys and values raises nothing.",[244,1059,1060,1061,1064,1065,1068,1069,1072],{},"Events: ",[202,1062,1063],{},"bench_code_changed"," (per app) and ",[202,1066,1067],{},"bench_config_changed"," (per file or server path), with\nup to 20 paths of each kind (added, modified, deleted). Tagged T1505.003 and T1565.001; a\ndeployment has no technique. ",[202,1070,1071],{},"integrity_files"," counts what is watched, per bench and for the\nhost's own paths.",[244,1074,1075,1078,1079,221,1081,1083],{},[202,1076,1077],{},"integrity.server_paths"," replaces ",[202,1080,1002],{},[202,1082,1005],{},", for example on a host\nwhose web server lives elsewhere. The agent's user must be able to read what it watches;\nunreadable files are skipped.",[282,1085,1086,1094],{},[285,1087,1088],{},[288,1089,1090,1092],{},[291,1091,392],{},[291,1093,395],{},[301,1095,1096,1109],{},[288,1097,1098,1103],{},[306,1099,1100],{},[403,1101,1102],{},"Bench code changed outside a deployment",[306,1104,1105,1106,1108],{},"a ",[202,1107,1063],{}," event at critical, per bench (critical)",[288,1110,1111,1116],{},[306,1112,1113],{},[403,1114,1115],{},"Bench or server config changed",[306,1117,1105,1118,1120],{},[202,1119,1067],{}," event, per host (warning)",[211,1122,1124],{"id":1123},"turning-detection-off","Turning detection off",[282,1126,1127,1137],{},[285,1128,1129],{},[288,1130,1131,1134],{},[291,1132,1133],{},"To turn off",[291,1135,1136],{},"Set in the agent config",[301,1138,1139,1149,1159],{},[288,1140,1141,1144],{},[306,1142,1143],{},"Auth log signals",[306,1145,1146],{},[202,1147,1148],{},"\"auth_log\": false",[288,1150,1151,1154],{},[306,1152,1153],{},"Exposure checks",[306,1155,1156],{},[202,1157,1158],{},"\"exposure\": false",[288,1160,1161,1163],{},[306,1162,889],{},[306,1164,1165],{},[202,1166,1167],{},"\"integrity\": false",[198,1169,1170],{},"Web attack detection follows the nginx logs: it stops for a bench whose nginx log the agent does\nnot tail.",[1172,1173,1174],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code 