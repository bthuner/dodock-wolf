547],{"id":248,"depth":453,"text":24,"children":1531},[1532],{"id":425,"depth":470,"text":65},{"id":600,"depth":453,"text":601},{"id":812,"depth":453,"text":813,"children":1535},[1536,1537,1538,1539,1540],{"id":816,"depth":470,"text":817},{"id":859,"depth":470,"text":264},{"id":946,"depth":470,"text":947},{"id":697,"depth":470,"text":697},{"id":1163,"depth":470,"text":1164},{"id":1229,"depth":453,"text":1230,"children":1542},[1543,1544],{"id":1302,"depth":470,"text":1303},{"id":1346,"depth":470,"text":1347},{"id":1403,"depth":453,"text":1404},{"id":1454,"depth":453,"text":1455},{"id":1484,"depth":453,"text":1485},"Run the Wolf Agent on a Frappe Pilot host and turn Pilot tasks into deployment events.","md",null,{},{"icon":53},{"title":50,"description":1548},"B_ltSDGQRxGFylwGQzkAxgOSXbLZMFFJbPi3CSBRvWI",[1556,1558],{"title":45,"path":46,"stem":47,"description":1557,"icon":48},"Run the Wolf Agent on a self-hosted Press app server and get deploy-correlated incidents from its benches.",{"title":60,"path":61,"stem":62,"description":1559,"icon":63},"Every metric and event the Wolf Agent sends, and where it reads it.",1795079205312]