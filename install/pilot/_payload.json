m":146,"icon":147},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":193,"title":50,"body":194,"description":1534,"extension":1535,"links":1536,"meta":1537,"navigation":1538,"path":51,"seo":1539,"stem":52,"__hash__":1540},"docs_en\u002F2.install\u002F5.pilot.md",{"type":195,"value":196,"toc":1514},"minimark",[197,226,241,245,255,288,302,315,322,393,409,412,423,526,576,584,588,791,796,800,804,843,846,853,930,934,965,1000,1032,1034,1039,1113,1147,1151,1160,1213,1217,1220,1276,1286,1290,1330,1334,1339,1378,1387,1391,1394,1418,1421,1435,1438,1442,1468,1472,1510],[198,199,200,207,208,212,213,217,218,221,222,225],"p",{},[201,202,206],"a",{"href":203,"rel":204},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fpilot",[205],"nofollow","Pilot"," is ",[209,210,211],"strong",{},"Frappe's"," server manager (\"Frappe Server Manager\"). It is not a Dokos tool: Dokos' public GitLab group has no Pilot repository. The Dokos documentation mentions Pilot only through the ",[214,215,216],"code",{},"pilot_endpoint"," \u002F ",[214,219,220],{},"pilot_auth_token"," site keys used by the Cloud Settings panel for Frappe Cloud v2 sites. These are the same keys Pilot writes into ",[214,223,224],{},"site_config.json",".",[198,227,228,229,232,233,240],{},"Everything on this page was checked on a live Pilot host: ",[209,230,231],{},"Pilot v1.0.0-rc.1"," in production mode (systemd user units, nginx, the Admin), a Frappe 16 bench and a site running the Wolf App. The repository's ",[201,234,237],{"href":235,"rel":236},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Ftree\u002Fmain\u002Fdev\u002Fpilot",[205],[214,238,239],{},"dev\u002Fpilot"," sets the same host up in a container.",[242,243,24],"h2",{"id":244},"install",[198,246,247,248,250,251,254],{},"Install the agent as on any host (",[201,249,35],{"href":36},"). It runs as its own ",[214,252,253],{},"wolf-agent"," user, out of the bench's reach: code that takes over a Frappe site cannot read its config, its integrity key or its state, nor stop it.",[198,256,257,258,261,262,265,266,271,272,275,276,279,280,283,284,287],{},"Pilot keeps a bench's ",[214,259,260],{},"bench.toml",", its ",[214,263,264],{},"tasks\u002F"," and its site configs readable by the bench user only, and runs the bench as that user's systemd user units, which another user cannot list. So on a Pilot host the installer also sets up ",[209,267,268],{},[214,269,270],{},"wolf-pilot-export",", a root helper run by ",[214,273,274],{},"wolf-pilot-export.timer"," every 20 seconds. It writes ",[214,277,278],{},"\u002Fvar\u002Flib\u002Fwolf-pilot-export\u002F\u003Cbench>.json"," (",[214,281,282],{},"root:wolf-agent",", mode ",[214,285,286],{},"0640",", in a folder root owns) with:",[289,290,291,295],"ul",{},[292,293,294],"li",{},"the latest 100 tasks: command, status, times, exit code, failure code and message, and of the arguments only the site;",[292,296,297,298,301],{},"the state of the bench's ",[214,299,300],{},"\u003Cbench>-*.service"," user units.",[198,303,304,305,308,309,311,312,314],{},"It reads the bench's files as the bench user, in a child process with a time limit: a link that user plants there gives access to nothing more than they could already read. It takes a bench only when its ",[214,306,307],{},"[bench] name"," is its folder's name and the folder belongs to the user whose home holds it. It copies nothing else: not ",[214,310,260],{}," (its Admin secret), not the site configs (their database passwords). Registration runs as root, so discovery still reads ",[214,313,260],{}," and the site configs once, for the bench's name, sites, domains and ports.",[198,316,317,318,321],{},"What this costs on Pilot: the ",[201,319,320],{"href":61},"MariaDB checks",", which need a site's database password.",[323,324,326,331,356,360,385],"steps",{"level":325},"3",[327,328,330],"h3",{"id":329},"check-what-wolf-finds","Check what Wolf finds",[332,333,338],"pre",{"className":334,"code":335,"language":336,"meta":337,"style":337},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo wolf-agent discover\n","bash","",[214,339,340],{"__ignoreMap":337},[341,342,345,349,353],"span",{"class":343,"line":344},"line",1,[341,346,348],{"class":347},"sBMFI","sudo",[341,350,352],{"class":351},"sfazB"," wolf-agent",[341,354,355],{"class":351}," discover\n",[327,357,359],{"id":358},"check-what-would-be-sent","Check what would be sent",[332,361,363],{"className":334,"code":362,"language":336,"meta":337,"style":337},"sudo -u wolf-agent wolf-agent --config \u002Fetc\u002Fwolf-agent\u002Fconfig.json check\n",[214,364,365],{"__ignoreMap":337},[341,366,367,369,372,374,376,379,382],{"class":343,"line":344},[341,368,348],{"class":347},[341,370,371],{"class":351}," -u",[341,373,352],{"class":351},[341,375,352],{"class":351},[341,377,378],{"class":351}," --config",[341,380,381],{"class":351}," \u002Fetc\u002Fwolf-agent\u002Fconfig.json",[341,383,384],{"class":351}," check\n",[198,386,387,390,391,225],{},[214,388,389],{},"check"," collects once and prints the JSON payload. Nothing is sent. See ",[201,392,70],{"href":71},[394,395,396],"warning",{},[198,397,398,399,402,403,406,407,225],{},"Worker log names are globbed at registration. Re-run ",[214,400,401],{},"wolf-agent register"," after changing ",[214,404,405],{},"[[workers]]"," in ",[214,408,260],{},[327,410,65],{"id":411},"configuration",[198,413,414,415,418,419,422],{},"Deployment events from Pilot tasks are on by default. The ",[214,416,417],{},"pilot"," section of ",[214,420,421],{},"\u002Fetc\u002Fwolf-agent\u002Fconfig.json",":",[332,424,429],{"className":425,"code":426,"filename":427,"language":428,"meta":337,"style":337},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"pilot\": {\n    \"deployments\": true,\n    \"api_url\": null,\n    \"token\": null,\n    \"jwt_secret\": null\n  }\n}\n","config.json","json",[214,430,431,437,454,470,485,499,514,520],{"__ignoreMap":337},[341,432,433],{"class":343,"line":344},[341,434,436],{"class":435},"sMK4o","{\n",[341,438,440,443,446,449,451],{"class":343,"line":439},2,[341,441,442],{"class":435},"  \"",[341,444,417],{"class":445},"spNyl",[341,447,448],{"class":435},"\"",[341,450,422],{"class":435},[341,452,453],{"class":435}," {\n",[341,455,457,460,463,465,467],{"class":343,"line":456},3,[341,458,459],{"class":435},"    \"",[341,461,462],{"class":347},"deployments",[341,464,448],{"class":435},[341,466,422],{"class":435},[341,468,469],{"class":435}," true,\n",[341,471,473,475,478,480,482],{"class":343,"line":472},4,[341,474,459],{"class":435},[341,476,477],{"class":347},"api_url",[341,479,448],{"class":435},[341,481,422],{"class":435},[341,483,484],{"class":435}," null,\n",[341,486,488,490,493,495,497],{"class":343,"line":487},5,[341,489,459],{"class":435},[341,491,492],{"class":347},"token",[341,494,448],{"class":435},[341,496,422],{"class":435},[341,498,484],{"class":435},[341,500,502,504,507,509,511],{"class":343,"line":501},6,[341,503,459],{"class":435},[341,505,506],{"class":347},"jwt_secret",[341,508,448],{"class":435},[341,510,422],{"class":435},[341,512,513],{"class":435}," null\n",[341,515,517],{"class":343,"line":516},7,[341,518,519],{"class":435},"  }\n",[341,521,523],{"class":343,"line":522},8,[341,524,525],{"class":435},"}\n",[527,528,529,544,555,564],"field-group",{},[530,531,534],"field",{"name":532,"type":533},"pilot.deployments","boolean",[198,535,536,537,540,541,225],{},"Poll Pilot tasks and turn them into events. ",[214,538,539],{},"false"," turns task polling off. Default ",[214,542,543],{},"true",[530,545,548],{"name":546,"type":547},"pilot.api_url","string | null",[198,549,550,551,554],{},"Overrides the per-bench Admin API address ",[214,552,553],{},"http:\u002F\u002F127.0.0.1:\u003Cadmin.port+1>",". It applies to every Pilot bench on the host, so set it only on single-bench hosts.",[530,556,558],{"name":557,"type":547},"pilot.token",[198,559,560,561,563],{},"A bench-scoped Admin API token, used only without ",[214,562,270],{},"'s copy.",[530,565,567],{"name":566,"type":547},"pilot.jwt_secret",[198,568,569,570,573,574,563],{},"The bench's ",[214,571,572],{},"[admin] jwt_secret",", to mint a one-hour token, only without ",[214,575,270],{},[198,577,578,579,581,582,225],{},"With ",[214,580,270],{},", Wolf needs neither. The full config is on ",[201,583,65],{"href":66},[242,585,587],{"id":586},"what-wolf-does-on-a-pilot-bench","What Wolf does on a Pilot bench",[589,590,591,607],"table",{},[592,593,594],"thead",{},[595,596,597,601,604],"tr",{},[598,599,600],"th",{},"Area",[598,602,603],{},"What Wolf does",[598,605,606],{},"On v1.0.0-rc.1",[608,609,610,636,658,679,696,709,720,745,778],"tbody",{},[595,611,612,616,633],{},[613,614,615],"td",{},"Discovery",[613,617,618,619,622,623,625,626,628,629,632],{},"Searches ",[214,620,621],{},"\u002Fhome\u002F*\u002Fpilot\u002Fbenches\u002F*",". A ",[214,624,260],{}," with ",[214,627,307],{}," and ",[214,630,631],{},"python"," is a Pilot bench, read with its real keys",[613,634,635],{},"checked",[595,637,638,641,656],{},[613,639,640],{},"Sites",[613,642,643,644,647,648,651,652,655],{},"Reads ",[214,645,646],{},"sites\u002F*\u002Fsite_config.json",", plus ",[214,649,650],{},"domains"," (plain strings or ",[214,653,654],{},"{\"domain\": …, \"route\": …}",") for host → site mapping",[613,657,635],{},[595,659,660,663,673],{},[613,661,662],{},"Process logs",[613,664,665,666,669,670],{},"Tails ",[214,667,668],{},"web"," and its stderr file, and the worker and schedule logs of a bench out of lite mode. On a sandboxed bench, Frappe's own logs in ",[214,671,672],{},"logs\u002Fworkload\u002F",[613,674,675,676,678],{},"checked (lite mode); ",[214,677,672],{}," unit tested",[595,680,681,684,694],{},[613,682,683],{},"nginx",[613,685,665,686,689,690,693],{},[214,687,688],{},"\u003Cbench>\u002Flogs\u002Fnginx-access.log",", in the ",[214,691,692],{},"pilot_access"," format",[613,695,635],{},[595,697,698,701,707],{},[613,699,700],{},"Redis queue",[613,702,703,704],{},"Queue length, RQ registries, workers and Redis memory from ",[214,705,706],{},"[redis] queue_port",[613,708,635],{},[595,710,711,714,717],{},[613,712,713],{},"MariaDB",[613,715,716],{},"Not on Pilot: the site's database password stays readable by the bench user only",[613,718,719],{},"—",[595,721,722,725,743],{},[613,723,724],{},"Processes",[613,726,727,728,731,732,735,736,738,739,742],{},"The bench user's systemd ",[209,729,730],{},"user"," units, ",[214,733,734],{},"\u003Cbench>-\u003Cprocess>.service",", as ",[214,737,270],{}," copies them (",[214,740,741],{},"bench_processes_down","). The Admin is socket-activated: inactive until its first request is not down",[613,744,635],{},[595,746,747,750,775],{},[613,748,749],{},"Deployments",[613,751,752,753,756,757,759,760,763,764,767,768,771,772,774],{},"A ",[214,754,755],{},"deployment"," event (category ",[214,758,417],{},") when a task such as update, migrate or app install ",[209,761,762],{},"starts",", and an ",[214,765,766],{},"error"," event (",[214,769,770],{},"pilot_task_failed",") when one fails, from ",[214,773,270],{},"'s copy",[613,776,777],{},"checked with a migrate run from the Admin",[595,779,780,783,786],{},[613,781,782],{},"\"Enable Wolf for this bench\" toggle in Pilot",[613,784,785],{},"Needs a change in frappe\u002Fpilot",[613,787,788],{},[209,789,790],{},"not done",[198,792,793,794,225],{},"The metrics themselves are described on ",[201,795,60],{"href":61},[242,797,799],{"id":798},"bench-layout","Bench layout",[327,801,803],{"id":802},"benches","Benches",[198,805,806,807,810,811,814,815,818,819,822,823,826,827,826,830,826,833,826,836,826,839,628,841,225],{},"Pilot's ",[214,808,809],{},"install.sh"," installs into ",[214,812,813],{},"$HOME\u002Fpilot"," as a non-root bench user (",[214,816,817],{},"frappe"," by default). Benches live in ",[214,820,821],{},"~\u002Fpilot\u002Fbenches\u002F\u003Cname>\u002F",", each with ",[214,824,825],{},"apps\u002F",", ",[214,828,829],{},"sites\u002F",[214,831,832],{},"env\u002F",[214,834,835],{},"logs\u002F",[214,837,838],{},"config\u002F",[214,840,264],{},[214,842,260],{},[327,844,260],{"id":845},"benchtoml",[198,847,848,849,852],{},"Mode ",[214,850,851],{},"0600",", readable by the bench user only. Wolf reads it at registration, which runs as root:",[589,854,855,865],{},[592,856,857],{},[595,858,859,862],{},[598,860,861],{},"Key",[598,863,864],{},"Use",[608,866,867,879,891,908,920],{},[595,868,869,873],{},[613,870,871],{},[214,872,307],{},[613,874,875,876,878],{},"Required, together with ",[214,877,631],{},". The bench name and the Pilot marker",[595,880,881,885],{},[613,882,883],{},[214,884,706],{},[613,886,887,888],{},"Queue Redis port. Default ",[214,889,890],{},"11000",[595,892,893,898],{},[613,894,895],{},[214,896,897],{},"[admin] port",[613,899,900,901,904,905],{},"Default ",[214,902,903],{},"7000",". The Admin backend listens on ",[214,906,907],{},"127.0.0.1:\u003Cport + 1>",[595,909,910,914],{},[613,911,912],{},[214,913,572],{},[613,915,916,917,919],{},"Only when Wolf mints an Admin token, which needs ",[214,918,260],{}," readable. Pilot writes it at the Admin's first session",[595,921,922,927],{},[613,923,924],{},[214,925,926],{},"[production] enabled",[613,928,929],{},"Kept for information",[327,931,933],{"id":932},"processes-and-logs","Processes and logs",[198,935,936,937,940,941,944,945,826,948,826,951,826,954,957,958,961,962,225],{},"Pilot runs a production bench as ",[209,938,939],{},"systemd user units"," of the bench user (",[214,942,943],{},"systemctl --user","), with linger on: ",[214,946,947],{},"\u003Cbench>-web",[214,949,950],{},"\u003Cbench>-redis_cache",[214,952,953],{},"\u003Cbench>-redis_queue",[214,955,956],{},"\u003Cbench>-admin"," (socket-activated, ",[214,959,960],{},"\u003Cbench>-admin.socket",") and app processes. Pilot's MariaDB is the user unit ",[214,963,964],{},"pilot-mariadb",[198,966,967,970,971,974,975,977,978,981,982,985,986,989,990,628,993,996,997,225],{},[209,968,969],{},"Lite mode",", on by default (",[214,972,973],{},"[lite_mode] enabled","), runs the web server, the job workers and the scheduler in one ",[214,976,668],{}," process (",[214,979,980],{},"frappe.runner","). Its logs, Python's ",[214,983,984],{},"logging"," output included, go to ",[214,987,988],{},"logs\u002Fweb.log.error.log",". Out of lite mode there are worker and schedule processes, logged as ",[214,991,992],{},"worker_\u003Cqueue-slug>_\u003Ci>.log",[214,994,995],{},"schedule.log",", with stderr in ",[214,998,999],{},"\u003Clog>.error.log",[198,1001,1002,1005,1006,826,1009,1012,1013,1015,1016,1019,1020,1023,1024,1027,1028,1031],{},[209,1003,1004],{},"The sandbox."," A new systemd bench runs its workload sandboxed, and Frappe's own logs (",[214,1007,1008],{},"frappe.log",[214,1010,1011],{},"scheduler.log","…) are then in ",[214,1014,672],{},". The sandbox needs unprivileged user namespaces, which Ubuntu 24.04 refuses by default (",[214,1017,1018],{},"kernel.apparmor_restrict_unprivileged_userns = 1","): ",[214,1021,1022],{},"pilot setup production"," then fails, and Pilot advises ",[214,1025,1026],{},"sandbox = false"," under ",[214,1029,1030],{},"[production]",". Wolf reads both layouts.",[327,1033,683],{"id":683},[198,1035,1036,1037,422],{},"Each site vhost logs to ",[214,1038,688],{},[332,1040,1043],{"className":1041,"code":1042,"language":683,"meta":337,"style":337},"language-nginx shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","log_format pilot_access '$pilot_client_addr [$time_local] \"$request_method $uri\" $status \"$host\" $request_time';\n",[214,1044,1045],{"__ignoreMap":337},[341,1046,1047,1050,1054,1057,1060,1063,1066,1068,1071,1074,1076,1079,1082,1085,1088,1090,1093,1096,1098,1101,1103,1105,1108,1110],{"class":343,"line":344},[341,1048,1049],{"class":435},"log_format ",[341,1051,1053],{"class":1052},"sTEyZ","pilot_access ",[341,1055,1056],{"class":351},"'",[341,1058,1059],{"class":435},"$",[341,1061,1062],{"class":1052},"pilot_client_addr",[341,1064,1065],{"class":351}," [",[341,1067,1059],{"class":435},[341,1069,1070],{"class":1052},"time_local",[341,1072,1073],{"class":351},"] \"",[341,1075,1059],{"class":435},[341,1077,1078],{"class":1052},"request_method",[341,1080,1081],{"class":435}," $",[341,1083,1084],{"class":1052},"uri",[341,1086,1087],{"class":351},"\" ",[341,1089,1059],{"class":435},[341,1091,1092],{"class":1052},"status",[341,1094,1095],{"class":351}," \"",[341,1097,1059],{"class":435},[341,1099,1100],{"class":1052},"host",[341,1102,1087],{"class":351},[341,1104,1059],{"class":435},[341,1106,1107],{"class":1052},"request_time",[341,1109,1056],{"class":351},[341,1111,1112],{"class":435},";\n",[198,1114,1115,1116,279,1119,1122,1123,1126,1127,1130,1131,1134,1135,826,1138,1141,1142,1146],{},"This format has ",[209,1117,1118],{},"no query string",[214,1120,1121],{},"$uri",", not ",[214,1124,1125],{},"$request_uri",") and ",[209,1128,1129],{},"no User-Agent",". On a Pilot bench, Wolf's ",[201,1132,1133],{"href":135},"web detection"," sees probed paths (",[214,1136,1137],{},"\u002F.env",[214,1139,1140],{},"\u002F.git\u002F",", CMS and appliance paths) but not injections or path traversal carried in a query string, nor scanners named by their User-Agent. ",[201,1143,1145],{"href":1144},"\u002Fsecurity\u002Fwazuh-suricata#suricata","Suricata"," sees the full requests.",[327,1148,1150],{"id":1149},"tasks","Tasks",[198,1152,1153,1154,283,1157,422],{},"Admin operations are tasks, stored as ",[214,1155,1156],{},"\u003Cbench>\u002Ftasks\u002F\u003CYYYYMMDD-HHMMSS-hex>\u002F",[214,1158,1159],{},"0700",[289,1161,1162,1193],{},[292,1163,1164,1167,1168,826,1171,826,1174,826,1177,826,1180,826,1183,1186,1187,826,1190,225],{},[214,1165,1166],{},"meta.json",": ",[214,1169,1170],{},"task_id",[214,1172,1173],{},"command",[214,1175,1176],{},"args",[214,1178,1179],{},"queued_at",[214,1181,1182],{},"started_at",[214,1184,1185],{},"finished_at"," (UTC ISO-8601), ",[214,1188,1189],{},"exit_code",[214,1191,1192],{},"failure",[292,1194,1195,1167,1197,826,1200,826,1203,826,1206,1209,1210,225],{},[214,1196,1092],{},[214,1198,1199],{},"queued",[214,1201,1202],{},"running",[214,1204,1205],{},"success",[214,1207,1208],{},"failed"," or ",[214,1211,1212],{},"killed",[242,1214,1216],{"id":1215},"deployment-events-from-pilot-tasks","Deployment events from Pilot tasks",[198,1218,1219],{},"Wolf reports these task commands:",[198,1221,1222,826,1225,826,1228,826,1231,826,1234,826,1237,826,1240,826,1243,826,1246,826,1249,826,1252,826,1255,826,1258,826,1261,826,1264,826,1267,826,1270,826,1273,225],{},[214,1223,1224],{},"update",[214,1226,1227],{},"retry-update",[214,1229,1230],{},"complete-migration",[214,1232,1233],{},"migrate",[214,1235,1236],{},"revert-migration",[214,1238,1239],{},"revert-apps",[214,1241,1242],{},"revert-site",[214,1244,1245],{},"switch-branch",[214,1247,1248],{},"get-and-install-app",[214,1250,1251],{},"install-app",[214,1253,1254],{},"uninstall-app",[214,1256,1257],{},"remove-app",[214,1259,1260],{},"build",[214,1262,1263],{},"restart-services",[214,1265,1266],{},"switch-lite-mode",[214,1268,1269],{},"setup-nginx",[214,1271,1272],{},"restore-site",[214,1274,1275],{},"reinstall-site",[198,1277,1278,1279,217,1282,1285],{},"The site comes from the task's ",[214,1280,1281],{},"site",[214,1283,1284],{},"sites"," arguments; nothing else of the arguments is kept.",[327,1287,1289],{"id":1288},"where-tasks-are-read","Where tasks are read",[1291,1292,1293,1304,1313],"ol",{},[292,1294,1295,826,1298,628,1301,1303],{},[209,1296,1297],{},"Task files",[214,1299,1300],{},"\u003Cbench>\u002Ftasks\u002F*\u002Fmeta.json",[214,1302,1092],{},", when the agent can read them (an agent run as the bench user).",[292,1305,1306,826,1310,1312],{},[209,1307,1308,774],{},[214,1309,270],{},[214,1311,278],{},", when it is less than 5 minutes old: the normal case.",[292,1314,1315,826,1318,1321,1322,1324,1325,1209,1327,1329],{},[209,1316,1317],{},"Admin API",[214,1319,1320],{},"GET http:\u002F\u002F127.0.0.1:\u003Cadmin.port+1>\u002Fapi\u002Fv1\u002Ftasks?limit=100",", only without the two others. It needs a bench-scoped token: ",[214,1323,557],{},", or one Wolf mints from ",[214,1326,566],{},[214,1328,260],{},". Pilot lists every token it verifies among the Admin's active sessions, and a bench-scoped token can do everything the Admin can: the copy avoids both.",[327,1331,1333],{"id":1332},"how-events-are-produced","How events are produced",[198,1335,1336,1337,422],{},"The same rules as on ",[201,1338,45],{"href":46},[289,1340,1341,1352,1369,1375],{},[292,1342,752,1343,1345,1346,1348,1349,225],{},[214,1344,755],{}," event is sent when the task starts, timestamped at ",[214,1347,1182],{},". An incident during a long migrate links to it, for example through the \"502 spike after deployment\" ",[201,1350,1351],{"href":102},"preset",[292,1353,1354,1355,1357,1358,1360,1361,826,1364,628,1367,225],{},"An ",[214,1356,766],{}," event is sent if the task ends ",[214,1359,1208],{},". It carries ",[214,1362,1363],{},"failure.code",[214,1365,1366],{},"failure.message",[214,1368,1189],{},[292,1370,1371,1372,225],{},"Reported task ids are kept for 3 days in ",[214,1373,1374],{},"\u003Cspool_dir>\u002Fpilot-tasks.json",[292,1376,1377],{},"The first poll skips history and only picks up queued or running tasks.",[198,1379,1380,1381,1383,1384,1386],{},"A migrate also records the site's own ",[214,1382,755],{}," event (source ",[214,1385,817],{},"), as on any bench: Pilot's says which task ran it.",[242,1388,1390],{"id":1389},"wolf-next-to-pilots-own-monitoring","Wolf next to Pilot's own monitoring",[198,1392,1393],{},"From the Pilot docs:",[289,1395,1396,1402,1412],{},[292,1397,1398,1401],{},[214,1399,1400],{},"pilot-monitor.service"," collects host, database and bench metrics and pings production sites.",[292,1403,1404,1407,1408,1411],{},[214,1405,1406],{},"[resource_limits]"," raises CPU, memory, disk and uptime alerts after 5 minutes. They go to Central (on Central-managed hosts), to ",[214,1409,1410],{},"webhook_endpoints"," and to mail.",[292,1413,1414,1417],{},[214,1415,1416],{},"[telemetry]"," ships metrics and logs to a region's \"Datum\" endpoint with a Central-issued token.",[198,1419,1420],{},"Wolf reads the same local files and does not interfere with any of these. What it adds on a self-hosted Pilot host:",[289,1422,1423,1426,1429,1432],{},[292,1424,1425],{},"Tracebacks, failed scheduled jobs and worker crashes as events.",[292,1427,1428],{},"5xx\u002F502 per site.",[292,1430,1431],{},"SSH signals.",[292,1433,1434],{},"Incidents tied to the Pilot task that preceded them.",[198,1436,1437],{},"All of it is kept on your own Wolf site.",[242,1439,1441],{"id":1440},"the-wolf-app-on-a-pilot-bench","The Wolf App on a Pilot bench",[198,1443,1444,1445,826,1448,1451,1452,1455,1456,1459,1460,1463,1464,1467],{},"The Wolf App installs on a Pilot bench like any app (",[214,1446,1447],{},"pilot get-app",[214,1449,1450],{},"pilot install-app","). Pilot checks that every app an app requires in ",[214,1453,1454],{},"hooks.py"," is declared in its ",[214,1457,1458],{},"pyproject.toml"," ",[214,1461,1462],{},"[tool.bench.frappe-dependencies]",", Frappe excepted: Frappe is implicit, and an app that lists it in ",[214,1465,1466],{},"required_apps"," is refused.",[242,1469,1471],{"id":1470},"what-pilot-would-need","What Pilot would need",[1291,1473,1474,1493,1502],{},[292,1475,1476,1479,1480,1483,1484,279,1486,826,1489,1492],{},[209,1477,1478],{},"\"Enable Wolf for this bench\" toggle."," A ",[214,1481,1482],{},"[wolf]"," table in ",[214,1485,260],{},[214,1487,1488],{},"enabled",[214,1490,1491],{},"url",") plus an Admin settings switch, which would install and register the agent. It belongs in frappe\u002Fpilot.",[292,1494,1495,279,1498,1501],{},[209,1496,1497],{},"A read-only machine token for the Admin API",[214,1499,1500],{},"tasks:read",", unit states), which would make the root helper unnecessary.",[292,1503,1504,1509],{},[209,1505,1506,1507],{},"The query string and User-Agent in ",[214,1508,692],{},", for web attack detection from the access log.",[1511,1512,1513],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}",{"title":337,"searchDepth":344,"depth":439,"links":1515},[1516,1519,1520,1527,1531,1532,1533],{"id":244,"depth":439,"text":24,"children":1517},[1518],{"id":411,"depth":456,"text":65},{"id":586,"depth":439,"text":587},{"id":798,"depth":439,"text":799,"children":1521},[1522,1523,1524,1525,1526],{"id":802,"depth":456,"text":803},{"id":845,"depth":456,"text":260},{"id":932,"depth":456,"text":933},{"id":683,"depth":456,"text":683},{"id":1149,"depth":456,"text":1150},{"id":1215,"depth":439,"text":1216,"children":1528},[1529,1530],{"id":1288,"depth":456,"text":1289},{"id":1332,"depth":456,"text":1333},{"id":1389,"depth":439,"text":1390},{"id":1440,"depth":439,"text":1441},{"id":1470,"depth":439,"text":1471},"Run the Wolf Agent on a Frappe Pilot host and turn Pilot tasks into deployment events.","md",null,{},{"icon":53},{"title":50,"description":1534},"FID4ddjV4Vp_OiLPBJceb22v0SK340NPkJ49GzRdQKo",[1542,1544],{"title":45,"path":46,"stem":47,"description":1543,"icon":48},"Run the Wolf Agent on a self-hosted Press app server and get deploy-correlated incidents from its benches.",{"title":60,"path":61,"stem":62,"description":1545,"icon":63},"Every metric and event the Wolf Agent sends, and where it reads it.",1795034180844]