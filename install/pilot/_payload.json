path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":183,"title":45,"body":184,"description":1533,"extension":1534,"links":1535,"meta":1536,"navigation":1537,"path":46,"seo":1538,"stem":47,"__hash__":1539},"docs_en\u002F2.install\u002F5.pilot.md",{"type":185,"value":186,"toc":1513},"minimark",[187,216,235,239,249,282,296,309,316,326,397,413,416,427,530,580,588,592,795,800,804,808,847,850,857,934,938,969,1004,1036,1038,1043,1117,1151,1155,1164,1217,1221,1224,1280,1290,1294,1334,1338,1377,1386,1390,1393,1417,1420,1434,1437,1441,1467,1471,1509],[188,189,190,197,198,202,203,207,208,211,212,215],"p",{},[191,192,196],"a",{"href":193,"rel":194},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fpilot",[195],"nofollow","Pilot"," is ",[199,200,201],"strong",{},"Frappe's"," server manager (\"Frappe Server Manager\"). It is not a Dokos tool: Dokos' public GitLab group has no Pilot repository. The Dokos documentation mentions Pilot only through the ",[204,205,206],"code",{},"pilot_endpoint"," \u002F ",[204,209,210],{},"pilot_auth_token"," site keys used by the Cloud Settings panel for Frappe Cloud v2 sites. These are the same keys Pilot writes into ",[204,213,214],{},"site_config.json",".",[188,217,218,219,222,223,226,227,234],{},"Everything on this page was checked on a live Pilot host: ",[199,220,221],{},"Pilot v1.0.0-rc.1",", and again on ",[199,224,225],{},"v1.0.0-rc.2"," (which changes only Pilot's release CI), in production mode (systemd user units, nginx, the Admin), a Frappe 16 bench and a site running the Wolf App. The repository's ",[191,228,231],{"href":229,"rel":230},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Ftree\u002Fmain\u002Fdev\u002Fpilot",[195],[204,232,233],{},"dev\u002Fpilot"," sets the same host up in a container.",[236,237,24],"h2",{"id":238},"install",[188,240,241,242,244,245,248],{},"Install the agent as on any host (",[191,243,35],{"href":36},"). It runs as its own ",[204,246,247],{},"wolf-agent"," user, out of the bench's reach: code that takes over a Frappe site cannot read its config, its integrity key or its state, nor stop it.",[188,250,251,252,255,256,259,260,265,266,269,270,273,274,277,278,281],{},"Pilot keeps a bench's ",[204,253,254],{},"bench.toml",", its ",[204,257,258],{},"tasks\u002F"," and its site configs readable by the bench user only, and runs the bench as that user's systemd user units, which another user cannot list. So on a Pilot host the installer also sets up ",[199,261,262],{},[204,263,264],{},"wolf-pilot-export",", a root helper run by ",[204,267,268],{},"wolf-pilot-export.timer"," every 20 seconds. It writes ",[204,271,272],{},"\u002Fvar\u002Flib\u002Fwolf-pilot-export\u002F\u003Cbench>.json"," (",[204,275,276],{},"root:wolf-agent",", mode ",[204,279,280],{},"0640",", in a folder root owns) with:",[283,284,285,289],"ul",{},[286,287,288],"li",{},"the latest 100 tasks: command, status, times, exit code, failure code and message, and of the arguments only the site;",[286,290,291,292,295],{},"the state of the bench's ",[204,293,294],{},"\u003Cbench>-*.service"," user units.",[188,297,298,299,302,303,305,306,308],{},"It reads the bench's files as the bench user, in a child process with a time limit: a link that user plants there gives access to nothing more than they could already read. It takes a bench only when its ",[204,300,301],{},"[bench] name"," is its folder's name and the folder belongs to the user whose home holds it. It copies nothing else: not ",[204,304,254],{}," (its Admin secret), not the site configs (their database passwords). Registration runs as root, so discovery still reads ",[204,307,254],{}," and the site configs once, for the bench's name, sites, domains and ports.",[188,310,311,312,315],{},"What this costs on Pilot: the ",[191,313,314],{"href":56},"MariaDB checks",", which need a site's database password.",[188,317,318,319,322,323,325],{},"To remove Wolf from a Pilot host, run ",[204,320,321],{},"systemctl disable --now wolf-pilot-export.timer"," before deleting the ",[204,324,247],{}," user: the helper's unit runs with that group, and fails at every run without it.",[327,328,330,335,360,364,389],"steps",{"level":329},"3",[331,332,334],"h3",{"id":333},"check-what-wolf-finds","Check what Wolf finds",[336,337,342],"pre",{"className":338,"code":339,"language":340,"meta":341,"style":341},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo wolf-agent discover\n","bash","",[204,343,344],{"__ignoreMap":341},[345,346,349,353,357],"span",{"class":347,"line":348},"line",1,[345,350,352],{"class":351},"sBMFI","sudo",[345,354,356],{"class":355},"sfazB"," wolf-agent",[345,358,359],{"class":355}," discover\n",[331,361,363],{"id":362},"check-what-would-be-sent","Check what would be sent",[336,365,367],{"className":338,"code":366,"language":340,"meta":341,"style":341},"sudo -u wolf-agent wolf-agent --config \u002Fetc\u002Fwolf-agent\u002Fconfig.json check\n",[204,368,369],{"__ignoreMap":341},[345,370,371,373,376,378,380,383,386],{"class":347,"line":348},[345,372,352],{"class":351},[345,374,375],{"class":355}," -u",[345,377,356],{"class":355},[345,379,356],{"class":355},[345,381,382],{"class":355}," --config",[345,384,385],{"class":355}," \u002Fetc\u002Fwolf-agent\u002Fconfig.json",[345,387,388],{"class":355}," check\n",[188,390,391,394,395,215],{},[204,392,393],{},"check"," collects once and prints the JSON payload. Nothing is sent. See ",[191,396,65],{"href":66},[398,399,400],"warning",{},[188,401,402,403,406,407,410,411,215],{},"Worker log names are globbed at registration. Re-run ",[204,404,405],{},"wolf-agent register"," after changing ",[204,408,409],{},"[[workers]]"," in ",[204,412,254],{},[331,414,60],{"id":415},"configuration",[188,417,418,419,422,423,426],{},"Deployment events from Pilot tasks are on by default. The ",[204,420,421],{},"pilot"," section of ",[204,424,425],{},"\u002Fetc\u002Fwolf-agent\u002Fconfig.json",":",[336,428,433],{"className":429,"code":430,"filename":431,"language":432,"meta":341,"style":341},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"pilot\": {\n    \"deployments\": true,\n    \"api_url\": null,\n    \"token\": null,\n    \"jwt_secret\": null\n  }\n}\n","config.json","json",[204,434,435,441,458,474,489,503,518,524],{"__ignoreMap":341},[345,436,437],{"class":347,"line":348},[345,438,440],{"class":439},"sMK4o","{\n",[345,442,444,447,450,453,455],{"class":347,"line":443},2,[345,445,446],{"class":439},"  \"",[345,448,421],{"class":449},"spNyl",[345,451,452],{"class":439},"\"",[345,454,426],{"class":439},[345,456,457],{"class":439}," {\n",[345,459,461,464,467,469,471],{"class":347,"line":460},3,[345,462,463],{"class":439},"    \"",[345,465,466],{"class":351},"deployments",[345,468,452],{"class":439},[345,470,426],{"class":439},[345,472,473],{"class":439}," true,\n",[345,475,477,479,482,484,486],{"class":347,"line":476},4,[345,478,463],{"class":439},[345,480,481],{"class":351},"api_url",[345,483,452],{"class":439},[345,485,426],{"class":439},[345,487,488],{"class":439}," null,\n",[345,490,492,494,497,499,501],{"class":347,"line":491},5,[345,493,463],{"class":439},[345,495,496],{"class":351},"token",[345,498,452],{"class":439},[345,500,426],{"class":439},[345,502,488],{"class":439},[345,504,506,508,511,513,515],{"class":347,"line":505},6,[345,507,463],{"class":439},[345,509,510],{"class":351},"jwt_secret",[345,512,452],{"class":439},[345,514,426],{"class":439},[345,516,517],{"class":439}," null\n",[345,519,521],{"class":347,"line":520},7,[345,522,523],{"class":439},"  }\n",[345,525,527],{"class":347,"line":526},8,[345,528,529],{"class":439},"}\n",[531,532,533,548,559,568],"field-group",{},[534,535,538],"field",{"name":536,"type":537},"pilot.deployments","boolean",[188,539,540,541,544,545,215],{},"Poll Pilot tasks and turn them into events. ",[204,542,543],{},"false"," turns task polling off. Default ",[204,546,547],{},"true",[534,549,552],{"name":550,"type":551},"pilot.api_url","string | null",[188,553,554,555,558],{},"Overrides the per-bench Admin API address ",[204,556,557],{},"http:\u002F\u002F127.0.0.1:\u003Cadmin.port+1>",". It applies to every Pilot bench on the host, so set it only on single-bench hosts.",[534,560,562],{"name":561,"type":551},"pilot.token",[188,563,564,565,567],{},"A bench-scoped Admin API token, used only without ",[204,566,264],{},"'s copy.",[534,569,571],{"name":570,"type":551},"pilot.jwt_secret",[188,572,573,574,577,578,567],{},"The bench's ",[204,575,576],{},"[admin] jwt_secret",", to mint a one-hour token, only without ",[204,579,264],{},[188,581,582,583,585,586,215],{},"With ",[204,584,264],{},", Wolf needs neither. The full config is on ",[191,587,60],{"href":61},[236,589,591],{"id":590},"what-wolf-does-on-a-pilot-bench","What Wolf does on a Pilot bench",[593,594,595,611],"table",{},[596,597,598],"thead",{},[599,600,601,605,608],"tr",{},[602,603,604],"th",{},"Area",[602,606,607],{},"What Wolf does",[602,609,610],{},"On v1.0.0-rc.1 and rc.2",[612,613,614,640,662,683,700,713,724,749,782],"tbody",{},[599,615,616,620,637],{},[617,618,619],"td",{},"Discovery",[617,621,622,623,626,627,629,630,632,633,636],{},"Searches ",[204,624,625],{},"\u002Fhome\u002F*\u002Fpilot\u002Fbenches\u002F*",". A ",[204,628,254],{}," with ",[204,631,301],{}," and ",[204,634,635],{},"python"," is a Pilot bench, read with its real keys",[617,638,639],{},"checked",[599,641,642,645,660],{},[617,643,644],{},"Sites",[617,646,647,648,651,652,655,656,659],{},"Reads ",[204,649,650],{},"sites\u002F*\u002Fsite_config.json",", plus ",[204,653,654],{},"domains"," (plain strings or ",[204,657,658],{},"{\"domain\": …, \"route\": …}",") for host → site mapping",[617,661,639],{},[599,663,664,667,677],{},[617,665,666],{},"Process logs",[617,668,669,670,673,674],{},"Tails ",[204,671,672],{},"web"," and its stderr file, and the worker and schedule logs of a bench out of lite mode. On a sandboxed bench, Frappe's own logs in ",[204,675,676],{},"logs\u002Fworkload\u002F",[617,678,679,680,682],{},"checked (lite mode); ",[204,681,676],{}," unit tested",[599,684,685,688,698],{},[617,686,687],{},"nginx",[617,689,669,690,693,694,697],{},[204,691,692],{},"\u003Cbench>\u002Flogs\u002Fnginx-access.log",", in the ",[204,695,696],{},"pilot_access"," format",[617,699,639],{},[599,701,702,705,711],{},[617,703,704],{},"Redis queue",[617,706,707,708],{},"Queue length, RQ registries, workers and Redis memory from ",[204,709,710],{},"[redis] queue_port",[617,712,639],{},[599,714,715,718,721],{},[617,716,717],{},"MariaDB",[617,719,720],{},"Not on Pilot: the site's database password stays readable by the bench user only",[617,722,723],{},"—",[599,725,726,729,747],{},[617,727,728],{},"Processes",[617,730,731,732,735,736,739,740,742,743,746],{},"The bench user's systemd ",[199,733,734],{},"user"," units, ",[204,737,738],{},"\u003Cbench>-\u003Cprocess>.service",", as ",[204,741,264],{}," copies them (",[204,744,745],{},"bench_processes_down","). The Admin is socket-activated: inactive until its first request is not down",[617,748,639],{},[599,750,751,754,779],{},[617,752,753],{},"Deployments",[617,755,756,757,760,761,763,764,767,768,771,772,775,776,778],{},"A ",[204,758,759],{},"deployment"," event (category ",[204,762,421],{},") when a task such as update, migrate or app install ",[199,765,766],{},"starts",", and an ",[204,769,770],{},"error"," event (",[204,773,774],{},"pilot_task_failed",") when one fails, from ",[204,777,264],{},"'s copy",[617,780,781],{},"checked with a migrate run from the Admin",[599,783,784,787,790],{},[617,785,786],{},"\"Enable Wolf for this bench\" toggle in Pilot",[617,788,789],{},"Needs a change in frappe\u002Fpilot",[617,791,792],{},[199,793,794],{},"not done",[188,796,797,798,215],{},"The metrics themselves are described on ",[191,799,55],{"href":56},[236,801,803],{"id":802},"bench-layout","Bench layout",[331,805,807],{"id":806},"benches","Benches",[188,809,810,811,814,815,818,819,822,823,826,827,830,831,830,834,830,837,830,840,830,843,632,845,215],{},"Pilot's ",[204,812,813],{},"install.sh"," installs into ",[204,816,817],{},"$HOME\u002Fpilot"," as a non-root bench user (",[204,820,821],{},"frappe"," by default). Benches live in ",[204,824,825],{},"~\u002Fpilot\u002Fbenches\u002F\u003Cname>\u002F",", each with ",[204,828,829],{},"apps\u002F",", ",[204,832,833],{},"sites\u002F",[204,835,836],{},"env\u002F",[204,838,839],{},"logs\u002F",[204,841,842],{},"config\u002F",[204,844,258],{},[204,846,254],{},[331,848,254],{"id":849},"benchtoml",[188,851,852,853,856],{},"Mode ",[204,854,855],{},"0600",", readable by the bench user only. Wolf reads it at registration, which runs as root:",[593,858,859,869],{},[596,860,861],{},[599,862,863,866],{},[602,864,865],{},"Key",[602,867,868],{},"Use",[612,870,871,883,895,912,924],{},[599,872,873,877],{},[617,874,875],{},[204,876,301],{},[617,878,879,880,882],{},"Required, together with ",[204,881,635],{},". The bench name and the Pilot marker",[599,884,885,889],{},[617,886,887],{},[204,888,710],{},[617,890,891,892],{},"Queue Redis port. Default ",[204,893,894],{},"11000",[599,896,897,902],{},[617,898,899],{},[204,900,901],{},"[admin] port",[617,903,904,905,908,909],{},"Default ",[204,906,907],{},"7000",". The Admin backend listens on ",[204,910,911],{},"127.0.0.1:\u003Cport + 1>",[599,913,914,918],{},[617,915,916],{},[204,917,576],{},[617,919,920,921,923],{},"Only when Wolf mints an Admin token, which needs ",[204,922,254],{}," readable. Pilot writes it at the Admin's first session",[599,925,926,931],{},[617,927,928],{},[204,929,930],{},"[production] enabled",[617,932,933],{},"Kept for information",[331,935,937],{"id":936},"processes-and-logs","Processes and logs",[188,939,940,941,944,945,948,949,830,952,830,955,830,958,961,962,965,966,215],{},"Pilot runs a production bench as ",[199,942,943],{},"systemd user units"," of the bench user (",[204,946,947],{},"systemctl --user","), with linger on: ",[204,950,951],{},"\u003Cbench>-web",[204,953,954],{},"\u003Cbench>-redis_cache",[204,956,957],{},"\u003Cbench>-redis_queue",[204,959,960],{},"\u003Cbench>-admin"," (socket-activated, ",[204,963,964],{},"\u003Cbench>-admin.socket",") and app processes. Pilot's MariaDB is the user unit ",[204,967,968],{},"pilot-mariadb",[188,970,971,974,975,978,979,981,982,985,986,989,990,993,994,632,997,1000,1001,215],{},[199,972,973],{},"Lite mode",", on by default (",[204,976,977],{},"[lite_mode] enabled","), runs the web server, the job workers and the scheduler in one ",[204,980,672],{}," process (",[204,983,984],{},"frappe.runner","). Its logs, Python's ",[204,987,988],{},"logging"," output included, go to ",[204,991,992],{},"logs\u002Fweb.log.error.log",". Out of lite mode there are worker and schedule processes, logged as ",[204,995,996],{},"worker_\u003Cqueue-slug>_\u003Ci>.log",[204,998,999],{},"schedule.log",", with stderr in ",[204,1002,1003],{},"\u003Clog>.error.log",[188,1005,1006,1009,1010,830,1013,1016,1017,1019,1020,1023,1024,1027,1028,1031,1032,1035],{},[199,1007,1008],{},"The sandbox."," A new systemd bench runs its workload sandboxed, and Frappe's own logs (",[204,1011,1012],{},"frappe.log",[204,1014,1015],{},"scheduler.log","…) are then in ",[204,1018,676],{},". The sandbox needs unprivileged user namespaces, which Ubuntu 24.04 refuses by default (",[204,1021,1022],{},"kernel.apparmor_restrict_unprivileged_userns = 1","): ",[204,1025,1026],{},"pilot setup production"," then fails, and Pilot advises ",[204,1029,1030],{},"sandbox = false"," under ",[204,1033,1034],{},"[production]",". Wolf reads both layouts.",[331,1037,687],{"id":687},[188,1039,1040,1041,426],{},"Each site vhost logs to ",[204,1042,692],{},[336,1044,1047],{"className":1045,"code":1046,"language":687,"meta":341,"style":341},"language-nginx shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","log_format pilot_access '$pilot_client_addr [$time_local] \"$request_method $uri\" $status \"$host\" $request_time';\n",[204,1048,1049],{"__ignoreMap":341},[345,1050,1051,1054,1058,1061,1064,1067,1070,1072,1075,1078,1080,1083,1086,1089,1092,1094,1097,1100,1102,1105,1107,1109,1112,1114],{"class":347,"line":348},[345,1052,1053],{"class":439},"log_format ",[345,1055,1057],{"class":1056},"sTEyZ","pilot_access ",[345,1059,1060],{"class":355},"'",[345,1062,1063],{"class":439},"$",[345,1065,1066],{"class":1056},"pilot_client_addr",[345,1068,1069],{"class":355}," [",[345,1071,1063],{"class":439},[345,1073,1074],{"class":1056},"time_local",[345,1076,1077],{"class":355},"] \"",[345,1079,1063],{"class":439},[345,1081,1082],{"class":1056},"request_method",[345,1084,1085],{"class":439}," $",[345,1087,1088],{"class":1056},"uri",[345,1090,1091],{"class":355},"\" ",[345,1093,1063],{"class":439},[345,1095,1096],{"class":1056},"status",[345,1098,1099],{"class":355}," \"",[345,1101,1063],{"class":439},[345,1103,1104],{"class":1056},"host",[345,1106,1091],{"class":355},[345,1108,1063],{"class":439},[345,1110,1111],{"class":1056},"request_time",[345,1113,1060],{"class":355},[345,1115,1116],{"class":439},";\n",[188,1118,1119,1120,273,1123,1126,1127,1130,1131,1134,1135,1138,1139,830,1142,1145,1146,1150],{},"This format has ",[199,1121,1122],{},"no query string",[204,1124,1125],{},"$uri",", not ",[204,1128,1129],{},"$request_uri",") and ",[199,1132,1133],{},"no User-Agent",". On a Pilot bench, Wolf's ",[191,1136,1137],{"href":125},"web detection"," sees probed paths (",[204,1140,1141],{},"\u002F.env",[204,1143,1144],{},"\u002F.git\u002F",", CMS and appliance paths) but not injections or path traversal carried in a query string, nor scanners named by their User-Agent. ",[191,1147,1149],{"href":1148},"\u002Fsecurity\u002Fwazuh-suricata#suricata","Suricata"," sees the full requests.",[331,1152,1154],{"id":1153},"tasks","Tasks",[188,1156,1157,1158,277,1161,426],{},"Admin operations are tasks, stored as ",[204,1159,1160],{},"\u003Cbench>\u002Ftasks\u002F\u003CYYYYMMDD-HHMMSS-hex>\u002F",[204,1162,1163],{},"0700",[283,1165,1166,1197],{},[286,1167,1168,1171,1172,830,1175,830,1178,830,1181,830,1184,830,1187,1190,1191,830,1194,215],{},[204,1169,1170],{},"meta.json",": ",[204,1173,1174],{},"task_id",[204,1176,1177],{},"command",[204,1179,1180],{},"args",[204,1182,1183],{},"queued_at",[204,1185,1186],{},"started_at",[204,1188,1189],{},"finished_at"," (UTC ISO-8601), ",[204,1192,1193],{},"exit_code",[204,1195,1196],{},"failure",[286,1198,1199,1171,1201,830,1204,830,1207,830,1210,1213,1214,215],{},[204,1200,1096],{},[204,1202,1203],{},"queued",[204,1205,1206],{},"running",[204,1208,1209],{},"success",[204,1211,1212],{},"failed"," or ",[204,1215,1216],{},"killed",[236,1218,1220],{"id":1219},"deployment-events-from-pilot-tasks","Deployment events from Pilot tasks",[188,1222,1223],{},"Wolf reports these task commands:",[188,1225,1226,830,1229,830,1232,830,1235,830,1238,830,1241,830,1244,830,1247,830,1250,830,1253,830,1256,830,1259,830,1262,830,1265,830,1268,830,1271,830,1274,830,1277,215],{},[204,1227,1228],{},"update",[204,1230,1231],{},"retry-update",[204,1233,1234],{},"complete-migration",[204,1236,1237],{},"migrate",[204,1239,1240],{},"revert-migration",[204,1242,1243],{},"revert-apps",[204,1245,1246],{},"revert-site",[204,1248,1249],{},"switch-branch",[204,1251,1252],{},"get-and-install-app",[204,1254,1255],{},"install-app",[204,1257,1258],{},"uninstall-app",[204,1260,1261],{},"remove-app",[204,1263,1264],{},"build",[204,1266,1267],{},"restart-services",[204,1269,1270],{},"switch-lite-mode",[204,1272,1273],{},"setup-nginx",[204,1275,1276],{},"restore-site",[204,1278,1279],{},"reinstall-site",[188,1281,1282,1283,207,1286,1289],{},"The site comes from the task's ",[204,1284,1285],{},"site",[204,1287,1288],{},"sites"," arguments; nothing else of the arguments is kept.",[331,1291,1293],{"id":1292},"where-tasks-are-read","Where tasks are read",[1295,1296,1297,1308,1317],"ol",{},[286,1298,1299,830,1302,632,1305,1307],{},[199,1300,1301],{},"Task files",[204,1303,1304],{},"\u003Cbench>\u002Ftasks\u002F*\u002Fmeta.json",[204,1306,1096],{},", when the agent can read them (an agent run as the bench user).",[286,1309,1310,830,1314,1316],{},[199,1311,1312,778],{},[204,1313,264],{},[204,1315,272],{},", when it is less than 5 minutes old: the normal case.",[286,1318,1319,830,1322,1325,1326,1328,1329,1213,1331,1333],{},[199,1320,1321],{},"Admin API",[204,1323,1324],{},"GET http:\u002F\u002F127.0.0.1:\u003Cadmin.port+1>\u002Fapi\u002Fv1\u002Ftasks?limit=100",", only without the two others. It needs a bench-scoped token: ",[204,1327,561],{},", or one Wolf mints from ",[204,1330,570],{},[204,1332,254],{},". Pilot lists every token it verifies among the Admin's active sessions, and a bench-scoped token can do everything the Admin can: the copy avoids both.",[331,1335,1337],{"id":1336},"how-events-are-produced","How events are produced",[283,1339,1340,1351,1368,1374],{},[286,1341,756,1342,1344,1345,1347,1348,215],{},[204,1343,759],{}," event is sent when the task starts, timestamped at ",[204,1346,1186],{},". An incident during a long migrate links to it, for example through the \"502 spike after deployment\" ",[191,1349,1350],{"href":97},"preset",[286,1352,1353,1354,1356,1357,1359,1360,830,1363,632,1366,215],{},"An ",[204,1355,770],{}," event is sent if the task ends ",[204,1358,1212],{},". It carries ",[204,1361,1362],{},"failure.code",[204,1364,1365],{},"failure.message",[204,1367,1193],{},[286,1369,1370,1371,215],{},"Reported task ids are kept for 3 days in ",[204,1372,1373],{},"\u003Cspool_dir>\u002Fpilot-tasks.json",[286,1375,1376],{},"The first poll skips history and only picks up queued or running tasks.",[188,1378,1379,1380,1382,1383,1385],{},"A migrate also records the site's own ",[204,1381,759],{}," event (source ",[204,1384,821],{},"), as on any bench: Pilot's says which task ran it.",[236,1387,1389],{"id":1388},"wolf-next-to-pilots-own-monitoring","Wolf next to Pilot's own monitoring",[188,1391,1392],{},"From the Pilot docs:",[283,1394,1395,1401,1411],{},[286,1396,1397,1400],{},[204,1398,1399],{},"pilot-monitor.service"," collects host, database and bench metrics and pings production sites.",[286,1402,1403,1406,1407,1410],{},[204,1404,1405],{},"[resource_limits]"," raises CPU, memory, disk and uptime alerts after 5 minutes. They go to Central (on Central-managed hosts), to ",[204,1408,1409],{},"webhook_endpoints"," and to mail.",[286,1412,1413,1416],{},[204,1414,1415],{},"[telemetry]"," ships metrics and logs to a region's \"Datum\" endpoint with a Central-issued token.",[188,1418,1419],{},"Wolf reads the same local files and does not interfere with any of these. What it adds on a self-hosted Pilot host:",[283,1421,1422,1425,1428,1431],{},[286,1423,1424],{},"Tracebacks, failed scheduled jobs and worker crashes as events.",[286,1426,1427],{},"5xx\u002F502 per site.",[286,1429,1430],{},"SSH signals.",[286,1432,1433],{},"Incidents tied to the Pilot task that preceded them.",[188,1435,1436],{},"All of it is kept on your own Wolf site.",[236,1438,1440],{"id":1439},"the-wolf-app-on-a-pilot-bench","The Wolf App on a Pilot bench",[188,1442,1443,1444,830,1447,1450,1451,1454,1455,1458,1459,1462,1463,1466],{},"The Wolf App installs on a Pilot bench like any app (",[204,1445,1446],{},"pilot get-app",[204,1448,1449],{},"pilot install-app","). Pilot checks that every app an app requires in ",[204,1452,1453],{},"hooks.py"," is declared in its ",[204,1456,1457],{},"pyproject.toml"," ",[204,1460,1461],{},"[tool.bench.frappe-dependencies]",", Frappe excepted: Frappe is implicit, and an app that lists it in ",[204,1464,1465],{},"required_apps"," is refused.",[236,1468,1470],{"id":1469},"what-pilot-would-need","What Pilot would need",[1295,1472,1473,1492,1501],{},[286,1474,1475,1478,1479,1482,1483,273,1485,830,1488,1491],{},[199,1476,1477],{},"\"Enable Wolf for this bench\" toggle."," A ",[204,1480,1481],{},"[wolf]"," table in ",[204,1484,254],{},[204,1486,1487],{},"enabled",[204,1489,1490],{},"url",") plus an Admin settings switch, which would install and register the agent. It belongs in frappe\u002Fpilot.",[286,1493,1494,273,1497,1500],{},[199,1495,1496],{},"A read-only machine token for the Admin API",[204,1498,1499],{},"tasks:read",", unit states), which would make the root helper unnecessary.",[286,1502,1503,1508],{},[199,1504,1505,1506],{},"The query string and User-Agent in ",[204,1507,696],{},", for web attack detection from the access log.",[1510,1511,1512],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}",{"title":341,"searchDepth":348,"depth":443,"links":1514},[1515,1518,1519,1526,1530,1531,1532],{"id":238,"depth":443,"text":24,"children":1516},[1517],{"id":415,"depth":460,"text":60},{"id":590,"depth":443,"text":591},{"id":802,"depth":443,"text":803,"children":1520},[1521,1522,1523,1524,1525],{"id":806,"depth":460,"text":807},{"id":849,"depth":460,"text":254},{"id":936,"depth":460,"text":937},{"id":687,"depth":460,"text":687},{"id":1153,"depth":460,"text":1154},{"id":1219,"depth":443,"text":1220,"children":1527},[1528,1529],{"id":1292,"depth":460,"text":1293},{"id":1336,"depth":460,"text":1337},{"id":1388,"depth":443,"text":1389},{"id":1439,"depth":443,"text":1440},{"id":1469,"depth":443,"text":1470},"Run the Wolf Agent on a Frappe Pilot host and turn Pilot tasks into deployment events.","md",null,{},{"icon":48},{"title":45,"description":1533},"NzmZfpr57e72gBH1L92X1jymPPLH6dLfsr1jdMrhhd8",[1541,1543],{"title":40,"path":41,"stem":42,"description":1542,"icon":43},"Install the Wolf App on the bench's other sites as satellites that forward to the central site.",{"title":55,"path":56,"stem":57,"description":1544,"icon":58},"Every metric and event the Wolf Agent sends, and where it reads it.",1795104293922]