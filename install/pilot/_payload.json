m":146,"icon":147},"Journal and deception","\u002Fsecurity\u002Fjournal","5.security\u002F5.journal","i-lucide-book-lock",{"title":149,"path":150,"stem":151,"icon":152},"Compliance and posture","\u002Fsecurity\u002Fcompliance","5.security\u002F6.compliance","i-lucide-scale",{"title":154,"path":155,"stem":156,"icon":109},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":158,"path":159,"stem":160,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":162,"icon":163,"path":164,"stem":165,"children":166,"page":54},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[167,172,177,182,187],{"title":168,"path":169,"stem":170,"icon":171},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":173,"path":174,"stem":175,"icon":176},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":178,"path":179,"stem":180,"icon":181},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":183,"path":184,"stem":185,"icon":186},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":188,"path":189,"stem":190,"icon":191},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"id":193,"title":50,"body":194,"description":1548,"extension":1549,"links":1550,"meta":1551,"navigation":1552,"path":51,"seo":1553,"stem":52,"__hash__":1554},"docs_en\u002F2.install\u002F5.pilot.md",{"type":195,"value":196,"toc":1528},"minimark",[197,226,245,249,259,292,306,319,326,336,407,423,426,437,540,590,598,602,805,810,814,818,857,860,867,944,948,979,1014,1046,1048,1053,1127,1161,1165,1174,1227,1231,1234,1290,1300,1304,1344,1348,1353,1392,1401,1405,1408,1432,1435,1449,1452,1456,1482,1486,1524],[198,199,200,207,208,212,213,217,218,221,222,225],"p",{},[201,202,206],"a",{"href":203,"rel":204},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fpilot",[205],"nofollow","Pilot"," is ",[209,210,211],"strong",{},"Frappe's"," server manager (\"Frappe Server Manager\"). It is not a Dokos tool: Dokos' public GitLab group has no Pilot repository. The Dokos documentation mentions Pilot only through the ",[214,215,216],"code",{},"pilot_endpoint"," \u002F ",[214,219,220],{},"pilot_auth_token"," site keys used by the Cloud Settings panel for Frappe Cloud v2 sites. These are the same keys Pilot writes into ",[214,223,224],{},"site_config.json",".",[198,227,228,229,232,233,236,237,244],{},"Everything on this page was checked on a live Pilot host: ",[209,230,231],{},"Pilot v1.0.0-rc.1",", and again on ",[209,234,235],{},"v1.0.0-rc.2"," (which changes only Pilot's release CI), in production mode (systemd user units, nginx, the Admin), a Frappe 16 bench and a site running the Wolf App. The repository's ",[201,238,241],{"href":239,"rel":240},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Ftree\u002Fmain\u002Fdev\u002Fpilot",[205],[214,242,243],{},"dev\u002Fpilot"," sets the same host up in a container.",[246,247,24],"h2",{"id":248},"install",[198,250,251,252,254,255,258],{},"Install the agent as on any host (",[201,253,35],{"href":36},"). It runs as its own ",[214,256,257],{},"wolf-agent"," user, out of the bench's reach: code that takes over a Frappe site cannot read its config, its integrity key or its state, nor stop it.",[198,260,261,262,265,266,269,270,275,276,279,280,283,284,287,288,291],{},"Pilot keeps a bench's ",[214,263,264],{},"bench.toml",", its ",[214,267,268],{},"tasks\u002F"," and its site configs readable by the bench user only, and runs the bench as that user's systemd user units, which another user cannot list. So on a Pilot host the installer also sets up ",[209,271,272],{},[214,273,274],{},"wolf-pilot-export",", a root helper run by ",[214,277,278],{},"wolf-pilot-export.timer"," every 20 seconds. It writes ",[214,281,282],{},"\u002Fvar\u002Flib\u002Fwolf-pilot-export\u002F\u003Cbench>.json"," (",[214,285,286],{},"root:wolf-agent",", mode ",[214,289,290],{},"0640",", in a folder root owns) with:",[293,294,295,299],"ul",{},[296,297,298],"li",{},"the latest 100 tasks: command, status, times, exit code, failure code and message, and of the arguments only the site;",[296,300,301,302,305],{},"the state of the bench's ",[214,303,304],{},"\u003Cbench>-*.service"," user units.",[198,307,308,309,312,313,315,316,318],{},"It reads the bench's files as the bench user, in a child process with a time limit: a link that user plants there gives access to nothing more than they could already read. It takes a bench only when its ",[214,310,311],{},"[bench] name"," is its folder's name and the folder belongs to the user whose home holds it. It copies nothing else: not ",[214,314,264],{}," (its Admin secret), not the site configs (their database passwords). Registration runs as root, so discovery still reads ",[214,317,264],{}," and the site configs once, for the bench's name, sites, domains and ports.",[198,320,321,322,325],{},"What this costs on Pilot: the ",[201,323,324],{"href":61},"MariaDB checks",", which need a site's database password.",[198,327,328,329,332,333,335],{},"To remove Wolf from a Pilot host, run ",[214,330,331],{},"systemctl disable --now wolf-pilot-export.timer"," before deleting the ",[214,334,257],{}," user: the helper's unit runs with that group, and fails at every run without it.",[337,338,340,345,370,374,399],"steps",{"level":339},"3",[341,342,344],"h3",{"id":343},"check-what-wolf-finds","Check what Wolf finds",[346,347,352],"pre",{"className":348,"code":349,"language":350,"meta":351,"style":351},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo wolf-agent discover\n","bash","",[214,353,354],{"__ignoreMap":351},[355,356,359,363,367],"span",{"class":357,"line":358},"line",1,[355,360,362],{"class":361},"sBMFI","sudo",[355,364,366],{"class":365},"sfazB"," wolf-agent",[355,368,369],{"class":365}," discover\n",[341,371,373],{"id":372},"check-what-would-be-sent","Check what would be sent",[346,375,377],{"className":348,"code":376,"language":350,"meta":351,"style":351},"sudo -u wolf-agent wolf-agent --config \u002Fetc\u002Fwolf-agent\u002Fconfig.json check\n",[214,378,379],{"__ignoreMap":351},[355,380,381,383,386,388,390,393,396],{"class":357,"line":358},[355,382,362],{"class":361},[355,384,385],{"class":365}," -u",[355,387,366],{"class":365},[355,389,366],{"class":365},[355,391,392],{"class":365}," --config",[355,394,395],{"class":365}," \u002Fetc\u002Fwolf-agent\u002Fconfig.json",[355,397,398],{"class":365}," check\n",[198,400,401,404,405,225],{},[214,402,403],{},"check"," collects once and prints the JSON payload. Nothing is sent. See ",[201,406,70],{"href":71},[408,409,410],"warning",{},[198,411,412,413,416,417,420,421,225],{},"Worker log names are globbed at registration. Re-run ",[214,414,415],{},"wolf-agent register"," after changing ",[214,418,419],{},"[[workers]]"," in ",[214,422,264],{},[341,424,65],{"id":425},"configuration",[198,427,428,429,432,433,436],{},"Deployment events from Pilot tasks are on by default. The ",[214,430,431],{},"pilot"," section of ",[214,434,435],{},"\u002Fetc\u002Fwolf-agent\u002Fconfig.json",":",[346,438,443],{"className":439,"code":440,"filename":441,"language":442,"meta":351,"style":351},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"pilot\": {\n    \"deployments\": true,\n    \"api_url\": null,\n    \"token\": null,\n    \"jwt_secret\": null\n  }\n}\n","config.json","json",[214,444,445,451,468,484,499,513,528,534],{"__ignoreMap":351},[355,446,447],{"class":357,"line":358},[355,448,450],{"class":449},"sMK4o","{\n",[355,452,454,457,460,463,465],{"class":357,"line":453},2,[355,455,456],{"class":449},"  \"",[355,458,431],{"class":459},"spNyl",[355,461,462],{"class":449},"\"",[355,464,436],{"class":449},[355,466,467],{"class":449}," {\n",[355,469,471,474,477,479,481],{"class":357,"line":470},3,[355,472,473],{"class":449},"    \"",[355,475,476],{"class":361},"deployments",[355,478,462],{"class":449},[355,480,436],{"class":449},[355,482,483],{"class":449}," true,\n",[355,485,487,489,492,494,496],{"class":357,"line":486},4,[355,488,473],{"class":449},[355,490,491],{"class":361},"api_url",[355,493,462],{"class":449},[355,495,436],{"class":449},[355,497,498],{"class":449}," null,\n",[355,500,502,504,507,509,511],{"class":357,"line":501},5,[355,503,473],{"class":449},[355,505,506],{"class":361},"token",[355,508,462],{"class":449},[355,510,436],{"class":449},[355,512,498],{"class":449},[355,514,516,518,521,523,525],{"class":357,"line":515},6,[355,517,473],{"class":449},[355,519,520],{"class":361},"jwt_secret",[355,522,462],{"class":449},[355,524,436],{"class":449},[355,526,527],{"class":449}," null\n",[355,529,531],{"class":357,"line":530},7,[355,532,533],{"class":449},"  }\n",[355,535,537],{"class":357,"line":536},8,[355,538,539],{"class":449},"}\n",[541,542,543,558,569,578],"field-group",{},[544,545,548],"field",{"name":546,"type":547},"pilot.deployments","boolean",[198,549,550,551,554,555,225],{},"Poll Pilot tasks and turn them into events. ",[214,552,553],{},"false"," turns task polling off. Default ",[214,556,557],{},"true",[544,559,562],{"name":560,"type":561},"pilot.api_url","string | null",[198,563,564,565,568],{},"Overrides the per-bench Admin API address ",[214,566,567],{},"http:\u002F\u002F127.0.0.1:\u003Cadmin.port+1>",". It applies to every Pilot bench on the host, so set it only on single-bench hosts.",[544,570,572],{"name":571,"type":561},"pilot.token",[198,573,574,575,577],{},"A bench-scoped Admin API token, used only without ",[214,576,274],{},"'s copy.",[544,579,581],{"name":580,"type":561},"pilot.jwt_secret",[198,582,583,584,587,588,577],{},"The bench's ",[214,585,586],{},"[admin] jwt_secret",", to mint a one-hour token, only without ",[214,589,274],{},[198,591,592,593,595,596,225],{},"With ",[214,594,274],{},", Wolf needs neither. The full config is on ",[201,597,65],{"href":66},[246,599,601],{"id":600},"what-wolf-does-on-a-pilot-bench","What Wolf does on a Pilot bench",[603,604,605,621],"table",{},[606,607,608],"thead",{},[609,610,611,615,618],"tr",{},[612,613,614],"th",{},"Area",[612,616,617],{},"What Wolf does",[612,619,620],{},"On v1.0.0-rc.1 and rc.2",[622,623,624,650,672,693,710,723,734,759,792],"tbody",{},[609,625,626,630,647],{},[627,628,629],"td",{},"Discovery",[627,631,632,633,636,637,639,640,642,643,646],{},"Searches ",[214,634,635],{},"\u002Fhome\u002F*\u002Fpilot\u002Fbenches\u002F*",". A ",[214,638,264],{}," with ",[214,641,311],{}," and ",[214,644,645],{},"python"," is a Pilot bench, read with its real keys",[627,648,649],{},"checked",[609,651,652,655,670],{},[627,653,654],{},"Sites",[627,656,657,658,661,662,665,666,669],{},"Reads ",[214,659,660],{},"sites\u002F*\u002Fsite_config.json",", plus ",[214,663,664],{},"domains"," (plain strings or ",[214,667,668],{},"{\"domain\": …, \"route\": …}",") for host → site mapping",[627,671,649],{},[609,673,674,677,687],{},[627,675,676],{},"Process logs",[627,678,679,680,683,684],{},"Tails ",[214,681,682],{},"web"," and its stderr file, and the worker and schedule logs of a bench out of lite mode. On a sandboxed bench, Frappe's own logs in ",[214,685,686],{},"logs\u002Fworkload\u002F",[627,688,689,690,692],{},"checked (lite mode); ",[214,691,686],{}," unit tested",[609,694,695,698,708],{},[627,696,697],{},"nginx",[627,699,679,700,703,704,707],{},[214,701,702],{},"\u003Cbench>\u002Flogs\u002Fnginx-access.log",", in the ",[214,705,706],{},"pilot_access"," format",[627,709,649],{},[609,711,712,715,721],{},[627,713,714],{},"Redis queue",[627,716,717,718],{},"Queue length, RQ registries, workers and Redis memory from ",[214,719,720],{},"[redis] queue_port",[627,722,649],{},[609,724,725,728,731],{},[627,726,727],{},"MariaDB",[627,729,730],{},"Not on Pilot: the site's database password stays readable by the bench user only",[627,732,733],{},"—",[609,735,736,739,757],{},[627,737,738],{},"Processes",[627,740,741,742,745,746,749,750,752,753,756],{},"The bench user's systemd ",[209,743,744],{},"user"," units, ",[214,747,748],{},"\u003Cbench>-\u003Cprocess>.service",", as ",[214,751,274],{}," copies them (",[214,754,755],{},"bench_processes_down","). The Admin is socket-activated: inactive until its first request is not down",[627,758,649],{},[609,760,761,764,789],{},[627,762,763],{},"Deployments",[627,765,766,767,770,771,773,774,777,778,781,782,785,786,788],{},"A ",[214,768,769],{},"deployment"," event (category ",[214,772,431],{},") when a task such as update, migrate or app install ",[209,775,776],{},"starts",", and an ",[214,779,780],{},"error"," event (",[214,783,784],{},"pilot_task_failed",") when one fails, from ",[214,787,274],{},"'s copy",[627,790,791],{},"checked with a migrate run from the Admin",[609,793,794,797,800],{},[627,795,796],{},"\"Enable Wolf for this bench\" toggle in Pilot",[627,798,799],{},"Needs a change in frappe\u002Fpilot",[627,801,802],{},[209,803,804],{},"not done",[198,806,807,808,225],{},"The metrics themselves are described on ",[201,809,60],{"href":61},[246,811,813],{"id":812},"bench-layout","Bench layout",[341,815,817],{"id":816},"benches","Benches",[198,819,820,821,824,825,828,829,832,833,836,837,840,841,840,844,840,847,840,850,840,853,642,855,225],{},"Pilot's ",[214,822,823],{},"install.sh"," installs into ",[214,826,827],{},"$HOME\u002Fpilot"," as a non-root bench user (",[214,830,831],{},"frappe"," by default). Benches live in ",[214,834,835],{},"~\u002Fpilot\u002Fbenches\u002F\u003Cname>\u002F",", each with ",[214,838,839],{},"apps\u002F",", ",[214,842,843],{},"sites\u002F",[214,845,846],{},"env\u002F",[214,848,849],{},"logs\u002F",[214,851,852],{},"config\u002F",[214,854,268],{},[214,856,264],{},[341,858,264],{"id":859},"benchtoml",[198,861,862,863,866],{},"Mode ",[214,864,865],{},"0600",", readable by the bench user only. Wolf reads it at registration, which runs as root:",[603,868,869,879],{},[606,870,871],{},[609,872,873,876],{},[612,874,875],{},"Key",[612,877,878],{},"Use",[622,880,881,893,905,922,934],{},[609,882,883,887],{},[627,884,885],{},[214,886,311],{},[627,888,889,890,892],{},"Required, together with ",[214,891,645],{},". The bench name and the Pilot marker",[609,894,895,899],{},[627,896,897],{},[214,898,720],{},[627,900,901,902],{},"Queue Redis port. Default ",[214,903,904],{},"11000",[609,906,907,912],{},[627,908,909],{},[214,910,911],{},"[admin] port",[627,913,914,915,918,919],{},"Default ",[214,916,917],{},"7000",". The Admin backend listens on ",[214,920,921],{},"127.0.0.1:\u003Cport + 1>",[609,923,924,928],{},[627,925,926],{},[214,927,586],{},[627,929,930,931,933],{},"Only when Wolf mints an Admin token, which needs ",[214,932,264],{}," readable. Pilot writes it at the Admin's first session",[609,935,936,941],{},[627,937,938],{},[214,939,940],{},"[production] enabled",[627,942,943],{},"Kept for information",[341,945,947],{"id":946},"processes-and-logs","Processes and logs",[198,949,950,951,954,955,958,959,840,962,840,965,840,968,971,972,975,976,225],{},"Pilot runs a production bench as ",[209,952,953],{},"systemd user units"," of the bench user (",[214,956,957],{},"systemctl --user","), with linger on: ",[214,960,961],{},"\u003Cbench>-web",[214,963,964],{},"\u003Cbench>-redis_cache",[214,966,967],{},"\u003Cbench>-redis_queue",[214,969,970],{},"\u003Cbench>-admin"," (socket-activated, ",[214,973,974],{},"\u003Cbench>-admin.socket",") and app processes. Pilot's MariaDB is the user unit ",[214,977,978],{},"pilot-mariadb",[198,980,981,984,985,988,989,991,992,995,996,999,1000,1003,1004,642,1007,1010,1011,225],{},[209,982,983],{},"Lite mode",", on by default (",[214,986,987],{},"[lite_mode] enabled","), runs the web server, the job workers and the scheduler in one ",[214,990,682],{}," process (",[214,993,994],{},"frappe.runner","). Its logs, Python's ",[214,997,998],{},"logging"," output included, go to ",[214,1001,1002],{},"logs\u002Fweb.log.error.log",". Out of lite mode there are worker and schedule processes, logged as ",[214,1005,1006],{},"worker_\u003Cqueue-slug>_\u003Ci>.log",[214,1008,1009],{},"schedule.log",", with stderr in ",[214,1012,1013],{},"\u003Clog>.error.log",[198,1015,1016,1019,1020,840,1023,1026,1027,1029,1030,1033,1034,1037,1038,1041,1042,1045],{},[209,1017,1018],{},"The sandbox."," A new systemd bench runs its workload sandboxed, and Frappe's own logs (",[214,1021,1022],{},"frappe.log",[214,1024,1025],{},"scheduler.log","…) are then in ",[214,1028,686],{},". The sandbox needs unprivileged user namespaces, which Ubuntu 24.04 refuses by default (",[214,1031,1032],{},"kernel.apparmor_restrict_unprivileged_userns = 1","): ",[214,1035,1036],{},"pilot setup production"," then fails, and Pilot advises ",[214,1039,1040],{},"sandbox = false"," under ",[214,1043,1044],{},"[production]",". Wolf reads both layouts.",[341,1047,697],{"id":697},[198,1049,1050,1051,436],{},"Each site vhost logs to ",[214,1052,702],{},[346,1054,1057],{"className":1055,"code":1056,"language":697,"meta":351,"style":351},"language-nginx shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","log_format pilot_access '$pilot_client_addr [$time_local] \"$request_method $uri\" $status \"$host\" $request_time';\n",[214,1058,1059],{"__ignoreMap":351},[355,1060,1061,1064,1068,1071,1074,1077,1080,1082,1085,1088,1090,1093,1096,1099,1102,1104,1107,1110,1112,1115,1117,1119,1122,1124],{"class":357,"line":358},[355,1062,1063],{"class":449},"log_format ",[355,1065,1067],{"class":1066},"sTEyZ","pilot_access ",[355,1069,1070],{"class":365},"'",[355,1072,1073],{"class":449},"$",[355,1075,1076],{"class":1066},"pilot_client_addr",[355,1078,1079],{"class":365}," [",[355,1081,1073],{"class":449},[355,1083,1084],{"class":1066},"time_local",[355,1086,1087],{"class":365},"] \"",[355,1089,1073],{"class":449},[355,1091,1092],{"class":1066},"request_method",[355,1094,1095],{"class":449}," $",[355,1097,1098],{"class":1066},"uri",[355,1100,1101],{"class":365},"\" ",[355,1103,1073],{"class":449},[355,1105,1106],{"class":1066},"status",[355,1108,1109],{"class":365}," \"",[355,1111,1073],{"class":449},[355,1113,1114],{"class":1066},"host",[355,1116,1101],{"class":365},[355,1118,1073],{"class":449},[355,1120,1121],{"class":1066},"request_time",[355,1123,1070],{"class":365},[355,1125,1126],{"class":449},";\n",[198,1128,1129,1130,283,1133,1136,1137,1140,1141,1144,1145,1148,1149,840,1152,1155,1156,1160],{},"This format has ",[209,1131,1132],{},"no query string",[214,1134,1135],{},"$uri",", not ",[214,1138,1139],{},"$request_uri",") and ",[209,1142,1143],{},"no User-Agent",". On a Pilot bench, Wolf's ",[201,1146,1147],{"href":135},"web detection"," sees probed paths (",[214,1150,1151],{},"\u002F.env",[214,1153,1154],{},"\u002F.git\u002F",", CMS and appliance paths) but not injections or path traversal carried in a query string, nor scanners named by their User-Agent. ",[201,1157,1159],{"href":1158},"\u002Fsecurity\u002Fwazuh-suricata#suricata","Suricata"," sees the full requests.",[341,1162,1164],{"id":1163},"tasks","Tasks",[198,1166,1167,1168,287,1171,436],{},"Admin operations are tasks, stored as ",[214,1169,1170],{},"\u003Cbench>\u002Ftasks\u002F\u003CYYYYMMDD-HHMMSS-hex>\u002F",[214,1172,1173],{},"0700",[293,1175,1176,1207],{},[296,1177,1178,1181,1182,840,1185,840,1188,840,1191,840,1194,840,1197,1200,1201,840,1204,225],{},[214,1179,1180],{},"meta.json",": ",[214,1183,1184],{},"task_id",[214,1186,1187],{},"command",[214,1189,1190],{},"args",[214,1192,1193],{},"queued_at",[214,1195,1196],{},"started_at",[214,1198,1199],{},"finished_at"," (UTC ISO-8601), ",[214,1202,1203],{},"exit_code",[214,1205,1206],{},"failure",[296,1208,1209,1181,1211,840,1214,840,1217,840,1220,1223,1224,225],{},[214,1210,1106],{},[214,1212,1213],{},"queued",[214,1215,1216],{},"running",[214,1218,1219],{},"success",[214,1221,1222],{},"failed"," or ",[214,1225,1226],{},"killed",[246,1228,1230],{"id":1229},"deployment-events-from-pilot-tasks","Deployment events from Pilot tasks",[198,1232,1233],{},"Wolf reports these task commands:",[198,1235,1236,840,1239,840,1242,840,1245,840,1248,840,1251,840,1254,840,1257,840,1260,840,1263,840,1266,840,1269,840,1272,840,1275,840,1278,840,1281,840,1284,840,1287,225],{},[214,1237,1238],{},"update",[214,1240,1241],{},"retry-update",[214,1243,1244],{},"complete-migration",[214,1246,1247],{},"migrate",[214,1249,1250],{},"revert-migration",[214,1252,1253],{},"revert-apps",[214,1255,1256],{},"revert-site",[214,1258,1259],{},"switch-branch",[214,1261,1262],{},"get-and-install-app",[214,1264,1265],{},"install-app",[214,1267,1268],{},"uninstall-app",[214,1270,1271],{},"remove-app",[214,1273,1274],{},"build",[214,1276,1277],{},"restart-services",[214,1279,1280],{},"switch-lite-mode",[214,1282,1283],{},"setup-nginx",[214,1285,1286],{},"restore-site",[214,1288,1289],{},"reinstall-site",[198,1291,1292,1293,217,1296,1299],{},"The site comes from the task's ",[214,1294,1295],{},"site",[214,1297,1298],{},"sites"," arguments; nothing else of the arguments is kept.",[341,1301,1303],{"id":1302},"where-tasks-are-read","Where tasks are read",[1305,1306,1307,1318,1327],"ol",{},[296,1308,1309,840,1312,642,1315,1317],{},[209,1310,1311],{},"Task files",[214,1313,1314],{},"\u003Cbench>\u002Ftasks\u002F*\u002Fmeta.json",[214,1316,1106],{},", when the agent can read them (an agent run as the bench user).",[296,1319,1320,840,1324,1326],{},[209,1321,1322,788],{},[214,1323,274],{},[214,1325,282],{},", when it is less than 5 minutes old: the normal case.",[296,1328,1329,840,1332,1335,1336,1338,1339,1223,1341,1343],{},[209,1330,1331],{},"Admin API",[214,1333,1334],{},"GET http:\u002F\u002F127.0.0.1:\u003Cadmin.port+1>\u002Fapi\u002Fv1\u002Ftasks?limit=100",", only without the two others. It needs a bench-scoped token: ",[214,1337,571],{},", or one Wolf mints from ",[214,1340,580],{},[214,1342,264],{},". Pilot lists every token it verifies among the Admin's active sessions, and a bench-scoped token can do everything the Admin can: the copy avoids both.",[341,1345,1347],{"id":1346},"how-events-are-produced","How events are produced",[198,1349,1350,1351,436],{},"The same rules as on ",[201,1352,45],{"href":46},[293,1354,1355,1366,1383,1389],{},[296,1356,766,1357,1359,1360,1362,1363,225],{},[214,1358,769],{}," event is sent when the task starts, timestamped at ",[214,1361,1196],{},". An incident during a long migrate links to it, for example through the \"502 spike after deployment\" ",[201,1364,1365],{"href":102},"preset",[296,1367,1368,1369,1371,1372,1374,1375,840,1378,642,1381,225],{},"An ",[214,1370,780],{}," event is sent if the task ends ",[214,1373,1222],{},". It carries ",[214,1376,1377],{},"failure.code",[214,1379,1380],{},"failure.message",[214,1382,1203],{},[296,1384,1385,1386,225],{},"Reported task ids are kept for 3 days in ",[214,1387,1388],{},"\u003Cspool_dir>\u002Fpilot-tasks.json",[296,1390,1391],{},"The first poll skips history and only picks up queued or running tasks.",[198,1393,1394,1395,1397,1398,1400],{},"A migrate also records the site's own ",[214,1396,769],{}," event (source ",[214,1399,831],{},"), as on any bench: Pilot's says which task ran it.",[246,1402,1404],{"id":1403},"wolf-next-to-pilots-own-monitoring","Wolf next to Pilot's own monitoring",[198,1406,1407],{},"From the Pilot docs:",[293,1409,1410,1416,1426],{},[296,1411,1412,1415],{},[214,1413,1414],{},"pilot-monitor.service"," collects host, database and bench metrics and pings production sites.",[296,1417,1418,1421,1422,1425],{},[214,1419,1420],{},"[resource_limits]"," raises CPU, memory, disk and uptime alerts after 5 minutes. They go to Central (on Central-managed hosts), to ",[214,1423,1424],{},"webhook_endpoints"," and to mail.",[296,1427,1428,1431],{},[214,1429,1430],{},"[telemetry]"," ships metrics and logs to a region's \"Datum\" endpoint with a Central-issued token.",[198,1433,1434],{},"Wolf reads the same local files and does not interfere with any of these. What it adds on a self-hosted Pilot host:",[293,1436,1437,1440,1443,1446],{},[296,1438,1439],{},"Tracebacks, failed scheduled jobs and worker crashes as events.",[296,1441,1442],{},"5xx\u002F502 per site.",[296,1444,1445],{},"SSH signals.",[296,1447,1448],{},"Incidents tied to the Pilot task that preceded them.",[198,1450,1451],{},"All of it is kept on your own Wolf site.",[246,1453,1455],{"id":1454},"the-wolf-app-on-a-pilot-bench","The Wolf App on a Pilot bench",[198,1457,1458,1459,840,1462,1465,1466,1469,1470,1473,1474,1477,1478,1481],{},"The Wolf App installs on a Pilot bench like any app (",[214,1460,1461],{},"pilot get-app",[214,1463,1464],{},"pilot install-app","). Pilot checks that every app an app requires in ",[214,1467,1468],{},"hooks.py"," is declared in its ",[214,1471,1472],{},"pyproject.toml"," ",[214,1475,1476],{},"[tool.bench.frappe-dependencies]",", Frappe excepted: Frappe is implicit, and an app that lists it in ",[214,1479,1480],{},"required_apps"," is refused.",[246,1483,1485],{"id":1484},"what-pilot-would-need","What Pilot would need",[1305,1487,1488,1507,1516],{},[296,1489,1490,1493,1494,1497,1498,283,1500,840,1503,1506],{},[209,1491,1492],{},"\"Enable Wolf for this bench\" toggle."," A ",[214,1495,1496],{},"[wolf]"," table in ",[214,1499,264],{},[214,1501,1502],{},"enabled",[214,1504,1505],{},"url",") plus an Admin settings switch, which would install and register the agent. It belongs in frappe\u002Fpilot.",[296,1508,1509,283,1512,1515],{},[209,1510,1511],{},"A read-only machine token for the Admin API",[214,1513,1514],{},"tasks:read",", unit states), which would make the root helper unnecessary.",[296,1517,1518,1523],{},[209,1519,1520,1521],{},"The query string and User-Agent in ",[214,1522,706],{},", for web attack detection from the access log.",[1525,1526,1527],"style",{},"html pre.shiki code .sBMFI