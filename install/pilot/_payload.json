44,"path":145,"stem":146,"icon":104},"SIEM export","\u002Fsecurity\u002Fsiem-export","5.security\u002F7.siem-export",{"title":148,"path":149,"stem":150,"icon":43},"Wazuh and Suricata","\u002Fsecurity\u002Fwazuh-suricata","5.security\u002F8.wazuh-suricata",{"title":152,"icon":153,"path":154,"stem":155,"children":156,"page":49},"Reference","i-lucide-book-marked","\u002Freference","6.reference",[157,162,167,172,177],{"title":158,"path":159,"stem":160,"icon":161},"Agent protocol","\u002Freference\u002Fprotocol","6.reference\u002F1.protocol","i-lucide-arrow-left-right",{"title":163,"path":164,"stem":165,"icon":166},"UI API","\u002Freference\u002Fui-api","6.reference\u002F2.ui-api","i-lucide-braces",{"title":168,"path":169,"stem":170,"icon":171},"Metric storage","\u002Freference\u002Fmetric-storage","6.reference\u002F3.metric-storage","i-lucide-database",{"title":173,"path":174,"stem":175,"icon":176},"Performance","\u002Freference\u002Fperformance","6.reference\u002F4.performance","i-lucide-gauge",{"title":178,"path":179,"stem":180,"icon":181},"Development","\u002Freference\u002Fdevelopment","6.reference\u002F5.development","i-lucide-code",{"title":183,"path":184,"stem":185,"children":186,"icon":189},"Internals","\u002Finternals","7.internals\u002F1.index",[187,190,195,199,204,208],{"title":188,"path":184,"stem":185,"icon":189},"Frappe Cloud v2, read from its code","i-lucide-map",{"title":191,"path":192,"stem":193,"icon":194},"The applications","\u002Finternals\u002Fapps","7.internals\u002F2.apps","i-lucide-boxes",{"title":196,"path":197,"stem":198,"icon":132},"Calls and trust","\u002Finternals\u002Finterop","7.internals\u002F3.interop",{"title":200,"path":201,"stem":202,"icon":203},"Flows","\u002Finternals\u002Fflows","7.internals\u002F4.flows","i-lucide-route",{"title":205,"path":206,"stem":207,"icon":38},"Inside a customer server","\u002Finternals\u002Fcustomer-server","7.internals\u002F5.customer-server",{"title":209,"path":210,"stem":211,"icon":117},"Notes for Wolf","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":45,"body":214,"description":1563,"extension":1564,"links":1565,"meta":1566,"navigation":1567,"path":46,"seo":1568,"stem":47,"__hash__":1569},"docs_en\u002F2.install\u002F5.pilot.md",{"type":215,"value":216,"toc":1543},"minimark",[217,246,265,269,279,312,326,339,346,356,427,443,446,457,560,610,618,622,825,830,834,838,877,880,887,964,968,999,1034,1066,1068,1073,1147,1181,1185,1194,1247,1251,1254,1310,1320,1324,1364,1368,1407,1416,1420,1423,1447,1450,1464,1467,1471,1497,1501,1539],[218,219,220,227,228,232,233,237,238,241,242,245],"p",{},[221,222,226],"a",{"href":223,"rel":224},"https:\u002F\u002Fgithub.com\u002Ffrappe\u002Fpilot",[225],"nofollow","Pilot"," is ",[229,230,231],"strong",{},"Frappe's"," server manager (\"Frappe Server Manager\"). It is not a Dokos tool: Dokos' public GitLab group has no Pilot repository. The Dokos documentation mentions Pilot only through the ",[234,235,236],"code",{},"pilot_endpoint"," \u002F ",[234,239,240],{},"pilot_auth_token"," site keys used by the Cloud Settings panel for Frappe Cloud v2 sites. These are the same keys Pilot writes into ",[234,243,244],{},"site_config.json",".",[218,247,248,249,252,253,256,257,264],{},"Everything on this page was checked on a live Pilot host: ",[229,250,251],{},"Pilot v1.0.0-rc.1",", and again on ",[229,254,255],{},"v1.0.0-rc.2"," (which changes only Pilot's release CI), in production mode (systemd user units, nginx, the Admin), a Frappe 16 bench and a site running the Wolf App. The repository's ",[221,258,261],{"href":259,"rel":260},"https:\u002F\u002Fgithub.com\u002Fbthuner\u002Fdodock-wolf\u002Ftree\u002Fmain\u002Fdev\u002Fpilot",[225],[234,262,263],{},"dev\u002Fpilot"," sets the same host up in a container.",[266,267,24],"h2",{"id":268},"install",[218,270,271,272,274,275,278],{},"Install the agent as on any host (",[221,273,35],{"href":36},"). It runs as its own ",[234,276,277],{},"wolf-agent"," user, out of the bench's reach: code that takes over a Frappe site cannot read its config, its integrity key or its state, nor stop it.",[218,280,281,282,285,286,289,290,295,296,299,300,303,304,307,308,311],{},"Pilot keeps a bench's ",[234,283,284],{},"bench.toml",", its ",[234,287,288],{},"tasks\u002F"," and its site configs readable by the bench user only, and runs the bench as that user's systemd user units, which another user cannot list. So on a Pilot host the installer also sets up ",[229,291,292],{},[234,293,294],{},"wolf-pilot-export",", a root helper run by ",[234,297,298],{},"wolf-pilot-export.timer"," every 20 seconds. It writes ",[234,301,302],{},"\u002Fvar\u002Flib\u002Fwolf-pilot-export\u002F\u003Cbench>.json"," (",[234,305,306],{},"root:wolf-agent",", mode ",[234,309,310],{},"0640",", in a folder root owns) with:",[313,314,315,319],"ul",{},[316,317,318],"li",{},"the latest 100 tasks: command, status, times, exit code, failure code and message, and of the arguments only the site;",[316,320,321,322,325],{},"the state of the bench's ",[234,323,324],{},"\u003Cbench>-*.service"," user units.",[218,327,328,329,332,333,335,336,338],{},"It reads the bench's files as the bench user, in a child process with a time limit: a link that user plants there gives access to nothing more than they could already read. It takes a bench only when its ",[234,330,331],{},"[bench] name"," is its folder's name and the folder belongs to the user whose home holds it. It copies nothing else: not ",[234,334,284],{}," (its Admin secret), not the site configs (their database passwords). Registration runs as root, so discovery still reads ",[234,337,284],{}," and the site configs once, for the bench's name, sites, domains and ports.",[218,340,341,342,345],{},"What this costs on Pilot: the ",[221,343,344],{"href":56},"MariaDB checks",", which need a site's database password.",[218,347,348,349,352,353,355],{},"To remove Wolf from a Pilot host, run ",[234,350,351],{},"systemctl disable --now wolf-pilot-export.timer"," before deleting the ",[234,354,277],{}," user: the helper's unit runs with that group, and fails at every run without it.",[357,358,360,365,390,394,419],"steps",{"level":359},"3",[361,362,364],"h3",{"id":363},"check-what-wolf-finds","Check what Wolf finds",[366,367,372],"pre",{"className":368,"code":369,"language":370,"meta":371,"style":371},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","sudo wolf-agent discover\n","bash","",[234,373,374],{"__ignoreMap":371},[375,376,379,383,387],"span",{"class":377,"line":378},"line",1,[375,380,382],{"class":381},"sBMFI","sudo",[375,384,386],{"class":385},"sfazB"," wolf-agent",[375,388,389],{"class":385}," discover\n",[361,391,393],{"id":392},"check-what-would-be-sent","Check what would be sent",[366,395,397],{"className":368,"code":396,"language":370,"meta":371,"style":371},"sudo -u wolf-agent wolf-agent --config \u002Fetc\u002Fwolf-agent\u002Fconfig.json check\n",[234,398,399],{"__ignoreMap":371},[375,400,401,403,406,408,410,413,416],{"class":377,"line":378},[375,402,382],{"class":381},[375,404,405],{"class":385}," -u",[375,407,386],{"class":385},[375,409,386],{"class":385},[375,411,412],{"class":385}," --config",[375,414,415],{"class":385}," \u002Fetc\u002Fwolf-agent\u002Fconfig.json",[375,417,418],{"class":385}," check\n",[218,420,421,424,425,245],{},[234,422,423],{},"check"," collects once and prints the JSON payload. Nothing is sent. See ",[221,426,65],{"href":66},[428,429,430],"warning",{},[218,431,432,433,436,437,440,441,245],{},"Worker log names are globbed at registration. Re-run ",[234,434,435],{},"wolf-agent register"," after changing ",[234,438,439],{},"[[workers]]"," in ",[234,442,284],{},[361,444,60],{"id":445},"configuration",[218,447,448,449,452,453,456],{},"Deployment events from Pilot tasks are on by default. The ",[234,450,451],{},"pilot"," section of ",[234,454,455],{},"\u002Fetc\u002Fwolf-agent\u002Fconfig.json",":",[366,458,463],{"className":459,"code":460,"filename":461,"language":462,"meta":371,"style":371},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"pilot\": {\n    \"deployments\": true,\n    \"api_url\": null,\n    \"token\": null,\n    \"jwt_secret\": null\n  }\n}\n","config.json","json",[234,464,465,471,488,504,519,533,548,554],{"__ignoreMap":371},[375,466,467],{"class":377,"line":378},[375,468,470],{"class":469},"sMK4o","{\n",[375,472,474,477,480,483,485],{"class":377,"line":473},2,[375,475,476],{"class":469},"  \"",[375,478,451],{"class":479},"spNyl",[375,481,482],{"class":469},"\"",[375,484,456],{"class":469},[375,486,487],{"class":469}," {\n",[375,489,491,494,497,499,501],{"class":377,"line":490},3,[375,492,493],{"class":469},"    \"",[375,495,496],{"class":381},"deployments",[375,498,482],{"class":469},[375,500,456],{"class":469},[375,502,503],{"class":469}," true,\n",[375,505,507,509,512,514,516],{"class":377,"line":506},4,[375,508,493],{"class":469},[375,510,511],{"class":381},"api_url",[375,513,482],{"class":469},[375,515,456],{"class":469},[375,517,518],{"class":469}," null,\n",[375,520,522,524,527,529,531],{"class":377,"line":521},5,[375,523,493],{"class":469},[375,525,526],{"class":381},"token",[375,528,482],{"class":469},[375,530,456],{"class":469},[375,532,518],{"class":469},[375,534,536,538,541,543,545],{"class":377,"line":535},6,[375,537,493],{"class":469},[375,539,540],{"class":381},"jwt_secret",[375,542,482],{"class":469},[375,544,456],{"class":469},[375,546,547],{"class":469}," null\n",[375,549,551],{"class":377,"line":550},7,[375,552,553],{"class":469},"  }\n",[375,555,557],{"class":377,"line":556},8,[375,558,559],{"class":469},"}\n",[561,562,563,578,589,598],"field-group",{},[564,565,568],"field",{"name":566,"type":567},"pilot.deployments","boolean",[218,569,570,571,574,575,245],{},"Poll Pilot tasks and turn them into events. ",[234,572,573],{},"false"," turns task polling off. Default ",[234,576,577],{},"true",[564,579,582],{"name":580,"type":581},"pilot.api_url","string | null",[218,583,584,585,588],{},"Overrides the per-bench Admin API address ",[234,586,587],{},"http:\u002F\u002F127.0.0.1:\u003Cadmin.port+1>",". It applies to every Pilot bench on the host, so set it only on single-bench hosts.",[564,590,592],{"name":591,"type":581},"pilot.token",[218,593,594,595,597],{},"A bench-scoped Admin API token, used only without ",[234,596,294],{},"'s copy.",[564,599,601],{"name":600,"type":581},"pilot.jwt_secret",[218,602,603,604,607,608,597],{},"The bench's ",[234,605,606],{},"[admin] jwt_secret",", to mint a one-hour token, only without ",[234,609,294],{},[218,611,612,613,615,616,245],{},"With ",[234,614,294],{},", Wolf needs neither. The full config is on ",[221,617,60],{"href":61},[266,619,621],{"id":620},"what-wolf-does-on-a-pilot-bench","What Wolf does on a Pilot bench",[623,624,625,641],"table",{},[626,627,628],"thead",{},[629,630,631,635,638],"tr",{},[632,633,634],"th",{},"Area",[632,636,637],{},"What Wolf does",[632,639,640],{},"On v1.0.0-rc.1 and rc.2",[642,643,644,670,692,713,730,743,754,779,812],"tbody",{},[629,645,646,650,667],{},[647,648,649],"td",{},"Discovery",[647,651,652,653,656,657,659,660,662,663,666],{},"Searches ",[234,654,655],{},"\u002Fhome\u002F*\u002Fpilot\u002Fbenches\u002F*",". A ",[234,658,284],{}," with ",[234,661,331],{}," and ",[234,664,665],{},"python"," is a Pilot bench, read with its real keys",[647,668,669],{},"checked",[629,671,672,675,690],{},[647,673,674],{},"Sites",[647,676,677,678,681,682,685,686,689],{},"Reads ",[234,679,680],{},"sites\u002F*\u002Fsite_config.json",", plus ",[234,683,684],{},"domains"," (plain strings or ",[234,687,688],{},"{\"domain\": …, \"route\": …}",") for host → site mapping",[647,691,669],{},[629,693,694,697,707],{},[647,695,696],{},"Process logs",[647,698,699,700,703,704],{},"Tails ",[234,701,702],{},"web"," and its stderr file, and the worker and schedule logs of a bench out of lite mode. On a sandboxed bench, Frappe's own logs in ",[234,705,706],{},"logs\u002Fworkload\u002F",[647,708,709,710,712],{},"checked (lite mode); ",[234,711,706],{}," unit tested",[629,714,715,718,728],{},[647,716,717],{},"nginx",[647,719,699,720,723,724,727],{},[234,721,722],{},"\u003Cbench>\u002Flogs\u002Fnginx-access.log",", in the ",[234,725,726],{},"pilot_access"," format",[647,729,669],{},[629,731,732,735,741],{},[647,733,734],{},"Redis queue",[647,736,737,738],{},"Queue length, RQ registries, workers and Redis memory from ",[234,739,740],{},"[redis] queue_port",[647,742,669],{},[629,744,745,748,751],{},[647,746,747],{},"MariaDB",[647,749,750],{},"Not on Pilot: the site's database password stays readable by the bench user only",[647,752,753],{},"—",[629,755,756,759,777],{},[647,757,758],{},"Processes",[647,760,761,762,765,766,769,770,772,773,776],{},"The bench user's systemd ",[229,763,764],{},"user"," units, ",[234,767,768],{},"\u003Cbench>-\u003Cprocess>.service",", as ",[234,771,294],{}," copies them (",[234,774,775],{},"bench_processes_down","). The Admin is socket-activated: inactive until its first request is not down",[647,778,669],{},[629,780,781,784,809],{},[647,782,783],{},"Deployments",[647,785,786,787,790,791,793,794,797,798,801,802,805,806,808],{},"A ",[234,788,789],{},"deployment"," event (category ",[234,792,451],{},") when a task such as update, migrate or app install ",[229,795,796],{},"starts",", and an ",[234,799,800],{},"error"," event (",[234,803,804],{},"pilot_task_failed",") when one fails, from ",[234,807,294],{},"'s copy",[647,810,811],{},"checked with a migrate run from the Admin",[629,813,814,817,820],{},[647,815,816],{},"\"Enable Wolf for this bench\" toggle in Pilot",[647,818,819],{},"Needs a change in frappe\u002Fpilot",[647,821,822],{},[229,823,824],{},"not done",[218,826,827,828,245],{},"The metrics themselves are described on ",[221,829,55],{"href":56},[266,831,833],{"id":832},"bench-layout","Bench layout",[361,835,837],{"id":836},"benches","Benches",[218,839,840,841,844,845,848,849,852,853,856,857,860,861,860,864,860,867,860,870,860,873,662,875,245],{},"Pilot's ",[234,842,843],{},"install.sh"," installs into ",[234,846,847],{},"$HOME\u002Fpilot"," as a non-root bench user (",[234,850,851],{},"frappe"," by default). Benches live in ",[234,854,855],{},"~\u002Fpilot\u002Fbenches\u002F\u003Cname>\u002F",", each with ",[234,858,859],{},"apps\u002F",", ",[234,862,863],{},"sites\u002F",[234,865,866],{},"env\u002F",[234,868,869],{},"logs\u002F",[234,871,872],{},"config\u002F",[234,874,288],{},[234,876,284],{},[361,878,284],{"id":879},"benchtoml",[218,881,882,883,886],{},"Mode ",[234,884,885],{},"0600",", readable by the bench user only. Wolf reads it at registration, which runs as root:",[623,888,889,899],{},[626,890,891],{},[629,892,893,896],{},[632,894,895],{},"Key",[632,897,898],{},"Use",[642,900,901,913,925,942,954],{},[629,902,903,907],{},[647,904,905],{},[234,906,331],{},[647,908,909,910,912],{},"Required, together with ",[234,911,665],{},". The bench name and the Pilot marker",[629,914,915,919],{},[647,916,917],{},[234,918,740],{},[647,920,921,922],{},"Queue Redis port. Default ",[234,923,924],{},"11000",[629,926,927,932],{},[647,928,929],{},[234,930,931],{},"[admin] port",[647,933,934,935,938,939],{},"Default ",[234,936,937],{},"7000",". The Admin backend listens on ",[234,940,941],{},"127.0.0.1:\u003Cport + 1>",[629,943,944,948],{},[647,945,946],{},[234,947,606],{},[647,949,950,951,953],{},"Only when Wolf mints an Admin token, which needs ",[234,952,284],{}," readable. Pilot writes it at the Admin's first session",[629,955,956,961],{},[647,957,958],{},[234,959,960],{},"[production] enabled",[647,962,963],{},"Kept for information",[361,965,967],{"id":966},"processes-and-logs","Processes and logs",[218,969,970,971,974,975,978,979,860,982,860,985,860,988,991,992,995,996,245],{},"Pilot runs a production bench as ",[229,972,973],{},"systemd user units"," of the bench user (",[234,976,977],{},"systemctl --user","), with linger on: ",[234,980,981],{},"\u003Cbench>-web",[234,983,984],{},"\u003Cbench>-redis_cache",[234,986,987],{},"\u003Cbench>-redis_queue",[234,989,990],{},"\u003Cbench>-admin"," (socket-activated, ",[234,993,994],{},"\u003Cbench>-admin.socket",") and app processes. Pilot's MariaDB is the user unit ",[234,997,998],{},"pilot-mariadb",[218,1000,1001,1004,1005,1008,1009,1011,1012,1015,1016,1019,1020,1023,1024,662,1027,1030,1031,245],{},[229,1002,1003],{},"Lite mode",", on by default (",[234,1006,1007],{},"[lite_mode] enabled","), runs the web server, the job workers and the scheduler in one ",[234,1010,702],{}," process (",[234,1013,1014],{},"frappe.runner","). Its logs, Python's ",[234,1017,1018],{},"logging"," output included, go to ",[234,1021,1022],{},"logs\u002Fweb.log.error.log",". Out of lite mode there are worker and schedule processes, logged as ",[234,1025,1026],{},"worker_\u003Cqueue-slug>_\u003Ci>.log",[234,1028,1029],{},"schedule.log",", with stderr in ",[234,1032,1033],{},"\u003Clog>.error.log",[218,1035,1036,1039,1040,860,1043,1046,1047,1049,1050,1053,1054,1057,1058,1061,1062,1065],{},[229,1037,1038],{},"The sandbox."," A new systemd bench runs its workload sandboxed, and Frappe's own logs (",[234,1041,1042],{},"frappe.log",[234,1044,1045],{},"scheduler.log","…) are then in ",[234,1048,706],{},". The sandbox needs unprivileged user namespaces, which Ubuntu 24.04 refuses by default (",[234,1051,1052],{},"kernel.apparmor_restrict_unprivileged_userns = 1","): ",[234,1055,1056],{},"pilot setup production"," then fails, and Pilot advises ",[234,1059,1060],{},"sandbox = false"," under ",[234,1063,1064],{},"[production]",". Wolf reads both layouts.",[361,1067,717],{"id":717},[218,1069,1070,1071,456],{},"Each site vhost logs to ",[234,1072,722],{},[366,1074,1077],{"className":1075,"code":1076,"language":717,"meta":371,"style":371},"language-nginx shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","log_format pilot_access '$pilot_client_addr [$time_local] \"$request_method $uri\" $status \"$host\" $request_time';\n",[234,1078,1079],{"__ignoreMap":371},[375,1080,1081,1084,1088,1091,1094,1097,1100,1102,1105,1108,1110,1113,1116,1119,1122,1124,1127,1130,1132,1135,1137,1139,1142,1144],{"class":377,"line":378},[375,1082,1083],{"class":469},"log_format ",[375,1085,1087],{"class":1086},"sTEyZ","pilot_access ",[375,1089,1090],{"class":385},"'",[375,1092,1093],{"class":469},"$",[375,1095,1096],{"class":1086},"pilot_client_addr",[375,1098,1099],{"class":385}," [",[375,1101,1093],{"class":469},[375,1103,1104],{"class":1086},"time_local",[375,1106,1107],{"class":385},"] \"",[375,1109,1093],{"class":469},[375,1111,1112],{"class":1086},"request_method",[375,1114,1115],{"class":469}," $",[375,1117,1118],{"class":1086},"uri",[375,1120,1121],{"class":385},"\" ",[375,1123,1093],{"class":469},[375,1125,1126],{"class":1086},"status",[375,1128,1129],{"class":385}," \"",[375,1131,1093],{"class":469},[375,1133,1134],{"class":1086},"host",[375,1136,1121],{"class":385},[375,1138,1093],{"class":469},[375,1140,1141],{"class":1086},"request_time",[375,1143,1090],{"class":385},[375,1145,1146],{"class":469},";\n",[218,1148,1149,1150,303,1153,1156,1157,1160,1161,1164,1165,1168,1169,860,1172,1175,1176,1180],{},"This format has ",[229,1151,1152],{},"no query string",[234,1154,1155],{},"$uri",", not ",[234,1158,1159],{},"$request_uri",") and ",[229,1162,1163],{},"no User-Agent",". On a Pilot bench, Wolf's ",[221,1166,1167],{"href":125},"web detection"," sees probed paths (",[234,1170,1171],{},"\u002F.env",[234,1173,1174],{},"\u002F.git\u002F",", CMS and appliance paths) but not injections or path traversal carried in a query string, nor scanners named by their User-Agent. ",[221,1177,1179],{"href":1178},"\u002Fsecurity\u002Fwazuh-suricata#suricata","Suricata"," sees the full requests.",[361,1182,1184],{"id":1183},"tasks","Tasks",[218,1186,1187,1188,307,1191,456],{},"Admin operations are tasks, stored as ",[234,1189,1190],{},"\u003Cbench>\u002Ftasks\u002F\u003CYYYYMMDD-HHMMSS-hex>\u002F",[234,1192,1193],{},"0700",[313,1195,1196,1227],{},[316,1197,1198,1201,1202,860,1205,860,1208,860,1211,860,1214,860,1217,1220,1221,860,1224,245],{},[234,1199,1200],{},"meta.json",": ",[234,1203,1204],{},"task_id",[234,1206,1207],{},"command",[234,1209,1210],{},"args",[234,1212,1213],{},"queued_at",[234,1215,1216],{},"started_at",[234,1218,1219],{},"finished_at"," (UTC ISO-8601), ",[234,1222,1223],{},"exit_code",[234,1225,1226],{},"failure",[316,1228,1229,1201,1231,860,1234,860,1237,860,1240,1243,1244,245],{},[234,1230,1126],{},[234,1232,1233],{},"queued",[234,1235,1236],{},"running",[234,1238,1239],{},"success",[234,1241,1242],{},"failed"," or ",[234,1245,1246],{},"killed",[266,1248,1250],{"id":1249},"deployment-events-from-pilot-tasks","Deployment events from Pilot tasks",[218,1252,1253],{},"Wolf reports these task commands:",[218,1255,1256,860,1259,860,1262,860,1265,860,1268,860,1271,860,1274,860,1277,860,1280,860,1283,860,1286,860,1289,860,1292,860,1295,860,1298,860,1301,860,1304,860,1307,245],{},[234,1257,1258],{},"update",[234,1260,1261],{},"retry-update",[234,1263,1264],{},"complete-migration",[234,1266,1267],{},"migrate",[234,1269,1270],{},"revert-migration",[234,1272,1273],{},"revert-apps",[234,1275,1276],{},"revert-site",[234,1278,1279],{},"switch-branch",[234,1281,1282],{},"get-and-install-app",[234,1284,1285],{},"install-app",[234,1287,1288],{},"uninstall-app",[234,1290,1291],{},"remove-app",[234,1293,1294],{},"build",[234,1296,1297],{},"restart-services",[234,1299,1300],{},"switch-lite-mode",[234,1302,1303],{},"setup-nginx",[234,1305,1306],{},"restore-site",[234,1308,1309],{},"reinstall-site",[218,1311,1312,1313,237,1316,1319],{},"The site comes from the task's ",[234,1314,1315],{},"site",[234,1317,1318],{},"sites"," arguments; nothing else of the arguments is kept.",[361,1321,1323],{"id":1322},"where-tasks-are-read","Where tasks are read",[1325,1326,1327,1338,1347],"ol",{},[316,1328,1329,860,1332,662,1335,1337],{},[229,1330,1331],{},"Task files",[234,1333,1334],{},"\u003Cbench>\u002Ftasks\u002F*\u002Fmeta.json",[234,1336,1126],{},", when the agent can read them (an agent run as the bench user).",[316,1339,1340,860,1344,1346],{},[229,1341,1342,808],{},[234,1343,294],{},[234,1345,302],{},", when it is less than 5 minutes old: the normal case.",[316,1348,1349,860,1352,1355,1356,1358,1359,1243,1361,1363],{},[229,1350,1351],{},"Admin API",[234,1353,1354],{},"GET http:\u002F\u002F127.0.0.1:\u003Cadmin.port+1>\u002Fapi\u002Fv1\u002Ftasks?limit=100",", only without the two others. It needs a bench-scoped token: ",[234,1357,591],{},", or one Wolf mints from ",[234,1360,600],{},[234,1362,284],{},". Pilot lists every token it verifies among the Admin's active sessions, and a bench-scoped token can do everything the Admin can: the copy avoids both.",[361,1365,1367],{"id":1366},"how-events-are-produced","How events are produced",[313,1369,1370,1381,1398,1404],{},[316,1371,786,1372,1374,1375,1377,1378,245],{},[234,1373,789],{}," event is sent when the task starts, timestamped at ",[234,1376,1216],{},". An incident during a long migrate links to it, for example through the \"502 spike after deployment\" ",[221,1379,1380],{"href":97},"preset",[316,1382,1383,1384,1386,1387,1389,1390,860,1393,662,1396,245],{},"An ",[234,1385,800],{}," event is sent if the task ends ",[234,1388,1242],{},". It carries ",[234,1391,1392],{},"failure.code",[234,1394,1395],{},"failure.message",[234,1397,1223],{},[316,1399,1400,1401,245],{},"Reported task ids are kept for 3 days in ",[234,1402,1403],{},"\u003Cspool_dir>\u002Fpilot-tasks.json",[316,1405,1406],{},"The first poll skips history and only picks up queued or running tasks.",[218,1408,1409,1410,1412,1413,1415],{},"A migrate also records the site's own ",[234,1411,789],{}," event (source ",[234,1414,851],{},"), as on any bench: Pilot's says which task ran it.",[266,1417,1419],{"id":1418},"wolf-next-to-pilots-own-monitoring","Wolf next to Pilot's own monitoring",[218,1421,1422],{},"From the Pilot docs:",[313,1424,1425,1431,1441],{},[316,1426,1427,1430],{},[234,1428,1429],{},"pilot-monitor.service"," collects host, database and bench metrics and pings production sites.",[316,1432,1433,1436,1437,1440],{},[234,1434,1435],{},"[resource_limits]"," raises CPU, memory, disk and uptime alerts after 5 minutes. They go to Central (on Central-managed hosts), to ",[234,1438,1439],{},"webhook_endpoints"," and to mail.",[316,1442,1443,1446],{},[234,1444,1445],{},"[telemetry]"," ships metrics and logs to a region's \"Datum\" endpoint with a Central-issued token.",[218,1448,1449],{},"Wolf reads the same local files and does not interfere with any of these. What it adds on a self-hosted Pilot host:",[313,1451,1452,1455,1458,1461],{},[316,1453,1454],{},"Tracebacks, failed scheduled jobs and worker crashes as events.",[316,1456,1457],{},"5xx\u002F502 per site.",[316,1459,1460],{},"SSH signals.",[316,1462,1463],{},"Incidents tied to the Pilot task that preceded them.",[218,1465,1466],{},"All of it is kept on your own Wolf site.",[266,1468,1470],{"id":1469},"the-wolf-app-on-a-pilot-bench","The Wolf App on a Pilot bench",[218,1472,1473,1474,860,1477,1480,1481,1484,1485,1488,1489,1492,1493,1496],{},"The Wolf App installs on a Pilot bench like any app (",[234,1475,1476],{},"pilot get-app",[234,1478,1479],{},"pilot install-app","). Pilot checks that every app an app requires in ",[234,1482,1483],{},"hooks.py"," is declared in its ",[234,1486,1487],{},"pyproject.toml"," ",[234,1490,1491],{},"[tool.bench.frappe-dependencies]",", Frappe excepted: Frappe is implicit, and an app that lists it in ",[234,1494,1495],{},"required_apps"," is refused.",[266,1498,1500],{"id":1499},"what-pilot-would-need","What Pilot would need",[1325,1502,1503,1522,1531],{},[316,1504,1505,1508,1509,1512,1513,303,1515,860,1518,1521],{},[229,1506,1507],{},"\"Enable Wolf for this bench\" toggle."," A ",[234,1510,1511],{},"[wolf]"," table in ",[234,1514,284],{},[234,1516,1517],{},"enabled",[234,1519,1520],{},"url",") plus an Admin settings switch, which would install and register the agent. It belongs in frappe\u002Fpilot.",[316,1523,1524,303,1527,1530],{},[229,1525,1526],{},"A read-only machine token for the Admin API",[234,1528,1529],{},"tasks:read",", unit states), which would make the root helper unnecessary.",[316,1532,1533,1538],{},[229,1534,1535,1536],{},"The query string and User-Agent in ",[234,1537,726],{},", for web attack detection from the access log.",[1540,1541,1542],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}",{"title":371,"searchDepth":378,"depth":473,"links":1544},[1545,1548,1549,1556,1560,1561,1562],{"id":268,"depth":473,"text":24,"children":1546},[1547],{"id":445,"depth":490,"text":60},{"id":620,"depth":473,"text":621},{"id":832,"depth":473,"text":833,"children":1550},[1551,1552,1553,1554,1555],{"id":836,"depth":490,"text":837},{"id":879,"depth":490,"text":284},{"id":966,"depth":490,"text":967},{"id":717,"depth":490,"text":717},{"id":1183,"depth":490,"text":1184},{"id":1249,"depth":473,"text":1250,"children":1557},[1558,1559],{"id":1322,"depth":490,"text":1323},{"id":1366,"depth":490,"text":1367},{"id":1418,"depth":473,"text":1419},{"id":1469,"depth":473,"text":1470},{"id":1499,"depth":473,"text":1500},"Run the Wolf Agent on a Frappe Pilot host and turn Pilot tasks into deployment events.","md",null,{},{"icon":48},{"title":45,"description":1563},"NzmZfpr57e72gBH1L92X1jymPPLH6dLfsr1jdMrhhd8",[1571,1573],{"title":40,"path":41,"stem":42,"description":1572,"icon":43},"Install the Wolf App on the bench's other sites as satellites that forward to the central site.",{"title":55,"path":56,"stem":57,"description":1574,"icon":58},"Every metric and event the Wolf Agent sends, and where it reads it.",1795107942208]