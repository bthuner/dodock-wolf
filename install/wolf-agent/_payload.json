r Wolf","\u002Finternals\u002Fwolf","7.internals\u002F6.wolf",{"id":213,"title":35,"body":214,"description":751,"extension":752,"links":753,"meta":754,"navigation":755,"path":36,"seo":756,"stem":37,"__hash__":757},"docs_en\u002F2.install\u002F2.wolf-agent.md",{"type":215,"value":216,"toc":743},"minimark",[217,221,226,234,299,302,329,332,391,395,490,498,565,570,574,577,601,620,624,694,704,708,718,725,729,739],[218,219,220],"p",{},"The Wolf Agent is a Python daemon (3.9 or later, standard library only). Install one per host:\nit watches every bench on that host.",[222,223,225],"h2",{"id":224},"one-line-install","One-line install",[218,227,228,229,233],{},"Copy the command from ",[230,231,232],"strong",{},"Wolf Settings → Agent install command",", or write it yourself:",[235,236,242],"pre",{"className":237,"code":238,"filename":239,"language":240,"meta":241,"style":241},"language-bash shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","curl -fsSL https:\u002F\u002Fraw.githubusercontent.com\u002Fbthuner\u002Fdodock-wolf\u002Fmain\u002Fagent\u002Finstall.sh \\\n  | sudo WOLF_URL=https:\u002F\u002Fwolf.example.com WOLF_TOKEN=\u003Cregistration token> bash\n","host","bash","",[243,244,245,265],"code",{"__ignoreMap":241},[246,247,250,254,258,261],"span",{"class":248,"line":249},"line",1,[246,251,253],{"class":252},"sBMFI","curl",[246,255,257],{"class":256},"sfazB"," -fsSL",[246,259,260],{"class":256}," https:\u002F\u002Fraw.githubusercontent.com\u002Fbthuner\u002Fdodock-wolf\u002Fmain\u002Fagent\u002Finstall.sh",[246,262,264],{"class":263},"sTEyZ"," \\\n",[246,266,268,272,275,278,281,284,287,290,293,296],{"class":248,"line":267},2,[246,269,271],{"class":270},"sMK4o","  |",[246,273,274],{"class":252}," sudo",[246,276,277],{"class":256}," WOLF_URL=https:\u002F\u002Fwolf.example.com",[246,279,280],{"class":256}," WOLF_TOKEN=",[246,282,283],{"class":270},"\u003C",[246,285,286],{"class":256},"registration",[246,288,289],{"class":256}," toke",[246,291,292],{"class":263},"n",[246,294,295],{"class":270},">",[246,297,298],{"class":256}," bash\n",[218,300,301],{},"From a checkout of the repository:",[235,303,305],{"className":237,"code":304,"filename":239,"language":240,"meta":241,"style":241},"sudo WOLF_URL=https:\u002F\u002Fwolf.example.com WOLF_TOKEN=\u003Cregistration token> .\u002Fagent\u002Finstall.sh\n",[243,306,307],{"__ignoreMap":241},[246,308,309,312,314,316,318,320,322,324,326],{"class":248,"line":249},[246,310,311],{"class":252},"sudo",[246,313,277],{"class":256},[246,315,280],{"class":256},[246,317,283],{"class":270},[246,319,286],{"class":256},[246,321,289],{"class":256},[246,323,292],{"class":263},[246,325,295],{"class":270},[246,327,328],{"class":256}," .\u002Fagent\u002Finstall.sh\n",[218,330,331],{},"The script:",[333,334,335,347,366,373,379],"ol",{},[336,337,338,339,342,343,346],"li",{},"creates a venv in ",[243,340,341],{},"\u002Fopt\u002Fwolf-agent"," and links ",[243,344,345],{},"\u002Fusr\u002Flocal\u002Fbin\u002Fwolf-agent",";",[336,348,349,350,353,354,357,358,361,362,365],{},"creates the system user ",[243,351,352],{},"wolf-agent"," and adds it to ",[243,355,356],{},"adm",", ",[243,359,360],{},"systemd-journal"," and ",[243,363,364],{},"frappe"," when\nthose groups exist, so it reads auth, nginx and bench logs without root;",[336,367,368,369,372],{},"registers the host and writes ",[243,370,371],{},"\u002Fetc\u002Fwolf-agent\u002Fconfig.json"," (mode 0600);",[336,374,375,376,346],{},"installs and starts ",[243,377,378],{},"wolf-agent.service",[336,380,381,382,386,387,390],{},"on a ",[383,384,385],"a",{"href":46},"Frappe Pilot"," host, installs ",[243,388,389],{},"wolf-pilot-export",", a root timer that copies\nthe bench's task and process states the agent cannot read itself.",[222,392,394],{"id":393},"install-options","Install options",[396,397,398,411],"table",{},[399,400,401],"thead",{},[402,403,404,408],"tr",{},[405,406,407],"th",{},"Variable",[405,409,410],{},"Effect",[412,413,414,425,439,453,467,480],"tbody",{},[402,415,416,422],{},[417,418,419],"td",{},[243,420,421],{},"WOLF_URL",[417,423,424],{},"The central Wolf site.",[402,426,427,432],{},[417,428,429],{},[243,430,431],{},"WOLF_TOKEN",[417,433,434,435,438],{},"Its registration token (",[230,436,437],{},"Wolf Settings",").",[402,440,441,446],{},[417,442,443],{},[243,444,445],{},"WOLF_BENCHES",[417,447,448,449,452],{},"Space-separated bench paths, to skip auto-discovery: ",[243,450,451],{},"\"\u002Fhome\u002Ffrappe\u002Ffrappe-bench \u002Fsrv\u002Fother-bench\"",".",[402,454,455,460],{},[417,456,457],{},[243,458,459],{},"WOLF_AGENT_SRC",[417,461,462,463,466],{},"pip source: a local directory or a ",[243,464,465],{},"git+https"," URL. Default: the script's directory, or GitHub when piped from curl.",[402,468,469,474],{},[417,470,471],{},[243,472,473],{},"WOLF_AGENT_REF",[417,475,476,477,452],{},"Git ref when installing from GitHub. Default ",[243,478,479],{},"main",[402,481,482,487],{},[417,483,484],{},[243,485,486],{},"WOLF_INSECURE=1",[417,488,489],{},"Skip TLS verification during registration and pushes (self-signed Wolf site).",[218,491,492,493,361,495,497],{},"Without ",[243,494,421],{},[243,496,431],{},", the agent is installed but not registered. Register it later:",[235,499,501],{"className":237,"code":500,"filename":239,"language":240,"meta":241,"style":241},"sudo wolf-agent --config \u002Fetc\u002Fwolf-agent\u002Fconfig.json register --url https:\u002F\u002Fwolf.example.com --token \u003Ctoken>\nsudo chown wolf-agent: \u002Fetc\u002Fwolf-agent\u002Fconfig.json && sudo systemctl start wolf-agent\n",[243,502,503,539],{"__ignoreMap":241},[246,504,505,507,510,513,516,519,522,525,528,531,534,536],{"class":248,"line":249},[246,506,311],{"class":252},[246,508,509],{"class":256}," wolf-agent",[246,511,512],{"class":256}," --config",[246,514,515],{"class":256}," \u002Fetc\u002Fwolf-agent\u002Fconfig.json",[246,517,518],{"class":256}," register",[246,520,521],{"class":256}," --url",[246,523,524],{"class":256}," https:\u002F\u002Fwolf.example.com",[246,526,527],{"class":256}," --token",[246,529,530],{"class":270}," \u003C",[246,532,533],{"class":256},"toke",[246,535,292],{"class":263},[246,537,538],{"class":270},">\n",[246,540,541,543,546,549,551,554,556,559,562],{"class":248,"line":267},[246,542,311],{"class":252},[246,544,545],{"class":256}," chown",[246,547,548],{"class":256}," wolf-agent:",[246,550,515],{"class":256},[246,552,553],{"class":270}," &&",[246,555,274],{"class":252},[246,557,558],{"class":256}," systemctl",[246,560,561],{"class":256}," start",[246,563,564],{"class":256}," wolf-agent\n",[218,566,567,568,452],{},"Without systemd (a container), the script prints the command to run as ",[243,569,352],{},[222,571,573],{"id":572},"bench-discovery","Bench discovery",[218,575,576],{},"The agent finds benches by itself:",[578,579,580,593],"ul",{},[336,581,582,583,586,587,361,590,346],{},"a ",[243,584,585],{},"bench.toml",", or a directory with ",[243,588,589],{},"sites\u002F",[243,591,592],{},"apps\u002Ffrappe",[336,594,595,597,598,600],{},[383,596,45],{"href":46},", read with Pilot's real ",[243,599,585],{}," schema.",[235,602,604],{"className":237,"code":603,"filename":239,"language":240,"meta":241,"style":241},"sudo -u wolf-agent wolf-agent discover\n",[243,605,606],{"__ignoreMap":241},[246,607,608,610,613,615,617],{"class":248,"line":249},[246,609,311],{"class":252},[246,611,612],{"class":256}," -u",[246,614,509],{"class":256},[246,616,509],{"class":256},[246,618,619],{"class":256}," discover\n",[222,621,623],{"id":622},"check-it","Check it",[235,625,627],{"className":237,"code":626,"filename":239,"language":240,"meta":241,"style":241},"sudo -u wolf-agent wolf-agent doctor           # what this host gives the agent, and what to fix\nsudo -u wolf-agent wolf-agent check            # collect once, print the payload, send nothing\nsudo -u wolf-agent wolf-agent check --status   # also ask the site for its health\njournalctl -u wolf-agent -f\n",[243,628,629,646,662,681],{"__ignoreMap":241},[246,630,631,633,635,637,639,642],{"class":248,"line":249},[246,632,311],{"class":252},[246,634,612],{"class":256},[246,636,509],{"class":256},[246,638,509],{"class":256},[246,640,641],{"class":256}," doctor",[246,643,645],{"class":644},"sHwdD","           # what this host gives the agent, and what to fix\n",[246,647,648,650,652,654,656,659],{"class":248,"line":267},[246,649,311],{"class":252},[246,651,612],{"class":256},[246,653,509],{"class":256},[246,655,509],{"class":256},[246,657,658],{"class":256}," check",[246,660,661],{"class":644},"            # collect once, print the payload, send nothing\n",[246,663,665,667,669,671,673,675,678],{"class":248,"line":664},3,[246,666,311],{"class":252},[246,668,612],{"class":256},[246,670,509],{"class":256},[246,672,509],{"class":256},[246,674,658],{"class":256},[246,676,677],{"class":256}," --status",[246,679,680],{"class":644},"   # also ask the site for its health\n",[246,682,684,687,689,691],{"class":248,"line":683},4,[246,685,686],{"class":252},"journalctl",[246,688,612],{"class":256},[246,690,509],{"class":256},[246,692,693],{"class":256}," -f\n",[218,695,696,697,699,700,703],{},"Within a minute the host appears in the Wolf UI. On the Wolf site it is a ",[230,698,35],{}," record\n(",[243,701,702],{},"WAG-0001","…) carrying its host name.",[222,705,707],{"id":706},"credentials","Credentials",[218,709,710,711,714,715,717],{},"The agent's secret is shown once, at registration. The site keeps only a salted HMAC-SHA256 hash.\nTo move an agent or recover a lost config, click ",[230,712,713],{},"Rotate secret"," on the ",[230,716,35],{}," form, or\nregister the host again.",[218,719,720,721,724],{},"If the site rejects the credentials (401 or 403), the agent sends a last ",[383,722,723],{"href":76},"watchdog","\nalert and exits with status 2, and systemd stops restarting it.",[222,726,728],{"id":727},"next","Next",[578,730,731,735],{},[336,732,733],{},[383,734,55],{"href":56},[336,736,