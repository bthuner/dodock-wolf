,548,561,570],"ul",{},[316,549,550,551,554,555,341,558,326],{},"a ",[223,552,553],{},"bench.toml",", or a directory with ",[223,556,557],{},"sites\u002F",[223,559,560],{},"apps\u002Ffrappe",[316,562,563,566,567,569],{},[564,565,50],"a",{"href":51},", read with Pilot's real ",[223,568,553],{}," schema;",[316,571,572,574,575,359],{},[564,573,45],{"href":46},", detected from ",[223,576,577],{},"\u002Fhome\u002Ffrappe\u002Fagent\u002Fconfig.json",[215,579,581],{"className":217,"code":580,"filename":219,"language":220,"meta":221,"style":221},"sudo -u wolf-agent wolf-agent discover\n",[223,582,583],{"__ignoreMap":221},[226,584,585,587,590,592,594],{"class":228,"line":229},[226,586,291],{"class":232},[226,588,589],{"class":236}," -u",[226,591,477],{"class":236},[226,593,477],{"class":236},[226,595,596],{"class":236}," discover\n",[202,598,600],{"id":599},"check-it","Check it",[215,602,604],{"className":217,"code":603,"filename":219,"language":220,"meta":221,"style":221},"sudo -u wolf-agent wolf-agent check            # collect once, print the payload, send nothing\nsudo -u wolf-agent wolf-agent check --status   # also ask the site for its health\njournalctl -u wolf-agent -f\n",[223,605,606,623,641],{"__ignoreMap":221},[226,607,608,610,612,614,616,619],{"class":228,"line":229},[226,609,291],{"class":232},[226,611,589],{"class":236},[226,613,477],{"class":236},[226,615,477],{"class":236},[226,617,618],{"class":236}," check",[226,620,622],{"class":621},"sHwdD","            # collect once, print the payload, send nothing\n",[226,624,625,627,629,631,633,635,638],{"class":228,"line":247},[226,626,291],{"class":232},[226,628,589],{"class":236},[226,630,477],{"class":236},[226,632,477],{"class":236},[226,634,618],{"class":236},[226,636,637],{"class":236}," --status",[226,639,640],{"class":621},"   # also ask the site for its health\n",[226,642,644,647,649,651],{"class":228,"line":643},3,[226,645,646],{"class":232},"journalctl",[226,648,589],{"class":236},[226,650,477],{"class":236},[226,652,653],{"class":236}," -f\n",[198,655,656,657,659,660,663],{},"Within a minute the host appears in the Wolf UI. On the Wolf site it is a ",[210,658,35],{}," record\n(",[223,661,662],{},"WAG-0001","…) carrying its host name.",[202,665,667],{"id":666},"credentials","Credentials",[198,669,670,671,674,675,677],{},"The agent's secret is shown once, at registration. The site keeps only a salted HMAC-SHA256 hash.\nTo move an agent or recover a lost config, click ",[210,672,673],{},"Rotate secret"," on the ",[210,676,35],{}," form, or\nregister the host again.",[198,679,680,681,684],{},"If the site rejects the credentials (401 or 403), the agent sends a last ",[564,682,683],{"href":81},"watchdog","\nalert and exits with status 2, and systemd stops restarting it.",[202,686,688],{"id":687},"next","Next",[546,690,691,695],{},[316,692,693],{},[564,694,60],{"href":61},[316,696,697],{},[564,698,65],{"href":66},[700,701,702],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);f