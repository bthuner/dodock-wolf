560,316],{},"a ",[213,554,555],{},"bench.toml",", or a directory with ",[213,558,559],{},"sites\u002F",[213,561,562],{},"apps\u002Ffrappe",[306,564,565,567,568,570],{},[353,566,45],{"href":46},", read with Pilot's real ",[213,569,555],{}," schema.",[205,572,574],{"className":207,"code":573,"filename":209,"language":210,"meta":211,"style":211},"sudo -u wolf-agent wolf-agent discover\n",[213,575,576],{"__ignoreMap":211},[216,577,578,580,583,585,587],{"class":218,"line":219},[216,579,281],{"class":222},[216,581,582],{"class":226}," -u",[216,584,479],{"class":226},[216,586,479],{"class":226},[216,588,589],{"class":226}," discover\n",[192,591,593],{"id":592},"check-it","Check it",[205,595,597],{"className":207,"code":596,"filename":209,"language":210,"meta":211,"style":211},"sudo -u wolf-agent wolf-agent doctor           # what this host gives the agent, and what to fix\nsudo -u wolf-agent wolf-agent check            # collect once, print the payload, send nothing\nsudo -u wolf-agent wolf-agent check --status   # also ask the site for its health\njournalctl -u wolf-agent -f\n",[213,598,599,616,632,651],{"__ignoreMap":211},[216,600,601,603,605,607,609,612],{"class":218,"line":219},[216,602,281],{"class":222},[216,604,582],{"class":226},[216,606,479],{"class":226},[216,608,479],{"class":226},[216,610,611],{"class":226}," doctor",[216,613,615],{"class":614},"sHwdD","           # what this host gives the agent, and what to fix\n",[216,617,618,620,622,624,626,629],{"class":218,"line":237},[216,619,281],{"class":222},[216,621,582],{"class":226},[216,623,479],{"class":226},[216,625,479],{"class":226},[216,627,628],{"class":226}," check",[216,630,631],{"class":614},"            # collect once, print the payload, send nothing\n",[216,633,635,637,639,641,643,645,648],{"class":218,"line":634},3,[216,636,281],{"class":222},[216,638,582],{"class":226},[216,640,479],{"class":226},[216,642,479],{"class":226},[216,644,628],{"class":226},[216,646,647],{"class":226}," --status",[216,649,650],{"class":614},"   # also ask the site for its health\n",[216,652,654,657,659,661],{"class":218,"line":653},4,[216,655,656],{"class":222},"journalctl",[216,658,582],{"class":226},[216,660,479],{"class":226},[216,662,663],{"class":226}," -f\n",[188,665,666,667,669,670,673],{},"Within a minute the host appears in the Wolf UI. On the Wolf site it is a ",[200,668,35],{}," record\n(",[213,671,672],{},"WAG-0001","…) carrying its host name.",[192,675,677],{"id":676},"credentials","Credentials",[188,679,680,681,684,685,687],{},"The agent's secret is shown once, at registration. The site keeps only a salted HMAC-SHA256 hash.\nTo move an agent or recover a lost config, click ",[200,682,683],{},"Rotate secret"," on the ",[200,686,35],{}," form, or\nregister the host again.",[188,689,690,691,694],{},"If the site rejects the credentials (401 or 403), the agent sends a last ",[353,692,693],{"href":76},"watchdog","\nalert and exits with status 2, and systemd stops restarting it.",[192,696,698],{"id":697},"next","Next",[548,700,701,705],{},[306,702,703],{},[353,704,55],{"href":56},[306,706,707],{},[353,708,60],{"href":61},[710,711,712],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-