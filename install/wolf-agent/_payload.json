,[226,301,269],{"class":236},[226,303,272],{"class":243},[226,305,275],{"class":250},[226,307,308],{"class":236}," .\u002Fagent\u002Finstall.sh\n",[198,310,311],{},"The script:",[313,314,315,327,346,353,359],"ol",{},[316,317,318,319,322,323,326],"li",{},"creates a venv in ",[223,320,321],{},"\u002Fopt\u002Fwolf-agent"," and links ",[223,324,325],{},"\u002Fusr\u002Flocal\u002Fbin\u002Fwolf-agent",";",[316,328,329,330,333,334,337,338,341,342,345],{},"creates the system user ",[223,331,332],{},"wolf-agent"," and adds it to ",[223,335,336],{},"adm",", ",[223,339,340],{},"systemd-journal"," and ",[223,343,344],{},"frappe"," when\nthose groups exist, so it reads auth, nginx and bench logs without root;",[316,347,348,349,352],{},"registers the host and writes ",[223,350,351],{},"\u002Fetc\u002Fwolf-agent\u002Fconfig.json"," (mode 0600);",[316,354,355,356,326],{},"installs and starts ",[223,357,358],{},"wolf-agent.service",[316,360,361,362,366,367,370],{},"on a ",[363,364,365],"a",{"href":51},"Frappe Pilot"," host, installs ",[223,368,369],{},"wolf-pilot-export",", a root timer that copies\nthe bench's task and process states the agent cannot read itself.",[202,372,374],{"id":373},"install-options","Install options",[376,377,378,391],"table",{},[379,380,381],"thead",{},[382,383,384,388],"tr",{},[385,386,387],"th",{},"Variable",[385,389,390],{},"Effect",[392,393,394,405,419,433,447,460],"tbody",{},[382,395,396,402],{},[397,398,399],"td",{},[223,400,401],{},"WOLF_URL",[397,403,404],{},"The central Wolf site.",[382,406,407,412],{},[397,408,409],{},[223,410,411],{},"WOLF_TOKEN",[397,413,414,415,418],{},"Its registration token (",[210,416,417],{},"Wolf Settings",").",[382,420,421,426],{},[397,422,423],{},[223,424,425],{},"WOLF_BENCHES",[397,427,428,429,432],{},"Space-separated bench paths, to skip auto-discovery: ",[223,430,431],{},"\"\u002Fhome\u002Ffrappe\u002Ffrappe-bench \u002Fsrv\u002Fother-bench\"",".",[382,434,435,440],{},[397,436,437],{},[223,438,439],{},"WOLF_AGENT_SRC",[397,441,442,443,446],{},"pip source: a local directory or a ",[223,444,445],{},"git+https"," URL. Default: the script's directory, or GitHub when piped from curl.",[382,448,449,454],{},[397,450,451],{},[223,452,453],{},"WOLF_AGENT_REF",[397,455,456,457,432],{},"Git ref when installing from GitHub. Default ",[223,458,459],{},"main",[382,461,462,467],{},[397,463,464],{},[223,465,466],{},"WOLF_INSECURE=1",[397,468,469],{},"Skip TLS verification during registration and pushes (self-signed Wolf site).",[198,471,472,473,341,475,477],{},"Without ",[223,474,401],{},[223,476,411],{},", the agent is installed but not registered. Register it later:",[215,479,481],{"className":217,"code":480,"filename":219,"language":220,"meta":221,"style":221},"sudo wolf-agent --config \u002Fetc\u002Fwolf-agent\u002Fconfig.json register --url https:\u002F\u002Fwolf.example.com --token \u003Ctoken>\nsudo chown wolf-agent: \u002Fetc\u002Fwolf-agent\u002Fconfig.json && sudo systemctl start wolf-agent\n",[223,482,483,519],{"__ignoreMap":221},[226,484,485,487,490,493,496,499,502,505,508,511,514,516],{"class":228,"line":229},[226,486,291],{"class":232},[226,488,489],{"class":236}," wolf-agent",[226,491,492],{"class":236}," --config",[226,494,495],{"class":236}," \u002Fetc\u002Fwolf-agent\u002Fconfig.json",[226,497,498],{"class":236}," register",[226,500,501],{"class":236}," --url",[226,503,504],{"class":236}," https:\u002F\u002Fwolf.example.com",[226,506,507],{"class":236}," --token",[226,509,510],{"class":250}," \u003C",[226,512,513],{"class":236},"toke",[226,515,272],{"class":243},[226,517,518],{"class":250},">\n",[226,520,521,523,526,529,531,534,536,539,542],{"class":228,"line":247},[226,522,291],{"class":232},[226,524,525],{"class":236}," chown",[226,527,528],{"class":236}," wolf-agent:",[226,530,495],{"class":236},[226,532,533],{"class":250}," &&",[226,535,254],{"class":232},[226,537,538],{"class":236}," systemctl",[226,540,541],{"class":236}," start",[226,543,544],{"class":236}," wolf-agent\n",[198,546,547,548,432],{},"Without systemd (a container), the script prints the command to run as ",[223,549,332],{},[202,551,553],{"id":552},"bench-discovery","Bench discovery",[198,555,556],{},"The agent finds benches by itself:",[558,559,560,573,581],"ul",{},[316,561,562,563,566,567,341,570,326],{},"a ",[223,564,565],{},"bench.toml",", or a directory with ",[223,568,569],{},"sites\u002F",[223,571,572],{},"apps\u002Ffrappe",[316,574,575,577,578,580],{},[363,576,50],{"href":51},", read with Pilot's real ",[223,579,565],{}," schema;",[316,582,583,585,586,432],{},[363,584,45],{"href":46},", detected from ",[223,587,588],{},"\u002Fhome\u002Ffrappe\u002Fagent\u002Fconfig.json",[215,590,592],{"className":217,"code":591,"filename":219,"language":220,"meta":221,"style":221},"sudo -u wolf-agent wolf-agent discover\n",[223,593,594],{"__ignoreMap":221},[226,595,596,598,601,603,605],{"class":228,"line":229},[226,597,291],{"class":232},[226,599,600],{"class":236}," -u",[226,602,489],{"class":236},[226,604,489],{"class":236},[226,606,607],{"class":236}," discover\n",[202,609,611],{"id":610},"check-it","Check it",[215,613,615],{"className":217,"code":614,"filename":219,"language":220,"meta":221,"style":221},"sudo -u wolf-agent wolf-agent doctor           # what this host gives the agent, and what to fix\nsudo -u wolf-agent wolf-agent check            # collect once, print the payload, send nothing\nsudo -u wolf-agent wolf-agent check --status   # also ask the site for its health\njournalctl -u wolf-agent -f\n",[223,616,617,634,650,669],{"__ignoreMap":221},[226,618,619,621,623,625,627,630],{"class":228,"line":229},[226,620,291],{"class":232},[226,622,600],{"class":236},[226,624,489],{"class":236},[226,626,489],{"class":236},[226,628,629],{"class":236}," doctor",[226,631,633],{"class":632},"sHwdD","           # what this host gives the agent, and what to fix\n",[226,635,636,638,640,642,644,647],{"class":228,"line":247},[226,637,291],{"class":232},[226,639,600],{"class":236},[226